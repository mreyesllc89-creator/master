//@version=6
strategy("Adaptive Shadow Limits - Buy Only + Regime-Smart Trailing [v6]", overlay=true,
     initial_capital=10000, pyramiding=0,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.04)

// ── Inputs ─────────────────────────────────────
baseOffset       = input.float(2.0,  "Base Shadow Offset (ATR)",      minval=0.5, step=0.1)
atrPeriod        = input.int(14,    "ATR Period",                     minval=1)
adxPeriod        = input.int(14,    "ADX Period (Regime)",            minval=1)
adxTrendLevel    = input.int(25,    "ADX Trending Threshold",         minval=10, maxval=40)
volMAPeriod      = input.int(20,    "Volume MA Period",               minval=5)
volMultiplier    = input.float(1.5, "High Volume Threshold",          minval=1.0, step=0.1)
tightFactor      = input.float(0.55, "Shadow Tighten Factor",         minval=0.3, maxval=1.0, step=0.05)
minOffsetFactor  = input.float(0.8, "Minimum Shadow Offset (ATR)",    minval=0.5, step=0.1)

// Regime-Smart Trailing Inputs
wideTrailMult    = input.float(2.5,  "Wide Trailing (Trending) × ATR",  minval=1.0, step=0.1)
tightTrailMult   = input.float(0.4,  "Tight Trailing (Choppy) × ATR",   minval=0.1, step=0.05)

// ── Calculations ───────────────────────────────
atrVal    = ta.atr(atrPeriod)
// ta.adx does not exist in Pine; ADX comes from ta.dmi(diLength, adxSmoothing)
[diPlus, diMinus, adxVal] = ta.dmi(adxPeriod, adxPeriod)
volMA     = ta.sma(volume, volMAPeriod)

// Some BTCUSD feeds (e.g. index symbols) have no volume; the volume filter is skipped there
hasVolume = not na(volume) and volume > 0

// Liquidity / Buying Pressure Proxies
isHighVol    = hasVolume and not na(volMA) and volume > volMA * volMultiplier
bullishClose = close > open
strongBull   = close > close[1] * 1.001 and bullishClose

// Dynamic Shadow Offset
offset = baseOffset * atrVal
if isHighVol
    offset *= tightFactor
if strongBull
    offset *= 0.75
offset := math.max(offset, minOffsetFactor * atrVal)

// Dynamic Buy Limit Price
buyLimitPrice = close - offset

// Plot Shadow
plot(buyLimitPrice, "Adaptive Buy Shadow", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)

// ── Regime Detection ───────────────────────────
isTrending = adxVal > adxTrendLevel
regimeText = isTrending ? "TRENDING" : "CHOPPY"

// Choose trailing multiplier based on regime
trailMult = isTrending ? wideTrailMult : tightTrailMult

// ── Strategy Logic ─────────────────────────────
// Wait for indicators to warm up before placing orders
ready = not na(atrVal) and not na(adxVal)

// Re-issuing an entry with the same ID replaces the pending limit order each bar
if ready and strategy.position_size == 0
    strategy.entry("Adaptive Buy Limit", strategy.long, limit=buyLimitPrice, comment="Shadow Buy")

// Regime-Smart Trailing Stop: trails the highest close since entry and only ratchets up
var float highestClose = na
var float trailStop    = na

if strategy.position_size > 0
    highestClose := na(highestClose) ? close : math.max(highestClose, close)
    candidate     = highestClose - trailMult * atrVal
    trailStop    := na(trailStop) ? candidate : math.max(trailStop, candidate)
    strategy.exit("Regime-Smart Trail", from_entry="Adaptive Buy Limit", stop=trailStop, comment="Trail Exit")
else
    highestClose := na
    trailStop    := na

plot(trailStop, "Trailing Stop", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Visuals
bgcolor(isHighVol ? color.new(color.green, 90) : na, title="High Liquidity")
bgcolor(isTrending ? color.new(color.teal, 95) : color.new(color.orange, 95), title="Regime Background")

// Table for live info
var table infoTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "Regime", text_color=color.white)
    table.cell(infoTable, 1, 0, regimeText, text_color = isTrending ? color.teal : color.orange)

    table.cell(infoTable, 0, 1, "ADX", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(adxVal, "#.##"), text_color=color.white)

    table.cell(infoTable, 0, 2, "Shadow Offset", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(offset, format.mintick) + " " + syminfo.currency, text_color=color.blue)

    table.cell(infoTable, 0, 3, "Trail Mult", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(trailMult, "0.0#") + "× ATR", text_color = isTrending ? color.teal : color.orange)

    table.cell(infoTable, 0, 4, "Volume Feed", text_color=color.white)
    table.cell(infoTable, 1, 4, hasVolume ? "OK" : "NONE (filter off)", text_color = hasVolume ? color.green : color.red)

// Alerts
if strategy.position_size > 0 and strategy.position_size[1] == 0
    alert("Adaptive Shadow Buy Filled @ " + str.tostring(strategy.position_avg_price, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0 and strategy.position_size[1] > 0
    alert("Regime-Smart Trailing Exit @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
