+{
+   // Positional binding, map declaration order, 30 inputs. Do not reorder.
+   return iCustom(sym, tf, InpDirMapIndicator,
+                  XPDIR_MAP_rsiLen,
+                  XPDIR_MAP_fastLen,
+                  XPDIR_MAP_slowLen,
+                  XPDIR_MAP_invertFill,
+                  XPDIR_MAP_extLook,
+                  XPDIR_MAP_loFrac,
+                  XPDIR_MAP_hiFrac,
+                  XPDIR_MAP_sqBotOn,
+                  XPDIR_MAP_sqBotMin,
+                  XPDIR_MAP_sqBotMax,
+                  XPDIR_MAP_sqBotCtx,
+                  XPDIR_MAP_sqBotSep,
+                  XPDIR_MAP_sqBotArea,
+                  XPDIR_MAP_sqTopOn,
+                  XPDIR_MAP_sqTopMin,
+                  XPDIR_MAP_sqTopMax,
+                  XPDIR_MAP_sqTopCtx,
+                  XPDIR_MAP_sqTopSep,
