//@version=6
indicator("TDI+ (Enhanced, final version)", overlay=false, max_bars_back=500, max_lines_count=100, max_labels_count=200)

// — Inputs —
RSIPeriod         = input.int(21, "RSI Period", minval=1)
PriceLinePeriod   = input.int(2,  "Price Line Period", minval=1)
SignalLinePeriod  = input.int(7,  "Signal Line Period", minval=1)
VolatilityPeriod  = input.int(34, "Volatility Band Period", minval=2)
ApplyToOpt        = input.string("Fast Line", "Apply Angle To", options=["Fast Line","Slow Line","RSI Line","Mid Line"])
PlotBull          = input.bool(true,  "Plot Bullish Divergence")
PlotHiddenBull    = input.bool(false, "Plot Hidden Bullish")
PlotBear          = input.bool(true,  "Plot Bearish Divergence")
PlotHiddenBear    = input.bool(false, "Plot Hidden Bearish")
RangeBars         = input.int(5, "Bars Range", minval=2)
LookbackBars      = input.int(60, "Divergence Lookback (bars)", minval=10, maxval=400)
ArrowDist         = input.float(3.0, "Arrow Distance (RSI points)", minval=0)

// — RSI & Bands —
slow     = ta.rsi(close, RSIPeriod)
ma_mid   = ta.sma(slow, VolatilityPeriod)
stdev    = ta.stdev(slow, VolatilityPeriod)
upper    = ma_mid + 1.6185 * stdev
lower    = ma_mid - 1.6185 * stdev
rsiLine  = ta.sma(slow, PriceLinePeriod)
fastLine = ta.sma(slow, SignalLinePeriod)

// — Background colors —
bgColor = rsiLine >= upper ? color.new(color.green, 85) :
          rsiLine <= lower ? color.new(color.red, 85) : na
bgcolor(bgColor)

// — Angle Calculation —
angle_src = switch ApplyToOpt
    "Fast Line" => fastLine
    "Slow Line" => slow
    "RSI Line"  => rsiLine
    => ma_mid

get_angle(float src, int count) =>
    slope = src - src[count]
    ang = math.atan(slope) * 180 / math.pi
    ang < 0 ? 360 + ang : ang

angle_val = get_angle(angle_src, 1)

// — Divergence Logic —
// A pivot at offset idx needs one confirmed bar to its right (idx - 1 >= 0).
isPeak(int idx) =>
    idx >= 1 and rsiLine[idx] >= rsiLine[idx + 1] and rsiLine[idx] > rsiLine[idx + 2] and rsiLine[idx] > rsiLine[idx - 1]

isTrough(int idx) =>
    idx >= 1 and rsiLine[idx] <= rsiLine[idx + 1] and rsiLine[idx] < rsiLine[idx + 2] and rsiLine[idx] < rsiLine[idx - 1]

// Search backwards (bounded) for the previous trough/peak at least `rng` bars older than idx.
lastTrough(int idx, int rng) =>
    int ans = na
    int maxJ = math.min(idx + LookbackBars, bar_index - 3)
    if idx + rng <= maxJ
        for j = idx + rng to maxJ
            if isTrough(j)
                ans := j
                break
    ans

lastPeak(int idx, int rng) =>
    int ans = na
    int maxJ = math.min(idx + LookbackBars, bar_index - 3)
    if idx + rng <= maxJ
        for j = idx + rng to maxJ
            if isPeak(j)
                ans := j
                break
    ans

// Reset every bar so arrows only print on the bar that detects the divergence.
float bullDiv = na
float bearDiv = na
var line bullLine = na
var line bearLine = na

// Only evaluate the most recently confirmed pivot (offset 1) so each divergence is signalled once.
int idx = 1
if bar_index > LookbackBars
    if isTrough(idx)
        lt = lastTrough(idx, RangeBars)
        if not na(lt)
            if PlotBull and rsiLine[idx] > rsiLine[lt] and low[idx] < low[lt]
                bullDiv := rsiLine[idx] - ArrowDist
                bullLine := line.new(bar_index - lt, rsiLine[lt], bar_index - idx, rsiLine[idx], color=color.lime, width=2)
            else if PlotHiddenBull and rsiLine[idx] < rsiLine[lt] and low[idx] > low[lt]
                bullDiv := rsiLine[idx] - ArrowDist
                bullLine := line.new(bar_index - lt, rsiLine[lt], bar_index - idx, rsiLine[idx], color=color.lime, width=1, style=line.style_dashed)

    if isPeak(idx)
        lp = lastPeak(idx, RangeBars)
        if not na(lp)
            if PlotBear and rsiLine[idx] < rsiLine[lp] and high[idx] > high[lp]
                bearDiv := rsiLine[idx] + ArrowDist
                bearLine := line.new(bar_index - lp, rsiLine[lp], bar_index - idx, rsiLine[idx], color=color.red, width=2)
            else if PlotHiddenBear and rsiLine[idx] > rsiLine[lp] and high[idx] < high[lp]
                bearDiv := rsiLine[idx] + ArrowDist
                bearLine := line.new(bar_index - lp, rsiLine[lp], bar_index - idx, rsiLine[idx], color=color.red, width=1, style=line.style_dashed)

// — Shark Fin breakout detection (first bar outside the band) —
upper_break = ta.crossover(rsiLine, upper)
lower_break = ta.crossunder(rsiLine, lower)

// — Plotting —
plot(rsiLine,  color=color.green,  title="RSI Price Line", linewidth=2)
plot(fastLine, color=color.red,    title="Fast Line")
plot(slow,     color=color.white,  title="Slow Line")
plot(ma_mid,   color=color.yellow, title="Middle Band")
plot(upper,    color=color.aqua,   title="Upper Band")
plot(lower,    color=color.aqua,   title="Lower Band")
plot(angle_val, title="Angle", display=display.data_window)
hline(50, "50 Level", color=color.gray, linestyle=hline.style_dotted)

// Arrows are drawn on the pivot bar (offset -1).
plotshape(bullDiv, style=shape.arrowup,   location=location.absolute, color=color.lime, size=size.small, title="Bull Divergence", offset=-1)
plotshape(bearDiv, style=shape.arrowdown, location=location.absolute, color=color.red,  size=size.small, title="Bear Divergence", offset=-1)

if upper_break
    label.new(bar_index, upper, "Shark Fin 🔼", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)

if lower_break
    label.new(bar_index, lower, "Shark Fin 🔽", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)

// — Alerts —
alertcondition(upper_break, title="Upper Shark Fin Breakout", message="Upper Shark Fin breakout on {{ticker}}")
alertcondition(lower_break, title="Lower Shark Fin Breakout", message="Lower Shark Fin breakout on {{ticker}}")
alertcondition(not na(bullDiv), title="Bullish Divergence", message="Bullish RSI divergence on {{ticker}}")
alertcondition(not na(bearDiv), title="Bearish Divergence", message="Bearish RSI divergence on {{ticker}}")
