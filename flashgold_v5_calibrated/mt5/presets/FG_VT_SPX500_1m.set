InpMagic=220110
InpDeviation=50
InpUseAnyCombo=false
InpBurstAtr=1.0
InpEntryDistAtr=0.1
InpHoldBars=3
InpHoldFavAtr=0.10
InpOneEntryPerBar=true
InpUsePriorFilter=false
InpPriorDriftBars=60
InpAtrLen=14
InpRsiLen=14
InpFastLen=2
InpMinAligned=3
InpAllowNeutralParent=false
InpZoneMode=1
InpUseZone1=true
InpZoneTf1=0
InpUseZone2=true
InpZoneTf2=2
InpUseZone3=true
InpZoneTf3=4
InpUseZone4=true
InpZoneTf4=10
InpUseZone5=false
InpZoneTf5=0
InpUseZone6=false
InpZoneTf6=0
InpDirection=0
InpValidBars=3
InpAllowReverse=true
InpExitOnOpposite=false
InpSlAtr=1.0
InpTpR=3.0
InpUseTrail=true
InpTrailActAtr=1.0
InpTrailDstAtr=0.75
InpMaxBarsHeld=0
InpLots=0.0
