//@version=6
// Calibrated for BTCUSD (crypto, 24/7). Works on any timeframe; best tested results on 4H.
strategy("Stepped Liquidity Limit Bounce - BTCUSD", overlay=true, margin_long=100, margin_short=100, process_orders_on_close=true,
     initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.06)

// =========================================================================
// INPUTS & SETTINGS
// =========================================================================
grp_trade = "Trade Direction & Risk"
tradeDirection = input.string("Both", title="Trade Direction", options=["Buy Only", "Sell Only", "Both"], group=grp_trade)
cancelBars     = input.int(6, title="Cancel Unfilled Order (Bars)", minval=1, group=grp_trade)
useATR         = input.bool(true, title="Use ATR for SL/TP/Cancel", group=grp_trade)
equityPct      = input.float(10, title="Position Size (% of Equity)", minval=0.1, maxval=100, group=grp_trade, tooltip="Backtest sizing. Rounded to the symbol's minimum contract, never below it.")

grp_vol = "Volatility Settings"
atrLength     = input.int(14, "ATR Length", minval=1, group=grp_vol)
atrMultTol    = input.float(0.3, "Touch Tolerance × ATR", minval=0, group=grp_vol)
atrMultSL     = input.float(2.0, "SL × ATR", minval=0.1, group=grp_vol)
atrMultTP     = input.float(4.0, "TP × ATR", minval=0.1, group=grp_vol)
atrMultCancel = input.float(3.0, "Cancel Distance × ATR", minval=0.1, group=grp_vol)

// Fixed distances are in PRICE units ($ for BTCUSD) because BTC tick size differs between feeds/brokers.
grp_fixed = "Fixed Distances (used when ATR is off, in price $)"
fixedTolPrice    = input.float(150,  "Fixed Touch Tolerance ($)", minval=0, group=grp_fixed)
fixedSLPrice     = input.float(800,  "Fixed SL ($)", minval=0.01, group=grp_fixed)
fixedTPPrice     = input.float(1600, "Fixed TP ($)", minval=0.01, group=grp_fixed)
fixedCancelPrice = input.float(1500, "Fixed Cancel Distance ($)", minval=0.01, group=grp_fixed)

grp_pc = "PineConnector Integration"
licenseID   = input.string("8252815278293", title="License ID", group=grp_pc)
riskVolume  = input.float(0.01, title="Risk / Lot Size (risk=)", minval=0, step=0.01, group=grp_pc, tooltip="On most MT brokers 1.00 lot BTCUSD = 1 BTC. Start small.")
pcSymbol    = input.string("", title="MT Symbol Override", group=grp_pc, tooltip="Leave blank to use the chart ticker. Set this if your broker names it differently (e.g. BTCUSDm, BTCUSD.a).")
pcUnits     = input.string("Price", title="SL/TP Units Sent", options=["Pips", "Points", "Price"], group=grp_pc, tooltip="Must match the Target Type set in your PineConnector EA. Points = ticks (syminfo.mintick). Price = absolute SL/TP prices.")
ticksPerPip = input.int(100, title="Ticks per Pip", minval=1, group=grp_pc, tooltip="Only used in Pips mode. BTCUSD pip size varies by broker; Price mode avoids this.")

grp_logic = "Micro-Structure & Steps"
pivotLeft      = input.int(5, title="Pivot Left Strength", minval=1, group=grp_logic)
pivotRight     = input.int(3, title="Pivot Right Strength", minval=1, group=grp_logic)
maxLevels      = input.int(8, title="Max Liquidity Levels to Track", minval=1, group=grp_logic)
minTouches     = input.int(1, title="Min Touches for a Valid Level", minval=1, group=grp_logic)
useTrendFilter = input.bool(true, "Use HTF Trend Filter", group=grp_logic)
autoHTF        = input.bool(true, "Auto Higher TF (4× chart timeframe)", group=grp_logic)
htfTimeframe   = input.timeframe("240", "Manual Higher TF for Trend", group=grp_logic, tooltip="Used only when Auto is off. Ignored if lower than the chart timeframe.")
htfEmaLength   = input.int(50, "HTF EMA Length", minval=1, group=grp_logic)
adxLength      = input.int(14, "ADX Length", minval=1, group=grp_logic)
adxThreshold   = input.int(20, "ADX Trend Threshold", group=grp_logic)

grp_speed = "Order Flow Mechanics"
confirmMode    = input.string("Absorption OR Velocity", title="Confirmation Mode", options=["Absorption OR Velocity", "Absorption AND Velocity", "Absorption Only", "Velocity Only", "None"], group=grp_speed, tooltip="AND is very strict: a long rejection wick and a large body rarely occur together.")
wickRatioLimit = input.float(0.45, title="Minimum Wick Rejection Ratio", group=grp_speed, step=0.05)
velocityMulti  = input.float(1.3, title="Institutional Speed Multiplier", group=grp_speed, step=0.1)
touchLookback  = input.int(3, title="Level Touch Lookback (Bars)", minval=1, group=grp_speed, tooltip="Confirmation candle may come up to this many bars after the level was touched.")
useVolFilter   = input.bool(false, title="Use Volume Surge Filter", group=grp_speed)
volSurgeMult   = input.float(1.2, title="Volume Surge Multiplier", group=grp_speed)
showDebug      = input.bool(true, title="Show Filter Diagnostics Table", group=grp_speed)

// =========================================================================
// CORE INDICATORS & VOLATILITY MATH
// =========================================================================
atr = ta.atr(atrLength)

// ATR expressed in ticks so every distance below shares one unit
atrInTicks = atr / syminfo.mintick

toleranceTicks  = useATR ? atrInTicks * atrMultTol    : fixedTolPrice    / syminfo.mintick
slTicks         = useATR ? atrInTicks * atrMultSL     : fixedSLPrice     / syminfo.mintick
tpTicks         = useATR ? atrInTicks * atrMultTP     : fixedTPPrice     / syminfo.mintick
cancelDistTicks = useATR ? atrInTicks * atrMultCancel : fixedCancelPrice / syminfo.mintick

tolerancePrice = toleranceTicks * syminfo.mintick

// HTF Trend: previous completed HTF bar + lookahead_on = no repainting, no future leak
// Trend timeframe must be above the chart timeframe so any chart TF works
autoTF  = timeframe.from_seconds(timeframe.in_seconds() * 4)
trendTF = autoHTF or timeframe.in_seconds(htfTimeframe) <= timeframe.in_seconds() ? autoTF : htfTimeframe
htfEMA = request.security(syminfo.tickerid, trendTF, ta.ema(close, htfEmaLength)[1], lookahead=barmerge.lookahead_on)

// ADX (Pine has no ta.adx; it comes from ta.dmi)
[diPlus, diMinus, adxVal] = ta.dmi(adxLength, adxLength)

// Wick & Velocity
candleRange     = high - low
bullishWick     = math.min(open, close) - low
bearishWick     = high - math.max(open, close)
candleRangeSafe = candleRange == 0 ? syminfo.mintick : candleRange
bullWickRatio   = bullishWick / candleRangeSafe
bearWickRatio   = bearishWick / candleRangeSafe

isBullAbsorption = bullWickRatio >= wickRatioLimit
isBearAbsorption = bearWickRatio >= wickRatioLimit

candleBody     = math.abs(close - open)
avgBodySpeed   = ta.sma(candleBody, 10)
isBullVelocity = (close > open) and (candleBody > avgBodySpeed * velocityMulti)
isBearVelocity = (close < open) and (candleBody > avgBodySpeed * velocityMulti)

// Volume Surge
volMA = ta.sma(volume, 20)
// Symbols without volume data (na/0) pass instead of blocking every trade
hasVolume = not na(volMA) and volMA > 0
volOK     = not useVolFilter or not hasVolume or (volume > volMA * volSurgeMult)

// =========================================================================
// MULTI-LEVEL LIQUIDITY (Arrays)
// =========================================================================
type LiqLevel
    float price
    int   touchCount

var array<LiqLevel> suppLiq = array.new<LiqLevel>()
var array<LiqLevel> resLiq  = array.new<LiqLevel>()

// Merge a pivot into an existing level within tolerance, otherwise add it as a new level.
addOrMergeLevel(array<LiqLevel> levels, float pivotPrice, float tol, int maxCount) =>
    bool merged = false
    for lvl in levels
        if math.abs(lvl.price - pivotPrice) <= tol
            lvl.touchCount := lvl.touchCount + 1
            merged := true
            break
    if not merged
        levels.push(LiqLevel.new(pivotPrice, 1))
    if levels.size() > maxCount
        levels.shift()
    merged

// Returns the price of the closest qualifying level within tolerance (na if none).
getTriggeredLevelPrice(array<LiqLevel> levels, float priceToCheck, float tol, int minT) =>
    float best     = na
    float bestDist = na
    for lvl in levels
        dist = math.abs(priceToCheck - lvl.price)
        if lvl.touchCount >= minT and dist <= tol and (na(bestDist) or dist < bestDist)
            best     := lvl.price
            bestDist := dist
    best

pivotLow  = ta.pivotlow(low, pivotLeft, pivotRight)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)

if not na(pivotLow)
    addOrMergeLevel(suppLiq, pivotLow, tolerancePrice, maxLevels)
if not na(pivotHigh)
    addOrMergeLevel(resLiq, pivotHigh, tolerancePrice, maxLevels)

// Plot stepped levels (newest for visibility)
plot(suppLiq.size() > 0 ? suppLiq.last().price : na, color=color.fuchsia, style=plot.style_linebr, linewidth=2, title="Stepped Support")
plot(resLiq.size()  > 0 ? resLiq.last().price  : na, color=color.red,     style=plot.style_linebr, linewidth=2, title="Stepped Resistance")

// =========================================================================
// PINECONNECTOR MESSAGE BUILDERS
// =========================================================================
mtSymbol = str.length(pcSymbol) > 0 ? pcSymbol : syminfo.ticker

fmtDistance(float ticks, float entryPx, bool isLong, bool isStop) =>
    string result = na
    if pcUnits == "Price"
        float dir = (isLong == isStop) ? -1.0 : 1.0
        result := str.tostring(entryPx + dir * ticks * syminfo.mintick, format.mintick)
    else if pcUnits == "Pips"
        result := str.tostring(ticks / ticksPerPip, "#.#")
    else
        result := str.tostring(math.round(ticks))
    result

buildLimitMsg(bool isLong, float entryPx, float slT, float tpT) =>
    licenseID + (isLong ? ",buylimit," : ",selllimit,") + mtSymbol +
         ",risk=" + str.tostring(riskVolume) +
         ",price=" + str.tostring(entryPx, format.mintick) +
         ",sl=" + fmtDistance(slT, entryPx, isLong, true) +
         ",tp=" + fmtDistance(tpT, entryPx, isLong, false)

cancelLongMsg  = licenseID + ",cancellong," + mtSymbol
cancelShortMsg = licenseID + ",cancelshort," + mtSymbol

// Explicit size so fractional BTC is never rounded down to 0 (which silently blocks every order)
calcQty(float px) =>
    float step = syminfo.mincontract > 0 ? syminfo.mincontract : 0.00000001
    float raw  = strategy.equity * equityPct / 100 / px
    math.max(step, math.floor(raw / step) * step)

// =========================================================================
// ORDER STATE
// =========================================================================
var int   barsSinceLongOrder  = na
var int   barsSinceShortOrder = na
var float pendingLongPrice    = na
var float pendingShortPrice   = na
// SL/TP are frozen at order time so the bracket does not drift with ATR
var float lockedLongSL  = na
var float lockedLongTP  = na
var float lockedShortSL = na
var float lockedShortTP = na

// --- 1) Fill detection: clear state and pull the opposite pending order ---
// Counting trades (not position_size) also catches a fill that hit SL/TP on the same bar.
tradeCount = strategy.opentrades + strategy.closedtrades
newFill    = tradeCount > nz(tradeCount[1])
string lastEntryId = na
if newFill
    lastEntryId := strategy.opentrades > 0 ? strategy.opentrades.entry_id(strategy.opentrades - 1) : strategy.closedtrades.entry_id(strategy.closedtrades - 1)

if newFill and lastEntryId == "Long"
    if not na(pendingShortPrice)
        strategy.cancel("Short")
        alert(cancelShortMsg, alert.freq_once_per_bar_close)
    pendingLongPrice    := na
    pendingShortPrice   := na
    barsSinceLongOrder  := na
    barsSinceShortOrder := na

if newFill and lastEntryId == "Short"
    if not na(pendingLongPrice)
        strategy.cancel("Long")
        alert(cancelLongMsg, alert.freq_once_per_bar_close)
    pendingLongPrice    := na
    pendingShortPrice   := na
    barsSinceLongOrder  := na
    barsSinceShortOrder := na

// --- 2) Age pending orders and cancel on time / distance ---
if not na(pendingLongPrice)
    barsSinceLongOrder += 1
    longTimeout = barsSinceLongOrder >= cancelBars
    longRunaway = close > pendingLongPrice + cancelDistTicks * syminfo.mintick
    if longTimeout or longRunaway
        strategy.cancel("Long")
        alert(cancelLongMsg, alert.freq_once_per_bar_close)
        pendingLongPrice   := na
        barsSinceLongOrder := na

if not na(pendingShortPrice)
    barsSinceShortOrder += 1
    shortTimeout = barsSinceShortOrder >= cancelBars
    shortRunaway = close < pendingShortPrice - cancelDistTicks * syminfo.mintick
    if shortTimeout or shortRunaway
        strategy.cancel("Short")
        alert(cancelShortMsg, alert.freq_once_per_bar_close)
        pendingShortPrice   := na
        barsSinceShortOrder := na

// =========================================================================
// ENTRY CONDITIONS (with all filters)
// =========================================================================
canLong  = tradeDirection == "Buy Only"  or tradeDirection == "Both"
canShort = tradeDirection == "Sell Only" or tradeDirection == "Both"

longTrendOK     = not useTrendFilter or close > htfEMA
shortTrendOK    = not useTrendFilter or close < htfEMA
trendStrengthOK = adxVal > adxThreshold

touchedSupportNow    = getTriggeredLevelPrice(suppLiq, low,  tolerancePrice, minTouches)
touchedResistanceNow = getTriggeredLevelPrice(resLiq,  high, tolerancePrice, minTouches)

// Remember the most recent touch so confirmation can follow a few bars later
var float lastSupportTouch    = na
var float lastResistanceTouch = na
var int   supportTouchBar     = na
var int   resistanceTouchBar  = na
if not na(touchedSupportNow)
    lastSupportTouch := touchedSupportNow
    supportTouchBar  := bar_index
if not na(touchedResistanceNow)
    lastResistanceTouch := touchedResistanceNow
    resistanceTouchBar  := bar_index

activeSupportPrice    = not na(supportTouchBar)    and bar_index - supportTouchBar    < touchLookback ? lastSupportTouch    : na
activeResistancePrice = not na(resistanceTouchBar) and bar_index - resistanceTouchBar < touchLookback ? lastResistanceTouch : na

bullAbs = isBullAbsorption or isBullAbsorption[1]
bearAbs = isBearAbsorption or isBearAbsorption[1]
confirm(bool absorb, bool velocity) =>
    switch confirmMode
        "Absorption OR Velocity"  => absorb or velocity
        "Absorption AND Velocity" => absorb and velocity
        "Absorption Only"         => absorb
        "Velocity Only"           => velocity
        => true
bullConfirm = confirm(bullAbs, isBullVelocity) and close > open
bearConfirm = confirm(bearAbs, isBearVelocity) and close < open

// close must be on the correct side of the level, otherwise the "limit" is marketable / rejected by the broker
longCondition  = canLong and strategy.position_size == 0 and na(pendingLongPrice) and
     not na(activeSupportPrice) and close > activeSupportPrice and
     bullConfirm and
     volOK and longTrendOK and trendStrengthOK and not na(slTicks) and not na(tpTicks)

shortCondition = canShort and strategy.position_size == 0 and na(pendingShortPrice) and
     not na(activeResistancePrice) and close < activeResistancePrice and
     bearConfirm and
     volOK and shortTrendOK and trendStrengthOK and not na(slTicks) and not na(tpTicks)

// --- 3) Place new limit orders (alert fires on placement, not on TV fill) ---
if longCondition
    lockedLongSL       := math.max(1, math.round(slTicks))
    lockedLongTP       := math.max(1, math.round(tpTicks))
    pendingLongPrice   := activeSupportPrice
    barsSinceLongOrder := 0
    strategy.entry("Long", strategy.long, qty=calcQty(activeSupportPrice), limit=activeSupportPrice)
    alert(buildLimitMsg(true, activeSupportPrice, lockedLongSL, lockedLongTP), alert.freq_once_per_bar_close)

if shortCondition
    lockedShortSL       := math.max(1, math.round(slTicks))
    lockedShortTP       := math.max(1, math.round(tpTicks))
    pendingShortPrice   := activeResistancePrice
    barsSinceShortOrder := 0
    strategy.entry("Short", strategy.short, qty=calcQty(activeResistancePrice), limit=activeResistancePrice)
    alert(buildLimitMsg(false, activeResistancePrice, lockedShortSL, lockedShortTP), alert.freq_once_per_bar_close)

// =========================================================================
// EXITS (frozen brackets; broker side handled by the sl=/tp= sent above)
// =========================================================================
if not na(lockedLongSL)
    strategy.exit("Exit Long", "Long", loss=lockedLongSL, profit=lockedLongTP)
if not na(lockedShortSL)
    strategy.exit("Exit Short", "Short", loss=lockedShortSL, profit=lockedShortTP)

// Pending order markers
plot(pendingLongPrice,  "Pending Buy Limit",  color=color.new(color.lime, 0),   style=plot.style_circles, linewidth=2)
plot(pendingShortPrice, "Pending Sell Limit", color=color.new(color.orange, 0), style=plot.style_circles, linewidth=2)

// =========================================================================
// FILTER DIAGNOSTICS (counts bars where each stage passed)
// =========================================================================
var int cTouchL = 0
var int cConfL = 0
var int cTrendL = 0
var int cSigL = 0
var int cTouchS = 0
var int cConfS = 0
var int cTrendS = 0
var int cSigS = 0
var int cVol = 0
var int cAdx = 0
var int cFill = 0
if not na(activeSupportPrice)
    cTouchL += 1
    if bullConfirm
        cConfL += 1
        if longTrendOK and trendStrengthOK and volOK
            cTrendL += 1
if not na(activeResistancePrice)
    cTouchS += 1
    if bearConfirm
        cConfS += 1
        if shortTrendOK and trendStrengthOK and volOK
            cTrendS += 1
cVol    += volOK ? 1 : 0
cAdx    += trendStrengthOK ? 1 : 0
cSigL   += longCondition ? 1 : 0
cSigS   += shortCondition ? 1 : 0
cFill   += newFill ? 1 : 0

var table dbg = table.new(position.top_right, 3, 11, bgcolor=color.new(color.black, 20), border_width=1)
if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "Stage",              text_color=color.white)
    table.cell(dbg, 1, 0, "Long",               text_color=color.lime)
    table.cell(dbg, 2, 0, "Short",              text_color=color.orange)
    table.cell(dbg, 0, 1, "Levels tracked",     text_color=color.white)
    table.cell(dbg, 1, 1, str.tostring(suppLiq.size()), text_color=color.white)
    table.cell(dbg, 2, 1, str.tostring(resLiq.size()),  text_color=color.white)
    table.cell(dbg, 0, 2, "Level touched",      text_color=color.white)
    table.cell(dbg, 1, 2, str.tostring(cTouchL), text_color=color.white)
    table.cell(dbg, 2, 2, str.tostring(cTouchS), text_color=color.white)
    table.cell(dbg, 0, 3, "+ Confirmation",     text_color=color.white)
    table.cell(dbg, 1, 3, str.tostring(cConfL), text_color=color.white)
    table.cell(dbg, 2, 3, str.tostring(cConfS), text_color=color.white)
    table.cell(dbg, 0, 4, "+ Trend/ADX/Vol",    text_color=color.white)
    table.cell(dbg, 1, 4, str.tostring(cTrendL), text_color=color.white)
    table.cell(dbg, 2, 4, str.tostring(cTrendS), text_color=color.white)
    table.cell(dbg, 0, 5, "Orders placed",      text_color=color.white)
    table.cell(dbg, 1, 5, str.tostring(cSigL),  text_color=color.white)
    table.cell(dbg, 2, 5, str.tostring(cSigS),  text_color=color.white)
    table.cell(dbg, 0, 6, "Fills (total)",      text_color=color.white)
    table.cell(dbg, 1, 6, str.tostring(cFill),  text_color=color.white)
    table.cell(dbg, 2, 6, "",                   text_color=color.white)
    table.cell(dbg, 0, 7, "ADX OK bars",        text_color=color.white)
    table.cell(dbg, 1, 7, str.tostring(cAdx),   text_color=color.white)
    table.cell(dbg, 2, 7, "",                   text_color=color.white)
    table.cell(dbg, 0, 8, "Volume OK bars",     text_color=color.white)
    table.cell(dbg, 1, 8, str.tostring(cVol),   text_color=color.white)
    table.cell(dbg, 2, 8, "",                   text_color=color.white)
    table.cell(dbg, 0, 9, "Trend TF",           text_color=color.white)
    table.cell(dbg, 1, 9, trendTF,              text_color=color.white)
    table.cell(dbg, 2, 9, "",                   text_color=color.white)
    table.cell(dbg, 0, 10, "Order qty",         text_color=color.white)
    table.cell(dbg, 1, 10, str.tostring(calcQty(close)), text_color=color.white)
    table.cell(dbg, 2, 10, "min " + str.tostring(syminfo.mincontract), text_color=color.white)
