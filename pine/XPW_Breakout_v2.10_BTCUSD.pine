//@version=6
//====================================================================
// XPW_Breakout_v2.10 (BTCUSD)   (Pine v6, single file, self-contained)
//--------------------------------------------------------------------
// v2.10 delta vs v2.01 (XAUUSD). Three asks: include commission,
// more extensive entry, entry by tick (not only by candle).
// Calibration notes, presets and sweep results: CALIBRATION.md.
//
// COSTS
//  C1  Cost model is explicit and INPUT-driven (group "2. Costs"):
//      commission % per side, commission cash per contract per side
//      (CFD: put HALF THE SPREAD here, plus any per-lot commission),
//      slippage per side. rtCost = 2 x (pct + cash + slip). It feeds
//        a) a COST GATE: never arm when rtCost > x% of the NET TP,
//        b) TP WIDENING: TP = target + rtCost, so the NET result at
//           TP equals the target you typed,
//        c) SIZING: risk budget / (SL distance + rtCost),
//        d) BREAKEVEN: BE stop = fill +/- rtCost, not the fill,
//        e) a referee TABLE: commission the tester actually charged
//           (strategy.closedtrades.commission) vs the modelled figure,
//           red when they disagree = header / Properties != inputs.
//      The strategy() header still does the P&L accounting. Keep the
//      two consistent: header commission == inputs, header slippage
//      (ticks) == SlipUSD / syminfo.mintick. The table prints the ticks.
//  C2  Header re-based for BTC (1 contract = 1 BTC on TV crypto and
//      CFD feeds): cash commission per contract, slippage in ticks at
//      mintick 0.01. v2.01's gold header was $0.61 per round trip on
//      BTC, 35-140x below any real venue.
//
// TICK EXECUTION
//  T1  calc_on_every_tick=true. Input "Execution": Tick re-evaluates
//      arming, cancelling, sizing, the cost gate and the trail on every
//      realtime tick; BarClose gates all of that to barstate.isconfirmed
//      (= v2.01 behaviour). Historical bars are computed once per bar
//      in both modes, so the backtest is identical; only live differs.
//  T2  Arm state, trail, breakeven and counters are varip so they
//      survive the per-tick rollback (a var ratchet re-issued with
//      strategy.exit RETREATS on the next tick: order state is not
//      rolled back, var state is).
//  T3  Entry LEVELS still come from CONFIRMED bars (pivot latched on
//      close, Donchian[1], previous day) because an unconfirmed level
//      cannot be backtested honestly. What is tick-driven is the arm /
//      cancel decision and the resting stop or limit order, which the
//      broker emulator fills on the tick (or intrabar) that touches it.
//  T4  calc_on_order_fills stays OFF: on historical bars it would let
//      the fill re-execution see the bar's final high/low/close.
//  T5  ATR used for geometry, buffer and gates is frozen to the last
//      CLOSED bar on interim ticks (atrRef), so tick decisions use the
//      same numbers the backtest used.
//  T6  Trail execution input: "Emulator" hands the trail to the broker
//      emulator (strategy.exit trail_points / trail_offset in ticks). It
//      ratchets on the 4-point path on historical bars and on every tick
//      live, so history and live agree and a trail exit can happen on the
//      same bar it was reached. "Script" is the v2.01 close-anchored
//      ratchet (bar close on history, per tick live in Tick mode).
//
// ENTRY MODULE
//  E1  Level sources (any combination; the nearest enabled level to
//      price is used per side): Pivot (v2.01 ta.pivothigh/low),
//      Donchian(N)[1], Previous-day high/low (non-repainting
//      request.security, lookahead_on + [1]).
//  E2  Trigger modes: Stop (rest a stop at the level; fills on touch),
//      CloseConfirm (market entry after a bar CLOSES beyond the level,
//      with a max-chase cap), Retest (limit at the broken level after
//      a confirmed close beyond it, valid K bars).
//  E3  Filters, each switchable: direction, chart-EMA trend, cooldown
//      bars after an exit, max trades per day, retry cap per level,
//      trade days, session hours (v2.01), compression gate (v2.01),
//      cost gate (C1). Indicator filters (ADX, ATR bands, volume, HTF
//      bias) were deliberately NOT added: on 600-bar samples they only
//      remove trades and cannot be calibrated.
//  E4  Exits: SL/TP locked per trade at arm time and re-anchored to the
//      real fill, ratchet trail (v2.01), optional breakeven step,
//      optional time stop.
//
// DEFECT FIXES (v2.01 -> v2.10), on top of F1-F10 which are retained
//  F11 v2.01 cancelled the resting stop on every bar whose close sat
//      inside the buffer below the level, so a breakout could only fill
//      if ONE bar travelled the whole buffer. Measured on the exports at
//      buffer 1.0 ATR: 60m armed 4 of 37 breaks, 15m 10 of 54. In Tick
//      mode it is fatal: the first tick inside the buffer cancels the
//      stop and it can never fill. v2.10 uses the buffer to ARM only
//      (ArmLatch). Once armed the stop rests until it fills, the level
//      goes away, a gate closes, or the position changes. Re-arming
//      after a trade needs a fresh pull-back of one buffer.
//      ArmLatch=false restores v2.01 for the acceptance test.
//  F12 strategy.risk.max_position_size only constrains strategy.entry();
//      v2.01 placed the straddle with strategy.order(), so the "second
//      enforcement layer" was inert. v2.10 uses strategy.entry() (OCA
//      kept; entries are only ever issued while flat, so its reversal
//      semantics never engage) and the rail is live.
//  F13 ATR geometry is locked per trade. Recomputing SL/TP from the
//      live ATR after the fill (the obvious way) makes the bracket a
//      moving target that disagrees with the level the cost gate
//      approved.
//
// GEOMETRY
//  G1  GeoMode "ATR": SL = k * ATR, TP = R * SL. One script spans
//      15m..240m on BTC. "Pct" keeps v2.01 percent-of-price geometry.
//      The gold SL 0.1% / TP 0.25% on BTC sit inside a single 15m-240m
//      bar: 37-92% of those trades resolve on the fill bar, decided by
//      the emulator's path assumption, not by the market.
//--------------------------------------------------------------------
// NOTES
//  * Properties: this header already sets calc_on_every_tick. Leave
//    "Recalculate: After order is filled" OFF. Bar magnifier ON if
//    your plan has it (stop entry + stop exit inside one bar).
//  * UI Properties override the header cost values once touched. On a
//    chart that carried v2.01 (gold: slippage 30, cash 0.003) do
//    Properties > Defaults > Reset settings, or type the BTC values in.
//    The table's commission row is the tripwire; it cannot check
//    slippage ticks, only commission.
//  * 'hour' / dayofweek use the EXCHANGE timezone of the chart symbol
//    (UTC for CRYPTO:BTCUSD; broker server time for CFD feeds).
//  * Tick mode can only be observed live or in forward test. If the
//    live trade list diverges from the backtest, that is T1-T3 at work,
//    not a bug: the backtest is the BarClose approximation. Realtime
//    trades made intrabar vanish on reload (bars are re-simulated).
//  * Limit fills (Retest mode) are never slipped by the emulator. The
//    cost model still charges SlipUSD on them, so gate / TP / sizing
//    stay conservative; the tester's P&L is optimistic by ~half spread.
//  * CFD feeds on TradingView are BID. A buy stop in MT5 triggers on
//    ASK, so longs pay ~one full spread relative to the chart trigger.
//    Half the spread per side in CommCash is the usual compromise.
//  * Swap / funding is not modelled by the tester. On 60m/240m a trade
//    often spans the daily rollover; one night of crypto CFD swap
//    (~$17-46 per BTC) is comparable to the whole round-trip cost.
//  * v2.01 acceptance recipe (reproduces its trade list): Execution
//    BarClose, ArmLatch off, Pivot only, GeoMode Pct (SL 0.1, TP 0.25),
//    Buffer 1.0 ATR, Trail Script, all cost switches off, Risk 4,
//    FixedQty/Cap as gold.
//====================================================================
strategy("XPW Breakout v2.10 (BTCUSD)", overlay=true,
     initial_capital=100000,
     pyramiding=0,
     calc_on_every_tick=true,
     calc_on_order_fills=false,
     process_orders_on_close=false,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=9.0,     // USD per BTC per side = CFD raw: $3 commission + $6 half of a $12 spread. CFD std: 8.5 (half of $17). Exchange: use percent 0.05
     slippage=500,             // ticks per side. mintick 0.01 -> $5 pure execution slip. Must equal SlipUSD / syminfo.mintick (table prints it)
     margin_long=0, margin_short=0,
     max_bars_back=500)

//============== INPUTS ==============//
grpX = "1. Execution"
ExecMode    = input.string("Tick", "Execution", options=["Tick", "BarClose"], group=grpX, tooltip="Tick: arm/cancel, sizing, cost gate and trail re-evaluated on every realtime tick. BarClose: wait for the bar to close (v2.01). Historical bars are identical in both modes.")
systemType  = input.int(1, "Trading System (1 = enabled)", group=grpX)
Direction   = input.string("Both", "Direction", options=["Both", "Long", "Short"], group=grpX)
ArmLatch    = input.bool(true, "Arm latch (buffer arms only, stop then rests)", group=grpX, tooltip="Off = v2.01: the stop is cancelled on every evaluation where price is inside the buffer. Keep ON for Tick execution.")
MaxDistAtr  = input.float(0.0, "Max level distance, ATR mult (0 = off)", minval=0.0, step=0.5, group=grpX, tooltip="Do not arm a level further than this from price (stale pivot after a fast move).")

grpC = "2. Costs (model, mirrors the header)"
CommPct     = input.float(0.0, "Commission % per side", minval=0.0, step=0.01, group=grpC, tooltip="Exchange taker ~0.05. Must equal the header / Properties commission when its type is percent.")
CommCash    = input.float(9.0, "Commission USD per contract per side", minval=0.0, step=0.5, group=grpC, tooltip="CFD: half the spread plus any per-lot commission. Must equal the header when its type is cash per contract.")
SlipUSD     = input.float(5.0, "Slippage USD per side", minval=0.0, step=0.5, group=grpC, tooltip="Pure execution slip on stop / market fills. Header slippage (ticks) should equal this divided by syminfo.mintick.")
UseCostGate = input.bool(true, "Cost gate (skip when RT cost > x% of net TP)", group=grpC)
MaxCostPct  = input.float(20.0, "   max round-trip cost, % of net TP", minval=1.0, maxval=100.0, step=5.0, group=grpC)
TPNetOfCost = input.bool(true, "Widen TP by round-trip cost (net target = input)", group=grpC)
SizeNetOfCost = input.bool(true, "Reserve round-trip cost in risk sizing", group=grpC)

grpS = "3. Sizing"
RiskPercent = input.float(1.0, "Risk percent of equity per trade", minval=0.0, step=0.25, group=grpS)
UseRiskSize = input.bool(true, "Risk-based sizing (off = FixedQty)", group=grpS)
FixedQty    = input.float(0.1, "FixedQty fallback (contracts = BTC)", minval=0.0, step=0.01, group=grpS)
MaxQtyHard  = input.float(2.0, "HARD qty cap (contracts = BTC)", minval=0.0001, step=0.1, group=grpS, tooltip="Also fed to strategy.risk.max_position_size. The cap binding is a misconfiguration signal, not a feature.")
QtyStep     = input.float(0.01, "Qty step (rounds down)", minval=0.000001, group=grpS)

grpG = "4. Geometry"
GeoMode     = input.string("ATR", "Geometry", options=["ATR", "Pct"], group=grpG, tooltip="ATR: SL = k*ATR, TP = R*SL, locked per trade at arm time. Pct: v2.01 percent-of-price.")
SlAtrMult   = input.float(3.0, "SL, ATR mult (ATR mode)", minval=0.1, step=0.25, group=grpG)
TpR         = input.float(3.0, "TP, R multiple of SL (ATR mode)", minval=0.1, step=0.25, group=grpG)
TPasPct     = input.float(0.25, "TP as percent of entry (Pct mode)", minval=0.01, step=0.05, group=grpG)
SLasPct     = input.float(0.1, "SL as percent of entry (Pct mode)", minval=0.01, step=0.05, group=grpG)
AtrLen      = input.int(14, "ATR length", minval=1, group=grpG)

grpL = "5. Levels"
UsePivot    = input.bool(true, "Pivot levels (v2.01)", group=grpL)
BarsN       = input.int(3, "   pivot bars each side", minval=1, group=grpL)
UseDonchian = input.bool(false, "Donchian levels (prior N bars)", group=grpL)
DonLen      = input.int(20, "   Donchian length", minval=2, group=grpL)
UsePrevDay  = input.bool(false, "Previous-day high/low", group=grpL)
BufMode     = input.string("ATR", "Entry buffer anchor", options=["ATR", "PctOfTP"], group=grpL)
BufAtrMult  = input.float(0.5, "Buffer, ATR mult", minval=0.0, step=0.1, group=grpL, tooltip="Minimum distance price -> level to ARM (MT5 stop-level analogue). 2.0 starves the strategy on BTC.")
BufPctTP    = input.float(50.0, "Buffer, percent of TP (parity mode)", minval=0.0, group=grpL)

grpE = "6. Entry trigger"
EntryMode   = input.string("Stop", "Trigger", options=["Stop", "CloseConfirm", "Retest"], group=grpE, tooltip="Stop: rest a stop order at the level (fills on the tick that touches it). CloseConfirm: market order after a bar closes beyond the level. Retest: limit order at the broken level after a confirmed close beyond it.")
MaxChaseAtr = input.float(0.5, "CloseConfirm: max close beyond level, ATR mult", minval=0.0, step=0.1, group=grpE)
RetestBars  = input.int(5, "Retest: bars the limit stays valid", minval=1, group=grpE)
RetestOffAtr = input.float(0.0, "Retest: limit offset inside the level, ATR mult", minval=0.0, step=0.05, group=grpE)

grpF = "7. Filters"
TrendLen    = input.int(0, "Chart EMA trend filter, length (0 = off)", minval=0, group=grpF, tooltip="Longs only above the EMA, shorts only below.")
Cooldown    = input.int(0, "Cooldown bars after an exit (0 = off)", minval=0, group=grpF)
MaxPerDay   = input.int(0, "Max trades per day (0 = off)", minval=0, group=grpF)
MaxRetries  = input.int(0, "Max losing retries per level (0 = off)", minval=0, group=grpF, tooltip="After N consecutive losses armed at the same level (within RetryTol ATR) that level is blocked until it changes or a trade wins.")
RetryTol    = input.float(0.25, "   same-level tolerance, ATR mult", minval=0.0, step=0.05, group=grpF)
UseCompGate = input.bool(false, "Compression gate (arm only when coiled)", group=grpF)
CompLen     = input.int(200, "   compression lookback", minval=20, group=grpF)
CompPct     = input.float(30.0, "   arm below width percentile", minval=1.0, maxval=100.0, group=grpF)

grpT = "8. Time"
SHInput     = input.int(0, "Start hour (0 = off)", minval=0, maxval=23, group=grpT)
EHInput     = input.int(0, "End hour (0 = off)", minval=0, maxval=23, group=grpT)
DowStr      = input.string("1234567", "Trade days (1=Sun .. 7=Sat)", group=grpT)

grpR = "9. Exits"
UseTrail    = input.bool(true, "Ratchet trail", group=grpR)
TrailExec   = input.string("Emulator", "Trail execution", options=["Emulator", "Script"], group=grpR, tooltip="Emulator: strategy.exit trail_points/trail_offset, ratchets on the intrabar path in backtests and on every tick live. Script: v2.01 close-anchored ratchet (bar close in backtests, per tick live in Tick mode).")
TrailMode   = input.string("ATR", "Trail anchor", options=["ATR", "PctOfTP"], group=grpR)
TrgAtrMult  = input.float(1.0, "Trail trigger, ATR mult", step=0.1, group=grpR)
TrlAtrMult  = input.float(1.5, "Trail distance, ATR mult", step=0.1, group=grpR)
TslTrgPctTP = input.float(7.0, "Trail trigger, percent of TP (parity mode)", group=grpR)
TslPctTP    = input.float(5.0, "Trail distance, percent of TP (parity mode)", group=grpR)
UseBE       = input.bool(false, "Breakeven step (stop to fill +/- RT cost)", group=grpR)
BeTrigR     = input.float(1.0, "   BE trigger, R multiple of SL", minval=0.1, step=0.25, group=grpR)
MaxBarsHeld = input.int(0, "Time stop, bars (0 = off)", minval=0, group=grpR)

grpD = "10. Display"
ShowTable   = input.bool(true, "Cost / state table", group=grpD)
ShowLevels  = input.bool(true, "Plot levels, TP and trail", group=grpD)
ShowEma     = input.bool(false, "Plot trend EMA", group=grpD)
ShowTickMark = input.bool(true, "Mark realtime bars (Tick mode)", group=grpD)

// Rail: emulator-level cap on top of calcQty clamp (live with strategy.entry, F12)
strategy.risk.max_position_size(MaxQtyHard)

//============== EXECUTION GATES ==============//
tickMode   = ExecMode == "Tick"
barClosed  = barstate.isconfirmed          // true on every historical bar, and on the last tick of a realtime bar
evalNow    = tickMode or barClosed         // when strategy.* calls are allowed
allowTrade = systemType == 1
allowL     = Direction != "Short"
allowS     = Direction != "Long"

//============== CORE SERIES (every bar, unconditionally) ==============//
atr    = ta.atr(AtrLen)
atrRef = barClosed ? atr : atr[1]          // T5: interim ticks use the last closed bar's ATR
atrPct = close > 0 ? atrRef / close * 100.0 : na

// Pivot levels: latched on bar close only, also in Tick mode (T3)
ph = ta.pivothigh(high, BarsN, BarsN)
pl = ta.pivotlow(low,  BarsN, BarsN)
var float swingH = na
var float swingL = na
if barClosed and not na(ph)
    swingH := ph
if barClosed and not na(pl)
    swingL := pl

// Donchian of the PRIOR N bars (excludes the forming bar: stable intrabar)
donH = ta.highest(high, DonLen)[1]
donL = ta.lowest(low,  DonLen)[1]

// Previous-day high / low, documented non-repainting form (lookahead_on + [1])
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

// Nearest enabled level above / below price
pickUp(float v, float cur) => not na(v) and v > close and (na(cur) or v < cur) ? v : cur
pickDn(float v, float cur) => not na(v) and v < close and (na(cur) or v > cur) ? v : cur
float lvlUp = na
float lvlDn = na
if UsePivot
    lvlUp := pickUp(swingH, lvlUp)
    lvlDn := pickDn(swingL, lvlDn)
if UseDonchian
    lvlUp := pickUp(donH, lvlUp)
    lvlDn := pickDn(donL, lvlDn)
if UsePrevDay
    lvlUp := pickUp(pdH, lvlUp)
    lvlDn := pickDn(pdL, lvlDn)

// Trend filter (chart EMA; length must be simple, so the input is used as is and gated by TrendLen > 0)
emaT   = ta.ema(close, math.max(TrendLen, 1))
trendL = TrendLen == 0 or close > emaT
trendS = TrendLen == 0 or close < emaT

// Session filter with overnight wrap (v2.01 F8) + trade days
h = hour
inSession = true
if SHInput != 0 and EHInput != 0 and SHInput > EHInput
    inSession := h >= SHInput or h < EHInput
else
    if SHInput != 0 and h < SHInput
        inSession := false
    if EHInput != 0 and h >= EHInput
        inSession := false
dowOK = str.contains(DowStr, str.tostring(dayofweek))

// Cooldown after the last exit, max trades per day
lastExitIdx = strategy.closedtrades > 0 ? strategy.closedtrades.exit_bar_index(math.max(strategy.closedtrades - 1, 0)) : na
coolOK = Cooldown == 0 or na(lastExitIdx) or bar_index - lastExitIdx >= Cooldown
varip int   dayKey  = -1
varip int   dayBase = 0
dayNow = time("D")
if dayNow != dayKey
    dayKey  := dayNow
    dayBase := strategy.closedtrades + strategy.opentrades
tradesToday = strategy.closedtrades + strategy.opentrades - dayBase
dayOK = MaxPerDay == 0 or tradesToday < MaxPerDay

// Compression gate: channel width relative to ATR, percentile ranked (v2.01)
chWidth   = lvlUp - lvlDn
compRatio = atrRef > 0 ? chWidth / atrRef : na
compPR    = ta.percentrank(compRatio, CompLen)
gateOK    = not UseCompGate or (not na(compPR) and compPR <= CompPct)

//============== GEOMETRY + COST MODEL (price units, no mintick) ==============//
slDistAt(float px) => GeoMode == "ATR" ? atrRef * SlAtrMult : px * SLasPct / 100.0
tpDistAt(float px) => GeoMode == "ATR" ? atrRef * SlAtrMult * TpR : px * TPasPct / 100.0
rtCostAt(float px) => 2.0 * (px * CommPct / 100.0 + CommCash + SlipUSD)       // round trip, per contract, USD
tpEffAt(float px)  => tpDistAt(px) + (TPNetOfCost ? rtCostAt(px) : 0.0)      // gross TP that nets the target
// Trail trigger / distance in price units for a given TP distance (v2.01 semantics)
trailTrg(float tpDist) => TrailMode == "ATR" ? atrRef * TrgAtrMult : tpDist * TslTrgPctTP / 100.0
trailDst(float tpDist) => TrailMode == "ATR" ? atrRef * TrlAtrMult : tpDist * TslPctTP / 100.0
// Emulator trail legs in ticks. Only when the emulator runs the trail.
emuTrail = UseTrail and TrailExec == "Emulator"
toTicks(float dist) => math.max(1, math.round(dist / syminfo.mintick))
snap(float px) => math.round_to_mintick(px)

tpRefDist = tpDistAt(close)
buffer    = BufMode == "ATR" ? atrRef * BufAtrMult : tpRefDist * BufPctTP / 100.0
rtCostNow = rtCostAt(close)
costOK    = not UseCostGate or (tpRefDist > 0 and rtCostNow <= tpRefDist * MaxCostPct / 100.0)

//============== SIZING (risk-based, cost-aware, hard-capped, fallback) ==============//
calcQty(float px) =>
    slD     = slDistAt(px)
    perUnit = slD + (SizeNetOfCost ? rtCostAt(px) : 0.0)
    raw     = UseRiskSize and perUnit > 0 ? (strategy.equity * RiskPercent / 100.0) / perUnit : FixedQty
    q       = na(raw) or raw <= 0 ? FixedQty : raw
    q      := math.min(q, MaxQtyHard)
    q      := math.floor(q / QtyStep) * QtyStep
    q

//============== RETRY CAP PER LEVEL + COMMISSION REFEREE (per closed trade) ==============//
// All varip: this block runs on the tick where a trade closes and must not run again on the next tick.
varip float commPaid  = 0.0      // charged by the tester (header / Properties commission)
varip float commModel = 0.0      // what the inputs say it should have been
varip int   commSeen  = 0
varip float lvlUsedL  = na       // level the current / last long was armed at
varip float lvlUsedS  = na
varip float blockLvlL = na       // level under retry block
varip float blockLvlS = na
varip int   blockCntL = 0
varip int   blockCntS = 0
if strategy.closedtrades > commSeen
    for i = commSeen to strategy.closedtrades - 1
        sz = strategy.closedtrades.size(i)
        commPaid  += strategy.closedtrades.commission(i)
        commModel += math.abs(sz) * ((strategy.closedtrades.entry_price(i) + strategy.closedtrades.exit_price(i)) * CommPct / 100.0 + 2.0 * CommCash)
        lost = strategy.closedtrades.profit(i) < 0
        if sz > 0
            if not lost
                blockCntL := 0
            else if not na(blockLvlL) and not na(lvlUsedL) and math.abs(lvlUsedL - blockLvlL) <= RetryTol * atrRef
                blockCntL += 1
            else
                blockLvlL := lvlUsedL
                blockCntL := 1
        else
            if not lost
                blockCntS := 0
            else if not na(blockLvlS) and not na(lvlUsedS) and math.abs(lvlUsedS - blockLvlS) <= RetryTol * atrRef
                blockCntS += 1
            else
                blockLvlS := lvlUsedS
                blockCntS := 1
    commSeen := strategy.closedtrades
retryOKL = MaxRetries == 0 or na(blockLvlL) or na(lvlUp) or blockCntL < MaxRetries or math.abs(lvlUp - blockLvlL) > RetryTol * atrRef
retryOKS = MaxRetries == 0 or na(blockLvlS) or na(lvlDn) or blockCntS < MaxRetries or math.abs(lvlDn - blockLvlS) > RetryTol * atrRef

//============== ENTRY MODULE ==============//
flat      = strategy.position_size == 0
baseOK    = allowTrade and flat and inSession and dowOK and gateOK and coolOK and dayOK and costOK
longFilt  = baseOK and allowL and trendL and retryOKL
shortFilt = baseOK and allowS and trendS and retryOKS

// Confirmed close beyond the level that was nearest at the previous close (CloseConfirm / Retest)
brkPxL = lvlUp[1]
brkPxS = lvlDn[1]
brkL   = barClosed and not na(brkPxL) and close > brkPxL
brkS   = barClosed and not na(brkPxS) and close < brkPxS

// Arm-time geometry, locked for the bracket and re-anchored to the real fill (varip: survives tick rollback)
varip float armSlL = na
varip float armTpL = na
varip float armSlS = na
varip float armTpS = na
varip bool  armedL = false
varip bool  armedS = false
varip float rtPxL   = na
varip float rtPxS   = na
varip int   rtUntilL = -1
varip int   rtUntilS = -1

// Bracket issue, shared by pre-staging and position management.
// stopPx / tpPx absolute; trgD / dstD trail trigger and distance in price units (emulator trail only)
exitLong(float stopPx, float tpPx, float trgD, float dstD, string lossTxt) =>
    if emuTrail
        strategy.exit("XL", from_entry="BuyStop", stop=snap(stopPx), limit=snap(tpPx), trail_points=toTicks(trgD), trail_offset=toTicks(dstD), comment_loss=lossTxt, comment_profit="TP", comment_trailing="Trail")
    else
        strategy.exit("XL", from_entry="BuyStop", stop=snap(stopPx), limit=snap(tpPx), comment_loss=lossTxt, comment_profit="TP")

exitShort(float stopPx, float tpPx, float trgD, float dstD, string lossTxt) =>
    if emuTrail
        strategy.exit("XS", from_entry="SellStop", stop=snap(stopPx), limit=snap(tpPx), trail_points=toTicks(trgD), trail_offset=toTicks(dstD), comment_loss=lossTxt, comment_profit="TP", comment_trailing="Trail")
    else
        strategy.exit("XS", from_entry="SellStop", stop=snap(stopPx), limit=snap(tpPx), comment_loss=lossTxt, comment_profit="TP")

// kind: 1 = stop at px, 2 = limit at px, 0 = market (px = reference for the bracket).
// Entry IDs stay BuyStop / SellStop for every kind (alert templates, v2.01 parity); the comment names the kind.
// strategy.entry (not strategy.order) so strategy.risk.max_position_size is live (F12).
placeLong(float px, float q, float slD, float tpD, int kind) =>
    if kind == 1
        strategy.entry("BuyStop", strategy.long, qty=q, stop=snap(px), oca_name="XPW", oca_type=strategy.oca.cancel, comment="L stop")
    else if kind == 2
        strategy.entry("BuyStop", strategy.long, qty=q, limit=snap(px), oca_name="XPW", oca_type=strategy.oca.cancel, comment="L retest")
    else
        strategy.entry("BuyStop", strategy.long, qty=q, oca_name="XPW", oca_type=strategy.oca.cancel, comment="L close-confirm")
    // Pre-staged bracket: the position is protected from the fill (F1)
    exitLong(px - slD, px + tpD, trailTrg(tpDistAt(px)), trailDst(tpDistAt(px)), "SL")

placeShort(float px, float q, float slD, float tpD, int kind) =>
    if kind == 1
        strategy.entry("SellStop", strategy.short, qty=q, stop=snap(px), oca_name="XPW", oca_type=strategy.oca.cancel, comment="S stop")
    else if kind == 2
        strategy.entry("SellStop", strategy.short, qty=q, limit=snap(px), oca_name="XPW", oca_type=strategy.oca.cancel, comment="S retest")
    else
        strategy.entry("SellStop", strategy.short, qty=q, oca_name="XPW", oca_type=strategy.oca.cancel, comment="S close-confirm")
    exitShort(px + slD, px - tpD, trailTrg(tpDistAt(px)), trailDst(tpDistAt(px)), "SL")

if EntryMode == "Stop"
    // OCA stop straddle on the nearest confirmed levels (F5); the buffer arms only (F11)
    if evalNow
        canL = longFilt and not na(lvlUp) and (MaxDistAtr == 0 or lvlUp - close <= MaxDistAtr * atrRef)
        if not canL
            armedL := false
        else if not armedL or not ArmLatch
            armedL := close < lvlUp - buffer
        if armedL
            qL = calcQty(lvlUp)
            if qL > 0
                armSlL   := slDistAt(lvlUp)
                armTpL   := tpEffAt(lvlUp)
                lvlUsedL := lvlUp
                placeLong(lvlUp, qL, armSlL, armTpL, 1)
            else
                armedL := false
        if not armedL
            strategy.cancel("BuyStop")

        canS = shortFilt and not na(lvlDn) and (MaxDistAtr == 0 or close - lvlDn <= MaxDistAtr * atrRef)
        if not canS
            armedS := false
        else if not armedS or not ArmLatch
            armedS := close > lvlDn + buffer
        if armedS
            qS = calcQty(lvlDn)
            if qS > 0
                armSlS   := slDistAt(lvlDn)
                armTpS   := tpEffAt(lvlDn)
                lvlUsedS := lvlDn
                placeShort(lvlDn, qS, armSlS, armTpS, 1)
            else
                armedS := false
        if not armedS
            strategy.cancel("SellStop")
else
    armedL := false
    armedS := false

if EntryMode == "CloseConfirm"
    // Market entry on a confirmed close beyond the level, unless the close already ran too far (chase cap)
    if brkL and longFilt and close - brkPxL <= MaxChaseAtr * atrRef
        qC = calcQty(close)
        if qC > 0
            armSlL   := slDistAt(close)
            armTpL   := tpEffAt(close)
            lvlUsedL := brkPxL
            placeLong(close, qC, armSlL, armTpL, 0)
    if brkS and shortFilt and brkPxS - close <= MaxChaseAtr * atrRef
        qC = calcQty(close)
        if qC > 0
            armSlS   := slDistAt(close)
            armTpS   := tpEffAt(close)
            lvlUsedS := brkPxS
            placeShort(close, qC, armSlS, armTpS, 0)

if EntryMode == "Retest"
    // A confirmed close beyond the level arms a limit at (inside) the level for RetestBars bars
    if brkL and longFilt
        rtPxL    := brkPxL - RetestOffAtr * atrRef
        rtUntilL := bar_index + RetestBars
    if brkS and shortFilt
        rtPxS    := brkPxS + RetestOffAtr * atrRef
        rtUntilS := bar_index + RetestBars
    // Invalidate: expired, filled (not flat), trading off, or price fell back through the level by a buffer
    if not na(rtPxL) and (bar_index > rtUntilL or not flat or not allowTrade or close < rtPxL - buffer)
        rtPxL := na
    if not na(rtPxS) and (bar_index > rtUntilS or not flat or not allowTrade or close > rtPxS + buffer)
        rtPxS := na
    if evalNow
        qRL = calcQty(na(rtPxL) ? close : rtPxL)
        if not na(rtPxL) and longFilt and qRL > 0
            armSlL   := slDistAt(rtPxL)
            armTpL   := tpEffAt(rtPxL)
            lvlUsedL := rtPxL
            placeLong(rtPxL, qRL, armSlL, armTpL, 2)
        else
            strategy.cancel("BuyStop")
        qRS = calcQty(na(rtPxS) ? close : rtPxS)
        if not na(rtPxS) and shortFilt and qRS > 0
            armSlS   := slDistAt(rtPxS)
            armTpS   := tpEffAt(rtPxS)
            lvlUsedS := rtPxS
            placeShort(rtPxS, qRS, armSlS, armTpS, 2)
        else
            strategy.cancel("SellStop")
else
    rtPxL := na
    rtPxS := na

//============== POSITION MGMT: locked SL/TP, ratchet trail, BE, time stop ==============//
varip float trailL = na
varip float tpLockL = na
varip float slDistL = na
varip float trailS = na
varip float tpLockS = na
varip float slDistS = na

if strategy.position_size > 0
    avgL = strategy.position_avg_price
    if na(trailL)
        // first execution in position: re-anchor the arm-time bracket to the real (slipped) fill (F13)
        slDistL := na(armSlL) ? slDistAt(avgL) : armSlL
        tpLockL := avgL + (na(armTpL) ? tpEffAt(avgL) : armTpL)
        trailL  := avgL - slDistL
    if evalNow
        tpDistL = tpLockL - avgL
        trgL    = trailTrg(tpDistL)
        dstL    = trailDst(tpDistL)
        if UseTrail and TrailExec == "Script" and close - avgL > trgL
            trailL := math.max(trailL, close - dstL)                          // ratchet, never retreats (F4)
        beL = avgL + rtCostAt(avgL)
        if UseBE and close - avgL >= BeTrigR * slDistL and beL < close
            trailL := math.max(trailL, beL)                                   // breakeven NET of costs, never above price
        exitLong(trailL, tpLockL, trgL, dstL, "SL/Trail")
        if MaxBarsHeld > 0 and barClosed and bar_index - strategy.opentrades.entry_bar_index(0) >= MaxBarsHeld
            strategy.close("BuyStop", comment="Time")
else
    trailL  := na
    tpLockL := na
    slDistL := na

if strategy.position_size < 0
    avgS = strategy.position_avg_price
    if na(trailS)
        slDistS := na(armSlS) ? slDistAt(avgS) : armSlS
        tpLockS := avgS - (na(armTpS) ? tpEffAt(avgS) : armTpS)
        trailS  := avgS + slDistS
    if evalNow
        tpDistS = avgS - tpLockS
        trgS    = trailTrg(tpDistS)
        dstS    = trailDst(tpDistS)
        if UseTrail and TrailExec == "Script" and avgS - close > trgS
            trailS := math.min(trailS, close + dstS)
        beS = avgS - rtCostAt(avgS)
        if UseBE and avgS - close >= BeTrigR * slDistS and beS > close
            trailS := math.min(trailS, beS)
        exitShort(trailS, tpLockS, trgS, dstS, "SL/Trail")
        if MaxBarsHeld > 0 and barClosed and bar_index - strategy.opentrades.entry_bar_index(0) >= MaxBarsHeld
            strategy.close("SellStop", comment="Time")
else
    trailS  := na
    tpLockS := na
    slDistS := na

//============== PLOTS / DIAGNOSTICS ==============//
varip int rtBars = 0
if barstate.isrealtime and barstate.isnew
    rtBars += 1
firstRT = barstate.isrealtime and not barstate.isrealtime[1]

plot(ShowLevels ? lvlUp : na, "Level Up",   color=color.new(color.teal, 0),   style=plot.style_linebr)
plot(ShowLevels ? lvlDn : na, "Level Down", color=color.new(color.maroon, 0), style=plot.style_linebr)
plot(ShowLevels and strategy.position_size > 0 ? trailL : ShowLevels and strategy.position_size < 0 ? trailS : na, "Stop", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(ShowLevels and strategy.position_size > 0 ? tpLockL : ShowLevels and strategy.position_size < 0 ? tpLockS : na, "TP", color=color.new(color.green, 40), style=plot.style_linebr)
plot(ShowEma and TrendLen > 0 ? emaT : na, "Trend EMA", color=color.new(color.blue, 30))
bgcolor(not inSession or not dowOK ? color.new(color.gray, 92) : na, title="Out of session")
bgcolor(UseCompGate and not gateOK ? color.new(color.red, 94) : na, title="Compression gate closed")
bgcolor(UseCostGate and not costOK ? color.new(color.yellow, 94) : na, title="Cost gate closed")
bgcolor(ShowTickMark and tickMode and barstate.isrealtime ? color.new(color.blue, 95) : na, title="Realtime bars (Tick mode live from here)")

var label rtLbl = na
if ShowTickMark and tickMode and firstRT and na(rtLbl)
    rtLbl := label.new(bar_index, high, "TICK MODE from here\nbars to the left: bar-close simulation", style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=size.small)

var table tbl = table.new(position.top_right, 2, 18, bgcolor=color.new(color.black, 85), border_width=1, border_color=color.new(color.gray, 70))
row(int r, string k, string v, color c) =>
    table.cell(tbl, 0, r, k, text_color=color.new(color.silver, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if ShowTable and barstate.islast
    lvSrc     = (UsePivot ? "Pivot " : "") + (UseDonchian ? "Don " : "") + (UsePrevDay ? "PrevDay" : "")
    tpNow     = tpEffAt(close)
    slNow     = slDistAt(close)
    costPctTP = tpRefDist > 0 ? rtCostNow / tpRefDist * 100.0 : na
    hdrTicks  = syminfo.mintick > 0 ? SlipUSD / syminfo.mintick : na
    wr        = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : na
    cR        = slNow > 0 ? rtCostNow / slNow : na                      // cost in R
    rMult     = slNow > 0 ? tpRefDist / slNow : na
    beWin     = na(cR) or na(rMult) ? na : (1.0 + cR) / (rMult + 1.0) * 100.0   // breakeven win rate with costs
    commMis   = commModel > 0 ? math.abs(commPaid - commModel) / commModel : (commPaid > 0 ? 1.0 : 0.0)
    commOK    = strategy.closedtrades == 0 or commMis <= 0.10
    per100    = bar_index > 0 ? strategy.closedtrades * 100.0 / bar_index : na
    blocked   = (trendL or trendS ? "" : "trend ") + (coolOK ? "" : "cooldown ") + (dayOK ? "" : "maxday ") + (gateOK ? "" : "coil ") + (costOK ? "" : "cost ") + (retryOKL and retryOKS ? "" : "retry ") + (inSession and dowOK ? "" : "time ")
    row(0,  "XPW v2.10", ExecMode + " / " + EntryMode + (ArmLatch ? " / latch" : " / v2.01 arm") + " / trail " + (UseTrail ? TrailExec : "off"), color.white)
    row(1,  "Levels", lvSrc == "" ? "NONE" : lvSrc, lvSrc == "" ? color.red : color.white)
    row(2,  "ATR " + str.tostring(AtrLen), str.tostring(atrRef, "#.##") + "  (" + str.tostring(atrPct, "#.###") + "%)", color.white)
    row(3,  "SL dist", str.tostring(slNow, "#.##") + "  (" + str.tostring(slNow / close * 100.0, "#.###") + "%)", color.white)
    row(4,  "TP dist gross / net", str.tostring(tpNow, "#.##") + " / " + str.tostring(tpRefDist, "#.##"), color.white)
    row(5,  "RT cost / contract", str.tostring(rtCostNow, "#.##") + "  (" + str.tostring(costPctTP, "#.#") + "% of net TP)", costOK ? color.white : color.orange)
    row(6,  "Cost gate", UseCostGate ? (costOK ? "open" : "CLOSED") : "off", costOK ? color.lime : color.orange)
    row(7,  "Breakeven win rate", na(beWin) ? "-" : str.tostring(beWin, "#.#") + "%  (R " + str.tostring(rMult, "#.##") + ", cost " + str.tostring(cR, "#.##") + " R)", color.white)
    row(8,  "Header slippage should be", na(hdrTicks) ? "?" : str.tostring(math.round(hdrTicks)) + " ticks", color.white)
    row(9,  "Commission charged / modelled", str.tostring(commPaid, "#.##") + " / " + str.tostring(commModel, "#.##") + (commOK ? "" : "  HEADER != INPUTS"), commOK ? color.white : color.red)
    row(10, "Qty next (L / S)", str.tostring(calcQty(na(lvlUp) ? close : lvlUp), "#.####") + " / " + str.tostring(calcQty(na(lvlDn) ? close : lvlDn), "#.####"), color.white)
    row(11, "Filters", blocked == "" ? "all pass" : "blocked: " + blocked, blocked == "" ? color.lime : color.orange)
    row(12, "Armed (L / S)", (armedL ? "yes" : "no") + " / " + (armedS ? "yes" : "no"), color.white)
    row(13, "Position", strategy.position_size > 0 ? "LONG " + str.tostring(strategy.position_size, "#.####") : strategy.position_size < 0 ? "SHORT " + str.tostring(-strategy.position_size, "#.####") : "flat", strategy.position_size != 0 ? color.yellow : color.white)
    row(14, "Net profit", str.tostring(strategy.netprofit, "#.##"), strategy.netprofit >= 0 ? color.lime : color.red)
    row(15, "Trades / win % / per 100 bars", str.tostring(strategy.closedtrades) + " / " + (na(wr) ? "-" : str.tostring(wr, "#.#")) + " / " + (na(per100) ? "-" : str.tostring(per100, "#.#")), color.white)
    row(16, "Symbol", syminfo.type + "  mintick " + str.tostring(syminfo.mintick) + "  1 contract = 1 " + syminfo.basecurrency + "  realtime bars " + str.tostring(rtBars), color.white)
    row(17, "Trading", allowTrade ? "enabled" : "DISABLED (systemType)", allowTrade ? color.lime : color.red)

var label warnLbl = na
if systemType != 1 and na(warnLbl) and barstate.islast
    warnLbl := label.new(bar_index, high, "systemType != 1 - TRADING DISABLED", style=label.style_label_down, color=color.red, textcolor=color.white)
