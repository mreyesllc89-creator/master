//@version=6
// ============================================================================
// TokioXAU_SinLimites_V3 — TradingView port (built step by step)
// Source: mql5/TokioXAU_SinLimites_V3.mq5 + mql5/Core/*.mqh
// Defaults = mql5/TokioXAU_SinLimites_V3.set
//
// BITE 1: market sensor, trend confidence, regime, grid step, martingale
//         multiplier and lot ladder — same formulas as the EA.
// BITE 2: virtual ledger. Buys and sells live side by side (like the EA on a
//         hedging account): basket seeding, grid adds, refill, trend adds
//         and the basket take-profit (TPManager.mqh).
// BITE 3: ratchet, trailing (TrailingEngine.mqh) and breakeven pad, plus a
//         tick engine:
//         - "Cada tick": on realtime bars the engine runs on every price
//           update, like the EA's OnTick (state kept with varip).
//         - History has no ticks: each bar is replayed as a price path
//           (lower-timeframe sub-bars if set: open, extremes, close), and
//           long jumps are split into synthetic ticks so no grid level is
//           skipped.
//         - "Al cierre de la vela": the same replay, once per closed bar.
//         Realtime tick results are lost on a chart reload (the history is
//         then replayed instead), so they can differ slightly afterwards.
// BITE 4: gates on server time (no-new window, blocked hours/days, weekend
//         session and flatten), side mode, daily loss and M1 confirmation.
//
// Inputs marked (bite N) are already loaded from the preset but only become
// active in that bite. MT5-only inputs (magic, slippage, Telegram, DB, CSV)
// have no TradingView equivalent and are left out.
// ============================================================================
indicator("TokioXAU SinLimites V3", overlay = true, max_labels_count = 500, max_lines_count = 100)

// ---------------------------------------------------------------- 2. Lotaje / Martingala
grpLot      = "2. Lotaje / Martingala"
baseLot     = input.float(0.01,   "Lote base (nivel 1)",        minval = 0.01, step = 0.01, group = grpLot)
maxLotOrder = input.float(0.3,    "Tope de lote por orden",     minval = 0.01, step = 0.01, group = grpLot)
maxLevels   = input.int(999,      "Niveles maximos por lado",   minval = 1,                 group = grpLot)
maxTotLots  = input.float(1000.0, "Exposicion maxima total (lotes)", group = grpLot)
martLow     = input.float(1.35,   "Mult. martingala ATR bajo",    step = 0.01, group = grpLot)
martMed     = input.float(1.25,   "Mult. martingala ATR medio",   step = 0.01, group = grpLot)
martHigh    = input.float(1.15,   "Mult. martingala ATR alto",    step = 0.01, group = grpLot)
martXHigh   = input.float(1.0,    "Mult. martingala ATR extremo", step = 0.01, group = grpLot)
martMaxLvls = input.int(8,        "Niveles con martingala; despues lote plano (0=siempre)", minval = 0, group = grpLot)

// ---------------------------------------------------------------- 3. Grid
grpGrid     = "3. Grid / persecucion del precio"
useATRStep  = input.bool(true,  "Paso por ATR",                    group = grpGrid)
atrMult     = input.float(0.3,  "Paso = ATR * mult",   step = 0.05, group = grpGrid)
fixedStep   = input.float(1.5,  "Paso fijo (precio, si ATR off)", step = 0.1, group = grpGrid)
minStep     = input.float(0.2,  "Paso minimo (precio)", step = 0.1, group = grpGrid)
stepGrowth  = input.float(0.1,  "Crecimiento del paso por nivel (0.10 = +10%)", step = 0.01, group = grpGrid)
chaseTrend  = input.bool(true,  "Seguir promediando aunque el regimen sea tendencia", group = grpGrid)
advStepMult = input.float(1.0,  "Paso extra con tendencia fuerte en contra (1 = igual)", step = 0.1, group = grpGrid)
addConfM1   = input.bool(false, "Promediar solo tras micro-rebote M1", group = grpGrid)
maxSprdAdd  = input.float(0.0,  "Spread max para promediar (0=sin limite)", step = 0.05, group = grpGrid)

// ---------------------------------------------------------------- 4. Indicadores
grpInd      = "4. Indicadores / filtros de entrada"
atrPeriod   = input.int(7,       "ATR",                  minval = 1, group = grpInd)
atrAvgLB    = input.int(50,      "Ventana ATR promedio", minval = 1, group = grpInd)
ratchetArm  = input.float(0.7,   "Trinquete: se arma al % del TP", step = 0.05, group = grpInd)
ratchetLock = input.float(0.5,   "Trinquete: % del pico protegido, 0=off", step = 0.05, group = grpInd)
maxAtrRatio = input.float(1.157, "No sembrar si ATR/ATRavg > esto (0=off)", step = 0.01, group = grpInd)
noNewFrom   = input.int(-1,      "No sembrar desde hora (-1=off)", minval = -1, maxval = 23, group = grpInd)
noNewTo     = input.int(-1,      "...hasta hora, inclusive",       minval = -1, maxval = 23, group = grpInd)
emaFastLen  = input.int(20,      "EMA rapida",    group = grpInd)
emaMedLen   = input.int(50,      "EMA media",     group = grpInd)
emaSlowLen  = input.int(100,     "EMA lenta",     group = grpInd)
emaTrendLen = input.int(200,     "EMA tendencia", group = grpInd)
adxPeriod   = input.int(14,      "ADX",           group = grpInd)
rsiPeriod   = input.int(14,      "RSI",           group = grpInd)
cciPeriod   = input.int(14,      "CCI",           group = grpInd)
momPeriod   = input.int(14,      "Momentum",      group = grpInd)
swingLB     = input.int(50,      "Ventana swings",     group = grpInd)
slopeLB     = input.int(5,       "Barras pendiente",   minval = 1, group = grpInd)
velLB       = input.int(5,       "Barras velocidad",   minval = 1, group = grpInd)
mt5Calc     = input.bool(true,   "Calculo estilo MT5 (ATR=SMA, ADX=EMA)", group = grpInd,
     tooltip = "MT5 calcula el ATR con media simple y el ADX con EMA. TradingView usa RMA (Wilder). Activado = mismos valores que el EA.")
// MACD / Bollinger / volume only feed display scores in the EA (never a trade decision): not ported.

// ---------------------------------------------------------------- 5. Salidas
grpExit     = "5. Salidas (moneda de la cuenta)"
baseTP      = input.float(5.0,  "TP base de la cesta",              step = 0.5,  group = grpExit)
tpAtrMult   = input.float(0.5,  "Componente ATR del TP",            step = 0.05, group = grpExit)
tpMin       = input.float(2.0,  "Piso del TP",                      step = 0.5,  group = grpExit)
trailAct    = input.float(4.0,  "Activar trailing a este profit", step = 0.5, group = grpExit)
trailStep   = input.float(1.5,  "Retroceso del trailing",  step = 0.1,  group = grpExit)
bePad       = input.float(0.2,  "Colchon breakeven",       step = 0.1,  group = grpExit)

// ---------------------------------------------------------------- 5b. Desarme de cestas profundas (bite 5)
grpDeep     = "5b. Desarme de cestas profundas (bite 5)"
scalpFrom   = input.int(0,      "TP individual desde este nivel por lado (0=off)", group = grpDeep)
scalpFrac   = input.float(0.8,  "TP individual = fraccion del paso", step = 0.05, group = grpDeep)
payDown     = input.bool(false, "Lo cobrado paga la peor posicion", group = grpDeep)
payDownBuf  = input.float(0.5,  "Colchon que debe quedar al pagar", group = grpDeep)
deepLevels  = input.int(0,      "Cesta profunda desde N posiciones (0=off)", group = grpDeep)
deepTP      = input.float(1.0,  "Objetivo de la cesta profunda", group = grpDeep)
survivalDD  = input.float(0.0,  "Supervivencia: % balance (0=off)", group = grpDeep)
survivalMul = input.float(2.0,  "Supervivencia: multiplicador del paso", group = grpDeep)
winBoost    = input.float(0.0,  "Anti-martingala: +x lote por cesta limpia (0=off)", group = grpDeep)
winBoostMax = input.float(1.5,  "Anti-martingala: tope", group = grpDeep)
cleanWinLvl = input.int(6,      "Anti-martingala: cesta limpia <= N posiciones", group = grpDeep)
lockPct     = input.float(0.0,  "Candado: % balance (0=off)", group = grpDeep)
lockMinLvl  = input.int(10,     "Candado: minimo de posiciones", group = grpDeep)
unlockATR   = input.float(3.0,  "Candado: quitar al rebotar N x ATR", group = grpDeep)
relockPct   = input.float(5.0,  "Candado: recubrir cada % balance", group = grpDeep)

// ---------------------------------------------------------------- 5c / 6 / 6c. Riesgo y stops
grpRisk     = "6. Riesgo y stops"
maxSpread   = input.float(0.6,  "Spread max para SEMBRAR (precio)", step = 0.05, group = grpRisk)
assumedSprd = input.float(0.3,  "Spread asumido (TradingView no tiene spread historico)", step = 0.05, group = grpRisk)
blockAddAdx = input.float(0.0,  "ADX que bloquea adds contra tendencia (0=off)", group = grpRisk)
maxTotLvl   = input.int(0,      "Tope global de posiciones (0=off)", minval = 0, group = grpRisk)
basketStop  = input.float(0.0,  "Perdida maxima por cesta (0=off) (bite 6)", group = grpRisk)
deepStopLvl = input.int(0,      "Stop catastrofe: desde N posiciones (0=off) (bite 6)", group = grpRisk)
deepStopPct = input.float(20.0, "Stop catastrofe: % balance (bite 6)", group = grpRisk)
stopCoolH   = input.float(24.0, "Stop catastrofe: horas de pausa (bite 6)", group = grpRisk)
timeCutMin  = input.float(0.0,  "Corte por tiempo: minutos (0=off) (bite 6)", group = grpRisk)
timeCutLoss = input.bool(false, "Corte por tiempo: solo en perdida (bite 6)", group = grpRisk)
timeCutPause= input.float(0.0,  "Corte por tiempo: minutos de pausa (bite 6)", group = grpRisk)
blockHours  = input.string("",  "Horas sin cestas nuevas, ej. 23,0,1", group = grpRisk)
blockDays   = input.string("",  "Dias sin cestas nuevas 0=Dom..6=Sab", group = grpRisk)
sideMode    = input.int(0,      "Lado: 0=ambos 1=compras 2=ventas 3=a favor 4=contra", minval = 0, maxval = 4, group = grpRisk)
sideLookH   = input.int(4,      "Lado: tendencia = precio vs cierre H1 de hace N horas", group = grpRisk)
dailyLoss   = input.float(0.0,  "Sin cestas nuevas si DD diario % (0=off)", group = grpRisk)
serverTZ    = input.string("GMT+2", "Zona horaria del servidor MT5", group = grpRisk,
     tooltip = "Las horas y dias bloqueados, la ventana sin siembra y el fin de semana usan la hora del SERVIDOR del broker (reloj del Market Watch). Ej.: GMT+2, GMT+3, Europe/Athens.")
stopPause   = input.float(0.0,  "Stop de cesta: minutos de pausa (bite 6)", group = grpRisk)
stopBudget  = input.float(0.0,  "Stop financiado: fraccion (0=off) (bite 6)", group = grpRisk)
stopBudCap  = input.float(0.0,  "Stop financiado: tope (bite 6)", group = grpRisk)
stopFlipH   = input.float(0.0,  "Tras stop: horas solo del lado del movimiento (bite 6)", group = grpRisk)
startBal    = input.float(1000.0, "Balance inicial de la simulacion", group = grpRisk,
     tooltip = "Solo se usa para los porcentajes de balance (supervivencia, candado, stop catastrofe).")

minSecs     = input.int(1,      "Segundos minimos entre entradas", minval = 0, group = grpRisk)
restartSecs = input.int(2,      "Pausa tras cosecha (segundos)", minval = 0, group = grpRisk)

// ---------------------------------------------------------------- 7. Tendencia
grpTrend    = "7. Tendencia"
trendBlock  = input.float(85.0, "Confianza de tendencia fuerte", group = grpTrend)
adxTrend    = input.float(25.0, "ADX minimo de tendencia",       group = grpTrend)
adxRange    = input.float(18.0, "ADX de rango",                  group = grpTrend)

// ---------------------------------------------------------------- 9c. Sesion / fin de semana
grpSess     = "9c. Sesion / fin de semana (hora servidor)"
avoidWknd   = input.bool(false, "Respetar horario", group = grpSess)
wkndFlatten = input.bool(false, "Cerrar todo antes del fin de semana", group = grpSess)
friStopH    = input.int(22,     "Viernes: no sembrar desde", minval = 0, maxval = 23, group = grpSess)
friFlatH    = input.int(23,     "Viernes: cerrar todo desde", minval = 0, maxval = 23, group = grpSess)
monStartH   = input.int(2,      "Lunes: sembrar desde", minval = 0, maxval = 23, group = grpSess)
sunResumeH  = input.int(0,      "Domingo: sembrar desde (0=sin espera)", minval = 0, maxval = 23, group = grpSess)
// 8. Recovery DD1..DD6 = 0, 9. Hedge (needs recovery >= 2) and 9b. Compound = off
// in the preset: these modules never act, so they are not ported.

// ---------------------------------------------------------------- Simulacion
grpSim      = "Simulacion (libro virtual)"
contractSz  = input.float(100.0, "Tamano de contrato (oz por lote)", group = grpSim)
commPerLot  = input.float(0.0,   "Comision por lote, ida y vuelta (moneda)", group = grpSim)
execMode    = input.string("Cada tick", "Modo de ejecucion", options = ["Cada tick", "Al cierre de la vela"], group = grpSim,
     tooltip = "Cada tick: en tiempo real el motor corre en cada actualizacion del precio, como OnTick del EA. Al cierre de la vela: corre una vez por vela cerrada. En el historico (sin ticks) ambos reproducen el recorrido de la vela.")
subTF       = input.timeframe("1", "Historico: sub-velas para el recorrido (vacio = la propia vela)", group = grpSim,
     tooltip = "Cada vela del historico se reproduce siguiendo las velas de este timeframe menor (apertura, extremos, cierre). Debe ser menor que el del grafico; si no, se usa la propia vela.")
synthDensity = input.float(4.0,  "Ticks sinteticos por paso de grid", minval = 1.0, step = 1.0, group = grpSim,
     tooltip = "Los saltos de precio se dividen en ticks separados por paso/N para no saltarse niveles del grid.")
maxSynth    = input.int(60,      "Maximo de ticks sinteticos por tramo", minval = 1, group = grpSim)
simStart    = input.time(timestamp("2000-01-01T00:00:00"), "Simular desde", group = grpSim)

// ---------------------------------------------------------------- Visual
grpVis      = "Visual"
showEmas    = input.bool(true,  "Mostrar EMAs",          group = grpVis)
showSwings  = input.bool(false, "Mostrar swings (BOS)",  group = grpVis)
showLadder  = input.bool(true,  "Mostrar escalera grid", group = grpVis)
ladderDepth = input.int(6,      "Niveles a mostrar", minval = 1, maxval = 12, group = grpVis)
showFills   = input.bool(true,  "Marcar entradas y cierres", group = grpVis)
showDash    = input.bool(true,  "Mostrar dashboard",     group = grpVis)

// ============================================================================
// Helpers (Utilities.mqh)
// ============================================================================
clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

mapRange(float x, float inLo, float inHi, float outLo, float outHi) =>
    inHi - inLo == 0.0 ? outLo : outLo + clamp((x - inLo) / (inHi - inLo), 0.0, 1.0) * (outHi - outLo)

// Floors to the 0.01 lot step, min 0.01, capped per order (NormalizeVolume).
normLot(float lot, float maxOrder) =>
    l = math.max(math.min(lot, maxOrder), 0.01)
    math.floor(l * 100.0 + 1e-7) / 100.0

// MT5 iADX: DI and DX smoothed with EMA (TradingView ta.dmi uses RMA).
mt5Adx(int len) =>
    float pDM = math.max(high - nz(high[1], high), 0.0)
    float nDM = math.max(nz(low[1], low) - low, 0.0)
    if pDM > nDM
        nDM := 0.0
    else if pDM < nDM
        pDM := 0.0
    else
        pDM := 0.0
        nDM := 0.0
    trv = math.max(high, nz(close[1], high)) - math.min(low, nz(close[1], low))
    pDI = ta.ema(trv != 0 ? 100.0 * pDM / trv : 0.0, len)
    nDI = ta.ema(trv != 0 ? 100.0 * nDM / trv : 0.0, len)
    sumDI = pDI + nDI
    adxV = ta.ema(sumDI != 0 ? 100.0 * math.abs(pDI - nDI) / sumDI : 0.0, len)
    [pDI, nDI, adxV]

// ============================================================================
// Sensor (MarketScanner.mqh)
// ============================================================================
atr      = mt5Calc ? ta.sma(ta.tr(true), atrPeriod) : ta.atr(atrPeriod)
atrAvg   = ta.sma(atr, atrAvgLB)
atrRatio = atrAvg > 0 ? atr / atrAvg : 1.0

emaF = ta.ema(close, emaFastLen)
emaM = ta.ema(close, emaMedLen)
emaS = ta.ema(close, emaSlowLen)
emaT = ta.ema(close, emaTrendLen)
emaSlope = (emaF - emaF[slopeLB]) / slopeLB
priceVel = (close - close[velLB]) / velLB

[mtPlus, mtMinus, mtAdx] = mt5Adx(adxPeriod)
[tvPlus, tvMinus, tvAdx] = ta.dmi(adxPeriod, adxPeriod)
plusDI  = mt5Calc ? mtPlus  : tvPlus
minusDI = mt5Calc ? mtMinus : tvMinus
adx     = mt5Calc ? mtAdx   : tvAdx

rsi = ta.rsi(close, rsiPeriod)
cci = ta.cci(hlc3, cciPeriod)
momentum = close[momPeriod] > 0 ? close / close[momPeriod] * 100.0 - 100.0 : 0.0   // iMomentum - 100

// Swings: most recent 5-bar fractal whose right neighbours are closed bars.
swingWin = math.max(swingLB, 60)
fracHigh = high[3] > high[4] and high[3] > high[5] and high[3] > high[2] and high[3] > high[1]
fracLow  = low[3]  < low[4]  and low[3]  < low[5]  and low[3]  < low[2]  and low[3]  < low[1]
var float shPrice = na
var int   shBar   = na
var float slPrice = na
var int   slBar   = na
if fracHigh
    shPrice := high[3]
    shBar   := bar_index - 3
if fracLow
    slPrice := low[3]
    slBar   := bar_index - 3
swingHigh = not na(shBar) and bar_index - shBar < swingWin ? shPrice : high[1]
swingLow  = not na(slBar) and bar_index - slBar < swingWin ? slPrice : low[1]
bosUp = close[1] > swingHigh
bosDn = close[1] < swingLow

// ============================================================================
// Tendencia (TrendDetector.mqh): confidence 0..100 + direction
// ============================================================================
slopeScore(float slope, float a) =>
    d = slope > 0 ? 1 : slope < 0 ? -1 : 0
    [d, clamp(math.abs(slope) / (a > 0 ? a : 1.0) * 100.0, 0.0, 100.0)]

float align = 0.0
int   adir  = 0
if emaF > emaM and emaM > emaS and emaS > emaT
    align := 100.0
    adir  := 1
else if emaF < emaM and emaM < emaS and emaS < emaT
    align := 100.0
    adir  := -1
else
    up = (emaF > emaM ? 1 : 0) + (emaM > emaS ? 1 : 0) + (emaS > emaT ? 1 : 0)
    dn = 3 - up
    align := math.abs(up - dn) / 3.0 * 100.0
    adir  := up > dn ? 1 : dn > up ? -1 : 0

adxScore = mapRange(adx, adxRange, 40.0, 0.0, 100.0)
didir    = plusDI > minusDI ? 1 : minusDI > plusDI ? -1 : 0
[sdir, slopeSc] = slopeScore(emaSlope, atr)
mdir     = momentum > 0 ? 1 : momentum < 0 ? -1 : 0
momScore = clamp(math.abs(momentum) * 20.0, 0.0, 100.0)
[vdir, velSc] = slopeScore(priceVel, atr)
atrExp   = mapRange(atrRatio, 1.0, 2.0, 0.0, 100.0)

vote     = adir * align + didir * adxScore + sdir * slopeSc + mdir * momScore + vdir * velSc
trendDir = vote > 0 ? 1 : vote < 0 ? -1 : 0
agree    = (trendDir != 0 ? ((adir == trendDir ? 1 : 0) + (didir == trendDir ? 1 : 0) + (sdir == trendDir ? 1 : 0) + (mdir == trendDir ? 1 : 0) + (vdir == trendDir ? 1 : 0)) : 0)
confBase = (0.30 * align + 0.25 * adxScore + 0.20 * slopeSc + 0.15 * momScore + 0.10 * velSc) * (0.5 + 0.5 * agree / 5.0) * (0.85 + 0.15 * atrExp / 100.0)
trendConf = trendDir == 0 ? 0.0 : clamp(confBase, 0.0, 100.0)

// ============================================================================
// Regimen (RegimeEngine.mqh). PANIC/RECOVERY depend on account DD% and are off
// with the preset (DD1..DD6 = 0), so they are not ported.
// ============================================================================
R_RANGE    = 0
R_TREND_UP = 1
R_TREND_DN = 2
R_MEANREV  = 3
R_BREAKOUT = 4
R_HIGHVOL  = 5
R_LOWVOL   = 6
R_NEWS     = 7

regime = atrRatio >= 2.5 ? R_NEWS :
     atrRatio >= 1.8 ? R_HIGHVOL :
     (bosUp or bosDn) and atrRatio >= 1.3 and adx >= adxTrend ? R_BREAKOUT :
     adx >= adxTrend and trendConf >= 60.0 and trendDir != 0 ? (trendDir > 0 ? R_TREND_UP : R_TREND_DN) :
     adx < adxRange and atrRatio < 0.8 ? R_LOWVOL :
     adx < adxTrend and (rsi > 70.0 or rsi < 30.0 or math.abs(cci) > 150.0) ? R_MEANREV :
     R_RANGE

regimeName(int r) =>
    switch r
        R_TREND_UP  => "TENDENCIA ALCISTA"
        R_TREND_DN  => "TENDENCIA BAJISTA"
        R_MEANREV   => "REVERSION MEDIA"
        R_BREAKOUT  => "BREAKOUT"
        R_HIGHVOL   => "ALTA VOLATILIDAD"
        R_LOWVOL    => "BAJA VOLATILIDAD"
        R_NEWS      => "NOTICIA"
        => "RANGO"

trendRegime = regime == R_TREND_UP or regime == R_TREND_DN or regime == R_BREAKOUT
strongTrend = trendConf >= trendBlock

// ============================================================================
// Grid (GridEngine.mqh + Engine.mqh)
// ============================================================================
gridBase = useATRStep ? atr * atrMult : fixedStep
gridBase := gridBase <= 0 ? fixedStep : gridBase
fVol = clamp(atrRatio, 0.7, 2.5)
fAdx = mapRange(adx, 15.0, 40.0, 1.0, 1.6)
fMom = mapRange(math.abs(momentum), 0.0, 2.0, 1.0, 1.4)
step = math.max(gridBase * fVol * fAdx * fMom, minStep)          // recovery/learning multipliers = 1

martMult  = atrRatio < 0.8 ? martLow : atrRatio < 1.2 ? martMed : atrRatio < 1.8 ? martHigh : martXHigh
volBucket = atrRatio < 0.8 ? "BAJO" : atrRatio < 1.2 ? "MEDIO" : atrRatio < 1.8 ? "ALTO" : "EXTREMO"

// HIGH_VOL regime: wider step, no martingale below 1, smaller lots.
gStep  = regime == R_HIGHVOL ? step * 1.5 : step
gMart  = regime == R_HIGHVOL ? math.max(martMult, 1.0) : martMult
gScale = regime == R_HIGHVOL ? 0.6 : 1.0

// sameSide = positions already open on that side (Engine.LevelStep / LevelLot).
levelStep(int sameSide, bool adverse) =>
    s = gStep
    if stepGrowth > 0 and sameSide > 1
        s *= math.pow(1.0 + stepGrowth, sameSide - 1)
    if adverse and advStepMult > 1.0
        s *= advStepMult
    s

levelLot(int sameSide) =>
    n = martMaxLvls > 0 and sameSide > martMaxLvls ? martMaxLvls : sameSide
    normLot(baseLot * math.pow(gMart, n) * gScale, maxLotOrder)

// ============================================================================
// Seed gates (RiskManager.AllowNew + Engine.VolExpansionBlocksNew / SeedGrid)
// ============================================================================
volBlocks   = maxAtrRatio > 0 and atrRatio > maxAtrRatio
riskBlocks  = regime == R_NEWS or assumedSprd > maxSpread

// ---- BITE 4: time, side and daily-loss gates (Engine.OnTick step 9)
parseList(string csv) =>
    out = array.new<int>()
    if str.length(csv) > 0
        for part in str.split(csv, ",")
            v = str.tonumber(str.trim(part))
            if not na(v)
                out.push(int(v))
    out

var array<int> blockHList = parseList(blockHours)
var array<int> blockDList = parseList(blockDays)

// iClose(H1, N): close of the H1 bar N hours back (for side modes 3 and 4).
h1Past = request.security(syminfo.tickerid, "60", close[math.max(sideLookH, 1)])

srvDow(int t) =>
    dayofweek(t, serverTZ) - 1          // 0 = Sunday ... 6 = Saturday, like MQL5
srvHour(int t) =>
    hour(t, serverTZ)

// SessionEngine.CanOpenNew (the broker-session check is implicit: no ticks when closed).
sessionCanOpen(int t) =>
    d = srvDow(t)
    h = srvHour(t)
    not avoidWknd or not (d == 6 or (d == 5 and h >= friStopH) or (d == 0 and sunResumeH > 0 and h < sunResumeH) or (d == 1 and h < monStartH))

// SessionEngine.ShouldFlatten
sessionFlatten(int t) =>
    d = srvDow(t)
    wkndFlatten and (d == 6 or (d == 5 and srvHour(t) >= friFlatH))

// Engine.HourBlocksNew: no seeding from hour A to hour B (inclusive, may wrap midnight).
hourBlocks(int t) =>
    h = srvHour(t)
    noNewFrom >= 0 and noNewTo >= 0 and (noNewFrom <= noNewTo ? (h >= noNewFrom and h <= noNewTo) : (h >= noNewFrom or h <= noNewTo))

// Engine.SideAllowed: 0 = both, +1 = buys only, -1 = sells only.
sideAllowed(float bid) =>
    int sd = 0
    if sideMode == 1
        sd := 1
    else if sideMode == 2
        sd := -1
    else if (sideMode == 3 or sideMode == 4) and not na(h1Past) and h1Past > 0
        d = bid > h1Past ? 1 : -1
        sd := sideMode == 3 ? d : -d
    sd

// Why a new basket may not be seeded right now ("" = allowed).
newBlockReason(int t, float equity, float dayStart) =>
    string r = ""
    if volBlocks
        r := "ATR alto"
    else if regime == R_NEWS
        r := "noticia"
    else if assumedSprd > maxSpread
        r := "spread"
    else if dailyLoss > 0 and dayStart > 0 and (dayStart - equity) / dayStart * 100.0 >= dailyLoss
        r := "perdida diaria"
    else if not sessionCanOpen(t)
        r := "sesion / fin de semana"
    else if hourBlocks(t)
        r := "ventana sin siembra"
    else if blockHList.includes(srvHour(t)) or blockDList.includes(srvDow(t))
        r := "hora/dia bloqueado"
    r

// Sides a new basket would open (SeedSingle in trend, SeedGrid otherwise).
seedSides(float bid) =>
    sd = sideAllowed(bid)
    bool canBuy  = false
    bool canSell = false
    if trendRegime
        canBuy  := trendDir > 0 and sd >= 0
        canSell := trendDir < 0 and sd <= 0
    else
        canBuy  := not ((strongTrend and trendDir < 0) or sd < 0)
        canSell := not ((strongTrend and trendDir > 0) or sd > 0)
    [canBuy, canSell]

// ============================================================================
// BITE 2+3 — Virtual ledger and tick engine
// ============================================================================
type Pos
    int   side      // +1 buy, -1 sell
    float price
    float lot
    int   t

// Chart marker waiting to be drawn (kept in the varip book so that markers
// created on realtime ticks survive the tick rollback).
type Mark
    int    bar
    float  price
    int    kind     // +1 buy, -1 sell, 0 basket close
    string txt
    string tip
    float  net

type Book
    array<Pos>  pos
    array<Mark> marks
    int   openT       = na    // basket start (ms)
    float peak        = 0.0   // m_basketPeak: shared by ratchet and trailing
    int   lastAdd     = 0     // ms of the last entry
    int   lastHarvest = 0     // ms of the last basket close
    float lastPx      = na    // last price fed to the engine
    int   lastT       = 0
    float realized    = 0.0
    int   baskets     = 0
    int   wins        = 0
    int   nTP         = 0
    int   nRatchet    = 0
    int   nTrail      = 0
    float worstNet    = 0.0
    int   maxPos      = 0
    float maxLots     = 0.0
    int   ticks       = 0
    int   nOther      = 0     // weekend flatten (more reasons in bite 6)
    int   m1Key       = 0     // current M1 candle (minute number) seen by the engine
    float m1Lo        = na    // its low / high in bid prices (M1Confirms)
    float m1Hi        = na
    int   dayKey      = 0     // server day, for the daily-loss anchor
    float dayStartBal = na

// varip: on realtime bars every tick's changes persist (like the EA's OnTick).
// On historical bars it behaves like var.
varip Book bk = Book.new(array.new<Pos>(), array.new<Mark>())

halfSpr = assumedSprd / 2.0
isTickMode = execMode == "Cada tick"

// Gates that depend on the current bar's indicators (Engine.GridAdds / OnTick).
advBuy   = strongTrend and trendDir < 0      // strong downtrend against the buys
advSell  = strongTrend and trendDir > 0
blkBuy   = blockAddAdx > 0 and adx >= blockAddAdx and minusDI > plusDI
blkSell  = blockAddAdx > 0 and adx >= blockAddAdx and plusDI > minusDI
allowAdd = maxSprdAdd <= 0 or assumedSprd <= maxSprdAdd
doGrid   = allowAdd and (not trendRegime or chaseTrend)

// Basket x-ray (BasketManager.mqh): counts, lots, extremes and floating money.
stats(Book b, float bidP, float askP) =>
    int   nb   = 0
    int   ns   = 0
    float lots = 0.0
    float loB  = na
    float hiS  = na
    float fl   = 0.0
    for p in b.pos
        lots += p.lot
        fl   -= commPerLot * p.lot
        if p.side > 0
            nb  += 1
            fl  += (bidP - p.price) * p.lot * contractSz
            loB := na(loB) ? p.price : math.min(loB, p.price)
        else
            ns  += 1
            fl  += (p.price - askP) * p.lot * contractSz
            hiS := na(hiS) ? p.price : math.max(hiS, p.price)
    [nb, ns, lots, loB, hiS, fl]

// Engine.Open: respects the total exposure cap.
openPos(Book b, int side, float price, float lot, string tag, float lotsNow, int tms) =>
    bool ok = false
    if lot > 0 and lotsNow + lot <= maxTotLots + 1e-9
        b.pos.push(Pos.new(side, price, lot, tms))
        if na(b.openT)
            b.openT := tms
        b.lastAdd := tms
        b.marks.push(Mark.new(bar_index, price, side, "", tag + "  " + str.tostring(lot, "#.##") + " @ " + str.tostring(price, format.mintick), 0.0))
        ok := true
    ok

// Engine.CloseAll + FinalizeClose (the ledger closes instantly, nothing pending).
closeAll(Book b, float net, int total, string reason, int tms, float px) =>
    b.realized    := b.realized + net
    b.baskets     := b.baskets + 1
    b.wins        := b.wins + (net > 0 ? 1 : 0)
    b.nTP         := b.nTP + (reason == "basket_tp" ? 1 : 0)
    b.nRatchet    := b.nRatchet + (reason == "ratchet_tp" ? 1 : 0)
    b.nTrail      := b.nTrail + (reason == "trail_tp" ? 1 : 0)
    b.nOther      := b.nOther + (reason == "weekend_flat" ? 1 : 0)
    b.lastHarvest := tms
    b.lastAdd     := tms
    b.openT       := na
    b.peak        := 0.0
    b.pos.clear()
    b.marks.push(Mark.new(bar_index, px, 0, (net >= 0 ? "+" : "") + str.tostring(net, "#.##") + "\n" + str.tostring(total) + " pos", reason, net))

// TPManager.BasketTP (recovery tpMult = 1; deep TP in bite 5).
basketTP(int total, float timeMin) =>
    lotsFactor = 1.0 + 0.10 * math.max(total - 1, 0)
    atrComp    = math.max(tpAtrMult * atrRatio, 0.5)
    timeDecay  = mapRange(timeMin, 0.0, 120.0, 1.0, 0.65)
    math.max(baseTP * lotsFactor * atrComp * timeDecay, tpMin)

// TrailingEngine: allowed pullback from the peak, scaled by volatility.
trailPullback() =>
    math.max(trailStep * clamp(atrRatio, 0.7, 2.0), 0.01)

// Engine.M1Confirms: the current M1 candle is no longer making a new adverse extreme.
m1Confirms(Book b, bool buySide, float sN, float bid, float ask) =>
    not addConfM1 or (buySide ? (na(b.m1Lo) or bid - b.m1Lo >= 0.20 * sN) : (na(b.m1Hi) or b.m1Hi - ask >= 0.20 * sN))

// Engine.GridAdds: at most one entry per tick.
gridAdds(Book b, float bid, float ask, int tms) =>
    [nb, ns, lots, loB, hiS, fl] = stats(b, bid, ask)
    bool added = false
    if doGrid and not (maxTotLvl > 0 and nb + ns >= maxTotLvl)
        if not blkBuy and nb > 0 and nb < maxLevels
            sN = levelStep(nb, advBuy)
            if loB - ask >= sN and m1Confirms(b, true, sN, bid, ask)
                added := openPos(b, 1, ask, levelLot(nb), "GridBuy N" + str.tostring(nb + 1), lots, tms)
        if not added and not blkSell and ns > 0 and ns < maxLevels
            sN = levelStep(ns, advSell)
            if bid - hiS >= sN and m1Confirms(b, false, sN, bid, ask)
                added := openPos(b, -1, bid, levelLot(ns), "GridSell N" + str.tostring(ns + 1), lots, tms)
        // Refill the missing side to stay two-sided (if the side mode allows it).
        if not added
            sd = sideAllowed(bid)
            if ns == 0 and nb > 0 and loB - bid >= gStep * 0.5 and not advSell and sd <= 0
                added := openPos(b, -1, bid, normLot(baseLot * gScale, maxLotOrder), "Refill", lots, tms)
            else if nb == 0 and ns > 0 and ask - hiS >= gStep * 0.5 and not advBuy and sd >= 0
                added := openPos(b, 1, ask, normLot(baseLot * gScale, maxLotOrder), "Refill", lots, tms)
    added

// Engine.ManageTrend with a basket open: base-lot pyramid on pullbacks.
trendAdd(Book b, float bid, float ask, int tms) =>
    [nb, ns, lots, loB, hiS, fl] = stats(b, bid, ask)
    near = 0.5 * atr
    sd = sideAllowed(bid)
    bool added = false
    if sd != 0 and sd != trendDir
        added := false
    else if trendDir > 0 and nb > 0 and nb < maxLevels and (bid <= emaF + near or bid <= emaM + near) and rsi < 60 and bid <= loB - step
        added := openPos(b, 1, ask, normLot(baseLot, maxLotOrder), "TrendAdd", lots, tms)
    else if trendDir < 0 and ns > 0 and ns < maxLevels and (ask >= emaF - near or ask >= emaM - near) and rsi > 40 and ask >= hiS + step
        added := openPos(b, -1, bid, normLot(baseLot, maxLotOrder), "TrendAdd", lots, tms)
    added

// Engine 15b: SeedSingle in trend regimes, SeedGrid otherwise.
seed(Book b, float bid, float ask, int tms) =>
    lotS = normLot(baseLot * gScale, maxLotOrder)
    b.peak := 0.0
    bool ok = false
    [canBuy, canSell] = seedSides(bid)
    if trendRegime
        if canBuy or canSell
            ok := openPos(b, trendDir, trendDir > 0 ? ask : bid, normLot(baseLot, maxLotOrder), "TrendSeed", 0.0, tms)
    else
        okB = canBuy ? openPos(b, 1, ask, lotS, "Seed", 0.0, tms) : false
        okS = canSell ? openPos(b, -1, bid, lotS, "Seed", okB ? lotS : 0.0, tms) : false
        ok := okB or okS
    ok

// One EA tick (Engine.OnTick, steps 9-15).
engineTick(Book b, float px, int tms) =>
    bid = px - halfSpr
    ask = px + halfSpr
    b.lastPx := px
    b.lastT  := tms
    b.ticks  := b.ticks + 1
    // M1 candle of this tick (low/high in bid prices) for M1Confirms.
    mKey = int(math.floor(tms / 60000))
    if mKey != b.m1Key
        b.m1Key := mKey
        b.m1Lo  := bid
        b.m1Hi  := bid
    else
        b.m1Lo := math.min(b.m1Lo, bid)
        b.m1Hi := math.max(b.m1Hi, bid)
    // Daily anchor (UpdatePnLAnchors): balance at the start of the server day.
    dKey = year(tms, serverTZ) * 10000 + month(tms, serverTZ) * 100 + dayofmonth(tms, serverTZ)
    if dKey != b.dayKey
        b.dayKey      := dKey
        b.dayStartBal := startBal + b.realized
    bool closed = false
    float netNow = 0.0
    if b.pos.size() > 0
        [nb, ns, lots, loB, hiS, net] = stats(b, bid, ask)
        netNow := net
        total = nb + ns
        b.worstNet := math.min(b.worstNet, net)
        b.maxPos   := math.max(b.maxPos, total)
        b.maxLots  := math.max(b.maxLots, lots)
        string why = ""
        if sessionFlatten(tms)
            // 11c) Weekend: flatten everything.
            why := "weekend_flat"
        else
            // 12) Exits
            target = basketTP(total, (tms - b.openT) / 60000.0)
            why := net >= target ? "basket_tp" : ""
            // Ratchet: once the peak reached arm% of the target, keep lock% of it.
            if why == "" and ratchetLock > 0 and target > 0 and b.peak >= target * ratchetArm and net <= b.peak * ratchetLock and net > 0
                why := "ratchet_tp"
            if why == ""
                if net > b.peak and net >= target * ratchetArm
                    b.peak := net
                // Trailing: only above the breakeven pad and the activation profit.
                if net >= bePad and net >= trailAct
                    if net > b.peak
                        b.peak := net
                    if b.peak - net >= trailPullback()
                        why := "trail_tp"
        if why != ""
            closeAll(b, net, total, why, tms, px)
            netNow := 0.0
            closed := true
    // 14) Anti-spike timers, then 15) entries (nothing at all while flattening).
    if not closed and not sessionFlatten(tms) and tms - b.lastAdd >= minSecs * 1000 and tms - b.lastHarvest >= restartSecs * 1000
        if b.pos.size() > 0
            gridAdds(b, bid, ask, tms)
            if trendRegime and allowAdd
                trendAdd(b, bid, ask, tms)
        else if newBlockReason(tms, startBal + b.realized + netNow, b.dayStartBal) == ""
            seed(b, bid, ask, tms)
    closed

// Moves the price from the last tick to px. Long jumps are split into
// synthetic ticks (gStep / density apart) so grid levels in between are seen.
runTo(Book b, float px, int tms) =>
    float prev  = na(b.lastPx) ? px : b.lastPx
    int   prevT = b.lastT > 0 ? b.lastT : tms
    spacing = math.max(gStep / synthDensity, syminfo.mintick)
    n = math.min(math.max(int(math.ceil(math.abs(px - prev) / spacing)), 1), maxSynth)
    for j = 1 to n
        engineTick(b, prev + (px - prev) * j / n, prevT + int(math.round((tms - prevT) * j / n)))
    n

// Price path of one bar: open -> nearer extreme -> other extreme -> close.
pushBarPath(array<float> P, array<int> T, float o, float h, float l, float c, int t0, int dur) =>
    upBar = c >= o
    P.push(o)
    T.push(t0)
    P.push(upBar ? l : h)
    T.push(t0 + int(math.round(dur / 3)))
    P.push(upBar ? h : l)
    T.push(t0 + int(math.round(dur * 2 / 3)))
    P.push(c)
    T.push(t0 + dur - 1)
    P.size()

// Markers of older bars were already drawn on their own bar.
if bk.marks.size() > 0
    for i = bk.marks.size() - 1 to 0
        if bk.marks.get(i).bar < bar_index
            bk.marks.remove(i)

ready  = time >= simStart and not na(atrAvg) and not na(emaT) and not na(adx) and bar_index > emaTrendLen
useSub = subTF != "" and timeframe.in_seconds(subTF) < timeframe.in_seconds()

if ready
    if isTickMode and barstate.isrealtime
        // Real ticks: every chart update is one (or more, if price jumped) EA tick.
        runTo(bk, close, timenow)
    else if barstate.isconfirmed
        // History (and close mode): replay the bar as a price path.
        pathP = array.new<float>()
        pathT = array.new<int>()
        if useSub
            [sO, sH, sL, sC, sT] = request.security_lower_tf(syminfo.tickerid, subTF, [open, high, low, close, time])
            subDur = timeframe.in_seconds(subTF) * 1000
            if sO.size() > 0
                for k = 0 to sO.size() - 1
                    pushBarPath(pathP, pathT, sO.get(k), sH.get(k), sL.get(k), sC.get(k), sT.get(k), subDur)
        if pathP.size() == 0
            pushBarPath(pathP, pathT, open, high, low, close, time, timeframe.in_seconds() * 1000)
        for k = 0 to pathP.size() - 1
            runTo(bk, pathP.get(k), pathT.get(k))

// Draw this bar's markers (redrawn on every realtime tick, kept on the last one).
if showFills and bk.marks.size() > 0
    for m in bk.marks
        if m.bar == bar_index
            if m.kind == 0
                label.new(bar_index, m.price, m.txt, style = label.style_label_down,
                     color = m.net >= 0 ? color.new(color.teal, 10) : color.new(color.maroon, 10),
                     textcolor = color.white, size = size.tiny, tooltip = m.tip)
            else
                label.new(bar_index, m.price, "", yloc = yloc.price,
                     style = m.kind > 0 ? label.style_triangleup : label.style_triangledown,
                     color = m.kind > 0 ? color.new(color.lime, 0) : color.new(color.fuchsia, 0),
                     size = size.tiny, tooltip = m.tip)

bidC = close - halfSpr
askC = close + halfSpr

// Current basket for display.
[dNb, dNs, dLots, dLoB, dHiS, dNet] = stats(bk, bidC, askC)
dTotal  = dNb + dNs
nowMs   = barstate.isrealtime ? timenow : time_close
dAgeMin = dTotal > 0 ? (nowMs - bk.openT) / 60000.0 : 0.0
dTarget = dTotal > 0 ? basketTP(dTotal, dAgeMin) : na
dBlock  = newBlockReason(nowMs, startBal + bk.realized + dNet, bk.dayStartBal)
[dBuy, dSell] = seedSides(bidC)
dArmed  = dTotal > 0 and ratchetLock > 0 and bk.peak >= dTarget * ratchetArm

plot(dTotal > 0 ? dNet : na, "Neto cesta", display = display.data_window)
plot(bk.realized, "Realizado", display = display.data_window)

// ============================================================================
// Visuals
// ============================================================================
plot(showEmas ? emaF : na, "EMA rapida",    color.new(color.aqua, 0))
plot(showEmas ? emaM : na, "EMA media",     color.new(color.yellow, 0))
plot(showEmas ? emaS : na, "EMA lenta",     color.new(color.orange, 0))
plot(showEmas ? emaT : na, "EMA tendencia", color.new(color.red, 0), 2)
plot(showSwings ? swingHigh : na, "Swing alto", color.new(color.gray, 30), style = plot.style_stepline)
plot(showSwings ? swingLow  : na, "Swing bajo", color.new(color.gray, 30), style = plot.style_stepline)

regimeColor = regime == R_TREND_UP ? color.new(color.green, 88) :
     regime == R_TREND_DN ? color.new(color.red, 88) :
     regime == R_BREAKOUT ? color.new(color.purple, 85) :
     regime == R_NEWS or regime == R_HIGHVOL ? color.new(color.orange, 85) : na
bgcolor(regimeColor, title = "Regimen")

// Next grid levels: from the open basket's extremes, or from the close if flat
// (the EA recomputes the step on every tick, so this is a snapshot).
var array<line>  ladder    = array.new<line>()
var array<label> ladderTxt = array.new<label>()
if barstate.islast and showLadder
    for l in ladder
        line.delete(l)
    for t in ladderTxt
        label.delete(t)
    array.clear(ladder)
    array.clear(ladderTxt)
    float pB = dNb > 0 ? dLoB : close
    float pS = dNs > 0 ? dHiS : close
    int   nB = math.max(dNb, 1)
    int   nS = math.max(dNs, 1)
    for k = 0 to ladderDepth - 1
        pB -= levelStep(nB + k, strongTrend and trendDir < 0)
        pS += levelStep(nS + k, strongTrend and trendDir > 0)
        array.push(ladder, line.new(bar_index - 15, pB, bar_index + 3, pB, color = color.new(color.lime, 30), style = line.style_dotted))
        array.push(ladder, line.new(bar_index - 15, pS, bar_index + 3, pS, color = color.new(color.fuchsia, 30), style = line.style_dotted))
        array.push(ladderTxt, label.new(bar_index + 3, pB, "B" + str.tostring(nB + k + 1) + " " + str.tostring(levelLot(nB + k), "#.##"), style = label.style_none, textcolor = color.lime, size = size.tiny))
        array.push(ladderTxt, label.new(bar_index + 3, pS, "S" + str.tostring(nS + k + 1) + " " + str.tostring(levelLot(nS + k), "#.##"), style = label.style_none, textcolor = color.fuchsia, size = size.tiny))

var table dash = table.new(position.top_right, 2, 21, bgcolor = color.new(color.black, 15), border_width = 1)
dashRow(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c,            text_size = size.small, text_halign = text.align_right)

money(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "#,##0.00")

if barstate.islast and showDash
    dashRow(0,  "Regimen",      regimeName(regime), trendRegime ? (trendDir > 0 ? color.lime : color.red) : color.white)
    dashRow(1,  "Tendencia",    (trendDir > 0 ? "ALCISTA " : trendDir < 0 ? "BAJISTA " : "PLANA ") + str.tostring(trendConf, "#") + "%" + (strongTrend ? " FUERTE" : ""), trendDir > 0 ? color.lime : trendDir < 0 ? color.red : color.gray)
    dashRow(2,  "ADX  +DI/-DI", str.tostring(adx, "#.#") + "  " + str.tostring(plusDI, "#.#") + "/" + str.tostring(minusDI, "#.#"), color.white)
    dashRow(3,  "ATR / ratio",  str.tostring(atr, "#.##") + " / " + str.tostring(atrRatio, "#.###"), color.white)
    dashRow(4,  "Volatilidad",  volBucket + "  mart x" + str.tostring(gMart, "#.##"), color.white)
    dashRow(5,  "Paso grid",    str.tostring(gStep, "#.##"), color.white)
    dashRow(6,  "Siembra",      dBlock != "" ? "BLOQUEADA (" + dBlock + ")" : dBuy and dSell ? "COMPRA + VENTA" : dBuy ? "SOLO COMPRA" : dSell ? "SOLO VENTA" : "NINGUNA", dBlock != "" ? color.orange : color.lime)
    dashRow(7,  "Cesta",        dTotal > 0 ? "B " + str.tostring(dNb) + " / S " + str.tostring(dNs) + "  " + str.tostring(dLots, "#.##") + " lotes" : "sin cesta", color.white)
    dashRow(8,  "Neto / objetivo", dTotal > 0 ? money(dNet) + " / " + str.tostring(dTarget, "#.##") : "-", dNet >= 0 ? color.lime : color.red)
    dashRow(9,  "Pico / trinquete", dTotal > 0 ? str.tostring(bk.peak, "#.##") + (dArmed ? "  suelo " + str.tostring(bk.peak * ratchetLock, "#.##") : "  sin armar") : "-", dArmed ? color.aqua : color.gray)
    dashRow(10, "Trailing",     dTotal > 0 ? (dNet >= math.max(trailAct, bePad) ? "ACTIVO  retroceso " + str.tostring(trailPullback(), "#.##") : "desde " + str.tostring(math.max(trailAct, bePad), "#.##")) : "-", color.white)
    dashRow(11, "Edad cesta",   dTotal > 0 ? str.tostring(dAgeMin, "#") + " min" : "-", color.white)
    dashRow(12, "Cestas cerradas", str.tostring(bk.baskets) + "  (ganadas " + str.tostring(bk.wins) + ")", color.white)
    dashRow(13, "Cierres TP/trinq/trail/finde", str.tostring(bk.nTP) + " / " + str.tostring(bk.nRatchet) + " / " + str.tostring(bk.nTrail) + " / " + str.tostring(bk.nOther), color.white)
    dashRow(14, "Realizado",    money(bk.realized), bk.realized >= 0 ? color.lime : color.red)
    dashRow(15, "Peor flotante", money(bk.worstNet), color.orange)
    dashRow(16, "Max pos / lotes", str.tostring(bk.maxPos) + " / " + str.tostring(bk.maxLots, "#.##"), color.white)
    dashRow(17, "Equity sim.",  str.tostring(startBal + bk.realized + dNet, "#,##0.00"), color.white)
    dashRow(18, "Ejecucion",    execMode + (barstate.isrealtime and isTickMode ? " (EN VIVO)" : "") + "  ticks " + str.tostring(bk.ticks), color.gray)
    dashRow(19, "Hora servidor", str.format_time(nowMs, "EEE HH:mm", serverTZ) + "  (" + serverTZ + ")" + (sideMode > 0 ? "  lado " + str.tostring(sideAllowed(bidC)) : ""), color.gray)
    dashRow(20, "Bite",         "4 / filtros de horario, lado y M1", color.gray)
