//@version=6
// DEFAULTS CALIBRATED FOR BTCUSD: exchange spot feed (COINBASE:BTCUSD, BITSTAMP:BTCUSD or BINANCE:BTCUSDT,
// not the composite index), 15m chart, rungs 1s / 10s / 1m / 3m / 5m. Whole-dollar prices, 30-minute
// travel horizon, 1.5 x 5m-ATR target so a hit clears fees, 2-day Hurst window, L1/L2 lines hidden and
// verdict labels kept from L3 up so the 1-second forest stays readable. Leave these as they are on BTC.
// XPW Chain STRATEGY v0.4D - the Look-Down Forest monitor turned into a backtestable strategy.
//
// Two trades, straight from the Fractal Direction Framework:
//   PULLBACK  - a chain WITH the parent resolves at level >= N. Enter in the parent's direction at the
//               bar close. Stop just beyond the parent's key level (last higher low / lower high), take
//               profit at R x risk, stop trails with the key level, exit if the parent flips.
//   REVERSAL  - a chain AGAINST the parent reaches level >= N and then a bar CLOSES through the key
//               level (BREAK). Enter in the chain's direction at that close. Stop beyond the chain's
//               start price, same TP / time stop.
// Orders fill on bar close (process_orders_on_close), one position at a time.
// BACKTEST LIMIT: the 1s rung only has ~1 day of intrabar history from a 15m chart, so the test is short.
// For a longer test use a 1h chart with rungs 5S / 15S / 1 / 5 / 15 (about a week of data).
//
// ---- original monitor notes follow ----
// XPW Chain Monitor v0.4D - LOOK DOWN, forest edition. v0.4 engine, rungs BELOW the chart, chosen by you.
//
// Load it on a higher chart (15m, 1h...). Pick five lower timeframes, smallest first
// (default 1s, 10s, 1m, 3m, 5m). The chain opens when the SMALLEST rung prints its square
// and climbs while each larger rung agrees inside its window. One label per chain, anchored at
// the EXACT TICK (time + price) of the rung-1 square, body to the LEFT of it; it GROWS one size per rung:
//   "1s"  ->  "1s > 10s"  ->  "1s > 10s > 1m"  ->  ...  ->  "... > 5m OK"   (all agree)
//   or    "1s > 10s X wall 1m"                                              (the wall)
// When the chain resolves, an END label is added at the EXACT TICK of the last rung that fired,
// body to the RIGHT, and a line links start -> end. Dots mark both ticks.
// FOREST: every rung-1 square opens its own chain; chains climb in parallel and each has its own
// growing label. Late grace tags "late". Reach = rolling mean final level (out of 5). NET travel
// at horizon end sits next to MFE/MAE so continuation and climax are distinguishable.
//
// PRICE ACCURACY: choose the decimals shown in every label, optionally list the price at EACH rung
// in the label, and draw a thin horizontal PRICE MARKER across the chart candle at the exact tick
// price (start and end) so you can see where on the candle it happened. Hover a dot for the exact
// price and time.
// LINE VISIBILITY: "Lines for L1..L5" lets you hide the link, price-marker and key-level lines per
// chain level (e.g. untick L1 and L2 to only see lines on chains that climbed to L3 or more).
//
// FRACTAL DIRECTION FRAMEWORK (divergence -> fractal -> break):
//   PARENT  = the chart timeframe, read from confirmed pivots. It turns UP when a bar closes above the
//             last pivot high and DOWN when a bar closes below the last pivot low. Its KEY LEVEL is the
//             last higher low (up) or lower high (down): the structure that must give way for a flip.
//   CHAIN   = the sub-trend. At birth every chain is tagged [with] the parent (pullback entry),
//             [vs] the parent (would-be reversal) or [range] (no parent yet). The key level of that
//             moment is frozen onto the chain and drawn as a dotted line.
//   BREAK   = after the verdict, a STRUCTURE WINDOW (chart bars) watches whether a bar closes through
//             the key level. A [vs] chain reads BREAK (the sub-trend became the new parent) or HELD
//             (roughness). A [with] chain reads "parent broke" (your pullback trade is stopped) or
//             "parent held". Stats split by relation; the table rows WITH / AGAINST summarise them.
//   DIVERGENCE PRESSURE = EMA of the number of open chains AGAINST the parent. It rises when the
//             small scales keep flipping while the parent has not: the early warning.
//   HURST   = rescaled-range slope over the last N chart bars (4 window sizes). > 0.55 persistent,
//             < 0.45 mean-reverting. Crude at chart resolution (R/S is biased upward on short
//             samples): a go / no-go for trusting continuation, not a precise exponent.
//
// Mechanics: request.security_lower_tf() returns every intrabar value inside each chart bar,
// so historical chains are reconstructed from the exact square times. On the live bar the
// label grows tick by tick. Limit: TradingView serves ~100k intrabars per request, so from a
// 15m chart the 1s rung only has data for the last ~110 chart bars (about a day).
//
// Square = the v0.7 Shape Map primitive (odd-colour island closes). Width in SECONDS by default
// (v0.6 fix), so the same island is recognised on every rung. Bottoms and tops never pooled.
//
// GHOST CANDLES: an indicator cannot make the chart's own candles transparent. Turn "Ghost candles"
// on, then hide the originals: right-click chart > Settings > Symbol > untick Body, Borders, Wick.

strategy("XPW Chain Strategy v0.4D Look-Down Forest", overlay = true, calc_on_every_tick = false, process_orders_on_close = true, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 50, max_labels_count = 500, max_lines_count = 500, max_bars_back = 500)

// ------------- TDI (keep identical to Shape Map v0.7) -------------
grpT = "TDI (keep identical to Shape Map v0.7)"
rsiLen     = input.int(14, "RSI length",     minval = 2, group = grpT)
fastLen    = input.int(2,  "Fast MA length", minval = 1, group = grpT)
slowLen    = input.int(7,  "Slow MA length", minval = 1, group = grpT)
invertFill = input.bool(true, "My panel paints fast>slow as RED", group = grpT)

grpW = "Square size units"
widthMode = input.string("Seconds", "Width units", options = ["Seconds", "Bars"], group = grpW, tooltip = "Seconds: island width and context are durations; every rung converts to its own bar count (rounded up, min 1). Bars: fixed bar counts on every rung (v0.3 behaviour).")
areaMode  = input.string("Bars", "Area lookback units", options = ["Bars", "Seconds"], group = grpW)

grpA = "Areas"
areaLook    = input.int(20,   "Area lookback (bars)",    minval = 5, group = grpA)
areaLookSec = input.int(60,   "Area lookback (seconds)", minval = 5, group = grpA)
loFrac      = input.float(0.20, "LOW area: below this fraction",  minval = 0.0, maxval = 1.0, step = 0.01, group = grpA)
hiFrac      = input.float(0.67, "HIGH area: above this fraction", minval = 0.0, maxval = 1.0, step = 0.01, group = grpA)

grpB = "BOTTOM square (odd RED island, LOW area)"
botMinSec  = input.int(1,  "Min island (seconds)",  minval = 1, group = grpB)
botMaxSec  = input.int(10, "Max island (seconds)",  minval = 1, group = grpB)
botCtxSec  = input.int(3,  "Context (seconds)",     minval = 1, group = grpB)
botMinW    = input.int(1, "Min width (bars)",    minval = 1, group = grpB)
botMaxW    = input.int(3, "Max width (bars)",    minval = 1, group = grpB)
botCtx     = input.int(2, "Context (bars)",      minval = 1, group = grpB)
botNeedLow = input.bool(true, "Require LOW area", group = grpB)
botSep     = input.int(5, "Min bars between squares", minval = 0, group = grpB)

grpP = "TOP square (odd LIME island, HIGH area)"
topMinSec   = input.int(1,  "Min island (seconds)",  minval = 1, group = grpP)
topMaxSec   = input.int(8,  "Max island (seconds)",  minval = 1, group = grpP)
topCtxSec   = input.int(4,  "Context (seconds)",     minval = 1, group = grpP)
topMinW     = input.int(1, "Min width (bars)",    minval = 1, group = grpP)
topMaxW     = input.int(2, "Max width (bars)",    minval = 1, group = grpP)
topCtx      = input.int(3, "Context (bars)",      minval = 1, group = grpP)
topNeedHigh = input.bool(true, "Require HIGH area", group = grpP)
topSep      = input.int(5, "Min bars between squares", minval = 0, group = grpP)

// ------------- RUNGS (your choice, all LOWER than the chart) -------------
grpR = "Rungs (lower timeframes, smallest first)"
r1 = input.timeframe("1S",  "Rung 1 (smallest, opens the chain)", group = grpR)
r2 = input.timeframe("10S", "Rung 2", group = grpR)
r3 = input.timeframe("1",   "Rung 3", group = grpR)
r4 = input.timeframe("3",   "Rung 4", group = grpR)
r5 = input.timeframe("5",   "Rung 5 (largest, all agree)", group = grpR)

// ------------- CHAIN -------------
grpC = "Chain"
agreeBars   = input.int(5, "Agreement window (bars of the HIGHER rung)", minval = 1, group = grpC)
graceBars   = input.int(2, "Late grace (extra bars of the HIGHER rung)", minval = 0, group = grpC)
tolBars     = input.int(1, "Higher rung may already have fired (its bars)", minval = 0, group = grpC)
horizonBars = input.int(6, "Measure travel for (bars of RUNG 5, after the verdict)", minval = 1, group = grpC)
atrLen      = input.int(14, "ATR length (rung 5)", minval = 2, group = grpC)
tgtAtr      = input.float(1.5, "Target travel (x rung-5 ATR)", minval = 0.1, step = 0.1, group = grpC)
alertLvl    = input.int(3, "Alert when a chain resolves at level >=", minval = 1, maxval = 5, group = grpC)
maxChains   = input.int(80, "Max chains alive (forest cap)", minval = 5, maxval = 200, group = grpC)
reachLen    = input.int(20, "Reach gauge: last N chains", minval = 3, maxval = 200, group = grpC)
showLabels  = input.bool(true, "Growing chain labels", group = grpC)
minLabelLvl = input.int(3, "Keep verdict labels only for level >=", minval = 1, maxval = 5, group = grpC, tooltip = "Chains that resolve below this level have their drawings removed. 5 = only chains that reach all five stay on the chart.")
showTable   = input.bool(true, "Show table", group = grpC)
tblPos      = input.string("Top right", "Table position", options = ["Top right", "Middle right", "Bottom right", "Top left"], group = grpC)
tblSizeIn   = input.string("Normal", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpC)
tblRel      = input.string("All", "Level rows count chains that are", options = ["All", "With parent", "Against parent", "Range"], group = grpC, tooltip = "Filters the L1..L5 statistics rows by the chain's relation to the parent trend.")

// ------------- LABELS & VISUALS -------------
grpL = "Labels & visuals"
lblBase     = input.int(20, "Label font size at L1 (points)", minval = 8, maxval = 72, group = grpL, tooltip = "Chain labels use a font size in points. They grow by the step below at every rung.")
lblStep     = input.int(5,  "Font size step per level (points)", minval = 0, maxval = 20, group = grpL)
showDot     = input.bool(true, "Dots at the exact ticks (time + price)", group = grpL, tooltip = "Hover a dot to see the exact price and time of that tick.")
showEnd     = input.bool(true, "End label (where the last rung fired)", group = grpL)
showLink    = input.bool(true, "Link start -> end", group = grpL)
longCol     = input.color(color.lime,    "LONG chain colour (BOT square)",  group = grpL)
longTxt     = input.color(color.black,   "LONG label text",                 group = grpL)
shortCol    = input.color(color.fuchsia, "SHORT chain colour (TOP square)", group = grpL)
shortTxt    = input.color(color.white,   "SHORT label text",                group = grpL)
ghost       = input.bool(false, "Ghost candles (see-through copy)", group = grpL, tooltip = "Then hide the chart's own candles: right-click > Settings > Symbol > untick Body, Borders, Wick.")
ghostTr     = input.int(80, "Ghost candle transparency", minval = 0, maxval = 100, group = grpL)
ghostUp     = input.color(color.teal, "Ghost up",   group = grpL)
ghostDn     = input.color(color.red,  "Ghost down", group = grpL)

// ------------- PRICE ACCURACY -------------
grpX = "Price accuracy"
priceDec   = input.int(0, "Price decimals (-1 = symbol tick size)", minval = -1, maxval = 10, group = grpX, tooltip = "How many decimals every label shows. -1 uses the symbol's own tick size.")
showRungPx = input.bool(false, "Show the price at EVERY rung in the label", group = grpX, tooltip = "1s 1.2345 > 10s 1.2350 > ... instead of only the start price.")
showMark   = input.bool(true, "Price marker across the candle (exact tick price)", group = grpX, tooltip = "Thin horizontal line across the chart candle that contains the tick, at its exact price. Start and end.")
markWidth  = input.int(2, "Price marker width", minval = 1, maxval = 5, group = grpX)

// ------------- LINE VISIBILITY PER LEVEL -------------
grpV = "Lines per chain level (link + price markers + key level)"
lineL1 = input.bool(false, "Lines for L1 chains (only rung 1 fired)", group = grpV)
lineL2 = input.bool(false, "Lines for L2 chains", group = grpV)
lineL3 = input.bool(true, "Lines for L3 chains", group = grpV)
lineL4 = input.bool(true, "Lines for L4 chains", group = grpV)
lineL5 = input.bool(true, "Lines for L5 chains (all agree)", group = grpV)

// ------------- FRACTAL DIRECTION FRAMEWORK -------------
grpF = "Fractal direction (parent, break, divergence, Hurst)"
pivLen    = input.int(5,  "Parent pivot strength (chart bars each side)", minval = 1, group = grpF, tooltip = "The parent trend is read from confirmed pivots on the chart timeframe. A pivot is confirmed this many bars late.")
structWin = input.int(12, "Structure window (chart bars after the verdict)", minval = 1, group = grpF, tooltip = "How long after a chain resolves the script watches whether a bar closes through the parent's key level.")
showKey   = input.bool(true, "Key level line (parent's last higher low / lower high)", group = grpF)
presLen   = input.int(10, "Divergence pressure EMA (chart bars)", minval = 1, group = grpF)
presWarn  = input.float(4.0, "Divergence warning when pressure >=", minval = 0.5, step = 0.5, group = grpF)
hurstLen  = input.int(192, "Hurst window (chart bars)", minval = 32, maxval = 480, group = grpF, tooltip = "Rescaled range at N/8, N/4, N/2 and N, slope of log(R/S) vs log(n). Needs this many bars loaded.")
pUpCol    = input.color(color.new(color.teal, 40), "Parent UP cell",   group = grpF)
pDnCol    = input.color(color.new(color.red, 40),  "Parent DOWN cell", group = grpF)

// ------------- STRATEGY -------------
grpS = "S1. Entries"
modePull     = input.bool(true,  "Trade PULLBACKS (chain WITH the parent resolves)", group = grpS)
modeRev      = input.bool(true,  "Trade REVERSALS (chain AGAINST the parent BREAKS structure)", group = grpS)
entryLvl     = input.int(3, "Chain must reach level >=", minval = 1, maxval = 5, group = grpS)
needAllAgree = input.bool(false, "Pullback needs all five rungs (L5 OK)", group = grpS)
exitFlip     = input.bool(true, "Exit when the parent flips", group = grpS)
skipDiv      = input.bool(true, "No pullback entries during a divergence warning", group = grpS)
revNeedDiv   = input.bool(false, "Reversal entries need a divergence warning", group = grpS)
hurstMin     = input.float(0.0, "Pullback needs Hurst >= (0 = off)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpS)
maxRiskAtr   = input.float(4.0,  "Skip the entry if risk > (x chart ATR)", minval = 0.5, step = 0.5, group = grpS)

grpE = "S2. Exits"
exitUnit     = input.string("ATR", "SL / TP / trail unit", options = ["Points", "ATR", "Structure"], group = grpE, tooltip = "Points: fixed distances in ticks (BTC tick 0.01 -> 30000 pts = $300). ATR: multiples of the chart-timeframe ATR. Structure: the Fractal rules - stop beyond the parent's key level (pullback) or the chain start (reversal), trailing with the key level.")
slPts        = input.int(30000, "Stop loss, pts (Points mode)", minval = 1, group = grpE, tooltip = "In ticks. 30000 x 0.01 = $300 on BTCUSD.")
tpPts        = input.int(60000, "Take profit, pts (Points mode)", minval = 1, group = grpE, tooltip = "In ticks. 60000 x 0.01 = $600 on BTCUSD.")
atrLenX      = input.int(14, "ATR length (ATR mode, chart timeframe)", minval = 1, group = grpE)
slAtr        = input.float(1.5, "Stop loss, ATR mult (ATR mode)", minval = 0.1, step = 0.1, group = grpE)
tpR          = input.float(2.0, "Take profit, R multiple of SL (ATR & Structure modes)", minval = 0.5, step = 0.5, group = grpE)
stopBufAtr   = input.float(0.5, "Structure: stop buffer beyond the key level (x ATR)", minval = 0.0, step = 0.05, group = grpE)
revStopAtr   = input.float(1.5, "Structure: reversal stop beyond the chain start (x ATR)", minval = 0.1, step = 0.1, group = grpE)
useTrail     = input.bool(true, "Trailing stop", group = grpE, tooltip = "Points / ATR modes: activates after the profit below, then follows price at the distance below. Structure mode: the stop follows the parent's key level.")
trActPts     = input.int(25000, "Trail activation, pts of profit (Points mode)", minval = 0, group = grpE)
trDistPts    = input.int(10000, "Trail distance, pts (Points mode)", minval = 1, group = grpE)
trActAtr     = input.float(1.5, "Trail activation, ATR mult (ATR mode)", minval = 0.0, step = 0.1, group = grpE)
trDistAtr    = input.float(0.5, "Trail distance, ATR mult (ATR mode)", minval = 0.05, step = 0.05, group = grpE)
maxBars      = input.int(0, "Time stop, bars (0 = off)", minval = 0, group = grpE)

grpQ = "S3. Sizing"
qtyMode      = input.string("Risk %", "Quantity", options = ["Fixed", "Risk %"], group = grpQ)
qtyFixed     = input.float(0.05, "Fixed quantity (BTC)", minval = 0.0001, step = 0.001, group = grpQ)
riskPct      = input.float(1.0, "Risk % of equity per trade (Risk mode)", minval = 0.01, step = 0.1, group = grpQ, tooltip = "Quantity = equity x risk% / distance to the stop.")
qtyMax       = input.float(1.0, "Max quantity (BTC)", minval = 0.0001, step = 0.01, group = grpQ)
qtyStep      = input.float(0.001, "Quantity step (rounds down)", minval = 0.00001, step = 0.001, group = grpQ)

tblSize = tblSizeIn == "Tiny" ? size.tiny : tblSizeIn == "Small" ? size.small : tblSizeIn == "Normal" ? size.normal : size.large

lineOn(int lvl) => lvl <= 1 ? lineL1 : lvl == 2 ? lineL2 : lvl == 3 ? lineL3 : lvl == 4 ? lineL4 : lineL5

fmtP(float p) => priceDec < 0 ? str.tostring(p, format.mintick) : priceDec == 0 ? str.tostring(p, "0") : str.tostring(p, "0." + str.repeat("0", priceDec))

fmtT(int t) => str.format_time(t, "yyyy-MM-dd HH:mm:ss", syminfo.timezone)

// ------------- LADDER -------------
niceTf(simple int s) =>
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? str.tostring(s / 60, "#") + "m" : s < 86400 ? str.tostring(s / 3600, "#") + "h" : s < 604800 ? "D" : s < 2592000 ? "W" : "M"

cs = timeframe.in_seconds()
q1 = timeframe.in_seconds(r1)
q2 = timeframe.in_seconds(r2)
q3 = timeframe.in_seconds(r3)
q4 = timeframe.in_seconds(r4)
q5 = timeframe.in_seconds(r5)
var array<int>    tfSec    = array.from(0, q1, q2, q3, q4, q5)
var array<string> rungName = array.from("", niceTf(q1), niceTf(q2), niceTf(q3), niceTf(q4), niceTf(q5))
tfOK = q1 < q2 and q2 < q3 and q3 < q4 and q4 < q5 and q5 < cs
// a rung that is not below the chart would break the lower-tf request; substitute the chart itself and disable
u1 = q1 < cs ? r1 : timeframe.period
u2 = q2 < cs ? r2 : timeframe.period
u3 = q3 < cs ? r3 : timeframe.period
u4 = q4 < cs ? r4 : timeframe.period
u5 = q5 < cs ? r5 : timeframe.period
horizonMs = horizonBars * q5 * 1000
structMs  = structWin * cs * 1000

// ------------- PARENT (chart timeframe structure) -------------
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
var float lastPH = na
var float lastPL = na
var int   parentDir = 0          // +1 up, -1 down, 0 none yet
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl
if parentDir != 1 and not na(lastPH) and close > lastPH
    parentDir := 1
if parentDir != -1 and not na(lastPL) and close < lastPL
    parentDir := -1
// the structure that must give way for the parent to die
float parentKey = parentDir > 0 ? lastPL : parentDir < 0 ? lastPH : na

// ------------- HURST (rescaled range, 4 window sizes) -------------
hurst(int N) =>
    float h = na
    if bar_index >= N + 1
        array<float> ret = array.new_float()
        for i = N to 1
            array.push(ret, math.log(close[i - 1] / close[i]))
        array<float> lx = array.new_float()
        array<float> ly = array.new_float()
        for k = 0 to 3
            int m = int(N / math.pow(2, 3 - k))
            if m >= 8
                int   blocks = int(N / m)
                float rsSum  = 0.0
                int   cnt    = 0
                for b = 0 to blocks - 1
                    float mean = 0.0
                    for j = 0 to m - 1
                        mean += array.get(ret, b * m + j)
                    mean /= m
                    float cum = 0.0
                    float mx  = 0.0
                    float mn  = 0.0
                    float ss  = 0.0
                    for j = 0 to m - 1
                        float dev = array.get(ret, b * m + j) - mean
                        cum += dev
                        mx := math.max(mx, cum)
                        mn := math.min(mn, cum)
                        ss += dev * dev
                    float sd = math.sqrt(ss / m)
                    if sd > 0
                        rsSum += (mx - mn) / sd
                        cnt   += 1
                if cnt > 0
                    array.push(lx, math.log(m))
                    array.push(ly, math.log(rsSum / cnt))
        int n = array.size(lx)
        if n >= 2
            float mxx = array.avg(lx)
            float myy = array.avg(ly)
            float sxy = 0.0
            float sxx = 0.0
            for i = 0 to n - 1
                float dx = array.get(lx, i) - mxx
                sxy += dx * (array.get(ly, i) - myy)
                sxx += dx * dx
            if sxx > 0
                h := sxy / sxx
    h

float H = hurst(hurstLen)
string hurstTag = na(H) ? "-" : H > 0.55 ? "persistent" : H < 0.45 ? "mean-reverting" : "random"

// ------------- WEDGE (v0.7 detect, unchanged) -------------
wedge(bool wantRedWedge, bool isRed, bool isLime, int minW, int maxW, int ctx) =>
    int  wHi   = math.max(minW, maxW)
    bool fired = false
    int  wOut  = 0
    for w = minW to wHi
        if not fired
            bool ok = true
            for i = 0 to ctx - 1
                bool v = wantRedWedge ? isLime[i] : isRed[i]
                if not v
                    ok := false
            if ok
                for i = 0 to w - 1
                    bool v = wantRedWedge ? isRed[ctx + i] : isLime[ctx + i]
                    if not v
                        ok := false
            if ok
                for i = 0 to ctx - 1
                    bool v = wantRedWedge ? isLime[ctx + w + i] : isRed[ctx + w + i]
                    if not v
                        ok := false
            if ok
                fired := true
                wOut  := w
    [fired, wOut]

secToBars(int sec, int tfs, int lo) => math.max(lo, int(math.ceil(sec * 1.0 / tfs)))

// ------------- ENGINE (runs inside each lower-tf request) -------------
// Returns the close TIME and close PRICE of the latest BOT square and TOP square as of each intrabar.
engine() =>
    int  tfs    = timeframe.in_seconds()
    bool useSec = widthMode == "Seconds"
    int bMinW = useSec ? secToBars(botMinSec, tfs, 1) : botMinW
    int bMaxW = useSec ? math.max(bMinW, secToBars(botMaxSec, tfs, 1)) : botMaxW
    int bCtx  = useSec ? secToBars(botCtxSec, tfs, 1) : botCtx
    int tMinW = useSec ? secToBars(topMinSec, tfs, 1) : topMinW
    int tMaxW = useSec ? math.max(tMinW, secToBars(topMaxSec, tfs, 1)) : topMaxW
    int tCtx  = useSec ? secToBars(topCtxSec, tfs, 1) : topCtx
    int aLook = areaMode == "Seconds" ? secToBars(areaLookSec, tfs, 5) : areaLook

    float r    = ta.rsi(close, rsiLen)
    float fast = ta.sma(r, fastLen)
    float slow = ta.sma(r, slowLen)
    bool  isRed  = invertFill ? fast > slow : fast < slow
    bool  isLime = not isRed
    float hiW  = ta.highest(slow, aLook)
    float loW  = ta.lowest(slow, aLook)
    float rngW = hiW - loW
    float posW = rngW > 0 ? (slow - loW) / rngW : 0.5
    bool  inLow  = posW <= loFrac
    bool  inHigh = posW >= hiFrac

    [botRaw, botWid] = wedge(true,  isRed, isLime, bMinW, bMaxW, bCtx)
    [topRaw, topWid] = wedge(false, isRed, isLime, tMinW, tMaxW, tCtx)

    var int lastBotBar = -10000
    var int lastTopBar = -10000
    bool botOK = botRaw and (not botNeedLow  or inLow[bCtx])  and (bar_index - lastBotBar >= botSep)
    bool topOK = topRaw and (not topNeedHigh or inHigh[tCtx]) and (bar_index - lastTopBar >= topSep)

    var int   bSqK = na
    var int   tSqK = na
    var float bSqP = na
    var float tSqP = na
    if botOK
        lastBotBar := bar_index
        bSqK := time_close
        bSqP := close
    if topOK
        lastTopBar := bar_index
        tSqK := time_close
        tSqP := close
    [bSqK, tSqK, bSqP, tSqP]

[aB1, aT1, pB1, pT1] = request.security_lower_tf(syminfo.tickerid, u1, engine())
[aB2, aT2, pB2, pT2] = request.security_lower_tf(syminfo.tickerid, u2, engine())
[aB3, aT3, pB3, pT3] = request.security_lower_tf(syminfo.tickerid, u3, engine())
[aB4, aT4, pB4, pT4] = request.security_lower_tf(syminfo.tickerid, u4, engine())
[aB5, aT5, pB5, pT5] = request.security_lower_tf(syminfo.tickerid, u5, engine())
atr5 = request.security(syminfo.tickerid, u5, ta.atr(atrLen))

// ------------- EVENT STREAM -------------
// Every distinct new square time in this chart bar becomes an event (time, rung, price at that tick).
var array<int> seenB = array.new_int(6, na)
var array<int> seenT = array.new_int(6, na)
var array<int> lastB = array.new_int(6, na)   // latest square time per rung (for the table)
var array<int> lastT = array.new_int(6, na)

collect(array<int> a, array<float> p, array<int> evT, array<int> evR, array<float> evP, int rung, array<int> seen, array<int> latest) =>
    int last = array.get(seen, rung)
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            int v = array.get(a, i)
            if not na(v) and (na(last) or v > last)
                array.push(evT, v)
                array.push(evR, rung)
                array.push(evP, i < array.size(p) ? array.get(p, i) : close)
                last := v
    array.set(seen, rung, last)
    if not na(last)
        array.set(latest, rung, last)

// ------------- STATE -------------
// one object per chain. open=true while climbing; open=false while measuring (endT set)
type Chain
    int   dir
    int   t0            // exact tick time of the rung-1 square (START)
    int   lastT         // exact tick time of the latest rung that fired (END)
    int   deadline
    float p0            // price at the start tick
    float lastP         // price at the latest rung tick
    int   originBar
    int   bS            // open time of the chart candle holding the start tick
    int   bE            // open time of the chart candle holding the end tick
    array<float> rp     // price at each rung tick, index 1..5
    int   rel           // +1 with the parent, -1 against it, 0 no parent
    int   pDir          // parent direction at birth
    float keyLvl        // parent's key level at birth (na when rel == 0)
    int   level      = 1
    bool  open       = true
    bool  grace      = false
    bool  late       = false
    int   finalLevel = -1
    int   endT       = na
    int   sEndT      = na   // structure window end
    int   brk        = 0    // 0 pending, 1 key level broken, -1 held
    float mfe        = 0.0
    float mae        = 0.0
    float net        = na   // travel at the horizon end
    string verd      = ""   // verdict text once resolved
    label lb         = na   // growing start label
    label dotS       = na   // dot at start tick
    label lbE        = na   // end label
    label dotE       = na   // dot at end tick
    line  ln         = na   // link start -> end
    line  mkS        = na   // price marker across the start candle
    line  mkE        = na   // price marker across the end candle
    line  keyLn      = na   // parent key level

var array<Chain> chains = array.new<Chain>()

// signals raised during this bar (functions may mutate the object's fields)
type Sig
    int   dirPull = 0
    float keyPull = na
    int   lvlPull = 0
    int   dirRev  = 0
    float p0Rev   = na
    int   lvlRev  = 0
var Sig sig = Sig.new()

// stats by relation (with 0, against 1, range 2) x side x level 1..5
var array<int>   sN    = array.new_int(36, 0)
var array<float> sMfe  = array.new_float(36, 0.0)
var array<float> sMae  = array.new_float(36, 0.0)
var array<float> sNet  = array.new_float(36, 0.0)
var array<int>   sHit  = array.new_int(36, 0)
var array<int>   sLate = array.new_int(36, 0)
var array<int>   sBrk  = array.new_int(36, 0)   // key level broken inside the structure window
relIdx(int rel) => rel == 1 ? 0 : rel == -1 ? 1 : 2
sIdx(int dir, int lvl, int rel) => relIdx(rel) * 12 + (dir > 0 ? 0 : 6) + math.max(1, math.min(5, lvl))
relSel(int rel) => tblRel == "All" or (tblRel == "With parent" and rel == 1) or (tblRel == "Against parent" and rel == -1) or (tblRel == "Range" and rel == 0)

var array<float> reachB   = array.new_float()
var array<float> reachT   = array.new_float()
var array<float> reachAll = array.new_float()
pushReach(array<float> buf, float v) =>
    array.push(buf, v)
    if array.size(buf) > reachLen
        array.shift(buf)
reachOf(array<float> buf) => array.size(buf) > 0 ? array.avg(buf) : na

winMs(int rung)   => agreeBars * array.get(tfSec, rung) * 1000
graceMs(int rung) => graceBars * array.get(tfSec, rung) * 1000
tolMs(int rung)   => tolBars   * array.get(tfSec, rung) * 1000

// label size ladder, shifted up by the boost
// font size in points: base at L1, one step per rung; level 6 = the "all agree" bonus size
lvlSize(int lvl) => lblBase + (math.max(1, lvl) - 1) * lblStep

chainCol(int dir, int tr) => color.new(dir > 0 ? longCol : shortCol, tr)
chainTxt(int dir)         => dir > 0 ? longTxt : shortTxt

relTag(Chain c) => c.rel == 1 ? " [with]" : c.rel == -1 ? " [vs]" : ""
brkTag(Chain c) => c.brk == 0 ? "" : c.rel == -1 ? (c.brk == 1 ? " BREAK" : " HELD") : c.rel == 1 ? (c.brk == 1 ? " parent broke" : " parent held") : ""

// path text; with "every rung" on each rung carries its own tick price, otherwise the start price is appended
pathStr(Chain c) =>
    string s = ""
    for i = 1 to c.level
        s := s + (i > 1 ? " > " : "") + array.get(rungName, i)
        if showRungPx
            s := s + " " + fmtP(array.get(c.rp, i))
    (showRungPx ? s : s + "  " + fmtP(c.p0)) + relTag(c)

// full start-label text at any moment
lblText(Chain c) => pathStr(c) + c.verd + brkTag(c)

// horizontal marker across the chart candle (open time bt) at price px
newMark(int bt, float px, color col) =>
    line.new(bt, px, bt + cs * 1000, px, xloc = xloc.bar_time, color = col, width = markWidth, style = line.style_solid)

// start marker and key-level line follow the chain's current level and the per-level toggle
syncLines(Chain c, color col) =>
    bool on = lineOn(c.level)
    if showMark and on
        if na(c.mkS)
            c.mkS := newMark(c.bS, c.p0, col)
        line.set_color(c.mkS, col)
    else if not na(c.mkS)
        line old = c.mkS
        c.mkS := na
        line.delete(old)
    if showKey and on and not na(c.keyLvl)
        if na(c.keyLn)
            c.keyLn := line.new(c.t0, c.keyLvl, c.t0 + structMs + horizonMs, c.keyLvl, xloc = xloc.bar_time, color = col, width = 1, style = line.style_dotted)
        line.set_color(c.keyLn, col)
    else if not na(c.keyLn)
        line oldK = c.keyLn
        c.keyLn := na
        line.delete(oldK)
    c.keyLn

// remove every drawing a chain owns
dropDrawings(Chain c) =>
    if not na(c.lb)
        label.delete(c.lb)
    if not na(c.dotS)
        label.delete(c.dotS)
    if not na(c.lbE)
        label.delete(c.lbE)
    if not na(c.dotE)
        label.delete(c.dotE)
    if not na(c.ln)
        line.delete(c.ln)
    if not na(c.mkS)
        line.delete(c.mkS)
    if not na(c.mkE)
        line.delete(c.mkE)
    if not na(c.keyLn)
        line.delete(c.keyLn)
    c.lb    := na
    c.dotS  := na
    c.lbE   := na
    c.dotE  := na
    c.ln    := na
    c.mkS   := na
    c.mkE   := na
    c.keyLn := na

resolveChain(Chain c, bool allAgree, int verdictT) =>
    c.open  := false
    c.endT  := verdictT + horizonMs
    c.sEndT := verdictT + structMs
    pushReach(c.dir > 0 ? reachB : reachT, c.level)
    pushReach(reachAll, c.level)
    string verd  = allAgree ? " OK" : " X wall " + array.get(rungName, c.level + 1)
    string lateS = c.late ? " late" : ""
    c.verd := verd + lateS
    if c.level < minLabelLvl
        dropDrawings(c)
    if c.level >= minLabelLvl
        int    tr    = allAgree ? 0 : 55
        color  col   = chainCol(c.dir, tr)
        bool   lines = lineOn(c.level)
        if not na(c.lb)
            label.set_text(c.lb, lblText(c))
            label.set_color(c.lb, col)
            if allAgree
                label.set_size(c.lb, lvlSize(6))
        if not na(c.dotS)
            label.set_color(c.dotS, col)
        syncLines(c, col)
        // END drawings at the tick of the last rung that fired
        if c.level > 1 and not na(c.lastT)
            if showLink and lines
                c.ln := line.new(c.t0, c.p0, c.lastT, c.lastP, xloc = xloc.bar_time, color = col, width = allAgree ? 2 : 1, style = line.style_dashed)
            if showMark and lines
                c.mkE := newMark(c.bE, c.lastP, col)
            if showLabels
                if showDot
                    c.dotE := label.new(c.lastT, c.lastP, "", xloc = xloc.bar_time, style = label.style_circle, color = col, size = size.tiny, tooltip = "END L" + str.tostring(c.level) + " " + array.get(rungName, c.level) + "\nprice " + fmtP(c.lastP) + "\n" + fmtT(c.lastT))
                if showEnd
                    c.lbE := label.new(c.lastT, c.lastP, "END  L" + str.tostring(c.level) + c.verd + relTag(c) + "  " + fmtP(c.lastP), xloc = xloc.bar_time, style = label.style_label_left, color = col, textcolor = chainTxt(c.dir), size = allAgree ? lvlSize(6) : lvlSize(c.level))
    // PULLBACK signal: a sub-trend with the parent completed to the required level
    if c.rel == 1 and c.level >= entryLvl and (not needAllAgree or allAgree) and c.level >= sig.lvlPull
        sig.dirPull := c.dir
        sig.keyPull := c.keyLvl
        sig.lvlPull := c.level
    c.finalLevel := c.level

// structure outcome known: refresh the start label and the key line
markBreak(Chain c) =>
    if not na(c.lb)
        label.set_text(c.lb, lblText(c))
    if not na(c.keyLn)
        line.set_width(c.keyLn, c.brk == 1 ? 2 : 1)
        line.set_style(c.keyLn, c.brk == 1 ? line.style_solid : line.style_dotted)
    c.brk

// close a chain if the clock `now` has passed its deadline (grace first)
expire(Chain c, int now) =>
    if c.open and now > c.deadline
        if graceBars > 0 and not c.grace
            c.grace    := true
            c.deadline := c.deadline + graceMs(c.level + 1)
        if c.open and now > c.deadline
            resolveChain(c, false, c.deadline)

openChain(int dir, int t, float px) =>
    if array.size(chains) >= maxChains
        bool evicted = false
        for j = 0 to array.size(chains) - 1
            Chain cj = array.get(chains, j)
            if not cj.open
                dropDrawings(cj)
                array.remove(chains, j)
                evicted := true
                break
        if not evicted
            Chain c0 = array.shift(chains)
            dropDrawings(c0)
    // relation to the parent trend at birth; no key level means no usable parent
    int   rel = na(parentKey) ? 0 : dir == parentDir ? 1 : -1
    float key = rel == 0 ? na : parentKey
    Chain c = Chain.new(dir = dir, t0 = t, lastT = t, deadline = t + winMs(2), p0 = px, lastP = px, originBar = bar_index, bS = time, bE = time, rp = array.new_float(6, na), rel = rel, pDir = rel == 0 ? 0 : parentDir, keyLvl = key)
    array.set(c.rp, 1, px)
    if showLabels
        // START: anchored at the exact tick, body to the LEFT, pointing right at it
        c.lb := label.new(t, px, lblText(c), xloc = xloc.bar_time, style = label.style_label_right, color = chainCol(dir, 70), textcolor = chainTxt(dir), size = lvlSize(1))
        if showDot
            c.dotS := label.new(t, px, "", xloc = xloc.bar_time, style = label.style_circle, color = chainCol(dir, 0), size = size.tiny, tooltip = "START " + array.get(rungName, 1) + (dir > 0 ? " BOT" : " TOP") + relTag(c) + "\nprice " + fmtP(px) + (na(key) ? "" : "\nparent key " + fmtP(key)) + "\n" + fmtT(t))
    syncLines(c, chainCol(dir, 40))
    array.push(chains, c)

// feed one event (time t, rung, price px) to every open chain of this side; rung 1 also opens a new chain
feed(int dir, int rung, int t, float px) =>
    int n = array.size(chains)
    if n > 0
        for i = 0 to n - 1
            Chain c = array.get(chains, i)
            if c.dir == dir and c.open
                expire(c, t)
                if c.open and rung == c.level + 1 and t >= c.lastT - tolMs(rung) and t <= c.deadline
                    if c.grace
                        c.late  := true
                        c.grace := false
                    c.level := rung
                    array.set(c.rp, rung, px)
                    if t >= c.lastT
                        c.bE := time
                    c.lastT := math.max(t, c.lastT)
                    c.lastP := px
                    if not na(c.lb)
                        label.set_text(c.lb, lblText(c))
                        label.set_size(c.lb, lvlSize(c.level))
                        label.set_color(c.lb, chainCol(c.dir, 70 - 14 * c.level))
                    syncLines(c, chainCol(c.dir, 40))
                    if c.level >= 5
                        resolveChain(c, true, t)
                    else
                        c.deadline := c.lastT + winMs(c.level + 1)
    if rung == 1
        openChain(dir, t, px)

// ------------- PER BAR (every update: live bar grows tick by tick) -------------
sig.dirPull := 0
sig.keyPull := na
sig.lvlPull := 0
sig.dirRev  := 0
sig.p0Rev   := na
sig.lvlRev  := 0
int nowT = barstate.isrealtime ? timenow : time_close
int botResolved = -1
int topResolved = -1

if tfOK
    array<int>   evT = array.new_int()
    array<int>   evR = array.new_int()
    array<float> evP = array.new_float()
    collect(aB1, pB1, evT, evR, evP, 1, seenB, lastB)
    collect(aB2, pB2, evT, evR, evP, 2, seenB, lastB)
    collect(aB3, pB3, evT, evR, evP, 3, seenB, lastB)
    collect(aB4, pB4, evT, evR, evP, 4, seenB, lastB)
    collect(aB5, pB5, evT, evR, evP, 5, seenB, lastB)
    if array.size(evT) > 0
        array<int> order = array.sort_indices(evT)
        for j = 0 to array.size(order) - 1
            int k = array.get(order, j)
            feed(1, array.get(evR, k), array.get(evT, k), array.get(evP, k))
    array.clear(evT)
    array.clear(evR)
    array.clear(evP)
    collect(aT1, pT1, evT, evR, evP, 1, seenT, lastT)
    collect(aT2, pT2, evT, evR, evP, 2, seenT, lastT)
    collect(aT3, pT3, evT, evR, evP, 3, seenT, lastT)
    collect(aT4, pT4, evT, evR, evP, 4, seenT, lastT)
    collect(aT5, pT5, evT, evR, evP, 5, seenT, lastT)
    if array.size(evT) > 0
        array<int> order2 = array.sort_indices(evT)
        for j = 0 to array.size(order2) - 1
            int k2 = array.get(order2, j)
            feed(-1, array.get(evR, k2), array.get(evT, k2), array.get(evP, k2))
    // end-of-update expiry for everything still open
    int n = array.size(chains)
    if n > 0
        for i = 0 to n - 1
            Chain c = array.get(chains, i)
            if c.open
                expire(c, nowT)
                if not c.open
                    if c.dir > 0
                        botResolved := math.max(botResolved, c.finalLevel)
                    else
                        topResolved := math.max(topResolved, c.finalLevel)

// measuring, on closed chart bars only
int  openB = 0
int  openT = 0
int  openWith    = 0
int  openAgainst = 0
bool breakVs     = false   // an AGAINST chain broke the parent's structure on this bar
bool breakWith   = false   // a WITH chain saw its parent break on this bar
if barstate.isconfirmed
    int n = array.size(chains)
    if n > 0
        for i = n - 1 to 0
            Chain c = array.get(chains, i)
            if not c.open
                if time < c.endT
                    c.mfe := math.max(c.mfe, c.dir > 0 ? high - c.p0 : c.p0 - low)
                    c.mae := math.max(c.mae, c.dir > 0 ? c.p0 - low  : high - c.p0)
                if na(c.net) and time_close >= c.endT
                    c.net := c.dir * (close - c.p0)
                // the structure test: did a bar close through the parent's key level?
                if c.rel != 0 and c.brk == 0
                    bool broke = c.pDir > 0 ? close < c.keyLvl : close > c.keyLvl
                    if broke
                        c.brk := 1
                        if c.rel == -1
                            breakVs := true
                        else
                            breakWith := true
                        // REVERSAL signal: the counter sub-trend broke the parent's structure
                        if c.rel == -1 and c.finalLevel >= entryLvl and c.finalLevel >= sig.lvlRev
                            sig.dirRev := c.dir
                            sig.p0Rev  := c.p0
                            sig.lvlRev := c.finalLevel
                        markBreak(c)
                    else if time_close >= c.sEndT
                        c.brk := -1
                        markBreak(c)
                bool structDone = c.rel == 0 or c.brk != 0
                if not na(c.net) and structDone
                    int   k   = sIdx(c.dir, c.finalLevel, c.rel)
                    float tgt = tgtAtr * atr5
                    array.set(sN,   k, array.get(sN,   k) + 1)
                    array.set(sMfe, k, array.get(sMfe, k) + c.mfe)
                    array.set(sMae, k, array.get(sMae, k) + c.mae)
                    array.set(sNet, k, array.get(sNet, k) + c.net)
                    if not na(tgt) and c.mfe >= tgt
                        array.set(sHit, k, array.get(sHit, k) + 1)
                    if c.late
                        array.set(sLate, k, array.get(sLate, k) + 1)
                    if c.brk == 1
                        array.set(sBrk, k, array.get(sBrk, k) + 1)
                    array.remove(chains, i)
if array.size(chains) > 0
    for i = 0 to array.size(chains) - 1
        Chain c = array.get(chains, i)
        if c.open
            if c.dir > 0
                openB += 1
            else
                openT += 1
            if c.rel == 1
                openWith += 1
            else if c.rel == -1
                openAgainst += 1

// divergence pressure: how many sub-trends are alive against the parent, smoothed
float pressure = ta.ema(openAgainst * 1.0, presLen)
bool  divergeWarn = pressure >= presWarn

// ------------- GHOST CANDLES -------------
gCol = color.new(close >= open ? ghostUp : ghostDn, ghostTr)
plotcandle(ghost ? open : na, ghost ? high : na, ghost ? low : na, ghost ? close : na, "Ghost candles", color = gCol, wickcolor = gCol, bordercolor = gCol)

// ------------- TABLE -------------
ageStr(int k, int now) => na(k) ? "-" : str.tostring(math.round((now - k) / 1000)) + "s ago"

// sums over the relations selected for the level rows
sumI(array<int> a, int dir, int L) =>
    int t = 0
    for rel = -1 to 1
        if relSel(rel)
            t += array.get(a, sIdx(dir, L, rel))
    t
sumF(array<float> a, int dir, int L) =>
    float t = 0.0
    for rel = -1 to 1
        if relSel(rel)
            t += array.get(a, sIdx(dir, L, rel))
    t

totalN(int dir) =>
    int t = 0
    for L = 1 to 5
        t += sumI(sN, dir, L)
    t

statStr(int dir, int L) =>
    int cnt = sumI(sN, dir, L)
    int tot = totalN(dir)
    cnt == 0 ? "-" : "n" + str.tostring(cnt) + " (" + str.tostring(math.round(100.0 * cnt / tot)) + "%) | MFE " + str.tostring(sumF(sMfe, dir, L) / cnt, "#.##") + " | MAE " + str.tostring(sumF(sMae, dir, L) / cnt, "#.##") + " | NET " + str.tostring(sumF(sNet, dir, L) / cnt, "#.##") + " | hit " + str.tostring(math.round(100.0 * sumI(sHit, dir, L) / cnt)) + "%" + (sumI(sLate, dir, L) > 0 ? " | late " + str.tostring(sumI(sLate, dir, L)) : "")

// one relation, all levels, one side
relStr(int dir, int rel) =>
    int   cnt = 0
    int   hit = 0
    int   brk = 0
    float net = 0.0
    int   hi  = 0
    for L = 1 to 5
        int k = sIdx(dir, L, rel)
        int n = array.get(sN, k)
        cnt += n
        hit += array.get(sHit, k)
        brk += array.get(sBrk, k)
        net += array.get(sNet, k)
        if L >= 3
            hi += n
    string word = rel == -1 ? "BREAK" : "parent broke"
    cnt == 0 ? "-" : "n" + str.tostring(cnt) + " | L3+ " + str.tostring(math.round(100.0 * hi / cnt)) + "% | hit " + str.tostring(math.round(100.0 * hit / cnt)) + "% | NET " + str.tostring(net / cnt, "#.##") + " | " + word + " " + str.tostring(math.round(100.0 * brk / cnt)) + "%"

reachStr(array<float> buf) =>
    float v = reachOf(buf)
    na(v) ? "-" : str.tostring(v, "#.##") + " / 5  (n" + str.tostring(array.size(buf)) + ")"

posStr = tblPos == "Top right" ? position.top_right : tblPos == "Middle right" ? position.middle_right : tblPos == "Bottom right" ? position.bottom_right : position.top_left
var table T = table.new(posStr, 3, 19, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))
cellBg = color.new(color.black, 15)

if showTable and barstate.islast
    table.cell(T, 0, 0, "XPW Look-Down Forest | chart " + niceTf(cs), text_color = color.white, bgcolor = color.new(color.blue, 40), text_size = tblSize)
    table.cell(T, 1, 0, tfOK ? "LONG / BOT (little red)" : "RUNGS MUST INCREASE", text_color = longTxt, bgcolor = tfOK ? longCol : color.new(color.red, 40), text_size = tblSize)
    table.cell(T, 2, 0, tfOK ? "SHORT / TOP (little lime)" : "and all be below the chart", text_color = shortTxt, bgcolor = tfOK ? shortCol : color.new(color.red, 40), text_size = tblSize)
    for i = 1 to 5
        table.cell(T, 0, i, "rung " + str.tostring(i) + " | " + array.get(rungName, i), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
        table.cell(T, 1, i, ageStr(array.get(lastB, i), nowT), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
        table.cell(T, 2, i, ageStr(array.get(lastT, i), nowT), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 0, 6, "open chains", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 1, 6, tfOK ? str.tostring(openB) : "disabled", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 2, 6, tfOK ? str.tostring(openT) : "disabled", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    float ra = reachOf(reachAll)
    table.cell(T, 0, 7, "reach | last " + str.tostring(reachLen) + " | all " + (na(ra) ? "-" : str.tostring(ra, "#.##")), text_color = color.white, bgcolor = color.new(color.purple, 40), text_size = tblSize)
    table.cell(T, 1, 7, reachStr(reachB), text_color = color.white, bgcolor = color.new(color.purple, 40), text_size = tblSize)
    table.cell(T, 2, 7, reachStr(reachT), text_color = color.white, bgcolor = color.new(color.purple, 40), text_size = tblSize)
    for L = 1 to 5
        table.cell(T, 0, 7 + L, (L == 5 ? "L5 | all agree" : "L" + str.tostring(L) + " | wall " + array.get(rungName, L + 1)) + (tblRel == "All" ? "" : " | " + tblRel), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
        table.cell(T, 1, 7 + L, statStr(1,  L), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
        table.cell(T, 2, 7 + L, statStr(-1, L), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 0, 13, "measure", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 1, 13, str.tostring(horizonBars) + " x " + array.get(rungName, 5) + " after verdict | grace " + str.tostring(graceBars), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 2, 13, "target " + str.tostring(tgtAtr, "#.#") + "xATR = " + str.tostring(tgtAtr * atr5, "#.##"), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    // --- fractal direction block ---
    color pCol = parentDir > 0 ? pUpCol : parentDir < 0 ? pDnCol : cellBg
    table.cell(T, 0, 14, "parent | " + (parentDir > 0 ? "UP" : parentDir < 0 ? "DOWN" : "none yet"), text_color = color.white, bgcolor = pCol, text_size = tblSize)
    table.cell(T, 1, 14, na(parentKey) ? "-" : (parentDir > 0 ? "last higher low " : "last lower high ") + fmtP(parentKey), text_color = color.white, bgcolor = pCol, text_size = tblSize)
    table.cell(T, 2, 14, "pivots " + str.tostring(pivLen) + " | structure window " + str.tostring(structWin) + " bars", text_color = color.white, bgcolor = pCol, text_size = tblSize)
    color dCol = divergeWarn ? color.new(color.orange, 30) : cellBg
    table.cell(T, 0, 15, "divergence pressure" + (divergeWarn ? " | WARNING" : ""), text_color = color.white, bgcolor = dCol, text_size = tblSize)
    table.cell(T, 1, 15, "open against " + str.tostring(openAgainst) + " | with " + str.tostring(openWith), text_color = color.white, bgcolor = dCol, text_size = tblSize)
    table.cell(T, 2, 15, "EMA" + str.tostring(presLen) + " " + str.tostring(pressure, "#.##") + " | warn >= " + str.tostring(presWarn, "#.#"), text_color = color.white, bgcolor = dCol, text_size = tblSize)
    color hCol = na(H) ? cellBg : H > 0.55 ? color.new(color.teal, 40) : H < 0.45 ? color.new(color.maroon, 40) : cellBg
    table.cell(T, 0, 16, "Hurst | R/S last " + str.tostring(hurstLen), text_color = color.white, bgcolor = hCol, text_size = tblSize)
    table.cell(T, 1, 16, na(H) ? "need " + str.tostring(hurstLen) + " bars" : str.tostring(H, "0.00") + "  " + hurstTag, text_color = color.white, bgcolor = hCol, text_size = tblSize)
    table.cell(T, 2, 16, "> 0.55 trust continuation | < 0.45 fade", text_color = color.white, bgcolor = hCol, text_size = tblSize)
    table.cell(T, 0, 17, "WITH parent (pullback)", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 1, 17, relStr(1,  1), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 2, 17, relStr(-1, 1), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 0, 18, "AGAINST parent (reversal)", text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 1, 18, relStr(1,  -1), text_color = color.white, bgcolor = cellBg, text_size = tblSize)
    table.cell(T, 2, 18, relStr(-1, -1), text_color = color.white, bgcolor = cellBg, text_size = tblSize)

plot(reachOf(reachAll), "Reach (all, last N)", display = display.data_window)
plot(reachOf(reachB),   "Reach BOT",           display = display.data_window)
plot(reachOf(reachT),   "Reach TOP",           display = display.data_window)
plot(openB, "Open BOT chains", display = display.data_window)
plot(openT, "Open TOP chains", display = display.data_window)
plot(botResolved, "BOT resolved level this update", display = display.data_window)
plot(topResolved, "TOP resolved level this update", display = display.data_window)
plot(parentDir,   "Parent direction", display = display.data_window)
plot(parentKey,   "Parent key level", display = display.data_window)
plot(openAgainst, "Open chains against parent", display = display.data_window)
plot(pressure,    "Divergence pressure", display = display.data_window)
plot(H,           "Hurst", display = display.data_window)

alertcondition(botResolved >= alertLvl, "XPW BOT chain reached level", "XPW Look-Down Forest: a BOT chain resolved at or above the alert level")
alertcondition(topResolved >= alertLvl, "XPW TOP chain reached level", "XPW Look-Down Forest: a TOP chain resolved at or above the alert level")
alertcondition(breakVs,   "XPW AGAINST chain BROKE parent", "XPW Look-Down Forest: a chain against the parent closed through its key level (BREAK)")
alertcondition(breakWith, "XPW parent broke under a WITH chain", "XPW Look-Down Forest: the parent's key level gave way while a pullback chain was being measured")
alertcondition(divergeWarn and not divergeWarn[1], "XPW divergence warning", "XPW Look-Down Forest: divergence pressure crossed the warning level")

// ------------- ORDERS (bar close) -------------
var float curStop  = na
var float curTp    = na
var float entryPx  = na
var int   entryBar = na
var bool  trailOn  = false
bool  flat    = strategy.position_size == 0
bool  hurstOK = hurstMin <= 0 or (not na(H) and H >= hurstMin)
float atrX    = ta.atr(atrLenX)          // chart-timeframe ATR for exits
float tick    = syminfo.mintick

// distances in price for the chosen unit
float slDist  = exitUnit == "Points" ? slPts * tick : slAtr * atrX
float trAct   = exitUnit == "Points" ? trActPts * tick : trActAtr * atrX
float trDist  = exitUnit == "Points" ? trDistPts * tick : trDistAtr * atrX

// candidate entry this bar
int    eDir  = 0
float  eStop = na
string eId   = ""
if modePull and sig.dirPull != 0 and hurstOK and not (skipDiv and divergeWarn)
    eDir  := sig.dirPull
    eStop := exitUnit == "Structure" ? (eDir > 0 ? sig.keyPull - stopBufAtr * atrX : sig.keyPull + stopBufAtr * atrX) : (eDir > 0 ? close - slDist : close + slDist)
    eId   := "pull"
if eDir == 0 and modeRev and sig.dirRev != 0 and (not revNeedDiv or divergeWarn)
    eDir  := sig.dirRev
    eStop := exitUnit == "Structure" ? (eDir > 0 ? sig.p0Rev - revStopAtr * atrX : sig.p0Rev + revStopAtr * atrX) : (eDir > 0 ? close - slDist : close + slDist)
    eId   := "rev"

// quantity
qtyFor(float risk) =>
    float q = qtyMode == "Fixed" ? qtyFixed : (strategy.equity * riskPct / 100.0) / risk
    q := math.min(q, qtyMax)
    q := math.floor(q / qtyStep) * qtyStep
    q

if eDir != 0 and flat and not na(atrX) and not na(eStop)
    float risk = eDir > 0 ? close - eStop : eStop - close
    if risk > 0 and risk <= maxRiskAtr * atrX
        float q = qtyFor(risk)
        if q > 0
            curStop  := eStop
            curTp    := exitUnit == "Points" ? (eDir > 0 ? close + tpPts * tick : close - tpPts * tick) : (eDir > 0 ? close + tpR * risk : close - tpR * risk)
            entryPx  := close
            entryBar := bar_index
            trailOn  := false
            strategy.entry(eId, eDir > 0 ? strategy.long : strategy.short, qty = q, comment = (eDir > 0 ? "L " : "S ") + eId + " L" + str.tostring(eId == "pull" ? sig.lvlPull : sig.lvlRev))
            strategy.exit("x", stop = curStop, limit = curTp)

// manage the open position
if not flat
    int pdir = strategy.position_size > 0 ? 1 : -1
    if useTrail
        if exitUnit == "Structure"
            if not na(parentKey) and parentDir == pdir
                float ns = pdir > 0 ? parentKey - stopBufAtr * atrX : parentKey + stopBufAtr * atrX
                if pdir > 0 ? ns > curStop : ns < curStop
                    curStop := ns
        else
            float profit = pdir > 0 ? high - entryPx : entryPx - low
            if profit >= trAct
                trailOn := true
            if trailOn
                float ns = pdir > 0 ? high - trDist : low + trDist
                if pdir > 0 ? ns > curStop : ns < curStop
                    curStop := ns
    strategy.exit("x", stop = curStop, limit = curTp)
    if exitFlip and parentDir == -pdir
        strategy.close_all(comment = "parent flipped")
    if maxBars > 0 and not na(entryBar) and bar_index - entryBar >= maxBars
        strategy.close_all(comment = "time stop")

plot(strategy.position_size != 0 ? curStop : na, "Stop", color = color.red,   style = plot.style_linebr, linewidth = 1)
plot(strategy.position_size != 0 ? curTp   : na, "Take profit", color = color.green, style = plot.style_linebr, linewidth = 1)
