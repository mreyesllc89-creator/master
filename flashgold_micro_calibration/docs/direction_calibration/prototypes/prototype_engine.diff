+def _lg_flush(lgi, lgf, nlog, rowi, rowf, stage, gap, last, cnt):
+    """[PLAN] append the pending decision row unless the decimation drops it. Returns (nlog, last_toff)."""
+    toff = rowi[LI_TOFF]
+    if stage == ST_MIXED and gap > 0 and last >= 0 and toff - last < gap:
+        return nlog, last
+    if nlog >= lgi.shape[0]:
+        cnt[C_LOG_DROPPED] += 1
+        return nlog, last
+    rowi[LI_STAGE] = stage
+    lgi[nlog, :] = rowi
+    lgf[nlog, :] = rowf
+    cnt[C_LOG_ROWS] += 1
+    return nlog + 1, toff
+
+
+@njit(cache=True, nogil=True)
+def _lg_micro_grid(T, B, A, i, t, rowi):
+    """[PLAN] tick index of the highest / lowest mid of the previous L ms (ticks [first >= t-L, i-1]), one backward pass."""
+    k = i - 1
+    hi = -1e18
+    lo = 1e18
+    hi_i = -1
+    lo_i = -1
+    for q in range(len(LG_MICRO_L)):
+        lim = t - LG_MICRO_L[q]
+        while k >= 0 and T[k] >= lim:
+            m = (B[k] + A[k]) * 0.5
+            if m > hi:
+                hi = m
+                hi_i = k
+            if m < lo:
+                lo = m
+                lo_i = k
+            k -= 1
+        rowi[LI_MHI + q] = hi_i
+        rowi[LI_MLO + q] = lo_i
+
+
+@njit(cache=True, nogil=True)
+def _lg_opp_grid(T, B, A, i, t, rowi):
+    """[PLAN] opposite-pressure inputs per window W: first tick of the window, tick of its lowest and highest mid (ticks [j, i])."""
+    k = i
+    hi = -1e18
+    lo = 1e18
+    hi_i = -1
+    lo_i = -1
+    for q in range(len(LG_OPP_W)):
+        lim = t - LG_OPP_W[q]
+        while k >= 0 and T[k] >= lim:
+            m = (B[k] + A[k]) * 0.5
+            if m > hi:
+                hi = m
+                hi_i = k
+            if m < lo:
+                lo = m
+                lo_i = k
+            k -= 1
+        rowi[LI_OREF + q] = k + 1
+        rowi[LI_OMIN + q] = lo_i
+        rowi[LI_OMAX + q] = hi_i
+
+
+@njit(cache=True, nogil=True)
+def _lg_drift(T, i, t, rowi):
+    """[PLAN] EntryPrior60Approved reference tick for several horizons (nearest tick to t - H within +-5 s, -1 = none)."""
+    for q in range(len(LG_DRIFT)):
+        target = t - LG_DRIFT[q]
+        lo_i = np.searchsorted(T[: i + 1], target - 5000)
+        hi_i = np.searchsorted(T[: i + 1], target + 5000, side="right")
+        best = -1
+        if hi_i > lo_i:
+            best = lo_i
+            bd = abs(T[lo_i] - target)
+            for k in range(lo_i + 1, hi_i):
+                d = abs(T[k] - target)
+                if d < bd:
+                    bd = d
+                    best = k
+        rowi[LI_DRIFT + q] = best
+
+
+@njit(cache=True, nogil=True)
+def _fg_z(t, bid, fg_micro, fg_interval, fg_warm, fg_wm, fg_minutes, fg_bars, fg_band, fg_against, fg_buy, fg_sell,
+          fg_time, fg_end, fg_li, fg_aat, fg_abar, fg_aprice, fg_adir, fg_aatr):
+    """[PLAN] FlashGoldAllowsEntry up to the gate verdict (the former inline block). Returns z (+1 BUY area, -1 SELL area,
+    0 none), fi (filter bar, -1 none) and fq (the armed-state bar, -1 none)."""
+    nfg = len(fg_time)
+    if fg_micro:
+        bucket = (t // fg_interval) * fg_interval
+        fi = np.searchsorted(fg_time, bucket)
+        if fi >= nfg or fg_time[fi] != bucket or fg_li[fi] < fg_warm:
+            fi = -1
+        bar_time = bucket
+        bar_end = bucket + fg_interval
+    else:
+        m1 = (t // 60000) * 60000
+        fi = np.searchsorted(fg_time, m1, side="right") - 1
+        bar_time = m1
+        bar_end = m1 + 60000
+    z = 0
+    fq = -1
+    if fi >= 0 and fg_li[fi] >= 1:
+        fq = fi - 1
+        clock = t
+        if bar_end - 1 < clock:
+            clock = bar_end - 1
+        if fg_end[fi] - 1 < clock:
+            clock = fg_end[fi] - 1
+        if clock < bar_time:
+            clock = bar_time
+        index = fg_li[fi] - 1 if clock == fg_end[fq] else fg_li[fi]
+        z = fg_gate(fg_aat[fq], fg_abar[fq], fg_aprice[fq], fg_adir[fq], fg_aatr[fq], clock, index, bid,
+                    fg_wm, fg_minutes, fg_bars, fg_band, fg_against, fg_buy, fg_sell)
+    return z, fi, fq
+
