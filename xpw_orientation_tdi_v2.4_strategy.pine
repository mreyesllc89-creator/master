//@version=6
// ============================================================================
//  XPW ORIENTATION TDI  -  v2.4 STRATEGY  -  trades the v2.4 event labels
// ----------------------------------------------------------------------------
//  This is the v2.4 indicator turned into a strategy. Calibration, ladder
//  logic, rung map, agreement gate and labels are the indicator's, line for
//  line. The only change to the indicator's own logic: an event is detected
//  whether or not labels are shown, so hiding labels never stops trading.
//
//  STRATEGY (group "Strategy")
//    Trade direction   Both / Long only (buy only) / Short only (sell only).
//    ENTER             "1st LEG ENTER LONGS" / "2nd LEG ENTER LONGS" buy,
//                      "... ENTER SHORTS" sell. Exactly the bars the labels
//                      print on, with the same agreement gate. Signals come
//                      from the chart rung "*" and, when "Also label the
//                      READ HERE rung" is on, from the "<<" rung as well.
//    EXIT              "exit once, then wait": END 1st LEG / END 2nd LEG
//                      closes the side that leg was on (upright = longs,
//                      inverted = shorts). Toggle with "Exit on END labels".
//    Opposite signal   Both: reverses. Long only / Short only: the opposite
//                      ENTER closes the position (toggle) but never opens one.
//    AGREE labels      Optional extra entries on "AGREE LONG/SHORT xN".
//    Trailing TP       Arms once price moves "activation" in your favour,
//                      then trails "offset" behind the best price.
//                      Units: ticks, price, or percent of entry.
//    Stop loss         Optional fixed stop, same units.
//    S3. Sizing        Fixed quantity, or Risk % of equity over the stop
//                      distance (needs the stop loss on), capped by Max
//                      quantity and rounded down to the step.
//  Orders are placed on the bar close where the label prints and fill on
//  the next bar's open (TradingView default).
//
//  DIRECTIONAL TIME FILTER (block "BEGIN/END DIRECTIONAL TIME FILTER")
//    A permission only. FlashGold v5's direction logic (inside the block)
//    opens a window on its signal bar: level = FlashGold entry price,
//    countdown in minutes or candles. In the window ENTER LONGS are taken
//    only above the level, ENTER SHORTS only below it; outside it no ENTER
//    is taken. Exits, trailing TP, stop loss and reversals are untouched.
//    "Enable filter" off = the strategy as before. Visuals on the price chart.
//
//  AGREEMENT (group "Agreement", off by default)
//    Every rung casts one vote from its own position and side:
//      LONG   a first / second / mid leg while upright,
//             or END FIRST LEG while inverted (the divergence flips it long)
//      SHORT  the same shapes while inverted,
//             or END FIRST LEG while upright (DIV SHORT ZONE)
//      none   STAIRCASE. "continue, no entry" disagrees with entering,
//             so it BREAKS a domino chain.
//      skip   no data, unreadable, or an inherited position (per input).
//             Transparent: it neither counts nor breaks the chain.
//    A label draws only when at least N rungs (2..10) agree with its side.
//      domino  = the rungs must agree in one unbroken chain that contains
//                the rung that fired. One rung after the next, top down.
//      fractal = any N agreeing rungs inside the scope, contiguous or not.
//                The same read repeating at different scales.
//    Scope = the whole ladder (default), the chart rung and every higher
//    rung, or the chart rung and every lower one. N is clamped to the rungs
//    in scope and the READ HERE row says so.
//    "AGREE LONG x5" / "AGREE SHORT x5" fires the instant the Nth rung
//    joins, so a signal that was gated at its own bar still shows up the
//    moment the ladder catches up (the domino effect). In domino mode that
//    chain has to run through the rung you read (READ HERE << if there is
//    one, else the chart rung *): the dominoes must reach the rung you act
//    on. The rung map gets an AGREE column with every rung's vote, and the
//    READ HERE row shows the long and short counts against the required N.
//
//  LABEL EVENTS (per rung: the chart rung "*" and the READ HERE rung "<<")
//    DIV SHORT ZONE / DIV LONG ZONE  the refusal at the extreme (divergence
//                                    on price). Upright ladder: price broke
//                                    the high, TDI refused -> SHORT zone.
//                                    Inverted: broke the low -> LONG zone.
//    END 1st LEG / END 2nd LEG       which leg the divergence closed.
//    exit once, then wait            attached to every END leg label.
//    1st LEG  ENTER LONGS/SHORTS     a first leg formed (own shape).
//    2nd LEG  ENTER LONGS/SHORTS     a second leg formed (own shape).
//    END 2nd LEG                     a second leg went into a staircase or
//                                    lost its shape into MID FIRST LEG.
//    look for LONGS/SHORTS,          optional (Labels > info), off by default.
//    continue, no entry
//  Long labels sit at the candle low, short labels at the candle high, both
//  pointing at the bar from the right, with the price in the text and a
//  short tick line at that price. Inherited positions never label.
//
//  v2.2 FIXES (kept)
//    D1. An INHERITED position no longer moves the orientation.
//    D2. baseDir comes from the highest rung whose direction is computed.
//    D3. READ HERE lands only on a rung with its OWN first or second leg.
//    D4. The trend SMA is computed on every bar.
//
//  HISTORY TEST 2026-09-19 (XAUUSD 1m May-Sep 2026): the ENTER verdict showed
//  NO SIGNAL on the 1 minute rung; every rung above it was underpowered. Read
//  the map for location. Do not trade the verdict column on its own.
// ============================================================================

strategy("XPW Orientation TDI v2.4 Strategy", shorttitle="XPW-OTDI4 S", overlay=false, max_labels_count=500, max_lines_count=500, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ---------------------------------------------------------------- INPUTS ----
rsiLen   = input.int(13,       "RSI length",            group="TDI core")
fastLen  = input.int(2,        "Fast line (RSI SMA)",   group="TDI core")
slowLen  = input.int(7,        "Signal line (RSI SMA)", group="TDI core")
bbLen    = input.int(34,       "Base line / bands",     group="TDI core")
bbMult   = input.float(1.6185, "Band width",            group="TDI core")

scaleWin = input.bool(true, "Scale window with rung", group="Structure", tooltip="ON: each rung measures about 4 of its parent's bars. OFF: flat window on every rung, as in v1.")
flatWin  = input.int(20, "Flat window (bars)", group="Structure", tooltip="Used on every rung when scaling is off.")
areaLen  = input.int(5, "Area window (bars)", group="Structure", tooltip="How many bars must hold together to count as an area rather than a spike.")
areaFrac = input.float(0.45, "Area compression max", group="Structure", tooltip="Area range / window range. At or below this = area. Above = V spike = illegible.")
trendLen = input.int(20, "Trend window (bars)", group="Structure", tooltip="Only used by the highest rung that has a computed direction.")

showTable = input.bool(true, "Show rung map", group="Display")
tblSize   = input.string("normal", "Table text size", options=["tiny","small","normal","large","huge"], group="Display", tooltip="Makes the whole table bigger or smaller.")
tblPos    = input.string("middle_right", "Table position", options=["top_right","middle_right","bottom_right","top_left","middle_left","bottom_left","top_center","bottom_center"], group="Display", tooltip="Where the table sits on the price chart.")

// LABELS
showLbl  = input.bool(true,  "Show event labels on price", group="Labels", tooltip="Display only. The strategy trades the events whether or not their labels are shown.")
lblRead  = input.bool(true,  "Also label the READ HERE rung", group="Labels", tooltip="Labels from the << rung are prefixed with its name, e.g. '1 Min:'. The strategy also trades the << rung's events only while this is on.")
lblInfo  = input.bool(false, "Info labels (look for / staircase)", group="Labels")
lblSizeS = input.string("normal", "Label size", options=["tiny","small","normal","large","huge"], group="Labels")
lblPrice = input.bool(true,  "Show price in label + price tick", group="Labels", tooltip="Adds the signal price to the label text and draws a short line at that price beside the candle.")
lblTick  = input.int(3, "Price tick length (bars)", minval=1, maxval=20, group="Labels")
cL1  = input.color(#00e676, "Long  - 1st leg",         group="Labels")
cL2  = input.color(#00897b, "Long  - 2nd leg",         group="Labels")
cS1  = input.color(#ff1744, "Short - 1st leg",         group="Labels")
cS2  = input.color(#ad1457, "Short - 2nd leg",         group="Labels")
cDL  = input.color(#76ff03, "Divergence LONG zone",    group="Labels")
cDS  = input.color(#ff9100, "Divergence SHORT zone",   group="Labels")
cEnd = input.color(#ffd600, "End of leg / exit once",  group="Labels")
cInf = input.color(#90a4ae, "Info (look for / stair)", group="Labels")

// AGREEMENT
agreeOn    = input.bool(false, "Require rung agreement", group="Agreement", tooltip="ON: a label draws only when at least N rungs agree with its side. OFF: every event labels, as in v2.3.")
agreeN     = input.int(3, "Rungs that must agree (N)", minval=2, maxval=10, group="Agreement")
agreeMode  = input.string("domino", "Agreement mode", options=["domino","fractal"], group="Agreement", tooltip="domino: N rungs in one unbroken chain that contains the rung that fired. fractal: any N agreeing rungs inside the scope, contiguous or not.")
agreeScope = input.string("whole ladder", "Scope", options=["whole ladder","chart rung and above","chart rung and below"], group="Agreement", tooltip="Which rungs may vote. 'chart rung and above' = the * rung and every higher timeframe. 'chart rung and below' = the * rung and every lower one. On a 1 Min chart 'below' is only the seconds rungs, so prefer the whole ladder or 'above'.")
agreeInh   = input.string("skip (transparent)", "Inherited rungs", options=["skip (transparent)","vote with parent","no vote (breaks chain)"], group="Agreement", tooltip="A rung with no shape of its own shows its parent's position '(inh)'. skip: it neither counts nor breaks a chain. vote with parent: it repeats the parent's vote (not independent evidence, so it inflates the count). no vote: it breaks a domino chain.")
agreeLbl   = input.bool(true, "Label the moment N rungs agree", group="Agreement", tooltip="Draws 'AGREE LONG xN' / 'AGREE SHORT xN' on the bar where the count first reaches N.")
cAgL = input.color(#00bfa5, "Agree LONG",  group="Agreement")
cAgS = input.color(#d500f9, "Agree SHORT", group="Agreement")

// STRATEGY
tradeDir   = input.string("Both", "Trade direction", options=["Both","Long only (buy only)","Short only (sell only)"], group="Strategy", tooltip="Long only: only ENTER LONGS labels open trades. Short only: only ENTER SHORTS labels open trades.")
exitOnEnd  = input.bool(true, "Exit on END labels (exit once, then wait)", group="Strategy", tooltip="END 1st LEG / END 2nd LEG closes the side that leg was on: upright rung = longs, inverted rung = shorts.")
oppCloses  = input.bool(true, "Opposite ENTER closes (one-side mode)", group="Strategy", tooltip="Long only / Short only: an ENTER label on the other side closes the open trade without opening a new one. In 'Both' an opposite ENTER always reverses.")
tradeAgree = input.bool(false, "Also enter on AGREE labels", group="Strategy", tooltip="Needs 'Require rung agreement' on. Enters on the bar 'AGREE LONG xN' / 'AGREE SHORT xN' fires.")
trailOn    = input.bool(true, "Use trailing take profit", group="Strategy")
trailUnit  = input.string("price", "Trail / stop units", options=["ticks","price","percent"], group="Strategy", tooltip="ticks = minimum price moves. price = raw price distance (e.g. 2.0 on XAUUSD = $2). percent = % of the entry price.")
trailAct   = input.float(2.0, "Trail activation", minval=0.0, step=0.1, group="Strategy", tooltip="Distance price must move in your favour before the trail arms.")
trailOff   = input.float(1.0, "Trail offset", minval=0.0, step=0.1, group="Strategy", tooltip="Distance the stop trails behind the best price once armed.")
slOn       = input.bool(false, "Use stop loss", group="Strategy")
slDist     = input.float(3.0, "Stop loss distance", minval=0.0, step=0.1, group="Strategy", tooltip="Same units as the trail.")

gS3 = "S3. Sizing"
QtyMode  = input.string("Fixed", "Quantity", options = ["Fixed", "Risk %"], group = gS3)
fixedQty = input.float(10, "Fixed quantity (contracts = oz, 100 = 1 lot)", minval = 0.0, group = gS3)
riskPct  = input.float(1.0, "Risk % of equity per trade (Risk mode)", minval = 0.0, step = 0.25, group = gS3, tooltip = "Quantity = equity x risk% / (stop distance x point value). Needs 'Use stop loss' on; otherwise the fixed quantity is used.")
maxQty   = input.float(50, "Max quantity", minval = 0.0, group = gS3)
qtyStep  = input.float(1, "Quantity step (rounds down)", minval = 0.000001, group = gS3)

// ======================= BEGIN DIRECTIONAL TIME FILTER =======================
// This strategy runs in its own pane, so the visuals go on the price chart.
DTF_FORCE_OVERLAY = true
// Set false when dtfValue is not a price (an oscillator), so the status box
// does not round the level to the symbol's tick.
DTF_LEVEL_IS_PRICE = true
GRP_DTF = "Directional time filter"
dtfOn        = input.bool(true, "Enable filter", group=GRP_DTF, tooltip="Off: every signal passes. On: closed at all times except the window a FlashGold signal opens (or ACTIVATE NOW / Start time): then buys are allowed only above the level, sells only below it.")
dtfArmNow    = input.bool(false, "ACTIVATE NOW", group=GRP_DTF, tooltip="Tick and press OK: the window opens at this moment and the level is the price at this moment. Start time and the manual levels are ignored. Untick + OK to disarm. While ticked, ANY settings change or chart reload activates it again at that moment and price (the status box shows what is armed). Not for alerts or for strategies linked through input.source: use Start time for those.")
dtfLvMode    = input.string("Actual price", "Level when activating", options=["Actual price", "Typed price"], group=GRP_DTF, tooltip="Actual price: ACTIVATE NOW captures the live price at that instant as the level. Typed price: the level is the number below.")
dtfTyped     = input.float(0, "Typed price", minval=0, group=GRP_DTF, tooltip="The level used by ACTIVATE NOW when 'Level when activating' is 'Typed price'. Buys allowed only above it, sells only below it.")
dtfStart     = input.time(timestamp("2030-01-01T00:00:00+0000"), "Start time", group=GRP_DTF, tooltip="Scheduled start, used when ACTIVATE NOW is off. Date and minute in the chart's time zone (the one on the time axis); add seconds below.")
dtfStartSec  = input.int(0, "+ seconds", minval=0, maxval=59, group=GRP_DTF, tooltip="Seconds added to Start time (useful on second charts).")
dtfDurUnit   = input.string("Minutes", "Countdown unit", options=["Minutes", "Candles"], group=GRP_DTF, tooltip="Minutes: the window stays open for the minutes below. Candles: the window stays open for the number of chart candles below, counted from the candle that armed it (1 = only that candle, whose order fills on the next one).")
dtfMinutes   = input.float(15, "Countdown (minutes)", minval=0, step=1, group=GRP_DTF, tooltip="Minutes the window stays open from the start. 0 = never expires. Bars are judged at their close, so a countdown shorter than one chart bar opens for at most one bar.")
dtfBars      = input.int(1, "Countdown (candles)", minval=1, group=GRP_DTF, tooltip="Chart candles the window stays open, counted from the candle that armed it.")
dtfRef       = input.source(close, "Actual price", group=GRP_DTF, tooltip="The actual price: 'Close' is the last traded price of the current bar (it moves with every tick). ACTIVATE NOW captures this value as the level, and it is compared to the level while the window is open. The dropdown names are TradingView's; leave it on Close unless you want another series.")
dtfBuyLevel  = input.float(50, "Buy only above (manual)", group=GRP_DTF, tooltip="Manual buy level, used when ACTIVATE NOW is off. Buys are allowed only while price is above it.")
dtfSellLevel = input.float(50, "Sell only below (manual)", group=GRP_DTF, tooltip="Manual sell level, used when ACTIVATE NOW is off. Sells are allowed only while price is below it.")
dtfAllowBuy  = input.bool(true, "Allow buys", inline="side", group=GRP_DTF, tooltip="Turn one side off completely inside the window.")
dtfAllowSell = input.bool(true, "Allow sells", inline="side", group=GRP_DTF)
dtfBefore    = input.string("Block", "Before start", options=["Block", "Pass"], group=GRP_DTF, tooltip="Block: nothing is allowed before the window opens. Pass: everything is allowed until the window opens.")
dtfShowBg    = input.bool(true, "Shade window", inline="vis", group=GRP_DTF)
dtfShowLv    = input.bool(true, "Draw level", inline="vis", group=GRP_DTF)
dtfShowTbl   = input.bool(true, "Status box", inline="vis", group=GRP_DTF, tooltip="Shown while the filter is enabled. Updates on each tick (once per bar inside a strategy) and freezes when the market is closed.")
dtfTblPos    = input.string("top_right", "Status box position", options=["top_right","middle_right","bottom_right","top_left","middle_left","bottom_left","top_center","bottom_center"], group=GRP_DTF)

// ---- Direction signal: arms the filter automatically ------------------------
GRP_SIG = "Direction signal (arms the filter)"
dtfSigOn    = input.bool(true, "Arm from signal", group=GRP_SIG, tooltip="On: every direction signal arms the filter: the window opens on the signal bar, the level is the signal price, and the countdown runs. Buys are then allowed only above that price, sells only below it. ACTIVATE NOW (if ticked) has priority; Start time is ignored.")
dtfSigSide  = input.string("Buy and sell signals", "Arm on", options=["Buy and sell signals", "Buy signals only", "Sell signals only"], group=GRP_SIG)
dtfSigRearm = input.bool(true, "New signal re-arms while open", group=GRP_SIG, tooltip="On: a new signal inside an open window restarts it at the new price and time. Off: signals are ignored until the countdown ends.")
dtfSigMark  = input.bool(true, "Mark signal bars", group=GRP_SIG)

dtfValue = dtfRef

// ===== SIGNAL LOGIC SLOT: FlashGold Continuation v5 direction =================
// The direction logic of "FlashGold Continuation v5 - TDI Trade Zone Filter"
// (© ghostsmartfire), as in the FlashGold v5 strategy: bid/ask model, TDI
// direction (RSI -> SMA fast / slow, fast rising = BUY), parent + six child
// zones alignment, burst gate, prior-drift filter, entry hold, one signal per
// bar. Orders, exits and sizing are NOT here: this only decides direction.
gCore = "FlashGold Core"
spreadPoints          = input.float(25.0, "Spread pts", minval = 0.0, step = 0.1, group = gCore, tooltip = "Full spread in points (mintick units). Half of it offsets bid and ask.")
entryDistPoints       = input.float(50.0, "Entry distance pts (Points unit)", minval = 0.0, step = 0.1, group = gCore)
entryHoldBars         = input.int(0, "Entry hold bars", minval = 0, group = gCore)
entryHoldMinFavPoints = input.float(5.0, "Hold min favorable pts (Points unit)", minval = 0.0, step = 0.1, group = gCore)
oneEntryPerBar        = input.bool(true, "One signal per bar", group = gCore)

gBurst = "Burst / Direction"
DistUnit         = input.string("ATR", "Burst / entry distance / hold unit", options = ["ATR", "Points"], group = gBurst, tooltip = "ATR: the three thresholds below are multiples of ATR(14) of the chart. Points: the point inputs in the Core group are used.")
burstAtrMult     = input.float(0.5, "Burst threshold, ATR mult (ATR unit)", minval = 0.0, step = 0.05, group = gBurst)
entryDistAtrMult = input.float(0.25, "Entry distance, ATR mult (ATR unit)", minval = 0.0, step = 0.05, group = gBurst)
holdFavAtrMult   = input.float(0.1, "Hold min favorable, ATR mult (ATR unit)", minval = 0.0, step = 0.05, group = gBurst)
burstPointsInput = input.float(172.0, "Burst threshold pts (Points unit)", minval = 0.0, step = 0.1, group = gBurst)
useBurstGate     = input.bool(true, "Require burst gate", group = gBurst)
useAnyCombo      = input.bool(false, "Allow any combo", group = gBurst, tooltip = "If on, TDI parent/zone can approve direction even when burst is weaker.")
priorDriftBars   = input.int(60, "Prior drift bars", minval = 1, group = gBurst)
usePriorFilter   = input.bool(false, "Use prior drift filter", group = gBurst)

gZone = "TDI Trade Zone Filter"
useTdiTradeZone = input.bool(true, "Use TDI trade-zone filter", group = gZone)
tdiParentTf     = input.timeframe("60", "Parent obedience timeframe", group = gZone, tooltip = "Calibrated with the parent = the chart timeframe. Leave it equal to the chart.")
tdiRsiLen       = input.int(14, "TDI RSI length", minval = 2, group = gZone)
tdiFastLen      = input.int(2, "TDI white fast length", minval = 1, group = gZone)
tdiSlowLen      = input.int(7, "TDI slow length", minval = 1, group = gZone)
minAlignedZones = input.int(2, "Minimum child zones aligned", minval = 0, maxval = 6, group = gZone)
allowNeutralParent = input.bool(false, "Allow trade if parent is flat", group = gZone)
ignoreNaZones   = input.bool(true, "Ignore zones without data", group = gZone, tooltip = "A child zone whose timeframe has no data on this bar is dropped from the active count instead of counting as MIX.")
htfNoRepaint    = input.bool(true, "Higher-TF zones use the last CLOSED bar", group = gZone, tooltip = "A child zone on a timeframe HIGHER than the chart is read from its last closed bar, so history and realtime agree.")
useZone1 = input.bool(true, "Use child zone 1", group = gZone)
zoneTf1  = input.timeframe("60", "Zone 1 timeframe", group = gZone)
useZone2 = input.bool(true, "Use child zone 2", group = gZone)
zoneTf2  = input.timeframe("120", "Zone 2 timeframe", group = gZone)
useZone3 = input.bool(true, "Use child zone 3", group = gZone)
zoneTf3  = input.timeframe("240", "Zone 3 timeframe", group = gZone)
useZone4 = input.bool(false, "Use child zone 4", group = gZone)
zoneTf4  = input.timeframe("480", "Zone 4 timeframe", group = gZone)
useZone5 = input.bool(false, "Use child zone 5", group = gZone)
zoneTf5  = input.timeframe("1", "Zone 5 timeframe", group = gZone)
useZone6 = input.bool(false, "Use child zone 6", group = gZone)
zoneTf6  = input.timeframe("2", "Zone 6 timeframe", group = gZone)

// price model
pt = syminfo.mintick
halfSpread = spreadPoints * pt * 0.5
bid = close - halfSpread
ask = close + halfSpread
midPrice = (bid + ask) * 0.5

// TDI direction
tdiDir() =>
    r = ta.rsi(close, tdiRsiLen)
    f = ta.sma(r, tdiFastLen)
    s = ta.sma(r, tdiSlowLen)
    d = f > f[1] ? 1 : f < f[1] ? -1 : 0
    [d, f, s]

tdiDirPrev() =>
    [d, f, s] = tdiDir()
    [d[1], f[1], s[1]]

isHigher(string tf) =>
    timeframe.in_seconds(tf) > timeframe.in_seconds(timeframe.period)

[parentDir, parentFast, parentSlow] = request.security(syminfo.tickerid, tdiParentTf, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z1Dir0, z1Fast, z1Slow] = request.security(syminfo.tickerid, zoneTf1, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z2Dir0, z2Fast, z2Slow] = request.security(syminfo.tickerid, zoneTf2, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z3Dir0, z3Fast, z3Slow] = request.security(syminfo.tickerid, zoneTf3, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z4Dir0, z4Fast, z4Slow] = request.security(syminfo.tickerid, zoneTf4, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z5Dir0, z5Fast, z5Slow] = request.security(syminfo.tickerid, zoneTf5, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z6Dir0, z6Fast, z6Slow] = request.security(syminfo.tickerid, zoneTf6, tdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
[z1DirP, z1FastP, z1SlowP] = request.security(syminfo.tickerid, zoneTf1, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
[z2DirP, z2FastP, z2SlowP] = request.security(syminfo.tickerid, zoneTf2, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
[z3DirP, z3FastP, z3SlowP] = request.security(syminfo.tickerid, zoneTf3, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
[z4DirP, z4FastP, z4SlowP] = request.security(syminfo.tickerid, zoneTf4, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
[z5DirP, z5FastP, z5SlowP] = request.security(syminfo.tickerid, zoneTf5, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
[z6DirP, z6FastP, z6SlowP] = request.security(syminfo.tickerid, zoneTf6, tdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
z1Dir = htfNoRepaint and isHigher(zoneTf1) ? z1DirP : z1Dir0
z2Dir = htfNoRepaint and isHigher(zoneTf2) ? z2DirP : z2Dir0
z3Dir = htfNoRepaint and isHigher(zoneTf3) ? z3DirP : z3Dir0
z4Dir = htfNoRepaint and isHigher(zoneTf4) ? z4DirP : z4Dir0
z5Dir = htfNoRepaint and isHigher(zoneTf5) ? z5DirP : z5Dir0
z6Dir = htfNoRepaint and isHigher(zoneTf6) ? z6DirP : z6Dir0

zoneOn(bool use, int dir) =>
    use and (not ignoreNaZones or not na(dir))

on1 = zoneOn(useZone1, z1Dir)
on2 = zoneOn(useZone2, z2Dir)
on3 = zoneOn(useZone3, z3Dir)
on4 = zoneOn(useZone4, z4Dir)
on5 = zoneOn(useZone5, z5Dir)
on6 = zoneOn(useZone6, z6Dir)

activeZones = (on1 ? 1 : 0) + (on2 ? 1 : 0) + (on3 ? 1 : 0) + (on4 ? 1 : 0) + (on5 ? 1 : 0) + (on6 ? 1 : 0)
parentSide = parentDir > 0 ? 1 : parentDir < 0 ? -1 : 0

alignCount(int dir, bool useZone) =>
    useZone and parentSide != 0 and dir == parentSide ? 1 : 0

alignedZones = alignCount(z1Dir, on1) + alignCount(z2Dir, on2) + alignCount(z3Dir, on3) + alignCount(z4Dir, on4) + alignCount(z5Dir, on5) + alignCount(z6Dir, on6)

requiredAligned = math.min(minAlignedZones, activeZones)
parentFlatAllowed = allowNeutralParent and parentSide == 0
zoneReady = activeZones == 0 or alignedZones >= requiredAligned

tradeZoneBuyAllowed = not useTdiTradeZone or ((parentSide == 1 or parentFlatAllowed) and zoneReady)
tradeZoneSellAllowed = not useTdiTradeZone or ((parentSide == -1 or parentFlatAllowed) and zoneReady)

// burst / prior drift
atrChart = ta.atr(14)
atrPts = atrChart / pt
burstThrPts   = DistUnit == "ATR" ? burstAtrMult * atrPts : burstPointsInput
entryDistPts  = DistUnit == "ATR" ? entryDistAtrMult * atrPts : entryDistPoints
holdFavPts    = DistUnit == "ATR" ? holdFavAtrMult * atrPts : entryHoldMinFavPoints

burstPts = (midPrice - midPrice[1]) / pt
priorDriftPts = (midPrice - midPrice[priorDriftBars]) / pt

burstBuy = burstPts >= burstThrPts
burstSell = burstPts <= -burstThrPts

priorBuyOk = not usePriorFilter or priorDriftPts > 0
priorSellOk = not usePriorFilter or priorDriftPts < 0

rawBuyCandidate = useAnyCombo ? (tradeZoneBuyAllowed and (not useBurstGate or burstBuy or parentSide == 1)) : (tradeZoneBuyAllowed and burstBuy)
rawSellCandidate = useAnyCombo ? (tradeZoneSellAllowed and (not useBurstGate or burstSell or parentSide == -1)) : (tradeZoneSellAllowed and burstSell)

buyCandidate = rawBuyCandidate and priorBuyOk
sellCandidate = rawSellCandidate and priorSellOk

// entry hold / virtual stop
var bool holdActive = false
var bool holdIsBuy = false
var int holdSignalBar = na
var float holdSignalMid = na
var int lastEntryBar = na

float buyEntryPrice = na
float sellEntryPrice = na
bool buySignal = false
bool sellSignal = false

canFire = not oneEntryPerBar or na(lastEntryBar) or lastEntryBar != bar_index

if buyCandidate and canFire
    if entryHoldBars == 0
        buyEntryPrice := ask + entryDistPts * pt
        buySignal := true
        lastEntryBar := bar_index
    else if not holdActive
        holdActive := true
        holdIsBuy := true
        holdSignalBar := bar_index
        holdSignalMid := midPrice
    else if holdIsBuy
        elapsedBars = bar_index - holdSignalBar
        holdMovePoints = (midPrice - holdSignalMid) / pt
        if elapsedBars >= entryHoldBars and holdMovePoints >= holdFavPts
            buyEntryPrice := ask + entryDistPts * pt
            buySignal := true
            lastEntryBar := bar_index
            holdActive := false

if sellCandidate and canFire
    if entryHoldBars == 0
        sellEntryPrice := bid - entryDistPts * pt
        sellSignal := true
        lastEntryBar := bar_index
    else if not holdActive
        holdActive := true
        holdIsBuy := false
        holdSignalBar := bar_index
        holdSignalMid := midPrice
    else if not holdIsBuy
        elapsedBars = bar_index - holdSignalBar
        holdMovePoints = (holdSignalMid - midPrice) / pt
        if elapsedBars >= entryHoldBars and holdMovePoints >= holdFavPts
            sellEntryPrice := bid - entryDistPts * pt
            sellSignal := true
            lastEntryBar := bar_index
            holdActive := false

if holdActive and ((holdIsBuy and not tradeZoneBuyAllowed) or (not holdIsBuy and not tradeZoneSellAllowed))
    holdActive := false
    holdSignalBar := na
    holdSignalMid := na

bool  dtfBuySignal  = buySignal
bool  dtfSellSignal = sellSignal
// The level is the strategy's entry trigger price (ask/bid +/- entry distance).
float dtfSignalPx   = buySignal ? buyEntryPrice : sellSignal ? sellEntryPrice : na
// ===== END SIGNAL LOGIC SLOT ==================================================

// ACTIVATE NOW capture: the moment and the price when the script (re)starts
// with the switch on. varip keeps it across live updates; a recompile (any
// settings change, chart reload) captures again.
varip int   dtfArmedAt  = na
varip float dtfArmedPx  = na
varip int   dtfArmedBar = na
// The capture waits for a tick where the price source has a value.
if dtfArmNow and barstate.islast and na(dtfArmedAt) and not na(dtfValue)
    dtfArmedAt  := timenow
    dtfArmedBar := bar_index
    dtfArmedPx := dtfLvMode == "Typed price" ? dtfTyped : dtfValue

// Signal arming: on a confirmed signal bar, the window starts at that bar's
// close with the level at the signal price. Committed state only (var), so
// backtests and live agree.
var int   dtfSigAt  = na
var int   dtfSigBar = na
var float dtfSigPx  = na
var int   dtfSigDir = 0
bool dtfByBars    = dtfDurUnit == "Candles"
int  dtfBarClose  = nz(time_close, time)
bool dtfPrevEnded = na(dtfSigAt) or (dtfByBars ? bar_index >= dtfSigBar + dtfBars : (dtfMinutes > 0 and dtfBarClose >= dtfSigAt + math.round(dtfMinutes * 60000)))
bool dtfSigFire   = dtfSigOn and barstate.isconfirmed and not na(dtfValue) and ((dtfBuySignal and dtfSigSide != "Sell signals only") or (dtfSellSignal and dtfSigSide != "Buy signals only")) and (dtfPrevEnded or dtfSigRearm)
if dtfSigFire
    dtfSigAt  := dtfBarClose
    dtfSigBar := bar_index
    dtfSigPx  := nz(dtfSignalPx, dtfValue)
    dtfSigDir := dtfBuySignal ? 1 : -1

// Clock. The committed value of a bar (history, and the closing update of the
// live bar) is judged at the bar's close time, so it never repaints. Intrabar
// ticks of the live bar use the real clock, so the window opens on the second.
dtfClock   = barstate.isconfirmed ? nz(time_close, time) : timenow
dtfStartAt = dtfArmNow ? dtfArmedAt : dtfSigOn ? dtfSigAt : dtfStart + dtfStartSec * 1000
dtfEnd     = not dtfByBars and dtfMinutes > 0 and not na(dtfStartAt) ? dtfStartAt + math.round(dtfMinutes * 60000) : na
dtfOneLv   = dtfArmNow or dtfSigOn
dtfBuyLv   = dtfArmNow ? dtfArmedPx : dtfSigOn ? dtfSigPx : dtfBuyLevel
dtfSellLv  = dtfArmNow ? dtfArmedPx : dtfSigOn ? dtfSigPx : dtfSellLevel

// Not armed yet (ACTIVATE NOW before the capture bar) counts as before start.
dtfBeforeStart = na(dtfStartAt) or dtfClock < dtfStartAt
// Candle mode: the window is the N candles from the one that armed it. For a
// scheduled start that is the first candle closing at or after Start time.
var int dtfTimeBar = na
if not dtfBeforeStart and na(dtfTimeBar)
    dtfTimeBar := bar_index
if dtfBeforeStart
    dtfTimeBar := na
int  dtfStartBar = dtfArmNow ? dtfArmedBar : dtfSigOn ? dtfSigBar : dtfTimeBar
int  dtfEndBar   = na(dtfStartBar) ? na : dtfStartBar + dtfBars
bool dtfInBars   = dtfByBars and not na(dtfEndBar) and bar_index < dtfEndBar
dtfOpen        = not dtfBeforeStart and (dtfByBars ? dtfInBars : (na(dtfEnd) or dtfClock < dtfEnd))
dtfAfterEnd    = dtfByBars ? (not dtfBeforeStart and not dtfInBars) : (not na(dtfEnd) and dtfClock >= dtfEnd)

// Final gates: is a buy / a sell ALLOWED on this bar? (Permission only.)
dtfBuyOk  = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowBuy  and dtfValue > dtfBuyLv)
dtfSellOk = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowSell and dtfValue < dtfSellLv)

// True on the first bar after the window has closed (chart marker / output).
dtfExpired = dtfOn and dtfAfterEnd and not dtfAfterEnd[1] and not barstate.isfirst

// A countdown shorter than one chart bar opens for at most one bar.
dtfTooShort = dtfOn and not dtfByBars and dtfMinutes > 0 and dtfMinutes * 60 < timeframe.in_seconds()

// ---- Visuals (optional: delete from here to END if you only want the gates)
dtfPosOf(string s) =>
    switch s
        "top_right"     => position.top_right
        "bottom_right"  => position.bottom_right
        "top_left"      => position.top_left
        "middle_left"   => position.middle_left
        "bottom_left"   => position.bottom_left
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        => position.middle_right

bgcolor(dtfShowBg and dtfOn and dtfOpen ? (dtfBuyOk and dtfSellOk ? color.new(color.yellow, 85) : dtfBuyOk ? color.new(color.green, 85) : dtfSellOk ? color.new(color.red, 85) : color.new(color.gray, 88)) : na, title="DTF window", force_overlay=DTF_FORCE_OVERLAY)
plotshape(dtfExpired, "DTF window ended", shape.xcross, location.top, color.orange, size=size.tiny, text="DTF end", textcolor=color.orange, force_overlay=DTF_FORCE_OVERLAY)
plotshape(dtfSigMark and dtfSigFire and dtfSigDir > 0, "DTF buy signal",  shape.triangleup,   location.belowbar, color.lime, size=size.tiny, force_overlay=DTF_FORCE_OVERLAY)
plotshape(dtfSigMark and dtfSigFire and dtfSigDir < 0, "DTF sell signal", shape.triangledown, location.abovebar, color.red,  size=size.tiny, force_overlay=DTF_FORCE_OVERLAY)

// Level lines as drawings (they do not stretch the price scale). Each window
// keeps its own line and a label at its start, so past windows stay readable.
// While waiting (manual / scheduled modes) the line previews the last 50 bars.
// Redrawn every bar so a host script's own drawings never garbage-collect the
// current one.
dtfActive = dtfOn and (dtfBeforeStart or dtfOpen) and not na(dtfBuyLv)
var line  dtfBuyLn    = na
var line  dtfSellLn   = na
var label dtfLbl      = na
var int   dtfOpenFrom = na
bool dtfNewWindow = dtfOpen and na(dtfOpenFrom)
if dtfNewWindow
    dtfOpenFrom := bar_index
    // a new window: leave the previous window's drawings in place
    dtfBuyLn  := na
    dtfSellLn := na
    dtfLbl    := na
if dtfShowLv and dtfActive
    int dtfX1 = math.max(0, math.max(bar_index - 9000, math.min(dtfOpen ? dtfOpenFrom : bar_index, bar_index - 50)))
    line.delete(dtfBuyLn)
    line.delete(dtfSellLn)
    if dtfOneLv
        color dtfLnCol = dtfSigOn and dtfSigDir > 0 ? color.lime : dtfSigOn and dtfSigDir < 0 ? color.red : color.white
        dtfBuyLn := line.new(dtfX1, dtfBuyLv, bar_index, dtfBuyLv, color=dtfLnCol, width=2, force_overlay=DTF_FORCE_OVERLAY)
    else
        dtfBuyLn  := line.new(dtfX1, dtfBuyLv,  bar_index, dtfBuyLv,  color=color.new(color.green, 0), width=2, force_overlay=DTF_FORCE_OVERLAY)
        dtfSellLn := line.new(dtfX1, dtfSellLv, bar_index, dtfSellLv, color=color.new(color.red, 0),   width=2, force_overlay=DTF_FORCE_OVERLAY)
    if dtfOpen and na(dtfLbl)
        string dtfWhat = dtfArmNow ? "NOW" : dtfSigOn ? (dtfSigDir > 0 ? "SIGNAL BUY" : "SIGNAL SELL") : "START"
        string dtfTxt  = dtfWhat + " @ " + str.tostring(dtfBuyLv, DTF_LEVEL_IS_PRICE ? format.mintick : "#.########") + (dtfByBars ? "\n" + str.tostring(dtfBars) + (dtfBars == 1 ? " candle" : " candles") : dtfMinutes > 0 ? "\n" + str.tostring(dtfMinutes, "#.#") + " min" : "\nno limit")
        color  dtfLbCol = dtfSigOn and dtfSigDir < 0 ? color.new(color.red, 20) : dtfSigOn and dtfSigDir > 0 ? color.new(color.lime, 20) : color.new(color.white, 20)
        dtfLbl := label.new(dtfOpenFrom, dtfBuyLv, dtfTxt, style=label.style_label_right, color=dtfLbCol, textcolor=color.black, size=size.small, force_overlay=DTF_FORCE_OVERLAY)
else if not dtfActive
    dtfOpenFrom := na

// Status box, judged by the real clock (display only; the gates never use it).
var table dtfTable = table.new(dtfPosOf(dtfTblPos), 2, 7, bgcolor=color.new(color.black, 20), border_width=1, force_overlay=DTF_FORCE_OVERLAY)
if dtfShowTbl and dtfOn and barstate.islast
    bool   dBefore = na(dtfStartAt) or timenow < dtfStartAt
    bool   dAfter  = dtfByBars ? (not dBefore and not dtfInBars) : (not na(dtfEnd) and timenow >= dtfEnd)
    bool   dOpen   = not dBefore and not dAfter
    bool   dBuy    = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowBuy  and dtfValue > dtfBuyLv)
    bool   dSell   = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowSell and dtfValue < dtfSellLv)
    string dMode   = dtfArmNow ? " (NOW)" : dtfSigOn ? (dtfSigDir > 0 ? " (SIGNAL BUY)" : dtfSigDir < 0 ? " (SIGNAL SELL)" : " (SIGNAL)") : ""
    string dState  = (dBefore ? (dtfTooShort ? "WAITING (< 1 bar)" : "WAITING") : dOpen ? "OPEN" : "ENDED") + dMode
    color  dCol    = dBefore ? color.yellow : dOpen ? color.lime : color.orange
    int    dSecs   = dOpen and not na(dtfEnd) ? math.max(0, math.floor((dtfEnd - timenow) / 1000.0)) : 0
    string dLeft   = dOpen and dtfByBars ? str.tostring(dtfEndBar - bar_index) + (dtfEndBar - bar_index == 1 ? " candle" : " candles") : dOpen and not na(dtfEnd) ? str.tostring(math.floor(dSecs / 60), "00") + ":" + str.tostring(dSecs % 60, "00") : dOpen ? "no limit" : "-"
    string dStart  = na(dtfStartAt) ? "-" : str.format_time(dtfStartAt, "MMM dd HH:mm:ss", syminfo.timezone)
    string dFmt    = DTF_LEVEL_IS_PRICE ? format.mintick : "#.########"
    table.cell(dtfTable, 0, 0, "DTF", text_color=color.white)
    table.cell(dtfTable, 1, 0, dState, text_color=dCol)
    table.cell(dtfTable, 0, 1, "Now (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 1, str.format_time(timenow, "MMM dd HH:mm:ss", syminfo.timezone), text_color=color.white)
    table.cell(dtfTable, 0, 2, "Start (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 2, dStart, text_color=dtfArmNow ? color.orange : dtfSigOn ? color.aqua : color.white)
    table.cell(dtfTable, 0, 3, "Countdown", text_color=color.white)
    table.cell(dtfTable, 1, 3, dLeft, text_color=color.white)
    table.cell(dtfTable, 0, 4, "Price now", text_color=color.white)
    table.cell(dtfTable, 1, 4, na(dtfValue) ? "-" : str.tostring(dtfValue, dFmt), text_color=color.white)
    table.cell(dtfTable, 0, 5, "Buy  > " + (na(dtfBuyLv)  ? "-" : str.tostring(dtfBuyLv,  dFmt)), text_color=color.white)
    table.cell(dtfTable, 1, 5, dBuy ? "ALLOWED" : "BLOCKED", text_color=dBuy ? color.lime : color.red)
    table.cell(dtfTable, 0, 6, "Sell < " + (na(dtfSellLv) ? "-" : str.tostring(dtfSellLv, dFmt)), text_color=color.white)
    table.cell(dtfTable, 1, 6, dSell ? "ALLOWED" : "BLOCKED", text_color=dSell ? color.lime : color.red)
// ======================== END DIRECTIONAL TIME FILTER ========================

// PER-RUNG WINDOWS. 4 parent bars expressed in this rung's bars, floor 12.
hM   = scaleWin ? 20 : flatWin
hW   = scaleWin ? 17 : flatWin
hD   = scaleWin ? 28 : flatWin
h4   = scaleWin ? 24 : flatWin
h1h  = scaleWin ? 16 : flatWin
h30  = scaleWin ? 12 : flatWin
h15  = scaleWin ? 12 : flatWin
h5   = scaleWin ? 12 : flatWin
h1   = scaleWin ? 20 : flatWin
hs30 = scaleWin ? 12 : flatWin
hs15 = scaleWin ? 12 : flatWin
hs5  = scaleWin ? 12 : flatWin
hs1  = scaleWin ? 20 : flatWin

// ------------------------------------------------------------- TDI CORE ----
tdiCore() =>
    r     = ta.rsi(close, rsiLen)
    fast  = ta.sma(r, fastLen)
    slow  = ta.sma(r, slowLen)
    basis = ta.sma(r, bbLen)
    dev   = bbMult * ta.stdev(r, bbLen)
    [r, fast, slow, basis, basis + dev, basis - dev]

// --------------------------------------------------------- RUNG MEASURE ----
// DIRECTION-BLIND. Shape carries no direction; the parent supplies it later.
rungState(simple int h) =>
    [_r, fast, _slow, basis, _up, _lo] = tdiCore()

    recentLow  = ta.lowest(low,   h)
    priorLow   = ta.lowest(low,   h)[h]
    recentHigh = ta.highest(high, h)
    priorHigh  = ta.highest(high, h)[h]
    fastLowR   = ta.lowest(fast,  h)
    fastLowP   = ta.lowest(fast,  h)[h]
    fastHighR  = ta.highest(fast, h)
    fastHighP  = ta.highest(fast, h)[h]

    brokeLow     = recentLow  < priorLow
    brokeHigh    = recentHigh > priorHigh
    tdiBrokeLow  = fastLowR   < fastLowP
    tdiBrokeHigh = fastHighR  > fastHighP

    refuseLow  = brokeLow  and not tdiBrokeLow
    refuseHigh = brokeHigh and not tdiBrokeHigh

    rngShort   = ta.highest(fast, areaLen) - ta.lowest(fast, areaLen)
    rngLong    = ta.highest(fast, h)       - ta.lowest(fast, h)
    compressed = rngLong > 0 and (rngShort / rngLong) <= areaFrac

    stairUp   = brokeHigh and tdiBrokeHigh and not refuseHigh
    stairDown = brokeLow  and tdiBrokeLow  and not refuseLow

    smaC    = ta.sma(close, trendLen)
    basisP  = basis[trendLen]
    dirUp   = basis > basisP and close > smaC
    dirDown = basis < basisP and close < smaC
    dir     = dirUp ? 1.0 : dirDown ? -1.0 : 0.0
    dirOk   = not na(basisP) and not na(smaC)

    [dir, refuseLow ? 1.0 : 0.0, refuseHigh ? 1.0 : 0.0, compressed ? 1.0 : 0.0, stairUp ? 1.0 : 0.0, stairDown ? 1.0 : 0.0, dirOk ? 1.0 : 0.0]

// ------------------------------------------------------------ RUNG FETCH ----
LA = barmerge.lookahead_off
[dM,  rlM,  rhM,  cM,  suM,  sdM,  okM ] = request.security(syminfo.tickerid, "M",   rungState(hM),   lookahead=LA)
[dW,  rlW,  rhW,  cW,  suW,  sdW,  okW ] = request.security(syminfo.tickerid, "W",   rungState(hW),   lookahead=LA)
[dD,  rlD,  rhD,  cD,  suD,  sdD,  okD ] = request.security(syminfo.tickerid, "D",   rungState(hD),   lookahead=LA)
[d4,  rl4,  rh4,  c4,  su4,  sd4,  ok4 ] = request.security(syminfo.tickerid, "240", rungState(h4),   lookahead=LA)
[d1h, rl1h, rh1h, c1h, su1h, sd1h, ok1h] = request.security(syminfo.tickerid, "60",  rungState(h1h),  lookahead=LA)
[d30, rl30, rh30, c30, su30, sd30, ok30] = request.security(syminfo.tickerid, "30",  rungState(h30),  lookahead=LA)
[d15, rl15, rh15, c15, su15, sd15, ok15] = request.security(syminfo.tickerid, "15",  rungState(h15),  lookahead=LA)
[d5,  rl5,  rh5,  c5,  su5,  sd5,  ok5 ] = request.security(syminfo.tickerid, "5",   rungState(h5),   lookahead=LA)
[d1,  rl1,  rh1,  c1,  su1,  sd1,  ok1 ] = request.security(syminfo.tickerid, "1",   rungState(h1),   lookahead=LA)
[e30, f30, g30, i30, j30, k30, n30] = request.security(syminfo.tickerid, "30S", rungState(hs30), lookahead=LA)
[e15, f15, g15, i15, j15, k15, n15] = request.security(syminfo.tickerid, "15S", rungState(hs15), lookahead=LA)
[e5,  f5,  g5,  i5,  j5,  k5,  n5 ] = request.security(syminfo.tickerid, "5S",  rungState(hs5),  lookahead=LA)
[e1,  f1,  g1,  i1,  j1,  k1,  n1 ] = request.security(syminfo.tickerid, "1S",  rungState(hs1),  lookahead=LA)

// ------------------------------------------------------------- ASSEMBLY ----
var array<string> tfName = array.from("1 Month","1 Week","1 Day","4 Hour","1 Hour","30 Min","15 Min","5 Min","1 Min","30 Sec","15 Sec","5 Sec","1 Sec")
var array<float>  tfSec  = array.from(2592000.,604800.,86400.,14400.,3600.,1800.,900.,300.,60.,30.,15.,5.,1.)

dirA = array.from(dM,  dW,  dD,  d4,  d1h,  d30,  d15,  d5,  d1,  e30, e15, e5, e1)
rlA  = array.from(rlM, rlW, rlD, rl4, rl1h, rl30, rl15, rl5, rl1, f30, f15, f5, f1)
rhA  = array.from(rhM, rhW, rhD, rh4, rh1h, rh30, rh15, rh5, rh1, g30, g15, g5, g1)
cA   = array.from(cM,  cW,  cD,  c4,  c1h,  c30,  c15,  c5,  c1,  i30, i15, i5, i1)
suA  = array.from(suM, suW, suD, su4, su1h, su30, su15, su5, su1, j30, j15, j5, j1)
sdA  = array.from(sdM, sdW, sdD, sd4, sd1h, sd30, sd15, sd5, sd1, k30, k15, k5, k1)
okA  = array.from(okM, okW, okD, ok4, ok1h, ok30, ok15, ok5, ok1, n30, n15, n5, n1)

var array<string> posA    = array.new_string(13, "UNAVAILABLE")
var array<string> shapeA  = array.new_string(13, "-")
var array<float>  orientA = array.new_float(13, 1.0)
var array<bool>   inhA    = array.new_bool(13, false)

// D2. The side comes from the highest rung whose direction is computed.
float baseDir = na
for i = 0 to 12
    if na(baseDir) and array.get(okA, i) == 1
        baseDir := array.get(dirA, i) >= 0 ? 1.0 : -1.0
baseDir := na(baseDir) ? 1.0 : baseDir
bool flip = false

for i = 0 to 12
    bool   avail = not na(array.get(rlA, i))
    float  o     = baseDir * (flip ? -1.0 : 1.0)
    array.set(orientA, i, o)

    bool refStart = o > 0 ? array.get(rlA, i) == 1 : array.get(rhA, i) == 1
    bool refEnd   = o > 0 ? array.get(rhA, i) == 1 : array.get(rlA, i) == 1
    bool stair    = o > 0 ? array.get(sdA, i) == 1 : array.get(suA, i) == 1
    bool area     = array.get(cA, i) == 1

    string shape = not avail ? "-" : stair ? "staircase" : refEnd ? "refusal hi" : refStart and area ? "refusal lo" : area ? "area" : "none"
    array.set(shapeA, i, shape)

    string pp  = i == 0 ? "" : array.get(posA, i - 1)
    bool   inh = false
    string pos = "UNAVAILABLE"

    if avail
        if stair
            pos := "STAIRCASE"
        else if refEnd
            pos := "END FIRST LEG"
        else if refStart and area
            pos := pp == "END FIRST LEG" or pp == "FIRST LEG" or pp == "MID FIRST LEG" ? "SECOND LEG" : "FIRST LEG"
        else if area
            pos := pp == "SECOND LEG" or pp == "MID SECOND LEG" ? "MID SECOND LEG" : pp == "STAIRCASE" ? "STAIRCASE" : "MID FIRST LEG"
        else
            inh := true
            pos := i == 0 or pp == "UNAVAILABLE" or pp == "UNREADABLE" ? "UNREADABLE" : pp

    array.set(posA, i, pos)
    array.set(inhA, i, inh)

    // D1. Only a rung's OWN shape hands a new side down.
    if pos == "END FIRST LEG" and not inh
        flip := not flip
    if pos == "FIRST LEG" and not inh
        flip := false

// --------------------------------------------------------- CHART ANCHOR ----
chartSec = timeframe.in_seconds(timeframe.period)
int chartIdx = 12
for i = 0 to 12
    if array.get(tfSec, i) >= chartSec
        chartIdx := i

// D3. READ HERE only lands on a rung with its OWN first or second leg.
int readAt = -1
for i = chartIdx to 12
    if readAt == -1
        string p = array.get(posA, i)
        if (p == "FIRST LEG" or p == "SECOND LEG") and not array.get(inhA, i)
            readAt := i

verdictOf(int i) =>
    string p    = array.get(posA, i)
    bool   inh  = array.get(inhA, i)
    string side = array.get(orientA, i) > 0 ? "LONGS" : "SHORTS"
    string v = switch
        p == "UNAVAILABLE"   => "no data"
        p == "UNREADABLE"    => "STAY OUT"
        inh                  => "no shape here"
        p == "STAIRCASE"     => "continue, no entry"
        p == "END FIRST LEG" => "exit once, then wait"
        p == "FIRST LEG"     => "ENTER " + side
        p == "SECOND LEG"    => "ENTER " + side
        => "look for " + side
    v

// ------------------------------------------------------------ AGREEMENT ----
// One vote per rung: +1 long, -1 short, 0 none (staircase), 9 skip.
// Skip is transparent: it neither counts toward N nor breaks a domino chain.
int VOTE_SKIP = 9
var array<int> voteA = array.new_int(13, 0)
for i = 0 to 12
    string p    = array.get(posA, i)
    bool   inh  = array.get(inhA, i)
    int    side = array.get(orientA, i) > 0 ? 1 : -1
    int v = VOTE_SKIP
    if p == "UNAVAILABLE" or p == "UNREADABLE"
        v := VOTE_SKIP
    else if inh and agreeInh == "skip (transparent)"
        v := VOTE_SKIP
    else if inh and agreeInh == "no vote (breaks chain)"
        v := 0
    else if inh
        // vote with parent: copy the parent's vote as already cast this bar.
        // Not recomputed from this rung's side: the rung under an own-shape
        // END FIRST LEG is already flipped, so recomputing would vote AGAINST
        // the parent. (i > 0 here: an inherited i == 0 is UNREADABLE above.)
        v := array.get(voteA, i - 1)
    else
        v := p == "FIRST LEG" or p == "SECOND LEG" or p == "MID FIRST LEG" or p == "MID SECOND LEG" ? side : p == "END FIRST LEG" ? -side : 0
    array.set(voteA, i, v)

int scopeLo   = agreeScope == "chart rung and below" ? chartIdx : 0
int scopeHi   = agreeScope == "chart rung and above" ? chartIdx : 12
int scopeSize = scopeHi - scopeLo + 1
// N can never exceed the rungs that may vote; the READ HERE row says so.
int needN     = math.min(agreeN, scopeSize)

// The unbroken chain of vote v that runs through rung i, stepping over skip
// votes and breaking on anything else. selfIn: count rung i as one of them
// regardless of its own vote (an event rung always counts itself).
// Both walks are clipped to the scope: a rung outside it is never counted
// and never breaks the chain (the READ HERE rung can sit below the scope
// when the scope is "chart rung and above").
chainThrough(int i, int v, bool selfIn) =>
    int n = selfIn ? 1 : 0
    int dnFrom = math.max(i + 1, scopeLo)
    if dnFrom <= scopeHi
        for j = dnFrom to scopeHi
            int vj = array.get(voteA, j)
            if vj == v
                n += 1
            else if vj != VOTE_SKIP
                break
    int upFrom = math.min(i - 1, scopeHi)
    if upFrom >= scopeLo
        for j = upFrom to scopeLo
            int vj = array.get(voteA, j)
            if vj == v
                n += 1
            else if vj != VOTE_SKIP
                break
    n

// How many rungs agree with vote v for an event on rung i. The event rung
// always counts as one, in both modes.
//   domino : the unbroken chain through rung i.
//   fractal: every agreeing rung inside the scope, contiguous or not.
agreeCount(int i, int v) =>
    int n = 0
    if v == 1 or v == -1
        if agreeMode == "fractal"
            n := 1
            for j = scopeLo to scopeHi
                if j != i and array.get(voteA, j) == v
                    n += 1
        else
            n := chainThrough(i, v, true)
    n

// The agreement one side has right now, for the AGREE label and the table.
//   fractal: the number of rungs on that side inside the scope.
//   domino : the chain that runs through the rung you read: READ HERE (<<)
//            when it exists, otherwise the chart rung (*). The same rung the
//            event gate uses, so the label and the table never disagree.
//            The dominoes have to reach that rung; a chain that stops above
//            it does not count. An anchor rung that skips is stepped through.
int anchor = readAt != -1 ? readAt : chartIdx
sideCount(int v) =>
    int n = 0
    if agreeMode == "fractal"
        for j = scopeLo to scopeHi
            if array.get(voteA, j) == v
                n += 1
    else
        int va = array.get(voteA, anchor)
        n := va == v ? chainThrough(anchor, v, true) : va == VOTE_SKIP ? chainThrough(anchor, v, false) : 0
    n

int longN  = sideCount(1)
int shortN = sideCount(-1)

// ---------------------------------------------------------------- LABELS ----
// Drawn on the price pane beside the candle. Long side = at the candle low,
// short side = at the candle high. A label fires the moment a rung's position
// CHANGES on the current bar, so history shows every instant it happened.
// Pine rolls back objects drawn on a live bar between ticks, so a state
// that flickers inside one bar leaves only the last label.
lsz = switch lblSizeS
    "tiny"   => size.tiny
    "small"  => size.small
    "large"  => size.large
    "huge"   => size.huge
    => size.normal

// The signal price is the candle extreme the shape formed on: the low for a
// long-side event, the high for a short-side event. The label sits at that
// price, pointing left at the candle, and a short line marks the level.
putLbl(string txt, color col, bool below) =>
    float px = below ? low : high
    string t = lblPrice ? txt + "\n@ " + str.tostring(px, format.mintick) : txt
    label.new(bar_index, px, t, xloc=xloc.bar_index, yloc=yloc.price, color=col, style=label.style_label_left, textcolor=color.black, size=lsz, force_overlay=true)
    if lblPrice
        line.new(bar_index - lblTick, px, bar_index + lblTick, px, xloc=xloc.bar_index, color=col, style=line.style_solid, width=2, force_overlay=true)

// Trade codes handed to the strategy, one per label event.
int SIG_NONE        = 0
int SIG_ENTER_LONG  = 1
int SIG_ENTER_SHORT = -1
int SIG_EXIT_LONG   = 2
int SIG_EXIT_SHORT  = -2

// Returns the rung's current position (the caller stores it as prev) and the
// trade code of the label that fired. The event fires on exactly the
// condition the indicator labels on; showLbl only decides whether it draws.
rungEvents(int i, string prev, string tag) =>
    string p    = array.get(posA, i)
    bool   inh  = array.get(inhA, i)
    bool   up   = array.get(orientA, i) > 0
    string side = up ? "LONGS" : "SHORTS"
    bool wasSecond = prev == "SECOND LEG" or prev == "MID SECOND LEG"
    // Agreement gate. The event's side is the rung's own vote. An END 2nd LEG
    // that rolled into a staircase has no vote, so it is judged on the side
    // the leg was on.
    int  v  = array.get(voteA, i)
    int  ev = v == 1 or v == -1 ? v : (up ? 1 : -1)
    int  n  = agreeOn ? agreeCount(i, ev) : 0
    bool ok = not agreeOn or n >= needN
    string ag = agreeOn ? "\n" + str.tostring(n) + " rungs agree" : ""
    int sig = SIG_NONE
    if ok and p != prev and not inh
        if p == "END FIRST LEG"
            // The divergence on price. Upright: broke the high, TDI refused -> short zone (top).
            // Inverted: broke the low, TDI refused -> long zone (bottom).
            // Exit once: the leg that ended was on this rung's side.
            sig := up ? SIG_EXIT_LONG : SIG_EXIT_SHORT
            if showLbl
                string zone = up ? "DIV SHORT ZONE" : "DIV LONG ZONE"
                string leg  = wasSecond ? "END 2nd LEG" : "END 1st LEG"
                putLbl(tag + zone + "\n" + leg + "\nexit once, then wait" + ag, up ? cDS : cDL, not up)
        else if p == "FIRST LEG"
            sig := up ? SIG_ENTER_LONG : SIG_ENTER_SHORT
            if showLbl
                putLbl(tag + "1st LEG\nENTER " + side + ag, up ? cL1 : cS1, up)
        else if p == "SECOND LEG"
            sig := up ? SIG_ENTER_LONG : SIG_ENTER_SHORT
            if showLbl
                putLbl(tag + "2nd LEG\nENTER " + side + ag, up ? cL2 : cS2, up)
        else if wasSecond and (p == "STAIRCASE" or p == "MID FIRST LEG")
            sig := up ? SIG_EXIT_LONG : SIG_EXIT_SHORT
            if showLbl
                putLbl(tag + "END 2nd LEG" + ag, cEnd, up)
        else if showLbl and lblInfo and p == "MID FIRST LEG"
            putLbl(tag + "look for " + side + ag, cInf, up)
        else if showLbl and lblInfo and p == "STAIRCASE"
            putLbl(tag + "continue, no entry" + ag, cInf, up)
    [p, sig]

var string prevChart  = ""
var string prevRead   = ""
var int    prevReadAt = -1

[pChart, sigChart] = rungEvents(chartIdx, prevChart, "")
prevChart := pChart
int sigRead = SIG_NONE
if lblRead and readAt != -1 and readAt != chartIdx
    string pr = readAt == prevReadAt ? prevRead : ""
    [pRead, sR] = rungEvents(readAt, pr, array.get(tfName, readAt) + ": ")
    prevRead := pRead
    sigRead  := sR
prevReadAt := readAt

// The domino effect: the bar where the Nth rung joins one side.
var int prevLongN  = 0
var int prevShortN = 0
bool agreeLongNow  = agreeOn and longN  >= needN and prevLongN  < needN
bool agreeShortNow = agreeOn and shortN >= needN and prevShortN < needN
if showLbl and agreeOn and agreeLbl
    if agreeLongNow
        putLbl("AGREE LONG x" + str.tostring(longN) + "\n" + agreeMode + ", need " + str.tostring(needN), cAgL, true)
    if agreeShortNow
        putLbl("AGREE SHORT x" + str.tostring(shortN) + "\n" + agreeMode + ", need " + str.tostring(needN), cAgS, false)
prevLongN  := longN
prevShortN := shortN

// -------------------------------------------------------------- STRATEGY ----
// Signals are the label events above, from the chart rung and (when its
// labels are on) the READ HERE rung. If the two rungs ask for opposite
// entries on the same bar, neither entry is taken.
bool longSig  = sigChart == SIG_ENTER_LONG  or sigRead == SIG_ENTER_LONG  or (tradeAgree and agreeLongNow)
bool shortSig = sigChart == SIG_ENTER_SHORT or sigRead == SIG_ENTER_SHORT or (tradeAgree and agreeShortNow)
bool exitL    = exitOnEnd and (sigChart == SIG_EXIT_LONG  or sigRead == SIG_EXIT_LONG)
bool exitS    = exitOnEnd and (sigChart == SIG_EXIT_SHORT or sigRead == SIG_EXIT_SHORT)
if longSig and shortSig
    longSig  := false
    shortSig := false

bool allowLong  = tradeDir != "Short only (sell only)"
bool allowShort = tradeDir != "Long only (buy only)"

// Directional time filter: an ENTER is taken only while its side is allowed.
bool goLong  = longSig  and allowLong  and dtfBuyOk
bool goShort = shortSig and allowShort and dtfSellOk
// One order per side per bar. An ENTER on the same bar as an END keeps the
// trade (same side) or reverses it (opposite side, via strategy.entry), so
// no separate close is sent then.
bool oppL   = oppCloses and shortSig and not allowShort
bool oppS   = oppCloses and longSig  and not allowLong
bool closeL = strategy.position_size > 0 and not goLong  and not goShort and (exitL or oppL)
bool closeS = strategy.position_size < 0 and not goShort and not goLong  and (exitS or oppS)

// Distances in ticks, measured from the entry (or this close while the entry
// is still pending, which is only used for the percent unit).
float refPx = strategy.position_size != 0 ? strategy.position_avg_price : close
toTicks(float d) =>
    trailUnit == "ticks" ? d : trailUnit == "price" ? d / syminfo.mintick : refPx * d / 100.0 / syminfo.mintick

float trPts = trailOn ? math.max(toTicks(trailAct), 0.0) : na
float trOff = trailOn ? math.max(toTicks(trailOff), 1.0) : na
float slPts = slOn    ? math.max(toTicks(slDist),   1.0) : na

// S3. Sizing: fixed, or risk % of equity over the stop distance (ticks).
calcQty(float slTicks) =>
    float q = fixedQty
    if QtyMode == "Risk %" and not na(slTicks) and slTicks > 0
        riskCash = strategy.equity * riskPct / 100.0
        stopCash = slTicks * syminfo.mintick * syminfo.pointvalue
        q := stopCash > 0 ? riskCash / stopCash : 0.0
    q := math.min(q, maxQty)
    q := math.floor(q / qtyStep + 1e-9) * qtyStep
    q
float entryQty = calcQty(slPts)

if closeL
    strategy.close("Long",  comment=exitL ? "exit once" : "opp ENTER")
if closeS
    strategy.close("Short", comment=exitS ? "exit once" : "opp ENTER")
if goLong and entryQty > 0
    strategy.entry("Long",  strategy.long,  qty=entryQty, comment="ENTER LONG")
if goShort and entryQty > 0
    strategy.entry("Short", strategy.short, qty=entryQty, comment="ENTER SHORT")

if trailOn or slOn
    if allowLong
        strategy.exit("Long X", from_entry="Long", trail_points=trPts, trail_offset=trOff, loss=slPts, comment_trailing="trail TP", comment_loss="SL")
    if allowShort
        strategy.exit("Short X", from_entry="Short", trail_points=trPts, trail_offset=trOff, loss=slPts, comment_trailing="trail TP", comment_loss="SL")

// ----------------------------------------------------------- CHART PANE ----
[_rNow, fastNow, slowNow, basisNow, upNow, loNow] = tdiCore()
chartOrient = array.get(orientA, chartIdx)
inv(v) => chartOrient > 0 ? v : 100.0 - v

plot(inv(fastNow),  "Fast",      color=color.new(#26c6da, 0), linewidth=2)
plot(inv(slowNow),  "Signal",    color=color.new(#ffa726, 0), linewidth=2)
plot(inv(basisNow), "Base line", color=color.new(#b0bec5, 0), linewidth=1)
pu = plot(inv(chartOrient > 0 ? upNow : loNow), "Band A", color=color.new(#546e7a, 40))
pl = plot(inv(chartOrient > 0 ? loNow : upNow), "Band B", color=color.new(#546e7a, 40))
fill(pu, pl, color=color.new(#546e7a, 92))
hline(50, "50", color=color.new(#78909c, 60), linestyle=hline.style_dotted)

// ---------------------------------------------------------------- TABLE ----
if showTable and barstate.islast
    tPos = switch tblPos
        "top_right"     => position.top_right
        "bottom_right"  => position.bottom_right
        "top_left"      => position.top_left
        "middle_left"   => position.middle_left
        "bottom_left"   => position.bottom_left
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        => position.middle_right
    var table t = table.new(tPos, 6, 15, border_width=1, force_overlay=true)
    int lastCol = agreeOn ? 5 : 4
    table.clear(t, 0, 0, lastCol, 14)
    sz = switch tblSize
        "tiny"  => size.tiny
        "small" => size.small
        "large" => size.large
        "huge"  => size.huge
        => size.normal
    hdr = color.new(#263238, 0)

    table.cell(t, 0, 0, "RUNG",     text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 1, 0, "ORIENT",   text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 2, 0, "SHAPE",    text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 3, 0, "POSITION", text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 4, 0, "VERDICT",  text_color=color.white, bgcolor=hdr, text_size=sz)
    if agreeOn
        table.cell(t, 5, 0, "AGREE", text_color=color.white, bgcolor=hdr, text_size=sz)

    for i = 0 to 12
        string p   = array.get(posA, i)
        bool   av  = p != "UNAVAILABLE"
        float  o   = array.get(orientA, i)
        bool   inh = array.get(inhA, i)
        string orS = not av ? "-" : (o > 0 ? "upright" : "INVERTED")
        string pS  = p + (inh and av ? " (inh)" : "")

        color bg = switch
            not av               => color.new(#37474f, 30)
            p == "SECOND LEG"    => color.new(#2e7d32, 20)
            p == "FIRST LEG"     => color.new(#2e7d32, 20)
            p == "END FIRST LEG" => color.new(#f9a825, 25)
            p == "STAIRCASE"     => color.new(#1565c0, 25)
            p == "UNREADABLE"    => color.new(#37474f, 30)
            => color.new(#455a64, 30)

        string mark = i == readAt ? "  <<" : (i == chartIdx ? "  *" : "")
        table.cell(t, 0, i + 1, array.get(tfName, i) + mark, text_color=color.white, bgcolor=bg, text_size=sz)
        table.cell(t, 1, i + 1, orS,                          text_color=color.white, bgcolor=bg, text_size=sz)
        table.cell(t, 2, i + 1, array.get(shapeA, i),         text_color=color.white, bgcolor=bg, text_size=sz)
        table.cell(t, 3, i + 1, pS,                           text_color=color.white, bgcolor=bg, text_size=sz)
        table.cell(t, 4, i + 1, verdictOf(i),                 text_color=color.white, bgcolor=bg, text_size=sz)
        if agreeOn
            int    vv   = array.get(voteA, i)
            bool   inSc = i >= scopeLo and i <= scopeHi
            string vS   = not inSc ? "out of scope" : vv == 1 ? "LONG" : vv == -1 ? "SHORT" : vv == 0 ? "none" : "skip"
            color  vbg  = not inSc ? color.new(#37474f, 30) : vv == 1 ? color.new(#1b5e20, 20) : vv == -1 ? color.new(#b71c1c, 20) : bg
            table.cell(t, 5, i + 1, vS, text_color=color.white, bgcolor=vbg, text_size=sz)

    string summary = readAt == -1 ? "nothing at or below " + array.get(tfName, chartIdx) + " - stay out" : array.get(tfName, readAt) + " - " + verdictOf(readAt)
    if agreeOn
        summary := summary + "  |  agree: LONG " + str.tostring(longN) + ", SHORT " + str.tostring(shortN) + " (need " + str.tostring(needN) + " of " + str.tostring(scopeSize) + " in scope, " + agreeMode + ")"
        if agreeN > scopeSize
            summary := summary + "  N " + str.tostring(agreeN) + " clamped to " + str.tostring(scopeSize)
    table.cell(t, 0, 14, "READ HERE", text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 1, 14, summary,     text_color=color.white, bgcolor=hdr, text_size=sz)
    table.merge_cells(t, 1, 14, lastCol, 14)
