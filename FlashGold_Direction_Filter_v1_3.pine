        3600 => array.from(0.025639073414926623, 0.03916769654733886, 0.002645754420693987, 0.008964596661018207, 0.04753476124379302, 0.19519413536425292, 1.0194529939620385, 1.250544204661583, 0.03265420933605991, 0.04255501408287477, 0.07337685821421094, 0.017912018107539868, 4.572350473772452e-05, 0.023701655272846574, 3.006267845556806e-05, 0.031110994289278694, 0.00010492332172602311)
        => array.from(0.025639073414926623, 0.03916769654733886, 0.002645754420693987, 0.008964596661018207, 0.04753476124379302, 0.19519413536425292, 1.0194529939620385, 1.250544204661583, 0.03265420933605991, 0.04255501408287477, 0.07337685821421094, 0.017912018107539868, 4.572350473772452e-05, 0.023701655272846574, 3.006267845556806e-05, 0.031110994289278694, 0.00010492332172602311)
fgvModelSd(int sec) =>
    switch sec
        300 => array.from(0.9215484861481988, 1.0148707628067108, 0.9999699672931722, 0.7428287101676778, 1.5548160818318304, 2.8672346610500203, 0.36800273936250955, 0.7719445013312931, 1.0075571571058963, 1.1945169235830977, 0.9997322524579442, 0.2128810141360795, 0.3137482677931758, 0.21715138996871833, 0.3157321116434854, 0.2239845628633155, 0.31736714287431594)
        900 => array.from(0.920174895214478, 0.9793052395469743, 0.999908584791319, 0.6864808727294801, 1.4368533685132419, 2.730987642046007, 0.33567969110405316, 0.8084210746030444, 0.9882710954170192, 1.1396564613295919, 0.9993814620365503, 0.22006634399833058, 0.3159062026102304, 0.22826385809619398, 0.3185059402016375, 0.23782811576051544, 0.32450306432680553)
        1800 => array.from(0.9190470333908592, 0.9795785209807892, 0.9997602212959644, 0.6746480869264027, 1.4179599934222318, 2.7480162046014085, 0.3426835467737998, 0.8269824832442365, 0.9938582125135946, 1.1381286421375696, 0.9996102397264018, 0.22821463925893012, 0.31844940562251994, 0.23777432912036592, 0.3245027665551082, 0.2490725392531204, 0.3299213934493546)
        3600 => array.from(0.9172145909589606, 0.97451247094647, 0.999996500985161, 0.6666718971187789, 1.4237547576490053, 2.8121526050110304, 0.3237921804134649, 0.855883260213135, 0.982795056426648, 1.0954353768385958, 0.9973042858991252, 0.23772361358066207, 0.3244007705334757, 0.2490022744250166, 0.32994660057205744, 0.2533067017610936, 0.3323376413540635)
        => array.from(0.9172145909589606, 0.97451247094647, 0.999996500985161, 0.6666718971187789, 1.4237547576490053, 2.8121526050110304, 0.3237921804134649, 0.855883260213135, 0.982795056426648, 1.0954353768385958, 0.9973042858991252, 0.23772361358066207, 0.3244007705334757, 0.2490022744250166, 0.32994660057205744, 0.2533067017610936, 0.3323376413540635)
fgvModelQlo(int sec) =>
    switch sec
        300 => -0.022431657596613527
        900 => -0.01380893547492774
        1800 => -0.009120472893690666
        3600 => 0.010181670398079984
        => 0.010181670398079984
fgvModelQhi(int sec) =>
    switch sec
        300 => 0.04486440495042973
        900 => 0.06433536707108466
        1800 => 0.07558599207607282
        3600 => 0.0826165017327217
        => 0.0826165017327217

// A model exists for 5m, 15m, 30m and 1H only; elsewhere the veto is not applied.
bool   fgvModel  = fgfTfSec == 300 or fgfTfSec == 900 or fgfTfSec == 1800 or fgfTfSec == 3600
bool   fgvActive = fgvOn and fgvModel
// The score's child timeframes: 2 x and 4 x the filter timeframe (the x2 / x4
// child zones of the calibration: 5m -> 10m / 20m, 15m -> 30m / 1H, 30m -> 1H /
// 2H, 1H -> 2H / 4H). Without a model the filter timeframe is read instead
// (a valid request whose result is not used).
string fgvTf2 = fgvModel ? str.tostring(math.round(fgfTfSec * 2 / 60.0)) : fgfTfEff
string fgvTf4 = fgvModel ? str.tostring(math.round(fgfTfSec * 4 / 60.0)) : fgfTfEff

// ===== FLASHGOLD SIGNAL =======================================================
// The strategy's signal logic, unchanged. It runs on the filter timeframe
// (ctxSec = its seconds, used where the strategy compared to the chart).

// TDI direction: fast line (SMA of RSI) rising = 1, falling = -1, flat = 0.
fgfTdiDir() =>
    float r = ta.rsi(close, fgfRsiLen)
    float f = ta.sma(r, fgfFastLen)
    f > f[1] ? 1 : f < f[1] ? -1 : 0

fgfTdiDirPrev() =>
    int d = fgfTdiDir()
    d[1]

// Direction of a child zone. A zone on a timeframe HIGHER than the one the
// signal runs on is read from its last closed bar (fgfHtfClosed).
fgfZoneDir(string tf, int ctxSec) =>
    int dNow  = request.security(syminfo.tickerid, tf, fgfTdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
    int dPrev = request.security(syminfo.tickerid, tf, fgfTdiDirPrev(), barmerge.gaps_off, barmerge.lookahead_on)
    fgfHtfClosed and timeframe.in_seconds(tf) > ctxSec ? dPrev : dNow

fgfZoneOn(bool use, int dir) =>
    use and (not fgfIgnoreNa or not na(dir))

fgfAlign(int dir, bool on, int side) =>
    on and side != 0 and dir == side ? 1 : 0

// Returns [buy signal, sell signal, signal (entry) price, parent side,
// aligned zones, active zones].
fgfSignal(int ctxSec) =>
    // price model
    float pt         = syminfo.mintick
    float halfSpread = fgfSpreadPts * pt * 0.5
    float bidPx      = close - halfSpread
    float askPx      = close + halfSpread
    float midPrice   = (bidPx + askPx) * 0.5

    // TDI trade zone
    int parentDir = request.security(syminfo.tickerid, fgfParentTf, fgfTdiDir(), barmerge.gaps_off, barmerge.lookahead_off)
    int z1Dir = fgfZoneDir(fgfZTf1, ctxSec)
    int z2Dir = fgfZoneDir(fgfZTf2, ctxSec)
    int z3Dir = fgfZoneDir(fgfZTf3, ctxSec)
    int z4Dir = fgfZoneDir(fgfZTf4, ctxSec)
    int z5Dir = fgfZoneDir(fgfZTf5, ctxSec)
    int z6Dir = fgfZoneDir(fgfZTf6, ctxSec)

    bool on1 = fgfZoneOn(fgfUseZ1, z1Dir)
    bool on2 = fgfZoneOn(fgfUseZ2, z2Dir)
    bool on3 = fgfZoneOn(fgfUseZ3, z3Dir)
    bool on4 = fgfZoneOn(fgfUseZ4, z4Dir)
    bool on5 = fgfZoneOn(fgfUseZ5, z5Dir)
    bool on6 = fgfZoneOn(fgfUseZ6, z6Dir)

    int activeZones  = (on1 ? 1 : 0) + (on2 ? 1 : 0) + (on3 ? 1 : 0) + (on4 ? 1 : 0) + (on5 ? 1 : 0) + (on6 ? 1 : 0)
    int parentSide   = parentDir > 0 ? 1 : parentDir < 0 ? -1 : 0
    int alignedZones = fgfAlign(z1Dir, on1, parentSide) + fgfAlign(z2Dir, on2, parentSide) + fgfAlign(z3Dir, on3, parentSide) + fgfAlign(z4Dir, on4, parentSide) + fgfAlign(z5Dir, on5, parentSide) + fgfAlign(z6Dir, on6, parentSide)

    int  requiredAligned   = math.min(fgfMinAligned, activeZones)
    bool parentFlatAllowed = fgfFlatParent and parentSide == 0
    bool zoneReady         = activeZones == 0 or alignedZones >= requiredAligned

    bool tradeZoneBuyAllowed  = not fgfUseZones or ((parentSide == 1 or parentFlatAllowed) and zoneReady)
    bool tradeZoneSellAllowed = not fgfUseZones or ((parentSide == -1 or parentFlatAllowed) and zoneReady)

    // burst / prior drift
    float atrPts       = ta.atr(14) / pt
    float burstThrPts  = fgfDistUnit == "ATR" ? fgfBurstAtr * atrPts : fgfBurstPts
    float entryDistPts = fgfDistUnit == "ATR" ? fgfEntryDistAtr * atrPts : fgfEntryDistPts
    float holdFavPts   = fgfDistUnit == "ATR" ? fgfHoldFavAtr * atrPts : fgfHoldFavPts

    float burstPts      = (midPrice - midPrice[1]) / pt
    float priorDriftPts = (midPrice - midPrice[fgfDriftBars]) / pt

    bool burstBuy  = burstPts >= burstThrPts
    bool burstSell = burstPts <= -burstThrPts

    bool priorBuyOk  = not fgfUseDrift or priorDriftPts > 0
    bool priorSellOk = not fgfUseDrift or priorDriftPts < 0

    bool rawBuyCandidate  = fgfAnyCombo ? (tradeZoneBuyAllowed and (not fgfUseBurst or burstBuy or parentSide == 1)) : (tradeZoneBuyAllowed and burstBuy)
    bool rawSellCandidate = fgfAnyCombo ? (tradeZoneSellAllowed and (not fgfUseBurst or burstSell or parentSide == -1)) : (tradeZoneSellAllowed and burstSell)

    bool buyCandidate  = rawBuyCandidate and priorBuyOk
    bool sellCandidate = rawSellCandidate and priorSellOk

    // entry hold / virtual stop
    var bool  holdActive    = false
    var bool  holdIsBuy     = false
    var int   holdSignalBar = na
    var float holdSignalMid = na
    var int   lastEntryBar  = na

    float buyEntryPrice  = na
    float sellEntryPrice = na
    bool  buySignal      = false
    bool  sellSignal     = false

    bool canFire = not fgfOnePerBar or na(lastEntryBar) or lastEntryBar != bar_index

    if buyCandidate and canFire
        if fgfHoldBars == 0
            buyEntryPrice := askPx + entryDistPts * pt
            buySignal     := true
            lastEntryBar  := bar_index
        else if not holdActive
            holdActive    := true
            holdIsBuy     := true
            holdSignalBar := bar_index
            holdSignalMid := midPrice
        else if holdIsBuy
            int   elapsedBars    = bar_index - holdSignalBar
            float holdMovePoints = (midPrice - holdSignalMid) / pt
            if elapsedBars >= fgfHoldBars and holdMovePoints >= holdFavPts
                buyEntryPrice := askPx + entryDistPts * pt
                buySignal     := true
                lastEntryBar  := bar_index
                holdActive    := false

    if sellCandidate and canFire
        if fgfHoldBars == 0
            sellEntryPrice := bidPx - entryDistPts * pt
            sellSignal     := true
            lastEntryBar   := bar_index
        else if not holdActive
            holdActive    := true
            holdIsBuy     := false
            holdSignalBar := bar_index
            holdSignalMid := midPrice
        else if not holdIsBuy
            int   elapsedBars    = bar_index - holdSignalBar
            float holdMovePoints = (holdSignalMid - midPrice) / pt
            if elapsedBars >= fgfHoldBars and holdMovePoints >= holdFavPts
                sellEntryPrice := bidPx - entryDistPts * pt
                sellSignal     := true
                lastEntryBar   := bar_index
                holdActive     := false

    if holdActive and ((holdIsBuy and not tradeZoneBuyAllowed) or (not holdIsBuy and not tradeZoneSellAllowed))
        holdActive    := false
        holdSignalBar := na
        holdSignalMid := na

    float signalPx = buySignal ? buyEntryPrice : sellSignal ? sellEntryPrice : na
    [buySignal, sellSignal, signalPx, parentSide, alignedZones, activeZones]
// ===== END FLASHGOLD SIGNAL ===================================================

// Arming, on the filter timeframe: a signal candle sets the level at its
// close. Committed state only (var), so backtests and live agree. aId counts
// the signals.
fgfArm(bool sBuy, bool sSell, float sPx, float sAtr) =>
    var int   aAt  = na
    var int   aBar = na
    var float aPx  = na
    var int   aDir = 0
    var int   aId  = 0
    var float aAtr = na
    if sBuy or sSell
        aAt  := nz(time_close, time)
        aBar := bar_index
        aPx  := fgfLvMode == "Entry price" ? nz(sPx, close) : close
        aDir := sBuy ? 1 : -1
        aId  += 1
        aAtr := sAtr
    [aAt, aBar, aPx, aDir, aId, aAtr]

// Direction score, on the filter timeframe: a rule's direction d at a candle
// is right h candles later when the close has moved that way. Returns the
// balanced share right (mean of the UP and DOWN shares; na until both
// exist) and the number of scored calls, over the window.
fgfHits(int d, int h) =>
    float mv   = close - close[h]
    int   pd   = nz(d[h])
    float upN  = pd == 1 and mv != 0 ? 1.0 : 0.0
    float upH  = pd == 1 and mv > 0 ? 1.0 : 0.0
    float dnN  = pd == -1 and mv != 0 ? 1.0 : 0.0
    float dnH  = pd == -1 and mv < 0 ? 1.0 : 0.0
    int   w    = math.max(fgsWin, 1)
    float wUpN = math.sum(upN, w)
    float wUpH = math.sum(upH, w)
    float wDnN = math.sum(dnN, w)
    float wDnH = math.sum(dnH, w)
    float cUpN = ta.cum(upN)
    float cUpH = ta.cum(upH)
    float cDnN = ta.cum(dnN)
    float cDnH = ta.cum(dnH)
    // (until the window is full: every candle so far)
    float sUpN = fgsWin > 0 and not na(wUpN) ? wUpN : cUpN
    float sUpH = fgsWin > 0 and not na(wUpH) ? wUpH : cUpH
    float sDnN = fgsWin > 0 and not na(wDnN) ? wDnN : cDnN
    float sDnH = fgsWin > 0 and not na(wDnH) ? wDnH : cDnH
    float acc  = sUpN > 0 and sDnN > 0 ? 0.5 * (sUpH / sUpN + sDnH / sDnN) : na
    [acc, sUpN + sDnN]

// The three rules at this filter candle's close, scored 1 and H candles later.
// (Level side: on the signal candle a close exactly AT the level counts as
// the signal's side, as the gate allows it there.)
fgfScore(float aPx, int aDir, int aBar) =>
    int dL = na(aPx) ? 0 : close > aPx ? 1 : close < aPx ? -1 : aBar == bar_index ? nz(aDir) : 0
    int dS = nz(aDir)
    int dR = -nz(aDir)
    [l1, ln] = fgfHits(dL, 1)
    [lh, lhn] = fgfHits(dL, fgsH)
    [s1, sn] = fgfHits(dS, 1)
    [sh, shn] = fgfHits(dS, fgsH)
    [r1, rn] = fgfHits(dR, 1)
    [rh, rhn] = fgfHits(dR, fgsH)
    [l1, lh, s1, sh, r1, rh, ln]

// ===== SCORE VETO (optional, off by default) ==================================
// The score's inputs are read from the filter's own state at the close of each
// filter candle, as the calibration computed them (VETO_PORT_CONTRACT.md).

// Fractal Direction Framework structure direction of this timeframe (the
// strategy's parent, direction only: pivots 5 / 3; a close through the
// protected higher low / lower high flips it).
fgvFdf() =>
    float ph    = ta.pivothigh(high, 5, 3)
    float pl    = ta.pivotlow(low, 5, 3)
    float loPiv = ta.lowest(low, 4)
    float hiPiv = ta.highest(high, 4)
    var float loSinceH = na
    var float hiSinceL = na
    loSinceH := na(loSinceH) ? low : math.min(loSinceH, low)
    hiSinceL := na(hiSinceL) ? high : math.max(hiSinceL, high)
    var float lastH = na
    var float lastL = na
    var int   dir   = 0
    var float protL = na
    var float protH = na
    if not na(ph)
        lastH    := ph
        loSinceH := loPiv
        if dir == -1 and (na(protH) or ph < protH)
            protH := ph
    if not na(pl)
        lastL    := pl
        hiSinceL := hiPiv
        if dir == 1 and (na(protL) or pl > protL)
            protL := pl
    if dir == 1 and not na(protL) and close < protL
        dir   := -1
        protH := na(hiSinceL) ? lastH : hiSinceL
        protL := na
    else if dir == -1 and not na(protH) and close > protH
        dir   := 1
        protL := na(loSinceH) ? lastL : loSinceH
        protH := na
    else if dir == 0
        if not na(lastH) and close > lastH
            dir   := 1
            protL := na(loSinceH) ? lastL : loSinceH
        else if not na(lastL) and close < lastL
            dir   := -1
            protH := na(hiSinceL) ? lastH : hiSinceL
    dir

// The TDI fast line (RSI 14 -> SMA 2) of a child timeframe: its last bar
// closed by the filter candle's open ([1] with lookahead_on) and the bar before.
fgvFastPrev() =>
    float f = ta.sma(ta.rsi(close, 14), 2)
    [f[1], f[2]]

// x / y as the calibration divides it (y = 0: the sign's limit; 0 / 0: na),
// clipped to [-lim, lim].
fgvDiv(float x, float y, float lim) =>
    float v = y == 0 ? (x > 0 ? lim : x < 0 ? -lim : na) : x / y
    na(v) ? na : math.max(-lim, math.min(lim, v))

// The cut-offs: the model's, moved away from (+) or toward (-) the middle by k
// x their gap; at k = -0.5 both meet in the middle. Returns [lower, upper].
fgvCuts(float qLo, float qHi, float k) =>
    float mid = (qLo + qHi) / 2
    float g   = qHi - qLo
    [math.min(qLo - k * g, mid), math.max(qHi + k * g, mid)]

// One row of the accuracy-vs-coverage table: the gate's side dZ alone (k na)
// or kept only while the score at cut-offs k agrees. Counted with one queue
// per row over the last fgsWin filter candles (0 = all history), so the
// permitted candles, the scored calls and the hits always cover the same
// candles. Returns [accuracy at the next candle (buys and sells averaged),
// scored calls, coverage, candles in the window].
fgvCurve(int dZ, float sc, bool rdy, float qLo, float qHi, float k) =>
    [lo, hi] = fgvCuts(qLo, qHi, nz(k))
    int a = na(k) ? dZ : not rdy ? 2 : sc > hi ? 1 : sc < lo ? -1 : 0
    int d = a == dZ ? dZ : 0
    // this close scores the previous close's permission: 1 up right, 2 up
    // wrong, 3 down right, 4 down wrong, 0 none (no permission, or no move)
    int   pd = nz(d[1])
    float mv = close - close[1]
    int   ev = pd == 1 and mv > 0 ? 1 : pd == 1 and mv < 0 ? 2 : pd == -1 and mv < 0 ? 3 : pd == -1 and mv > 0 ? 4 : 0
    int   on = d != 0 ? 1 : 0
    // running counts: [permitted candles, ev 1, ev 2, ev 3, ev 4]
    var array<int> cnt = array.new<int>(5, 0)
    var array<int> qEv = array.new<int>()
    var array<int> qOn = array.new<int>()
    array.set(cnt, 0, array.get(cnt, 0) + on)
    if ev > 0
        array.set(cnt, ev, array.get(cnt, ev) + 1)
    if fgsWin > 0
        array.push(qEv, ev)
        array.push(qOn, on)
        if array.size(qOn) > fgsWin
            int oEv = array.shift(qEv)
            array.set(cnt, 0, array.get(cnt, 0) - array.shift(qOn))
            if oEv > 0
                array.set(cnt, oEv, array.get(cnt, oEv) - 1)
    int   nC  = fgsWin > 0 ? array.size(qOn) : bar_index + 1
    int   uN  = array.get(cnt, 1) + array.get(cnt, 2)
    int   dN  = array.get(cnt, 3) + array.get(cnt, 4)
    float acc = uN > 0 and dN > 0 ? 0.5 * (float(array.get(cnt, 1)) / uN + float(array.get(cnt, 3)) / dN) : na
    [acc, float(uN + dN), nC > 0 ? float(array.get(cnt, 0)) / nC : na, float(nC)]

// The score at this filter candle's close. Returns [score (log-odds), answer
// (1 UP, -1 DOWN, 0 undecided or inputs missing), inputs ready (1 / 0), the
// 17 inputs]. Without a model for the timeframe: not ready.
fgvScore(float aPx, int aDir, int aBar, float aAtr, float fAtr) =>
    var float[] w  = fgvModelW(fgfTfSec)
    var float[] mu = fgvModelMu(fgfTfSec)
    var float[] sd = fgvModelSd(fgfTfSec)
    float qLo = fgvModelQlo(fgfTfSec)
    float qHi = fgvModelQhi(fgfTfSec)
    // 1-3: the zone at this close (the filter's rule: band edges rounded
    // outward to the tick, cleared by more than half a tick; with no band the
    // level alone, without the chart gate's "at the level on the signal
    // candle" exception, as the calibration), the distance from the level in
    // ATR(14) of the signal candle, the last signal's side
    float mt   = syminfo.mintick
    float band = fgfBandAtr * nz(aAtr)
    float up   = band > 0 ? math.ceil((aPx + band) / mt - 1e-9) * mt : aPx
    float dn   = band > 0 ? math.floor((aPx - band) / mt + 1e-9) * mt : aPx
    bool  inUp = band > 0 ? close > up + mt / 2 : close > aPx
    bool  inDn = band > 0 ? close < dn - mt / 2 : close < aPx
    float zone = na(aPx) ? 0 : inUp ? 1 : inDn ? -1 : 0
    float dist = na(aPx) or na(aAtr) or aAtr == 0 ? 0 : math.max(-5, math.min(5, (close - aPx) / aAtr))
    float side = aDir
    // 4-6: the 1 / 5 / 20-candle returns in ATR(14) of this candle
    float r1   = fgvDiv(close - close[1], fAtr, 10)
    float r5   = fgvDiv(close - close[5], fAtr, 10)
    float r20  = fgvDiv(close - close[20], fAtr, 10)
    // 7: volatility, ATR over its 100-candle average
    float atrM = ta.sma(fAtr, 100)
    float vol  = na(atrM) ? na : atrM == 0 ? (fAtr > 0 ? 5 : na) : math.max(0, math.min(5, fAtr / atrM))
    // 8: the signal's age, ln(1 + candles since the signal candle)
    float age  = na(aBar) ? na : math.log(1 + (bar_index - aBar))
    // 9-10: zone x volatility, distance x volatility
    float zv   = zone * vol
    float dv   = dist * vol
    // 11: the structure direction of this timeframe
    float fdir = fgvFdf()
    // 12-17: the TDI fast line's level (F - 50) / 50 and slope (F - F[1]) / 10
    // on this timeframe (this candle) and on 2 x and 4 x it (their last bar
    // closed by this candle's open)
    float f1   = ta.sma(ta.rsi(close, 14), 2)
    float fL1  = (f1 - 50) / 50
    float fS1  = (f1 - f1[1]) / 10
    [f2, f2p]  = request.security(syminfo.tickerid, fgvTf2, fgvFastPrev(), barmerge.gaps_off, barmerge.lookahead_on)
    [f4, f4p]  = request.security(syminfo.tickerid, fgvTf4, fgvFastPrev(), barmerge.gaps_off, barmerge.lookahead_on)
    float fL2  = (f2 - 50) / 50
    float fS2  = (f2 - f2p) / 10
    float fL4  = (f4 - 50) / 50
    float fS4  = (f4 - f4p) / 10
    bool  rdy  = fgvModel and not (na(dist) or na(r1) or na(r5) or na(r20) or na(vol) or na(age) or na(fL1) or na(fS1) or na(fL2) or na(fS2) or na(fL4) or na(fS4))
    // the standardised logit
    float z = array.get(w, 0)
    z += (zone - array.get(mu, 0)) / array.get(sd, 0) * array.get(w, 1)
    z += (dist - array.get(mu, 1)) / array.get(sd, 1) * array.get(w, 2)
    z += (side - array.get(mu, 2)) / array.get(sd, 2) * array.get(w, 3)
    z += (r1 - array.get(mu, 3)) / array.get(sd, 3) * array.get(w, 4)
    z += (r5 - array.get(mu, 4)) / array.get(sd, 4) * array.get(w, 5)
    z += (r20 - array.get(mu, 5)) / array.get(sd, 5) * array.get(w, 6)
    z += (vol - array.get(mu, 6)) / array.get(sd, 6) * array.get(w, 7)
    z += (age - array.get(mu, 7)) / array.get(sd, 7) * array.get(w, 8)
    z += (zv - array.get(mu, 8)) / array.get(sd, 8) * array.get(w, 9)
    z += (dv - array.get(mu, 9)) / array.get(sd, 9) * array.get(w, 10)
    z += (fdir - array.get(mu, 10)) / array.get(sd, 10) * array.get(w, 11)
    z += (fL1 - array.get(mu, 11)) / array.get(sd, 11) * array.get(w, 12)
    z += (fS1 - array.get(mu, 12)) / array.get(sd, 12) * array.get(w, 13)
    z += (fL2 - array.get(mu, 13)) / array.get(sd, 13) * array.get(w, 14)
    z += (fS2 - array.get(mu, 14)) / array.get(sd, 14) * array.get(w, 15)
    z += (fL4 - array.get(mu, 15)) / array.get(sd, 15) * array.get(w, 16)
    z += (fS4 - array.get(mu, 16)) / array.get(sd, 16) * array.get(w, 17)
    float sc  = rdy ? z : na
    [lo, hi]  = fgvCuts(qLo, qHi, fgvWiden)
    float ans = rdy ? (sc > hi ? 1 : sc < lo ? -1 : 0) : 0
    // accuracy vs coverage: the gate's side at this close (the zone with the
    // against / side switches), alone and with the veto at several cut-offs
    int dZ = zone == 1 and fgfAllowBuy and (fgfAgainst or side > 0) ? 1 : zone == -1 and fgfAllowSell and (fgfAgainst or side < 0) ? -1 : 0
    [k0a, k0n, k0c, k0s] = fgvCurve(dZ, sc, rdy, qLo, qHi, na)
    [k1a, k1n, k1c, k1s] = fgvCurve(dZ, sc, rdy, qLo, qHi, -0.5)
    [k2a, k2n, k2c, k2s] = fgvCurve(dZ, sc, rdy, qLo, qHi, 0.0)
    [k3a, k3n, k3c, k3s] = fgvCurve(dZ, sc, rdy, qLo, qHi, 0.5)
    [k4a, k4n, k4c, k4s] = fgvCurve(dZ, sc, rdy, qLo, qHi, 1.0)
    [k5a, k5n, k5c, k5s] = fgvCurve(dZ, sc, rdy, qLo, qHi, 2.0)
    [k6a, k6n, k6c, k6s] = fgvCurve(dZ, sc, rdy, qLo, qHi, fgvWiden)
    [sc, ans, rdy ? 1.0 : 0.0, zone, dist, side, r1, r5, r20, vol, age, zv, dv, fdir, fL1, fS1, fL2, fS2, fL4, fS4, k0a, k0n, k0c, k1a, k1n, k1c, k2a, k2n, k2c, k3a, k3n, k3c, k4a, k4n, k4c, k5a, k5n, k5c, k6a, k6n, k6c, k0s]

// The names of the settings that differ from the veto's calibration ("" = none).
fgvCalibDiff() =>
    string s = ""
    s += fgfBandAtr != 0.25 ? "band 0.25\n" : ""
    s += fgfLvMode != "Entry price" ? "level Entry price\n" : ""
    s += fgfLast != "Until next signal" ? "lasts until next signal\n" : ""
    s += not fgfAgainst ? "against on\n" : ""
    s += not fgfUseZones ? "TDI zones on\n" : ""
    s += timeframe.in_seconds(fgfParentTf) != fgfTfSec ? "parent = filter TF\n" : ""
    s += not (fgfUseZ1 and fgfUseZ2 and fgfUseZ3) or fgfUseZ4 or fgfUseZ5 or fgfUseZ6 ? "child zones 1-3 only\n" : ""
    s += fgfUseZ1 and timeframe.in_seconds(fgfZTf1) != fgfTfSec ? "zone 1 = filter TF\n" : ""
    s += fgfUseZ2 and timeframe.in_seconds(fgfZTf2) != fgfTfSec * 2 ? "zone 2 = 2 x filter TF\n" : ""
    s += fgfUseZ3 and timeframe.in_seconds(fgfZTf3) != fgfTfSec * 4 ? "zone 3 = 4 x filter TF\n" : ""
    s += fgfMinAligned != 2 ? "min aligned 2\n" : ""
    s += fgfFlatParent ? "flat parent off\n" : ""
    s += not fgfIgnoreNa ? "ignore no-data on\n" : ""
    s += not fgfHtfClosed ? "higher-TF closed on\n" : ""
    s += fgfRsiLen != 14 or fgfFastLen != 2 ? "RSI 14 / fast 2\n" : ""
    s += fgfSpreadPts != 25 ? "spread 25\n" : ""
    s += fgfDistUnit != "ATR" or fgfBurstAtr != 0.5 or fgfEntryDistAtr != 0.25 ? "burst 0.5 / entry 0.25 ATR\n" : ""
    s += fgfHoldBars != 0 ? "hold 0\n" : ""
    s += not fgfOnePerBar or not fgfUseBurst or fgfAnyCombo or fgfUseDrift ? "one per bar, burst on, any combo off, drift off\n" : ""
    str.length(s) > 0 ? str.substring(s, 0, str.length(s) - 1) : s
// ===== END SCORE VETO =========================================================

// Each filter candle sends its arm, its conditions, its index, open and close
// time, and the arm, conditions and close time of the candle before it. An
// arm is used only once the candle that made it has closed by this chart's
// clock, so the forming filter candle is never read and nothing repaints.
// Reverse-old-signal readout, on the filter timeframe: the call d made h
// candles ago is right when the close has moved its way since. Counts only
// calls made on or after fgrFrom. Returns [balanced accuracy (na until both
// sides have calls), calls, distinct signals behind them].
fgrHits(int d, int id, int h) =>
    float mv = close - close[h]
    int   pd = nz(d[h])
    bool  ok = pd != 0 and not na(time[h]) and time[h] >= fgrFrom and not na(mv) and mv != 0
    var float uN = 0.0
    var float uH = 0.0
    var float dN = 0.0
    var float dH = 0.0
    var int   sN = 0
    var int   lastId = -1
    if ok
        if pd > 0
            uN += 1
            uH += mv > 0 ? 1 : 0
        else
            dN += 1
            dH += mv < 0 ? 1 : 0
        if nz(id[h]) != lastId
            sN += 1
            lastId := nz(id[h])
    [uN > 0 and dN > 0 ? 0.5 * (uH / uN + dH / dN) : na, uN + dN, float(sN)]

fgfRead() =>
    [sBuy, sSell, sPx, sPar, sAl, sAc] = fgfSignal(fgfTfSec)
    float fAtr = ta.atr(14)
    [aAt, aBar, aPx, aDir, aId, aAtr] = fgfArm(sBuy, sSell, sPx, fAtr)
    [cL1, cLh, cS1, cSh, cR1, cRh, cN] = fgfScore(aPx, aDir, aBar)
    int rAge  = na(aBar) ? -1 : bar_index - aBar
    int rCall = rAge >= fgrAge ? -aDir : 0
    [r6a, r6n, r6s] = fgrHits(rCall, aId, 6)
    [r12a, r12n, r12s] = fgrHits(rCall, aId, 12)
    [vSc, vAns, vOk, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, k0a, k0n, k0c, k1a, k1n, k1c, k2a, k2n, k2c, k3a, k3n, k3c, k4a, k4n, k4c, k5a, k5n, k5c, k6a, k6n, k6c, k0s] = fgvScore(aPx, aDir, aBar, aAtr, fAtr)
    [aAt, aBar, aPx, aDir, aId, sPar, sAl, sAc, bar_index, time, nz(time_close, time), aAt[1], aBar[1], aPx[1], aDir[1], aId[1], sPar[1], sAl[1], sAc[1], nz(time_close[1], time[1]), cL1, cLh, cS1, cSh, cR1, cRh, cN, cL1[1], cLh[1], cS1[1], cSh[1], cR1[1], cRh[1], cN[1], aAtr, aAtr[1], vSc, vAns, vOk, vSc[1], vAns[1], vOk[1], x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, k0a[1], k0n[1], k0c[1], k1a[1], k1n[1], k1c[1], k2a[1], k2n[1], k2c[1], k3a[1], k3n[1], k3c[1], k4a[1], k4n[1], k4c[1], k5a[1], k5n[1], k5c[1], k6a[1], k6n[1], k6c[1], k0s[1], rCall, rAge, rCall[1], rAge[1], r6a[1], r6n[1], r6s[1], r12a[1], r12n[1], r12s[1]]

[fpAt, fpBar, fpPx, fpDir, fpId, fpPar, fpAl, fpAc, fpIdx, fpOpen, fpClose, fqAt, fqBar, fqPx, fqDir, fqId, fqPar, fqAl, fqAc, fqClose, fpL1, fpLh, fpS1, fpSh, fpR1, fpRh, fpN, fqL1, fqLh, fqS1, fqSh, fqR1, fqRh, fqN, fpAtr, fqAtr, fpVSc, fpVAns, fpVOk, fqVSc, fqVAns, fqVOk, fvX1, fvX2, fvX3, fvX4, fvX5, fvX6, fvX7, fvX8, fvX9, fvX10, fvX11, fvX12, fvX13, fvX14, fvX15, fvX16, fvX17, fcA0, fcN0, fcC0, fcA1, fcN1, fcC1, fcA2, fcN2, fcC2, fcA3, fcN3, fcC3, fcA4, fcN4, fcC4, fcA5, fcN5, fcC5, fcA6, fcN6, fcC6, fcS0, fpRC, fpRA, fqRC, fqRA, frA6, frN6, frS6, frA12, frN12, frS12] = request.security(syminfo.tickerid, fgfTfEff, fgfRead(), barmerge.gaps_off, barmerge.lookahead_off)

fgfTfText(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 60 ? str.tostring(sec) + "s" : sec < 3600 ? str.tostring(sec / 60, "#.##") + "m" : sec < 86400 ? str.tostring(sec / 3600, "#.##") + "H" : tf
string fgfTfTag = fgfTfText(fgfTfEff)

// Clock: the moment a bar is judged ("Check price on").
//   Tick          a closed bar at its close time; the live bar at the real
//                 clock (every tick), kept inside the bar.
//   Candle open   every bar at its open time (fixed from its first tick).
//   Candle close  a closed bar at its close time; the live bar at its open
//                 time, with the last closed candle's close (see fgfValue).
// Closed bars never repaint in any mode.
bool fgfLiveBar = not barstate.isconfirmed
bool fgfAtOpen  = fgfCheck == "Candle open" or (fgfCheck == "Candle close" and fgfLiveBar)
// The close-time clock (Tick, and closed bars in Candle close). A live bar's
// real clock never reaches the bar's close, nor the close of the filter
// candle still forming (fp on a live bar), so a filter candle is never read
// before its data has closed (delayed data, late ticks).
int  fgfClockC  = fgfLiveBar ? math.max(time, math.min(timenow, nz(time_close, timenow + 1) - 1, nz(fpClose, timenow + 1) - 1)) : nz(time_close, time)
fgfClock = fgfAtOpen ? time : fgfClockC

// The arm in force = the latest filter candle closed by the clock:
//   1  the latest filter candle (fp), once it has closed by the clock
//   2  the candle before it (fq), once that one has closed
//   0  neither (a chart candle longer than the filter candle, judged at its
//      open): the previous chart bar's close-time pick, the latest filter
//      candle closed by this bar's open, as none closes between the two;
//      its index is judged at this bar's open (after a session gap, the
//      next candle)
int fgfSelC = fgfClockC >= fpClose ? 1 : 2
int fgfSel  = fgfAtOpen ? (fpClose <= time ? 1 : fqClose <= time ? 2 : 0) : fgfSelC
// the close-time pick of every bar, kept for the next bar's open (fgfSel 0)
int   fgfCAt  = fgfSelC == 1 ? fpAt  : fqAt
int   fgfCBar = fgfSelC == 1 ? fpBar : fqBar
float fgfCPx  = fgfSelC == 1 ? fpPx  : fqPx
int   fgfCDir = fgfSelC == 1 ? fpDir : fqDir
int   fgfCId  = fgfSelC == 1 ? fpId  : fqId
int   fgfCPar = fgfSelC == 1 ? fpPar : fqPar
int   fgfCAl  = fgfSelC == 1 ? fpAl  : fqAl
int   fgfCAc  = fgfSelC == 1 ? fpAc  : fqAc
// The filter candle the clock falls in (Candles mode): the picked candle when
// it closes exactly at the clock, else the one after it.
int   fgfCIdx = fgfSelC == 1 ? (fgfClockC == fpClose ? fpIdx : fpIdx + 1) : (fgfClockC == fqClose ? fpIdx - 1 : fpIdx)
// the picked candle itself and its close, for the next bar's open (fgfSel 0)
int   fgfCK      = fgfSelC == 1 ? fpIdx : fpIdx - 1
int   fgfCKClose = fgfSelC == 1 ? fpClose : fqClose

int   fgfSigAt  = fgfSel == 1 ? fpAt  : fgfSel == 2 ? fqAt  : fgfCAt[1]
int   fgfSigBar = fgfSel == 1 ? fpBar : fgfSel == 2 ? fqBar : fgfCBar[1]
float fgfLevel  = fgfSel == 1 ? fpPx  : fgfSel == 2 ? fqPx  : fgfCPx[1]
int   fgfSigDir = nz(fgfSel == 1 ? fpDir : fgfSel == 2 ? fqDir : fgfCDir[1])
// the ATR(14) of the signal candle (the no-trade band's unit)
float fgfCAtr   = fgfSelC == 1 ? fpAtr : fqAtr
float fgfSigAtr = fgfSel == 1 ? fpAtr : fgfSel == 2 ? fqAtr : fgfCAtr[1]
int   fgfSigId  = nz(fgfSel == 1 ? fpId  : fgfSel == 2 ? fqId  : fgfCId[1])
// The conditions of the last closed filter candle (status box).
int   fgfPar    = fgfSel == 1 ? fpPar : fgfSel == 2 ? fqPar : fgfCPar[1]
int   fgfAl     = fgfSel == 1 ? fpAl  : fgfSel == 2 ? fqAl  : fgfCAl[1]
int   fgfAc     = fgfSel == 1 ? fpAc  : fgfSel == 2 ? fqAc  : fgfCAc[1]
// The direction score of the last closed filter candle (status box, output).
fgfPickC(float p, float q) =>
    fgfSelC == 1 ? p : q
fgfPick(float p, float q, float cPrev) =>
    fgfSel == 1 ? p : fgfSel == 2 ? q : cPrev
float fgsCL1 = fgfPickC(fpL1, fqL1)
float fgsCLh = fgfPickC(fpLh, fqLh)
float fgsCS1 = fgfPickC(fpS1, fqS1)
float fgsCSh = fgfPickC(fpSh, fqSh)
float fgsCR1 = fgfPickC(fpR1, fqR1)
float fgsCRh = fgfPickC(fpRh, fqRh)
float fgsCN  = fgfPickC(fpN, fqN)
float fgsL1  = fgfPick(fpL1, fqL1, fgsCL1[1])
float fgsLh  = fgfPick(fpLh, fqLh, fgsCLh[1])
float fgsS1  = fgfPick(fpS1, fqS1, fgsCS1[1])
float fgsSh  = fgfPick(fpSh, fqSh, fgsCSh[1])
float fgsR1  = fgfPick(fpR1, fqR1, fgsCR1[1])
float fgsRh  = fgfPick(fpRh, fqRh, fgsCRh[1])
float fgsN   = fgfPick(fpN, fqN, fgsCN[1])
// The score veto of the filter candle in force (picked like the arm).
// The reverse-old-signal call of the filter candle in force (picked like the arm).
float fgrCC   = fgfPickC(fpRC, fqRC)
float fgrCA   = fgfPickC(fpRA, fqRA)
int   fgrCall = int(nz(fgfPick(fpRC, fqRC, fgrCC[1])))
int   fgrAgeN = int(nz(fgfPick(fpRA, fqRA, fgrCA[1]), -1))
float fgvCSc  = fgfPickC(fpVSc, fqVSc)
float fgvCAns = fgfPickC(fpVAns, fqVAns)
float fgvCOk  = fgfPickC(fpVOk, fqVOk)
float fgvSc   = fgfPick(fpVSc, fqVSc, fgvCSc[1])
int   fgvAns  = math.round(nz(fgfPick(fpVAns, fqVAns, fgvCAns[1])))
bool  fgvRdy  = nz(fgfPick(fpVOk, fqVOk, fgvCOk[1])) == 1
// With the veto on, a zone allows its side only while the score agrees
// (and nothing until the score's inputs exist). Off, or without a model for
// the filter timeframe: always true, the zones decide alone.
bool  fgvBuyOk  = not fgvActive or fgvAns == 1
bool  fgvSellOk = not fgvActive or fgvAns == -1
int   fgfIdx    = not fgfAtOpen ? fgfCIdx : fgfSel == 1 ? (time == fpClose ? fpIdx : fpIdx + 1) : fgfSel == 2 ? (time == fqClose ? fpIdx - 1 : fpIdx) : (time == fgfCKClose[1] ? fgfCK[1] : fgfCK[1] + 1)

// The price compared to the level, at that moment.
fgfValue = fgfCheck == "Candle open" ? open : fgfCheck == "Candle close" and fgfLiveBar ? close[1] : close

// Permission window: from the signal candle's close, until the next signal
// (or the minutes / candles run out).
bool fgfArmed  = not na(fgfSigAt) and fgfClock >= fgfSigAt
int  fgfEnd    = fgfLast == "Minutes" and fgfArmed ? fgfSigAt + fgfMinutes * 60000 : na
int  fgfEndBar = fgfLast == "Candles" and fgfArmed ? fgfSigBar + fgfBars : na
bool fgfOpen   = fgfArmed and (fgfLast == "Minutes" ? fgfClock < fgfEnd : fgfLast == "Candles" ? fgfIdx < fgfEndBar : true)

// On the signal candle itself price can sit exactly at the level ("Signal
// close"): there the signal's own side counts as allowed AT the level.
bool fgfOnSigBar = fgfArmed and fgfIdx == fgfSigBar
bool fgfAtBuyLv  = fgfOnSigBar and fgfSigDir > 0 and fgfValue >= fgfLevel
bool fgfAtSellLv = fgfOnSigBar and fgfSigDir < 0 and fgfValue <= fgfLevel

// The zones (see ZONES): above the band BUY ZONE, below it SELL ZONE, inside
// it NO TRADE. With no band the level itself splits them (and on the signal
// candle price exactly at the level counts for the signal's side).
float fgfBand  = fgfBandAtr * nz(fgfSigAtr)
float fgfMt    = syminfo.mintick
float fgfUpLv  = fgfBand > 0 ? math.ceil((fgfLevel + fgfBand) / fgfMt - 1e-9) * fgfMt : fgfLevel
float fgfDnLv  = fgfBand > 0 ? math.floor((fgfLevel - fgfBand) / fgfMt + 1e-9) * fgfMt : fgfLevel
bool  fgfInUp  = fgfBand > 0 ? fgfValue > fgfUpLv + fgfMt / 2 : (fgfValue > fgfLevel or fgfAtBuyLv)
bool  fgfInDn  = fgfBand > 0 ? fgfValue < fgfDnLv - fgfMt / 2 : (fgfValue < fgfLevel or fgfAtSellLv)
// the signal's direction is confirmed while price is in its own zone
bool  fgfSigOk = fgfArmed and (fgfSigDir > 0 ? fgfInUp : fgfSigDir < 0 ? fgfInDn : false)
// a zone allows its side unless it is against the signal and that is off
bool  fgfUpNow = fgfInUp and (fgfAgainst or fgfSigDir > 0)
bool  fgfDnNow = fgfInDn and (fgfAgainst or fgfSigDir < 0)

// Final gates: is a buy / a sell ALLOWED on this bar? (Permission only.)
fgfBuyOk  = not fgfOn or (fgfOpen and fgfAllowBuy  and fgfUpNow and fgvBuyOk)
fgfSellOk = not fgfOn or (fgfOpen and fgfAllowSell and fgfDnNow and fgvSellOk)

// A new signal became known on this bar; a Minutes / Candles permission ended.
bool fgfNewSig  = fgfSigId > fgfSigId[1]
// What may be done now: 1 BUY ZONE, -1 SELL ZONE, 0 NO TRADE, 2 filter off.
int  fgfZone    = not fgfOn ? 2 : fgfBuyOk ? 1 : fgfSellOk ? -1 : 0
bool fgfEnded   = fgfArmed and not fgfOpen
bool fgfExpired = fgfOn and fgfEnded and not fgfEnded[1] and not barstate.isfirst

// ---- Visuals (optional: delete from here to END if you only want the gates)
fgfPosOf(string s) =>
    switch s
        "top_right"     => position.top_right
        "bottom_right"  => position.bottom_right
        "top_left"      => position.top_left
        "middle_left"   => position.middle_left
        "bottom_left"   => position.bottom_left
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        => position.middle_right

bgcolor(fgfShowBg and fgfOn and fgfOpen ? (fgfBuyOk ? color.new(color.green, 85) : fgfSellOk ? color.new(color.red, 85) : color.new(color.gray, 88)) : na, title="FGF permission", force_overlay=FGF_FORCE_OVERLAY)
plotshape(fgfSigMark and fgfOn and fgfNewSig and fgfSigDir > 0, "FGF buy signal",  shape.triangleup,   location.belowbar, color.lime, size=size.tiny, force_overlay=FGF_FORCE_OVERLAY)
plotshape(fgfSigMark and fgfOn and fgfNewSig and fgfSigDir < 0, "FGF sell signal", shape.triangledown, location.abovebar, color.red,  size=size.tiny, force_overlay=FGF_FORCE_OVERLAY)
plotshape(fgfExpired, "FGF permission ended", shape.xcross, location.top, color.orange, size=size.tiny, text="FGF end", textcolor=color.orange, force_overlay=FGF_FORCE_OVERLAY)

// Level line as a drawing (it does not stretch the price scale). Each signal
// keeps its own line and label, so past levels stay readable. Redrawn every
// bar so a host script's own drawings never garbage-collect the current one.
var line  fgfLn   = na
var label fgfLbl  = na
var int   fgfFrom = na
if fgfNewSig or (na(fgfFrom) and fgfArmed)
    // a new signal: leave the previous signal's drawings where they ended
    fgfLn   := na
    fgfLbl  := na
    fgfFrom := bar_index
if fgfShowLv and fgfOn and fgfOpen and not na(fgfLevel) and not na(fgfFrom)
    int   fgfX1  = math.max(fgfFrom, bar_index - 9000)
    color fgfCol = fgfSigDir > 0 ? color.lime : color.red
    line.delete(fgfLn)
    fgfLn := line.new(fgfX1, fgfLevel, bar_index, fgfLevel, color=fgfCol, width=2, force_overlay=FGF_FORCE_OVERLAY)
    if na(fgfLbl)
        string fgfLastTxt = fgfLast == "Minutes" ? str.tostring(fgfMinutes) + " min" : fgfLast == "Candles" ? str.tostring(fgfBars) + (fgfBars == 1 ? " candle " : " candles ") + fgfTfTag : "until next signal"
        string fgfTxt     = (fgfSigDir > 0 ? "BUY" : "SELL") + " signal " + fgfTfTag + " @ " + str.tostring(fgfLevel, format.mintick) + "\n" + fgfLastTxt
        fgfLbl := label.new(fgfX1, fgfLevel, fgfTxt, style=label.style_label_right, color=color.new(fgfCol, 20), textcolor=color.black, size=size.small, force_overlay=FGF_FORCE_OVERLAY)

// The permission as the status box and the zone names show it: Tick + Minutes
// also ends it by the real clock (the gates, shading and outputs keep the
// candle's clock, see TIMING).
bool fgfDOpen = fgfOpen and not (fgfCheck == "Tick" and fgfLast == "Minutes" and timenow >= fgfEnd)

// The edge of a zone as text: with a band, the band edge (the last NO TRADE
// tick); with no band, the level rounded to the last tick that is not
// allowed, or on the signal candle the first tick that is (">=" / "<=").
fgfEdgeTx(bool up) =>
    bool  incl = fgfBand == 0 and fgfOnSigBar and (up ? fgfSigDir > 0 : fgfSigDir < 0)
    float edge = up ? fgfUpLv : fgfDnLv
    float k    = edge / fgfMt
    float tk   = fgfBand > 0 ? edge : (up != incl ? math.floor(k + 1e-9) : math.ceil(k - 1e-9)) * fgfMt
    (up ? (incl ? ">= " : "> ") : (incl ? "<= " : "< ")) + str.tostring(tk, format.mintick)

// The band's edges (dashed) and the zone names at the last candle.
var line  fgfLnUp = na
var line  fgfLnDn = na
var label fgfZUp  = na
var label fgfZDn  = na
var label fgfZMid = na
if fgfNewSig
    fgfLnUp := na
    fgfLnDn := na
if fgfShowLv and fgfOn and fgfOpen and not na(fgfLevel) and not na(fgfFrom) and fgfBand > 0
    int fgfX2 = math.max(fgfFrom, bar_index - 9000)
    line.delete(fgfLnUp)
    line.delete(fgfLnDn)
    fgfLnUp := line.new(fgfX2, fgfUpLv, bar_index, fgfUpLv, color=color.new(color.lime, 40), style=line.style_dashed, width=1, force_overlay=FGF_FORCE_OVERLAY)
    fgfLnDn := line.new(fgfX2, fgfDnLv, bar_index, fgfDnLv, color=color.new(color.red, 40), style=line.style_dashed, width=1, force_overlay=FGF_FORCE_OVERLAY)
if barstate.islast
    label.delete(fgfZUp)
    label.delete(fgfZDn)
    label.delete(fgfZMid)
    if fgfShowLv and fgfOn and fgfDOpen and not na(fgfLevel)
        bool upAllowed = fgfAllowBuy and (fgfAgainst or fgfSigDir > 0)
        bool dnAllowed = fgfAllowSell and (fgfAgainst or fgfSigDir < 0)
        // (with the score veto on, a zone the score blocks right now is marked)
        bool upVeto = upAllowed and not fgvBuyOk
        bool dnVeto = dnAllowed and not fgvSellOk
        string vetoTx = fgvRdy ? " (score veto) " : " (score not ready) "
        fgfZUp  := label.new(bar_index + 3, fgfUpLv, (upAllowed ? (upVeto ? "BUY ZONE" + vetoTx : "BUY ZONE ") : "NO TRADE ") + fgfEdgeTx(true), style=label.style_label_lower_left, color=color.new(upAllowed and not upVeto ? color.lime : color.gray, 30), textcolor=color.black, size=size.small, force_overlay=FGF_FORCE_OVERLAY)
        fgfZDn  := label.new(bar_index + 3, fgfDnLv, (dnAllowed ? (dnVeto ? "SELL ZONE" + vetoTx : "SELL ZONE ") : "NO TRADE ") + fgfEdgeTx(false), style=label.style_label_upper_left, color=color.new(dnAllowed and not dnVeto ? color.red : color.gray, 30), textcolor=color.white, size=size.small, force_overlay=FGF_FORCE_OVERLAY)
        if fgfBand > 0
            fgfZMid := label.new(bar_index + 3, fgfLevel, "NO TRADE (band)", style=label.style_label_left, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny, force_overlay=FGF_FORCE_OVERLAY)

// Status box (display only; the gates never use it). Judged like the gates,
// at the bar's clock; Tick + Minutes also ends it by the real clock.
// The readout's accuracy as text: accuracy (calls, signals).
fgrRes(float acc, float n, float sg) =>
    (na(acc) ? "-" : str.tostring(acc * 100, "#.0") + "%") + "  (" + (na(n) ? "0" : str.tostring(n, "#")) + " calls, " + (na(sg) ? "0" : str.tostring(sg, "#")) + " signals)"

var table fgfTable = table.new(fgfPosOf(fgfTblPos), 2, 30, bgcolor=color.new(color.black, 20), border_width=1, force_overlay=FGF_FORCE_OVERLAY)

// the BTC/USD reference scores (out of sample 2025-07 .. 2026-10) of the filter timeframe's bucket
fgsRefTxt(int sec) =>
    int m = math.round(sec / 60.0)
    if m >= 1 and m <= 2
        "1m: level 50/50  signal 50/49  reversed 50/51"
    else if m >= 3 and m <= 10
        "5m: level 51/51  signal 49/49  reversed 51/51"
    else if m >= 11 and m <= 22
        "15m: level 51/51  signal 48/48  reversed 52/52"
    else if m >= 23 and m <= 45
        "30m: level 51/52  signal 49/48  reversed 51/52"
    else if m >= 46 and m <= 90
        "1H: level 50/49  signal 48/50  reversed 52/50"
    else if m >= 91 and m <= 180
        "2H: level 49/52  signal 49/48  reversed 51/52"
    else if m >= 181 and m <= 360
        "4H: level 49/53  signal 49/48  reversed 51/52"
    else if m >= 361 and m <= 720
        "8H: level 51/48  signal 48/51  reversed 52/49"
    else if m >= 1080 and m <= 2880
        "1D: level 49/57  signal 53/43  reversed 47/57"
    else
        "-"

fgsPct(float v) =>
    na(v) ? "-" : str.tostring(v * 100, "#") + "%"
if fgfShowTbl and fgfOn and barstate.islast
    bool   dOpen  = fgfDOpen
    bool   dBuy   = dOpen and fgfAllowBuy  and fgfUpNow and fgvBuyOk
    bool   dSell  = dOpen and fgfAllowSell and fgfDnNow and fgvSellOk
    string dSide  = fgfSigDir > 0 ? "BUY" : "SELL"
    string dDo    = fgfSigDir > 0 ? "buy" : "sell"
    // what may be done now, and why not when nothing may
    string dWhy   = not fgfArmed ? "waiting for a signal" : not dOpen ? "permission ended" : not (fgfInUp or fgfInDn) ? "price at the level (band)" : fgfInUp and not fgfAgainst and fgfSigDir < 0 ? "above a SELL signal (against it)" : fgfInDn and not fgfAgainst and fgfSigDir > 0 ? "below a BUY signal (against it)" : fgvActive and ((fgfUpNow and fgfAllowBuy) or (fgfDnNow and fgfAllowSell)) ? (fgvRdy ? "score veto (" + (fgfUpNow ? "BUY ZONE" : "SELL ZONE") + ", score " + (fgvAns > 0 ? "UP" : fgvAns < 0 ? "DOWN" : "undecided") + ")" : "score veto (inputs not ready)") : "that side is switched off"
    string dState = dBuy ? "BUY ZONE - buys allowed, no sells" : dSell ? "SELL ZONE - sells allowed, no buys" : "NO TRADE - " + dWhy
    color  dCol   = dBuy ? color.lime : dSell ? color.red : color.orange
    bool   dConf  = dOpen and fgfSigOk
    bool   dSideSw = fgfSigDir > 0 ? fgfAllowBuy : fgfAllowSell
    bool   dSideV  = fgfSigDir > 0 ? fgvBuyOk : fgvSellOk
    bool   dSideOn = dSideSw and dSideV
    string dSigTx = not fgfArmed ? "-" : not dOpen ? "- (permission ended)" : dConf ? (dSideOn ? "CONFIRMED - " + dDo + "s allowed" : not dSideSw ? "CONFIRMED - but " + dDo + "s are switched off" : "CONFIRMED - but " + dDo + "s are blocked by the score veto") : "NOT CONFIRMED - do not " + dDo
    int    dSecs  = dOpen and not na(fgfEnd) ? math.max(0, math.floor((fgfEnd - (fgfCheck == "Tick" ? timenow : fgfClock)) / 1000.0)) : 0
    string dLeft  = not dOpen ? "-" : fgfLast == "Minutes" ? str.tostring(math.floor(dSecs / 60), "00") + ":" + str.tostring(dSecs % 60, "00") : fgfLast == "Candles" ? str.tostring(fgfEndBar - fgfIdx) + (fgfEndBar - fgfIdx == 1 ? " candle " : " candles ") + fgfTfTag : "until next signal"
    string dSig   = na(fgfSigAt) ? "-" : dSide + " " + str.format_time(fgfSigAt, "MMM dd HH:mm", syminfo.timezone) + " @ " + (na(fgfLevel) ? "-" : str.tostring(fgfLevel, format.mintick))
    string dPar   = na(fgfPar) ? "-" : fgfPar > 0 ? "BUY" : fgfPar < 0 ? "SELL" : "FLAT"
    string dZones = na(fgfAc) ? "-" : str.tostring(fgfAl) + "/" + str.tostring(fgfAc)
    string dUp    = na(fgfLevel) ? "-" : fgfEdgeTx(true)
    string dDn    = na(fgfLevel) ? "-" : fgfEdgeTx(false)
    table.cell(fgfTable, 0, 0, "FG filter " + fgfTfTag, text_color=color.white)
    table.cell(fgfTable, 1, 0, dState, text_color=dCol)
    table.cell(fgfTable, 0, 1, "Signal (exch tz)", text_color=color.white)
    table.cell(fgfTable, 1, 1, dSig, text_color=fgfSigDir > 0 ? color.lime : fgfSigDir < 0 ? color.red : color.white)
    table.cell(fgfTable, 0, 2, "Signal direction", text_color=color.white)
    table.cell(fgfTable, 1, 2, dSigTx, text_color=not fgfArmed ? color.white : dConf and dSideOn ? (fgfSigDir > 0 ? color.lime : color.red) : color.orange)
    table.cell(fgfTable, 0, 3, "BUY ZONE  " + dUp, text_color=color.white)
    bool   dUpSw  = dOpen and fgfAllowBuy and (fgfAgainst or fgfSigDir > 0)
    bool   dDnSw  = dOpen and fgfAllowSell and (fgfAgainst or fgfSigDir < 0)
    bool   dUpOk  = dUpSw and fgvBuyOk
    bool   dDnOk  = dDnSw and fgvSellOk
    string dOff   = not fgfArmed ? "NO TRADE (no signal yet)" : not dOpen ? "NO TRADE (permission ended)" : "NO TRADE there"
    string dVeto  = fgvRdy ? "blocked now (score veto)" : "blocked (score not ready)"
    table.cell(fgfTable, 1, 3, dBuy ? "ALLOWED (now)" : dUpOk ? "allowed there" : dUpSw ? dVeto : dOff, text_color=dBuy ? color.lime : dUpOk ? color.gray : color.orange)
    table.cell(fgfTable, 0, 4, "SELL ZONE " + dDn, text_color=color.white)
    table.cell(fgfTable, 1, 4, dSell ? "ALLOWED (now)" : dDnOk ? "allowed there" : dDnSw ? dVeto : dOff, text_color=dSell ? color.red : dDnOk ? color.gray : color.orange)
    table.cell(fgfTable, 0, 5, "NO TRADE band", text_color=color.white)
    table.cell(fgfTable, 1, 5, na(fgfLevel) ? "-" : fgfBand > 0 ? str.tostring(fgfDnLv, format.mintick) + " - " + str.tostring(fgfUpLv, format.mintick) : fgfBandAtr > 0 and fgfArmed and na(fgfSigAtr) ? "off (no ATR yet at the signal)" : "off", text_color=color.white)
    table.cell(fgfTable, 0, 6, fgfCheck == "Candle open" ? "Candle open" : fgfCheck == "Candle close" ? "Last close" : "Price now", text_color=color.white)
    table.cell(fgfTable, 1, 6, na(fgfValue) ? "-" : str.tostring(fgfValue, format.mintick), text_color=color.white)
    table.cell(fgfTable, 0, 7, "Left", text_color=color.white)
    table.cell(fgfTable, 1, 7, dLeft, text_color=color.white)
    table.cell(fgfTable, 0, 8, "Last " + fgfTfTag + " parent / zones", text_color=color.white)
    table.cell(fgfTable, 1, 8, dPar + " / " + dZones + " aligned", text_color=dPar == "BUY" ? color.lime : dPar == "SELL" ? color.red : color.white)
    if fgsShow
        string hTxt = "next 1 / " + str.tostring(fgsH) + " " + fgfTfTag
        string wTxt = fgsWin > 0 ? "last " + str.tostring(fgsWin) : "all"
        table.cell(fgfTable, 0, 9, "Direction score (" + wTxt + ", " + (na(fgsN) ? "-" : str.tostring(fgsN, "#")) + " level-side calls)", text_color=color.gray)
        table.cell(fgfTable, 1, 9, hTxt + "  (50% = coin flip)", text_color=color.gray)
        table.cell(fgfTable, 0, 10, "Level side (bare level)", text_color=color.aqua)
        table.cell(fgfTable, 1, 10, fgsPct(fgsL1) + " / " + fgsPct(fgsLh), text_color=color.aqua)
        table.cell(fgfTable, 0, 11, "Signal direction", text_color=color.gray)
        table.cell(fgfTable, 1, 11, fgsPct(fgsS1) + " / " + fgsPct(fgsSh), text_color=color.gray)
        table.cell(fgfTable, 0, 12, "Signal reversed", text_color=color.gray)
        table.cell(fgfTable, 1, 12, fgsPct(fgsR1) + " / " + fgsPct(fgsRh), text_color=color.gray)
        table.cell(fgfTable, 0, 13, "BTC 2025-26 (1/10), parent = TF, zones x1/2/4", text_color=color.gray)
        table.cell(fgfTable, 1, 13, fgsRefTxt(fgfTfSec), text_color=color.gray)
    if fgvOn
        // (right under the last row in use: 9 without the direction score, 14 with it)
        int    vRow = fgsShow ? 14 : 9
        [vLo, vHi] = fgvCuts(fgvModelQlo(fgfTfSec), fgvModelQhi(fgfTfSec), fgvWiden)
        string vCut = " (cut-offs x" + str.tostring(fgvWiden) + ": UP > " + str.tostring(vHi, "#.####") + ", DOWN < " + str.tostring(vLo, "#.####") + ")"
        string vTxt = not fgvModel ? "NOT APPLIED: no model for " + fgfTfTag + " (5m, 15m, 30m, 1H only); zones alone" : not fgvRdy ? (not fgfArmed ? "waiting for the first signal: NO TRADE" : "inputs not ready (about 100 " + fgfTfTag + " candles of history): NO TRADE") : "score " + str.tostring(fgvSc, "#.####") + " = " + (fgvAns > 0 ? "UP: buys pass, sells blocked" : fgvAns < 0 ? "DOWN: sells pass, buys blocked" : "undecided: nothing passes") + vCut
        table.cell(fgfTable, 0, vRow, fgvModel ? "Score veto (" + fgfTfTag + " model, BTC 2020-25)" : "Score veto", text_color=color.white)
        table.cell(fgfTable, 1, vRow, vTxt, text_color=not fgvModel or not fgvRdy ? color.orange : fgvAns > 0 ? color.lime : fgvAns < 0 ? color.red : color.orange)
        string vDiff = fgvCalibDiff()
        if vDiff != ""
            table.cell(fgfTable, 0, vRow + 1, "Veto calibrated with", text_color=color.gray)
            table.cell(fgfTable, 1, vRow + 1, vDiff, text_color=color.orange)
    if fgvCurveOn and fgvModel
        // (under the veto rows when they are shown, else under the last row)
        int cRow = fgvOn ? (fgsShow ? 14 : 9) + (fgvCalibDiff() != "" ? 2 : 1) : fgsShow ? 14 : 9
        string wTxt2 = (na(fcS0) ? "-" : str.tostring(fcS0, "#")) + (fgsWin > 0 ? " of the last " + str.tostring(fgsWin) : " (all)")
        table.cell(fgfTable, 0, cRow, "Accuracy vs coverage (" + wTxt2 + " " + fgfTfTag + " candles, next candle, buys/sells averaged)", text_color=color.white)
        table.cell(fgfTable, 1, cRow, "right / permitted / calls  (50% = coin flip)", text_color=color.white)
        bool cMine = fgvWiden != -0.5 and fgvWiden != 0 and fgvWiden != 0.5 and fgvWiden != 1 and fgvWiden != 2
        for r = 0 to (cMine ? 6 : 5)
            float  ca = r == 0 ? fcA0 : r == 1 ? fcA1 : r == 2 ? fcA2 : r == 3 ? fcA3 : r == 4 ? fcA4 : r == 5 ? fcA5 : fcA6
            float  cn = r == 0 ? fcN0 : r == 1 ? fcN1 : r == 2 ? fcN2 : r == 3 ? fcN3 : r == 4 ? fcN4 : r == 5 ? fcN5 : fcN6
            float  cc = r == 0 ? fcC0 : r == 1 ? fcC1 : r == 2 ? fcC2 : r == 3 ? fcC3 : r == 4 ? fcC4 : r == 5 ? fcC5 : fcC6
            float  ck = r == 1 ? -0.5 : r == 2 ? 0.0 : r == 3 ? 0.5 : r == 4 ? 1.0 : r == 5 ? 2.0 : fgvWiden
            bool   cUse = r == 0 ? not fgvOn : fgvOn and ck == fgvWiden and (r == 6 or not cMine)
            string cName = r == 0 ? "Zones alone (veto off)" : "Zones + veto, cut-offs x" + str.tostring(ck) + (r == 2 ? " (model)" : r == 1 ? " (every score decides)" : "")
            string cVal = (na(ca) ? "-" : str.tostring(ca * 100, "#.0") + "%") + " / " + (na(cc) ? "-" : str.tostring(cc * 100, "#") + "%") + " / " + (na(cn) ? "-" : str.tostring(cn, "#"))
            color  cCol = na(cn) or cn < 100 ? color.gray : cUse ? color.aqua : color.white
            table.cell(fgfTable, 0, cRow + 1 + r, cName + (cUse ? "  <- in use" : ""), text_color=cCol)
            table.cell(fgfTable, 1, cRow + 1 + r, cVal, text_color=cCol)
    if fgrShow
        // (under every row in use above)
        int  rRow  = fgsShow ? 14 : 9
        rRow += fgvOn ? (fgvCalibDiff() != "" ? 2 : 1) : 0
        bool rMine = fgvWiden != -0.5 and fgvWiden != 0 and fgvWiden != 0.5 and fgvWiden != 1 and fgvWiden != 2
        rRow += fgvCurveOn and fgvModel ? (rMine ? 8 : 7) : 0
        string rTf  = fgfTfSec == 900 ? "" : "  (tested on 15m, this is " + fgfTfTag + ")"
        string rNow = not fgfArmed ? "no signal yet" : fgrCall > 0 ? "BUY (last SELL signal " + str.tostring(fgrAgeN) + " candles old)" : fgrCall < 0 ? "SELL (last BUY signal " + str.tostring(fgrAgeN) + " candles old)" : "none (last signal " + str.tostring(fgrAgeN) + " of " + str.tostring(fgrAge) + " candles old)"
        table.cell(fgfTable, 0, rRow, "Reverse old signal (info only)" + rTf, text_color=color.white)
        table.cell(fgfTable, 1, rRow, rNow, text_color=fgrCall > 0 ? color.lime : fgrCall < 0 ? color.red : color.gray)
        string rFrom = str.format_time(fgrFrom, "yyyy-MM-dd", "UTC")
        color rCol6  = na(frS6) or frS6 < 100 ? color.gray : frA6 >= 0.54 ? color.lime : frA6 <= 0.5 ? color.orange : color.white
        color rCol12 = na(frS12) or frS12 < 100 ? color.gray : frA12 >= 0.54 ? color.lime : frA12 <= 0.5 ? color.orange : color.white
        table.cell(fgfTable, 0, rRow + 1, "  right 6 " + fgfTfTag + " candles later, since " + rFrom, text_color=color.gray)
        table.cell(fgfTable, 1, rRow + 1, fgrRes(frA6, frN6, frS6), text_color=rCol6)
        table.cell(fgfTable, 0, rRow + 2, "  right 12 " + fgfTfTag + " candles later, since " + rFrom, text_color=color.gray)
        table.cell(fgfTable, 1, rRow + 2, fgrRes(frA12, frN12, frS12), text_color=rCol12)
// ====================== END FLASHGOLD DIRECTION FILTER =======================

// Exported values (Data Window + linkable as a source from other scripts).
plot(fgfOn and fgfOpen ? 1 : 0, "FGF active", display=display.data_window)
plot(fgfBuyOk ? 1 : 0, "FGF buy allowed", display=display.data_window)
plot(fgfSellOk ? 1 : 0, "FGF sell allowed", display=display.data_window)
plot(fgfLevel, "FGF level", display=display.data_window)
plot(fgfNewSig ? fgfSigDir : 0, "FGF signal (1 buy, -1 sell)", display=display.data_window)
plot(fgfExpired ? 1 : 0, "FGF ended", display=display.data_window)
plot(fgfZone, "FGF zone (1 buy, -1 sell, 0 no trade, 2 off)", display=display.data_window)
plot(fgfOn and fgfOpen and fgfSigOk ? 1 : 0, "FGF signal confirmed", display=display.data_window)
plot(fgsShow ? fgsL1 : na, "FGF score (next candle)", display=display.data_window)
plot(fgfOn and fgvActive ? fgvAns : 2, "FGF score veto (1 buys only, -1 sells only, 0 none, 2 not applied)", display=display.data_window)
plot(fgvModel ? fgvSc : na, "FGF veto score (log-odds, > 0 up)", display=display.data_window)
plot(fgrShow ? fgrCall : na, "FGR reverse-old-signal call (1 buy, -1 sell, 0 none)", display=display.data_window)
// the score's inputs at the latest filter candle (the forming one on the live bar; "Score inputs in the Data Window", parity check)
plot(fgvDbg ? fvX1 : na, "FGV in 1 zone", display=display.data_window)
plot(fgvDbg ? fvX2 : na, "FGV in 2 dist", display=display.data_window)
plot(fgvDbg ? fvX3 : na, "FGV in 3 side", display=display.data_window)
plot(fgvDbg ? fvX4 : na, "FGV in 4 r1", display=display.data_window)
plot(fgvDbg ? fvX5 : na, "FGV in 5 r5", display=display.data_window)
plot(fgvDbg ? fvX6 : na, "FGV in 6 r20", display=display.data_window)
plot(fgvDbg ? fvX7 : na, "FGV in 7 vol", display=display.data_window)
plot(fgvDbg ? fvX8 : na, "FGV in 8 age", display=display.data_window)
plot(fgvDbg ? fvX9 : na, "FGV in 9 zone_vol", display=display.data_window)
plot(fgvDbg ? fvX10 : na, "FGV in 10 dist_vol", display=display.data_window)
plot(fgvDbg ? fvX11 : na, "FGV in 11 fdir", display=display.data_window)
plot(fgvDbg ? fvX12 : na, "FGV in 12 f level TF", display=display.data_window)
plot(fgvDbg ? fvX13 : na, "FGV in 13 f slope TF", display=display.data_window)
plot(fgvDbg and fgvModel ? fvX14 : na, "FGV in 14 f level 2xTF", display=display.data_window)
plot(fgvDbg and fgvModel ? fvX15 : na, "FGV in 15 f slope 2xTF", display=display.data_window)
plot(fgvDbg and fgvModel ? fvX16 : na, "FGV in 16 f level 4xTF", display=display.data_window)
plot(fgvDbg and fgvModel ? fvX17 : na, "FGV in 17 f slope 4xTF", display=display.data_window)
plot(fgvDbg ? fpVSc : na, "FGV score (last filter candle)", display=display.data_window)
plot(fgvDbg ? fpVAns : na, "FGV answer (last filter candle)", display=display.data_window)
