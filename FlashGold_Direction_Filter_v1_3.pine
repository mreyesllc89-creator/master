        3600 => array.from(0.054145340241876366, -0.0035965920361391477, -0.07515549098386952, -0.12620871450665233, -0.038251455772585395, 0.05814676699279951, 0.02606967776937521, 0.008603474766150877, -0.020706677609849494, -0.022071135853903565, -0.006956496903340242, -0.06810141019571728, -0.051847489117548155, -0.03473021670971929, -0.03305796617003554, -0.06908509720169013, 0.03884064449149588, 0.05012915289178514)
