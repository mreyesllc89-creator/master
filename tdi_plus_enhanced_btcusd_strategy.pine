//@version=6
// Defaults updated to match the supplied input screenshots. Historical calibration comments below describe the original breakout setup, not these defaults.
// ============================================================================
//  TDI+ (Enhanced) - STRATEGY - user-selected defaults and signal alerts
// ----------------------------------------------------------------------------
//  Same logic as tdi_plus_enhanced_strategy.pine, with defaults set for
//  BTCUSD (spot or CFD, 1 contract = 1 BTC), calibrated on MEXC BTCUSDT
//  10-minute data, 29 Sep - 4 Oct 2026 (739 bars), 0.05% fee per side.
//
//  CALIBRATION RESULT
//    * Entries: band BREAKOUT only, both directions. The Shark Fin
//      "complete" (reversal) entry lost money in the last 40% of the data
//      with every exit tested, so it is off by default, as are the
//      divergence and cross entries.
//    * Exit preset (S2. EXITS), 1 point = $0.01:
//        Best PF        SL 15000  TP 200000  no trail
//                       PF 2.10, win 30%, 20 trades
//        Best win rate  SL 100000 no TP      trail from 30000 at 2500
//                       PF 1.29, win 70%, 20 trades (small wins, rare
//                       larger losses)
//        Longest TP     SL 15000  TP 300000  trail from 50000 at 10000
//                       PF 1.51, win 35%, 23 trades
//        Best trailing  SL 15000  no TP      trail from 50000 at 15000
//                       PF 1.52, win 32%, 22 trades
//        Custom         uses the values typed in below
//      Each preset was profitable in both the first 60% and the last 40%
//      of the data. That is only 20-23 trades over five days, so treat
//      these as a starting point and re-check on more history.
//    * Points mode is MT5 style: 1 point = 0.01 of BTC price ("Point size"
//      input), 100 points = $1, whatever the broker's tick size.
//    * Sizing defaults to Risk 1% of equity, in BTC: fixed 0.05 BTC,
//      max 1 BTC, step 0.001 BTC.
//    * Commission 0.05% per side (MEXC spot taker). Set yours in
//      Properties.
//    * A warning shows on the chart if the symbol is not BTC.
// ----------------------------------------------------------------------------
//  The TDI, band, divergence and Shark Fin calculations are identical to
//  tdi_plus_enhanced_indicator.pine. Choose which signals open trades:
//
//    Regular divergence   Bull div = long, bear div = short. Pivots are
//                         confirmed, so the order goes in "Pivot Lookback
//                         Right" bars after the pivot (no repainting).
//    Hidden divergence    Same, for hidden divergences (off by default).
//    Shark Fin complete   Price line returns inside the band:
//                         back above lower band = long,
//                         back below upper band = short.
//    Band breakout        Momentum: price line crosses above upper = long,
//                         below lower = short (off by default).
//    Price/Signal cross   Price line crosses the fast (signal) line, filtered
//                         by the middle band (above mid for longs, below for
//                         shorts). Off by default.
//
//  Trade direction: Both reverses on an opposite signal. Buy only / Sell
//  only: the opposite signal closes the position when "Exit on opposite
//  signal" is on, but never opens one.
//
//  S2. EXITS  - stop loss, take profit and trailing stop in Points
//               (1 point = "Point size" of price) or ATR. In ATR mode the TP is an
//               R multiple of the SL distance. Distances are frozen at entry.
//               Optional time stop closes a trade after N bars.
//  S3. SIZING - Fixed quantity, or Risk % of equity per trade (needs a stop
//               loss; falls back to the fixed quantity when SL is off).
//               Capped at Max quantity and at equity x Max leverage (so an
//               order is never rejected for lack of funds), then rounded
//               down to Quantity step. A status table shows signal count,
//               closed trades and the next order size.
//  Orders are placed on bar close and fill on the next bar's open.
//
//  DIRECTIONAL TIME FILTER (group "Directional time filter", v1.4)
//    A time-boxed direction PERMISSION on top of the entries. From a start
//    moment (ACTIVATE NOW, or a scheduled Start time) and for the countdown,
//    longs are placed only while price is ABOVE the level and shorts only
//    while price is BELOW it. When the countdown ends every entry is blocked
//    until it is armed again. Only the strategy.entry calls are gated: the
//    "Exit on opposite signal" close, SL / TP / trail and the time stop are
//    never gated. In "Both" an opposite signal the filter blocks does not
//    reverse, so the open trade stays until its own exit. The Long / Short
//    signal dots and alerts still show every raw signal.
//    The block ships with the filter ON and nothing armed (WAITING): every
//    entry is blocked until you arm it (ACTIVATE NOW or Start time) or
//    switch "Enable filter" off. ACTIVATE NOW re-arms on every reload of
//    the script, so use Start time for anything left running or driven
//    by alerts.
//    Its shading, level and status box are drawn on the price chart.
// ============================================================================
strategy("TDI+ (Enhanced) Strategy - BTCUSD", shorttitle="TDI+ BTC", overlay=false, max_lines_count=500, max_labels_count=50,
         pyramiding=0, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=0.05,
         margin_long=0, margin_short=0, commission_type=strategy.commission.percent, commission_value=0.05)
// — Inputs —
grpT = "TDI"
RSIPeriod        = input.int(21, "RSI Period", minval=1, group=grpT)
PriceLinePeriod  = input.int(2, "Price Line Period", minval=1, group=grpT)
SignalLinePeriod = input.int(7, "Signal Line Period", minval=1, group=grpT)
VolatilityPeriod = input.int(34, "Volatility Band Period", minval=2, group=grpT)
BandMult         = input.float(1.6185, "Band Multiplier", minval=0.1, step=0.01, group=grpT)
ShowBg           = input.bool(true, "Colour background outside bands", group=grpT)
grpD = "Divergence"
PivotLeft    = input.int(5, "Pivot Lookback Left", minval=1, group=grpD)
PivotRight   = input.int(5, "Pivot Lookback Right (confirmation bars)", minval=1, group=grpD)
RangeMin     = input.int(5, "Min Bars Between Pivots", minval=1, group=grpD)
RangeMax     = input.int(60, "Max Bars Between Pivots", minval=2, group=grpD)
ArrowDist    = input.float(3.0, "Arrow Distance (RSI points)", minval=0, group=grpD)
DrawDivLines = input.bool(true, "Draw Divergence Lines", group=grpD)
grpE = "Strategy - entries"
TradeDir     = input.string("Sell only", "Trade Direction", options=["Both", "Buy only", "Sell only"], group=grpE)
UseDiv       = input.bool(false, "Enter on regular divergence", group=grpE)
UseHiddenDiv = input.bool(false, "Enter on hidden divergence", group=grpE)
UseFin       = input.bool(false, "Enter on Shark Fin complete", group=grpE)
UseBreakout  = input.bool(false, "Enter on band breakout (momentum)", group=grpE)
UseCross     = input.bool(true, "Enter on price/signal cross (mid filtered)", group=grpE)
grpX = "S2. EXITS"
ExitOnOpp    = input.bool(true, "Exit on opposite signal", group=grpX)
ExitPreset   = input.string("Custom", "Exit preset", options=["Best PF", "Best win rate", "Longest TP", "Best trailing", "Custom"], group=grpX, tooltip="Calibrated on MEXC BTCUSDT 10m, breakout entries, both directions.\nBest PF: SL 15000, TP 200000, no trail.\nBest win rate: SL 100000, no TP, trail from 30000 at 2500.\nLongest TP: SL 15000, TP 300000, trail from 50000 at 10000.\nBest trailing: SL 15000, no TP, trail from 50000 at 15000.\nCustom: uses the values below. (1 point = $0.01)")
ExitUnit     = input.string("Points", "SL / TP / trail unit (Custom)", options=["Points", "ATR"], group=grpX)
PointSize    = input.float(0.01, "Point size (price per point)", minval=0, step=0.01, group=grpX, tooltip="0.01 = MT5-style BTCUSD point (100 pts = $1). 0 = use the symbol's tick size.")
SLPts        = input.float(5000, "Stop loss, pts (Points mode)", minval=0, group=grpX, tooltip="15000 pts x 0.01 = $150. 0 = off.")
TPPts        = input.float(50000, "Take profit, pts (Points mode)", minval=0, group=grpX, tooltip="200000 pts x 0.01 = $2000. 0 = off.")
ATRLen       = input.int(14, "ATR length (ATR mode)", minval=1, group=grpX)
SLATR        = input.float(0.0, "Stop loss, ATR mult (ATR mode)", minval=0, step=0.1, group=grpX)
TPR          = input.float(5.0, "Take profit, R multiple of SL (ATR mode)", minval=0, step=0.1, group=grpX)
UseTrail     = input.bool(true, "Trailing stop (Custom)", group=grpX)
TrailActPts  = input.float(3500, "Trail activation, pts of profit (Points mode)", minval=0, group=grpX)
TrailDistPts = input.float(100, "Trail distance, pts (Points mode)", minval=0, group=grpX)
TrailActATR  = input.float(0.2, "Trail activation, ATR mult (ATR mode)", minval=0, step=0.1, group=grpX)
TrailDistATR = input.float(1.0, "Trail distance, ATR mult (ATR mode)", minval=0, step=0.1, group=grpX)
TimeStopBars = input.int(0, "Time stop, bars (0 = off)", minval=0, group=grpX)
grpQ = "S3. SIZING"
QtyMode  = input.string("Risk", "Quantity", options=["Fixed", "Risk"], group=grpQ)
FixedQty = input.float(0.05, "Fixed quantity (BTC)", minval=0, step=0.001, group=grpQ)
RiskPct  = input.float(1.0, "Risk % of equity per trade (Risk mode)", minval=0, step=0.1, group=grpQ, tooltip="Quantity = equity x risk % / stop-loss distance in money. Needs a stop loss; uses the fixed quantity when SL is off.")
MaxQty   = input.float(1.0, "Max quantity (BTC)", minval=0, step=0.001, group=grpQ)
QtyStep  = input.float(0.001, "Quantity step (BTC, rounds down)", minval=0, step=0.001, group=grpQ)
Leverage = input.float(1, "Max leverage (x equity)", minval=0.01, step=0.5, group=grpQ, tooltip="Position value is capped at equity x leverage, so orders are never rejected for lack of funds. 1 = no leverage.")
ShowInfo = input.bool(true, "Show status table", group=grpQ)
// ======================= BEGIN DIRECTIONAL TIME FILTER =======================
// Directional Time Filter v1.4. A time-boxed direction PERMISSION: it only
// answers "is a buy allowed now? is a sell allowed now?". The strategy's own
// entry and exit logic stays as it is; an ENTER that is not allowed is
// simply not taken. Exits are never gated.
// Set true when this block lives in a script that runs in its own pane
// (overlay=false) so the visuals are drawn on the price chart.
DTF_FORCE_OVERLAY = true
// Set false when dtfValue is not a price (an oscillator), so the status box
// does not round the level to the symbol's tick.
DTF_LEVEL_IS_PRICE = true
GRP_DTF = "Directional time filter"
dtfOn        = input.bool(true, "Enable filter", group=GRP_DTF, tooltip="Off: every signal passes. On: buys are allowed only while price > level, sells only while price < level, and only inside the time window.")
dtfArmNow    = input.bool(false, "ACTIVATE NOW", group=GRP_DTF, tooltip="Tick and press OK: the window opens at this moment and the level is the price at this moment. Start time and the manual levels are ignored. Untick + OK to disarm. While ticked, ANY settings change or chart reload activates it again at that moment and price (the status box shows what is armed). Not for alerts or for strategies linked through input.source: use Start time for those.")
dtfLvMode    = input.string("Actual price", "Level when activating", options=["Actual price", "Typed price"], group=GRP_DTF, tooltip="Actual price: ACTIVATE NOW captures the live price at that instant as the level. Typed price: the level is the number below.")
dtfTyped     = input.float(0, "Typed price", minval=0, group=GRP_DTF, tooltip="The level used by ACTIVATE NOW when 'Level when activating' is 'Typed price'. Buys allowed only above it, sells only below it.")
dtfStart     = input.time(timestamp("2030-01-01T00:00:00+0000"), "Start time", group=GRP_DTF, tooltip="Scheduled start, used when ACTIVATE NOW is off. Date and minute in the chart's time zone (the one on the time axis); add seconds below.")
dtfStartSec  = input.int(0, "+ seconds", minval=0, maxval=59, group=GRP_DTF, tooltip="Seconds added to Start time (useful on second charts).")
dtfMinutes   = input.float(15, "Countdown (minutes)", minval=0, step=1, group=GRP_DTF, tooltip="Minutes the window stays open from the start. 0 = never expires. Bars are judged at their close, so a countdown shorter than one chart bar opens for at most one bar.")
dtfRef       = input.source(close, "Actual price", group=GRP_DTF, tooltip="The actual price: 'Close' is the last traded price of the current bar (it moves with every tick). ACTIVATE NOW captures this value as the level, and it is compared to the level while the window is open. The dropdown names are TradingView's; leave it on Close unless you want another series.")
dtfBuyLevel  = input.float(50, "Buy only above (manual)", group=GRP_DTF, tooltip="Manual buy level, used when ACTIVATE NOW is off. Buys are allowed only while price is above it.")
dtfSellLevel = input.float(50, "Sell only below (manual)", group=GRP_DTF, tooltip="Manual sell level, used when ACTIVATE NOW is off. Sells are allowed only while price is below it.")
dtfAllowBuy  = input.bool(true, "Allow buys", inline="side", group=GRP_DTF, tooltip="Turn one side off completely inside the window.")
dtfAllowSell = input.bool(true, "Allow sells", inline="side", group=GRP_DTF)
dtfBefore    = input.string("Block", "Before start", options=["Block", "Pass"], group=GRP_DTF, tooltip="Block: nothing is allowed before the window opens. Pass: everything is allowed until the window opens.")
dtfShowBg    = input.bool(true, "Shade window", inline="vis", group=GRP_DTF)
dtfShowLv    = input.bool(true, "Draw level", inline="vis", group=GRP_DTF)
dtfShowTbl   = input.bool(true, "Status box", inline="vis", group=GRP_DTF, tooltip="Shown while the filter is enabled. Updates on each tick (once per bar inside a strategy) and freezes when the market is closed.")
dtfTblPos    = input.string("top_left", "Status box position", options=["top_right","middle_right","bottom_right","top_left","middle_left","bottom_left","top_center","bottom_center"], group=GRP_DTF)

dtfValue = dtfRef

// ACTIVATE NOW capture: the moment and the price when the script (re)starts
// with the switch on. varip keeps it across live updates; a recompile (any
// settings change, chart reload) captures again.
varip int   dtfArmedAt = na
varip float dtfArmedPx = na
// The capture waits for a tick where the price source has a value.
if dtfArmNow and barstate.islast and na(dtfArmedAt) and not na(dtfValue)
    dtfArmedAt := timenow
    dtfArmedPx := dtfLvMode == "Typed price" ? dtfTyped : dtfValue

// Clock. The committed value of a bar (history, and the closing update of the
// live bar) is judged at the bar's close time, so it never repaints. Intrabar
// ticks of the live bar use the real clock, so the window opens on the second.
dtfClock   = barstate.isconfirmed ? nz(time_close, time) : timenow
dtfStartAt = dtfArmNow ? dtfArmedAt : dtfStart + dtfStartSec * 1000
dtfEnd     = dtfMinutes > 0 and not na(dtfStartAt) ? dtfStartAt + math.round(dtfMinutes * 60000) : na
dtfBuyLv   = dtfArmNow ? dtfArmedPx : dtfBuyLevel
dtfSellLv  = dtfArmNow ? dtfArmedPx : dtfSellLevel

// Not armed yet (ACTIVATE NOW before the capture bar) counts as before start.
dtfBeforeStart = na(dtfStartAt) or dtfClock < dtfStartAt
dtfOpen        = not dtfBeforeStart and (na(dtfEnd) or dtfClock < dtfEnd)
dtfAfterEnd    = not na(dtfEnd) and dtfClock >= dtfEnd

// Final gates: is a buy / a sell ALLOWED on this bar? (Permission only.)
dtfBuyOk  = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowBuy  and dtfValue > dtfBuyLv)
dtfSellOk = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowSell and dtfValue < dtfSellLv)

// True on the first bar after the window has closed (chart marker / output).
dtfExpired = dtfOn and dtfAfterEnd and not dtfAfterEnd[1] and not barstate.isfirst

// A countdown shorter than one chart bar opens for at most one bar.
dtfTooShort = dtfOn and dtfMinutes > 0 and dtfMinutes * 60 < timeframe.in_seconds()

// ---- Visuals (optional: delete from here to END if you only want the gates)
dtfPosOf(string s) =>
    switch s
        "top_right"     => position.top_right
        "bottom_right"  => position.bottom_right
        "top_left"      => position.top_left
        "middle_left"   => position.middle_left
        "bottom_left"   => position.bottom_left
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        => position.middle_right

bgcolor(dtfShowBg and dtfOn and dtfOpen ? (dtfBuyOk and dtfSellOk ? color.new(color.yellow, 85) : dtfBuyOk ? color.new(color.green, 85) : dtfSellOk ? color.new(color.red, 85) : color.new(color.gray, 88)) : na, title="DTF window", force_overlay=DTF_FORCE_OVERLAY)
plotshape(dtfExpired, "DTF window ended", shape.xcross, location.top, color.orange, size=size.tiny, text="DTF end", textcolor=color.orange, force_overlay=DTF_FORCE_OVERLAY)

// Level lines as drawings (they do not stretch the price scale). While
// waiting they preview the last 50 bars; while open they span the window;
// after the end they stay as a record. Redrawn every bar so a host script's
// own drawings never garbage-collect them. With ACTIVATE NOW both levels are
// the same price: one white line.
dtfActive = dtfOn and (dtfBeforeStart or dtfOpen) and not na(dtfBuyLv)
var line dtfBuyLn    = na
var line dtfSellLn   = na
var int  dtfOpenFrom = na
if dtfOpen and na(dtfOpenFrom)
    dtfOpenFrom := bar_index
if dtfShowLv and dtfActive
    // From the window's first bar, but always at least the last 50 bars so the
    // line is visible from the moment it is armed; never more than 9000 back.
    int dtfX1 = math.max(0, math.max(bar_index - 9000, math.min(dtfOpen ? dtfOpenFrom : bar_index, bar_index - 50)))
    line.delete(dtfBuyLn)
    line.delete(dtfSellLn)
    if dtfArmNow
        dtfBuyLn := line.new(dtfX1, dtfBuyLv, bar_index, dtfBuyLv, color=color.new(color.white, 0), width=2, force_overlay=DTF_FORCE_OVERLAY)
    else
        dtfBuyLn  := line.new(dtfX1, dtfBuyLv,  bar_index, dtfBuyLv,  color=color.new(color.green, 0), width=2, force_overlay=DTF_FORCE_OVERLAY)
        dtfSellLn := line.new(dtfX1, dtfSellLv, bar_index, dtfSellLv, color=color.new(color.red, 0),   width=2, force_overlay=DTF_FORCE_OVERLAY)
else if not dtfActive
    dtfOpenFrom := na

// Status box, judged by the real clock (display only; the gates never use it).
var table dtfTable = table.new(dtfPosOf(dtfTblPos), 2, 7, bgcolor=color.new(color.black, 20), border_width=1, force_overlay=DTF_FORCE_OVERLAY)
if dtfShowTbl and dtfOn and barstate.islast
    bool   dBefore = na(dtfStartAt) or timenow < dtfStartAt
    bool   dAfter  = not na(dtfEnd) and timenow >= dtfEnd
    bool   dOpen   = not dBefore and not dAfter
    bool   dBuy    = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowBuy  and dtfValue > dtfBuyLv)
    bool   dSell   = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowSell and dtfValue < dtfSellLv)
    string dMode   = dtfArmNow ? " (NOW)" : ""
    string dState  = (dBefore ? (dtfTooShort ? "WAITING (< 1 bar)" : "WAITING") : dOpen ? "OPEN" : "ENDED") + dMode
    color  dCol    = dBefore ? color.yellow : dOpen ? color.lime : color.orange
    int    dSecs   = dOpen and not na(dtfEnd) ? math.max(0, math.floor((dtfEnd - timenow) / 1000.0)) : 0
    string dLeft   = dOpen and not na(dtfEnd) ? str.tostring(math.floor(dSecs / 60), "00") + ":" + str.tostring(dSecs % 60, "00") : dOpen ? "no limit" : "-"
    string dStart  = na(dtfStartAt) ? "-" : str.format_time(dtfStartAt, "MMM dd HH:mm:ss", syminfo.timezone)
    string dFmt    = DTF_LEVEL_IS_PRICE ? format.mintick : "#.########"
    table.cell(dtfTable, 0, 0, "DTF", text_color=color.white)
    table.cell(dtfTable, 1, 0, dState, text_color=dCol)
    table.cell(dtfTable, 0, 1, "Now (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 1, str.format_time(timenow, "MMM dd HH:mm:ss", syminfo.timezone), text_color=color.white)
    table.cell(dtfTable, 0, 2, "Start (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 2, dStart, text_color=dtfArmNow ? color.orange : color.white)
    table.cell(dtfTable, 0, 3, "Countdown", text_color=color.white)
    table.cell(dtfTable, 1, 3, dLeft, text_color=color.white)
    table.cell(dtfTable, 0, 4, "Price now", text_color=color.white)
    table.cell(dtfTable, 1, 4, na(dtfValue) ? "-" : str.tostring(dtfValue, dFmt), text_color=color.white)
    table.cell(dtfTable, 0, 5, "Buy  > " + (na(dtfBuyLv)  ? "-" : str.tostring(dtfBuyLv,  dFmt)), text_color=color.white)
    table.cell(dtfTable, 1, 5, dBuy ? "ALLOWED" : "BLOCKED", text_color=dBuy ? color.lime : color.red)
    table.cell(dtfTable, 0, 6, "Sell < " + (na(dtfSellLv) ? "-" : str.tostring(dtfSellLv, dFmt)), text_color=color.white)
    table.cell(dtfTable, 1, 6, dSell ? "ALLOWED" : "BLOCKED", text_color=dSell ? color.lime : color.red)

// Exported values (Data Window + linkable as a source from other scripts).
plot(dtfOn and dtfOpen ? 1 : 0, "DTF window open", display=display.data_window)
plot(dtfBuyOk ? 1 : 0, "DTF buy allowed", display=display.data_window)
plot(dtfSellOk ? 1 : 0, "DTF sell allowed", display=display.data_window)
plot(dtfExpired ? 1 : 0, "DTF expired", display=display.data_window)
plot(dtfValue, "DTF price used", display=display.data_window)
plot(dtfBuyLv, "DTF level", display=display.data_window)
// ======================== END DIRECTIONAL TIME FILTER ========================

// — RSI & Bands —
slow     = ta.rsi(close, RSIPeriod)
ma_mid   = ta.sma(slow, VolatilityPeriod)
stdev    = ta.stdev(slow, VolatilityPeriod)
upper    = ma_mid + BandMult * stdev
lower    = ma_mid - BandMult * stdev
rsiLine  = ta.sma(slow, PriceLinePeriod)
fastLine = ta.sma(slow, SignalLinePeriod)

bgColor = rsiLine >= upper ? color.new(color.green, 85) : rsiLine <= lower ? color.new(color.red, 85) : na
bgcolor(ShowBg ? bgColor : na)

// — Divergence Logic (confirmed pivots on the RSI price line) —
plFound = not na(ta.pivotlow(rsiLine, PivotLeft, PivotRight))
phFound = not na(ta.pivothigh(rsiLine, PivotLeft, PivotRight))

barsSincePL = ta.barssince(plFound[1])
barsSincePH = ta.barssince(phFound[1])
plInRange   = barsSincePL >= RangeMin and barsSincePL <= RangeMax
phInRange   = barsSincePH >= RangeMin and barsSincePH <= RangeMax

pivBar  = bar_index - PivotRight
rsiPiv  = rsiLine[PivotRight]
lowPiv  = low[PivotRight]
highPiv = high[PivotRight]

prevRsiPL  = ta.valuewhen(plFound, rsiPiv, 1)
prevLowPL  = ta.valuewhen(plFound, lowPiv, 1)
prevBarPL  = ta.valuewhen(plFound, pivBar, 1)
prevRsiPH  = ta.valuewhen(phFound, rsiPiv, 1)
prevHighPH = ta.valuewhen(phFound, highPiv, 1)
prevBarPH  = ta.valuewhen(phFound, pivBar, 1)

bullDivCond       = plFound and plInRange and rsiPiv > prevRsiPL and lowPiv < prevLowPL
hiddenBullDivCond = plFound and plInRange and rsiPiv < prevRsiPL and lowPiv > prevLowPL
bearDivCond       = phFound and phInRange and rsiPiv < prevRsiPH and highPiv > prevHighPH
hiddenBearDivCond = phFound and phInRange and rsiPiv > prevRsiPH and highPiv < prevHighPH

if DrawDivLines
    if UseDiv and bullDivCond
        line.new(prevBarPL, prevRsiPL, pivBar, rsiPiv, color=color.lime, width=2)
    if UseHiddenDiv and hiddenBullDivCond
        line.new(prevBarPL, prevRsiPL, pivBar, rsiPiv, color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    if UseDiv and bearDivCond
        line.new(prevBarPH, prevRsiPH, pivBar, rsiPiv, color=color.red, width=2)
    if UseHiddenDiv and hiddenBearDivCond
        line.new(prevBarPH, prevRsiPH, pivBar, rsiPiv, color=color.new(color.red, 40), width=1, style=line.style_dashed)

// — Shark Fin —
upper_break = ta.crossover(rsiLine, upper)
lower_break = ta.crossunder(rsiLine, lower)
upper_fin   = ta.crossunder(rsiLine, upper)
lower_fin   = ta.crossover(rsiLine, lower)

// — Price / signal cross —
crossUp   = ta.crossover(rsiLine, fastLine) and rsiLine > ma_mid
crossDown = ta.crossunder(rsiLine, fastLine) and rsiLine < ma_mid

// — Signals —
longSig  = (UseDiv and bullDivCond) or (UseHiddenDiv and hiddenBullDivCond) or (UseFin and lower_fin) or (UseBreakout and upper_break) or (UseCross and crossUp)
shortSig = (UseDiv and bearDivCond) or (UseHiddenDiv and hiddenBearDivCond) or (UseFin and upper_fin) or (UseBreakout and lower_break) or (UseCross and crossDown)

// Conflicting signals on the same bar cancel each other.
goLong  = longSig and not shortSig
goShort = shortSig and not longSig

allowLong  = TradeDir != "Sell only"
allowShort = TradeDir != "Buy only"

// — S2. Exit distances (ticks) —
atr    = ta.atr(ATRLen)
isPts  = ExitUnit == "Points"
atrTk  = atr / syminfo.mintick
ptTk   = PointSize > 0 ? PointSize / syminfo.mintick : 1.0   // ticks per point
cSL    = isPts ? (SLPts > 0 ? SLPts * ptTk : na) : (SLATR > 0 ? SLATR * atrTk : na)
cTP    = isPts ? (TPPts > 0 ? TPPts * ptTk : na) : (TPR > 0 ? cSL * TPR : na)
cAct   = UseTrail ? (isPts ? TrailActPts * ptTk : TrailActATR * atrTk) : na
cOff   = UseTrail ? (isPts ? TrailDistPts * ptTk : TrailDistATR * atrTk) : na

// Presets, in calibrated points (1 point = $0.01), converted to ticks.
presetTk = 0.01 / syminfo.mintick
float pSL  = na
float pTP  = na
float pAct = na
float pOff = na
if ExitPreset == "Best PF"
    pSL := 15000
    pTP := 200000
else if ExitPreset == "Best win rate"
    pSL  := 100000
    pAct := 30000
    pOff := 2500
else if ExitPreset == "Longest TP"
    pSL  := 15000
    pTP  := 300000
    pAct := 50000
    pOff := 10000
else if ExitPreset == "Best trailing"
    pSL  := 15000
    pAct := 50000
    pOff := 15000

usePreset = ExitPreset != "Custom"
slTk    = usePreset ? pSL * presetTk : cSL
tpTk    = usePreset ? pTP * presetTk : cTP
trActTk = usePreset ? pAct * presetTk : cAct
trOffTk = usePreset ? pOff * presetTk : cOff

// — S3. Sizing —
calcQty() =>
    float q = FixedQty
    if QtyMode == "Risk" and slTk > 0
        perUnitRisk = slTk * syminfo.mintick * syminfo.pointvalue
        q := strategy.equity * RiskPct / 100 / perUnitRisk
    affordable = strategy.equity * Leverage * 0.98 / (close * syminfo.pointvalue)
    q := math.min(q, MaxQty, affordable)
    QtyStep > 0 ? math.floor(q / QtyStep) * QtyStep : q

entryQty = calcQty()

// Exit distances frozen at entry, one set per side.
var float lSL  = na
var float lTP  = na
var float lAct = na
var float lOff = na
var float sSL  = na
var float sTP  = na
var float sAct = na
var float sOff = na

// — Orders —
// Directional time filter: an entry it blocks is simply not placed. The
// "Opp signal" close (an exit) and every strategy.exit stay as they are.
if goLong
    if allowLong and dtfBuyOk and entryQty > 0 and strategy.position_size <= 0
        strategy.entry("Long", strategy.long, qty=entryQty)
        lSL  := slTk
        lTP  := tpTk
        lAct := trActTk
        lOff := trOffTk
    else if not allowLong and ExitOnOpp
        strategy.close("Short", comment="Opp signal")

if goShort
    if allowShort and dtfSellOk and entryQty > 0 and strategy.position_size >= 0
        strategy.entry("Short", strategy.short, qty=entryQty)
        sSL  := slTk
        sTP  := tpTk
        sAct := trActTk
        sOff := trOffTk
    else if not allowShort and ExitOnOpp
        strategy.close("Long", comment="Opp signal")

if not na(lSL) or not na(lTP) or not na(lAct)
    strategy.exit("Long Exit", from_entry="Long", loss=lSL, profit=lTP, trail_points=lAct, trail_offset=lOff,
                  comment_loss="SL", comment_profit="TP", comment_trailing="Trail")
if not na(sSL) or not na(sTP) or not na(sAct)
    strategy.exit("Short Exit", from_entry="Short", loss=sSL, profit=sTP, trail_points=sAct, trail_offset=sOff,
                  comment_loss="SL", comment_profit="TP", comment_trailing="Trail")

// Time stop
if TimeStopBars > 0 and strategy.opentrades > 0
    if bar_index - strategy.opentrades.entry_bar_index(0) >= TimeStopBars
        strategy.close_all(comment="Time stop")

// — Plotting —
hline(68, "Level 68", color=color.gray, linestyle=hline.style_dotted)
hline(50, "Level 50", color=color.gray, linestyle=hline.style_dashed)
hline(32, "Level 32", color=color.gray, linestyle=hline.style_dotted)

plot(rsiLine, color=color.green, title="RSI Price Line", linewidth=2)
plot(fastLine, color=color.red, title="Fast Line")
plot(slow, color=color.white, title="Slow Line")
plot(ma_mid, color=color.yellow, title="Middle Band")
plot(upper, color=color.aqua, title="Upper Band")
plot(lower, color=color.aqua, title="Lower Band")

plotshape(UseDiv and bullDivCond ? rsiPiv - ArrowDist : na, title="Bull Divergence", style=shape.arrowup, location=location.absolute, color=color.lime, size=size.small, offset=-PivotRight)
plotshape(UseHiddenDiv and hiddenBullDivCond ? rsiPiv - ArrowDist : na, title="Hidden Bull Divergence", style=shape.arrowup, location=location.absolute, color=color.new(color.lime, 40), size=size.tiny, text="H", textcolor=color.lime, offset=-PivotRight)
plotshape(UseDiv and bearDivCond ? rsiPiv + ArrowDist : na, title="Bear Divergence", style=shape.arrowdown, location=location.absolute, color=color.red, size=size.small, offset=-PivotRight)
plotshape(UseHiddenDiv and hiddenBearDivCond ? rsiPiv + ArrowDist : na, title="Hidden Bear Divergence", style=shape.arrowdown, location=location.absolute, color=color.new(color.red, 40), size=size.tiny, text="H", textcolor=color.red, offset=-PivotRight)

plotshape(upper_break ? upper : na, title="Upper Shark Fin Breakout", style=shape.labeldown, location=location.absolute, color=color.green, text="Shark Fin 🔼", textcolor=color.white, size=size.small)
plotshape(lower_break ? lower : na, title="Lower Shark Fin Breakout", style=shape.labelup, location=location.absolute, color=color.red, text="Shark Fin 🔽", textcolor=color.white, size=size.small)
plotshape(upper_fin ? upper : na, title="Upper Fin Complete", style=shape.triangledown, location=location.absolute, color=color.orange, size=size.tiny)
plotshape(lower_fin ? lower : na, title="Lower Fin Complete", style=shape.triangleup, location=location.absolute, color=color.teal, size=size.tiny)

plotshape(goLong, title="Long Signal", style=shape.circle, location=location.bottom, color=color.lime, size=size.tiny)
plotshape(goShort, title="Short Signal", style=shape.circle, location=location.top, color=color.red, size=size.tiny)

// — Alerts —
alertcondition(goLong, title="TDI+ Long Signal", message="TDI+ long signal on {{ticker}}")
alertcondition(goShort, title="TDI+ Short Signal", message="TDI+ short signal on {{ticker}}")

// — Symbol check —
var label symWarn = na
if barstate.islast and syminfo.basecurrency != "BTC" and syminfo.basecurrency != "XBT"
    label.delete(symWarn)
    symWarn := label.new(bar_index, 50, "This copy is calibrated for BTCUSD.\nChart symbol: " + syminfo.ticker, style=label.style_label_left, color=color.orange, textcolor=color.black, size=size.normal)

// — Status table —
var int nLongSig  = 0
var int nShortSig = 0
nLongSig  += goLong ? 1 : 0
nShortSig += goShort ? 1 : 0
var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1)
if ShowInfo and barstate.islast
    table.cell(info, 0, 0, "Signals L / S", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(nLongSig) + " / " + str.tostring(nShortSig), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "Closed trades", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "Next qty", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(entryQty), text_color=entryQty > 0 ? color.white : color.red, text_size=size.small)
    table.cell(info, 0, 3, "Direction", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, TradeDir, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 5, "Exit preset", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, ExitPreset, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 4, "1 point =", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, "$" + str.tostring(PointSize > 0 ? PointSize : syminfo.mintick), text_color=color.white, text_size=size.small)
