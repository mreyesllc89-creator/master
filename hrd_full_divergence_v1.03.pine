//@version=6
// ============================================================================
//  HRD MultiTF Full Divergence  -  Horizon Resonance Divergence  -  v1.03
// ----------------------------------------------------------------------------
//  Fixes over v1.02 (MQL5 port):
//    * Oscillator is normalised 0-100. v1.02 added raw MACD (price units) to
//      RSI/Stoch (0-100), so MACD swamped the composite on BTC/indices and
//      vanished on FX. MACD is now scaled by ATR and clamped to 0-100.
//    * Real score. v1.02 used constants (85/78/88/82), so "Score Threshold"
//      did nothing below 78. Score now = divergence type + oscillator spread
//      + OB/OS zone or trend alignment + horizon (D/W/M level) confluence.
//    * Full divergence set: Regular, Hidden AND Exaggerated (equal price,
//      oscillator divergence), bullish and bearish.
//    * Compares the new pivot with up to N earlier pivots (not only the last
//      one) and rejects a divergence line that intermediate pivots cut.
//    * Minimum oscillator spread filter (no 0.01-point "divergences").
//    * Label offset uses ATR instead of 30 * mintick.
//    * Duplicate alertconditions removed; divergence alertconditions added.
//  Signals print on the pivot CONFIRMATION bar (pivot + Pivot Strength bars),
//  so nothing repaints. The line/label is drawn back at the pivot itself.
// ============================================================================
indicator("HRD Full Divergence v1.03", shorttitle="HRD Div", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================ INPUTS ============================
grpColors    = "Horizon Colors"
showHorizons = input.bool(true, "Show Horizon Levels", group=grpColors)
dailyColor   = input.color(color.aqua,    "Daily Color",   group=grpColors)
weeklyColor  = input.color(color.yellow,  "Weekly Color",  group=grpColors)
monthlyColor = input.color(color.fuchsia, "Monthly Color", group=grpColors)

grpOsc  = "Composite Oscillator"
rsiLen  = input.int(14, "RSI Length",            minval=2, group=grpOsc)
stLen   = input.int(5,  "Stoch %K Length",       minval=1, group=grpOsc)
stSmth  = input.int(3,  "Stoch Smoothing",       minval=1, group=grpOsc)
wRsi    = input.float(0.4, "Weight RSI",   minval=0, step=0.05, group=grpOsc)
wMacd   = input.float(0.3, "Weight MACD",  minval=0, step=0.05, group=grpOsc)
wStoch  = input.float(0.3, "Weight Stoch", minval=0, step=0.05, group=grpOsc)

grpDiv         = "Divergence Settings"
scoreThreshold = input.int(70,  "Score Threshold",                 minval=0, maxval=100, group=grpDiv)
pivotStrength  = input.int(5,   "Pivot Strength (L/R)",            minval=1,             group=grpDiv)
maxDivLookback = input.int(60,  "Max Divergence Lookback (bars)",  minval=10,            group=grpDiv)
maxCompare     = input.int(3,   "Compare with last N pivots",      minval=1, maxval=10,  group=grpDiv)
minOscDelta    = input.float(3.0, "Min Oscillator Spread",         minval=0, step=0.5,   group=grpDiv)
eqTolAtr       = input.float(0.1, "Equal-Price Tolerance (x ATR)", minval=0, step=0.05,  group=grpDiv, tooltip="Pivots closer than this are 'equal' -> Exaggerated divergence")
useRegular     = input.bool(true, "Regular",     inline="k", group=grpDiv)
useHidden      = input.bool(true, "Hidden",      inline="k", group=grpDiv)
useExag        = input.bool(true, "Exaggerated", inline="k", group=grpDiv)

grpScore  = "Scoring"
osLevel   = input.float(35, "Oversold zone (osc <=)",   group=grpScore)
obLevel   = input.float(65, "Overbought zone (osc >=)", group=grpScore)
trendLen  = input.int(200, "Trend EMA (hidden div bonus)", minval=1, group=grpScore)
hzTolAtr  = input.float(0.5, "Horizon proximity (x ATR)", minval=0, step=0.1, group=grpScore)

grpVis       = "Display / Alerts"
showDivLines = input.bool(true, "Show Divergence Lines", group=grpVis)
showLabels   = input.bool(true, "Show Score Labels",     group=grpVis)
showWeak     = input.bool(false, "Also draw sub-threshold divergences (faded)", group=grpVis)
alertsOn     = input.bool(true, "Enable alert() calls",  group=grpVis)

// ============================ HORIZONS (HTF prev H/L) ============================
// [1] + lookahead_on = previous *completed* HTF bar -> no repaint
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
pml = request.security(syminfo.tickerid, "M", low[1],  lookahead=barmerge.lookahead_on)

plot(showHorizons ? pdh : na, "Prev Day High",   color=dailyColor,   linewidth=2, style=plot.style_stepline)
plot(showHorizons ? pdl : na, "Prev Day Low",    color=dailyColor,   linewidth=2, style=plot.style_stepline)
plot(showHorizons ? pwh : na, "Prev Week High",  color=weeklyColor,  linewidth=2, style=plot.style_stepline)
plot(showHorizons ? pwl : na, "Prev Week Low",   color=weeklyColor,  linewidth=2, style=plot.style_stepline)
plot(showHorizons ? pmh : na, "Prev Month High", color=monthlyColor, linewidth=2, style=plot.style_stepline)
plot(showHorizons ? pml : na, "Prev Month Low",  color=monthlyColor, linewidth=2, style=plot.style_stepline)

// ============================ BREAKOUTS ============================
maxLevel  = math.max(pdh, math.max(pwh, pmh))
minLevel  = math.min(pdl, math.min(pwl, pml))
bullBreak = close > maxLevel and close[1] <= maxLevel[1]
bearBreak = close < minLevel and close[1] >= minLevel[1]

plotshape(bullBreak, "Bull Break", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(bearBreak, "Bear Break", shape.triangledown, location.abovebar, color.red,  size=size.small)

// ============================ OSCILLATOR (0-100) ============================
rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
stochVal = ta.sma(ta.stoch(close, high, low, stLen), stSmth)
atrVal   = ta.atr(14)
emaTrend = ta.ema(close, trendLen)
// MACD in ATR units -> 0-100 (+/-2 ATR maps to 0/100)
macdNorm = math.max(0.0, math.min(100.0, 50.0 + 25.0 * nz(macdLine / atrVal)))
wSum     = math.max(wRsi + wMacd + wStoch, 1e-10)
osc      = (rsiVal * wRsi + macdNorm * wMacd + stochVal * wStoch) / wSum

// ============================ PIVOT HISTORY ============================
ph = ta.pivothigh(high, pivotStrength, pivotStrength)
pl = ta.pivotlow(low,   pivotStrength, pivotStrength)

var array<int>   plBars = array.new<int>()
var array<float> plPx   = array.new<float>()
var array<float> plOs   = array.new<float>()
var array<int>   phBars = array.new<int>()
var array<float> phPx   = array.new<float>()
var array<float> phOs   = array.new<float>()

// ============================ CORE ============================
// kind: 1 = Regular, 2 = Hidden, 3 = Exaggerated
kindName(int k) => k == 1 ? "Regular" : k == 2 ? "Hidden" : "Exaggerated"
kindBase(int k) => k == 1 ? 55 : k == 3 ? 45 : 40

// dir = +1 bullish (pivot lows), -1 bearish (pivot highs)
// Returns [kind, index of matched earlier pivot, oscillator spread]
findDiv(int dir, int cBar, float cPx, float cOs, float tol, array<int> bars, array<float> pxs, array<float> oss) =>
    int   bestKind  = 0
    int   bestIdx   = -1
    float bestSpr   = 0.0
    float bestPart  = -1.0
    int n = math.min(array.size(bars), maxCompare)
    if n > 0
        for i = 0 to n - 1
            int pBar = array.get(bars, i)
            if cBar - pBar > maxDivLookback
                break
            float pPx    = array.get(pxs, i)
            float pOs    = array.get(oss, i)
            float pxMove = (cPx - pPx) * dir   // < 0 : lower low (bull) / higher high (bear)
            float osMove = (cOs - pOs) * dir   // > 0 : higher osc low (bull) / lower osc high (bear)
            int k = 0
            if useRegular and pxMove < -tol and osMove >= minOscDelta
                k := 1
            else if useExag and math.abs(pxMove) <= tol and osMove >= minOscDelta
                k := 3
            else if useHidden and pxMove > tol and osMove <= -minOscDelta
                k := 2
            // Line validity: no intermediate pivot may cut through the divergence line
            if k != 0 and i > 0
                for j = 0 to i - 1
                    float lineAt = pPx + (cPx - pPx) * (array.get(bars, j) - pBar) / (cBar - pBar)
                    if (array.get(pxs, j) - lineAt) * dir < 0
                        k := 0
                        break
            if k != 0
                float spr  = math.abs(osMove)
                float part = kindBase(k) + math.min(15.0, spr * 1.5)
                if part > bestPart
                    bestPart := part
                    bestKind := k
                    bestIdx  := i
                    bestSpr  := spr
    [bestKind, bestIdx, bestSpr]

// Horizon confluence: pivot within tol of a D/W/M level -> +10/+15/+20 (cap 30)
hzBonus(float px, float tol, float dH, float dL, float wH, float wL, float mH, float mL) =>
    float b = 0.0
    if math.min(math.abs(px - nz(dH, 1e20)), math.abs(px - nz(dL, 1e20))) <= tol
        b += 10
    if math.min(math.abs(px - nz(wH, 1e20)), math.abs(px - nz(wL, 1e20))) <= tol
        b += 15
    if math.min(math.abs(px - nz(mH, 1e20)), math.abs(px - nz(mL, 1e20))) <= tol
        b += 20
    math.min(b, 30.0)

calcScore(int dir, int k, float spr, float cOs, float cPx, float trendAt, float hz) =>
    float s = kindBase(k) + math.min(15.0, spr * 1.5)
    if k == 2
        s += (dir == 1 ? cPx > trendAt : cPx < trendAt) ? 10 : 0
    else
        s += (dir == 1 ? cOs <= osLevel : cOs >= obLevel) ? 10 : 0
    int(math.round(math.min(100.0, s + hz)))

pushPivot(array<int> bars, array<float> pxs, array<float> oss, int b, float p, float o) =>
    array.unshift(bars, b)
    array.unshift(pxs, p)
    array.unshift(oss, o)
    if array.size(bars) > 10
        array.pop(bars)
        array.pop(pxs)
        array.pop(oss)

drawDiv(int dir, int k, int score, int b1, float p1, int b2, float p2, float atrAt) =>
    bool strong = score >= scoreThreshold
    if strong or showWeak
        color base = dir == 1 ? color.lime : color.red
        color col  = strong ? base : color.new(color.gray, 40)
        if showDivLines
            line.new(b1, p1, b2, p2, color=col, width=strong ? 2 : 1, style=k == 2 ? line.style_dashed : line.style_dotted)
        if showLabels
            string txt = (k == 2 ? "Hidden " : k == 3 ? "Exag. " : "Regular ") + (dir == 1 ? "Bull" : "Bear") + " | " + str.tostring(score)
            color  tc  = strong ? (score >= 85 ? base : color.yellow) : color.gray
            label.new(b2, dir == 1 ? p2 - atrAt * 0.5 : p2 + atrAt * 0.5, txt, style=dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(tc, 80), textcolor=tc, size=size.small)

// ============================ DETECTION ============================
int    bullScore = 0
int    bearScore = 0
string bullKind  = ""
string bearKind  = ""
float  bullHz    = 0.0
float  bearHz    = 0.0

if not na(pl)
    int   cBar  = bar_index - pivotStrength
    float cOs   = osc[pivotStrength]
    float atrAt = atrVal[pivotStrength]
    [k, idx, spr] = findDiv(1, cBar, pl, cOs, eqTolAtr * atrAt, plBars, plPx, plOs)
    if k != 0
        bullHz := hzBonus(pl, hzTolAtr * atrAt, pdh[pivotStrength], pdl[pivotStrength], pwh[pivotStrength], pwl[pivotStrength], pmh[pivotStrength], pml[pivotStrength])
        bullScore := calcScore(1, k, spr, cOs, pl, emaTrend[pivotStrength], bullHz)
        bullKind  := kindName(k)
        drawDiv(1, k, bullScore, array.get(plBars, idx), array.get(plPx, idx), cBar, pl, atrAt)
    pushPivot(plBars, plPx, plOs, cBar, pl, cOs)

if not na(ph)
    int   cBar  = bar_index - pivotStrength
    float cOs   = osc[pivotStrength]
    float atrAt = atrVal[pivotStrength]
    [k, idx, spr] = findDiv(-1, cBar, ph, cOs, eqTolAtr * atrAt, phBars, phPx, phOs)
    if k != 0
        bearHz := hzBonus(ph, hzTolAtr * atrAt, pdh[pivotStrength], pdl[pivotStrength], pwh[pivotStrength], pwl[pivotStrength], pmh[pivotStrength], pml[pivotStrength])
        bearScore := calcScore(-1, k, spr, cOs, ph, emaTrend[pivotStrength], bearHz)
        bearKind  := kindName(k)
        drawDiv(-1, k, bearScore, array.get(phBars, idx), array.get(phPx, idx), cBar, ph, atrAt)
    pushPivot(phBars, phPx, phOs, cBar, ph, cOs)

bullDiv = bullScore >= scoreThreshold and bullScore > 0
bearDiv = bearScore >= scoreThreshold and bearScore > 0

// Confirmation-bar markers (the bar a strategy/alert can act on)
plotshape(bullDiv, "Bull Div Confirmed", shape.circle, location.belowbar, color.lime, size=size.tiny)
plotshape(bearDiv, "Bear Div Confirmed", shape.circle, location.abovebar, color.red,  size=size.tiny)

// Data window values
plot(osc,       "Composite Osc", display=display.data_window)
plot(bullScore, "Bull Score",    display=display.data_window)
plot(bearScore, "Bear Score",    display=display.data_window)

// ============================ ALERTS ============================
if alertsOn and bullDiv
    alert("HRD " + bullKind + " Bullish | Score " + str.tostring(bullScore) + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
if alertsOn and bearDiv
    alert("HRD " + bearKind + " Bearish | Score " + str.tostring(bearScore) + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

alertcondition(bullBreak, "Bullish Breakout",   "HRD Bull Break of horizon")
alertcondition(bearBreak, "Bearish Breakout",   "HRD Bear Break of horizon")
alertcondition(bullDiv,   "Bullish Divergence", "HRD Bullish divergence (score >= threshold)")
alertcondition(bearDiv,   "Bearish Divergence", "HRD Bearish divergence (score >= threshold)")
