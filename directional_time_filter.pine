//@version=6
// ============================================================================
//  DIRECTIONAL TIME FILTER  -  v1.3
// ----------------------------------------------------------------------------
//  A time-boxed direction PERMISSION you can bolt onto any script. It only
//  answers "is a buy allowed now? is a sell allowed now?". Your script's own
//  entry and exit logic stays as it is; a signal that is not allowed is
//  simply not taken.
//
//  You say: "from THIS moment, for the next N minutes (countdown),
//            only take BUYS while PRICE is ABOVE <buy level>
//            and only take SELLS while PRICE is BELOW <sell level>."
//  When the countdown reaches zero the filter closes: no new trades at all
//  until you set a new start time. It never re-opens by itself.
//
//  Example:  start = 14:30, countdown = 15 min, levels = 50 / 50
//            14:30:00 -> 14:45:00   buy signals pass only if price > 50
//                                   sell signals pass only if price < 50
//            after 14:45:00         every signal is blocked
//
//  INPUTS (group "Directional time filter")
//    Enable filter      Off = every signal passes, as if the filter is absent.
//    Start time         Date + minute the window opens, in the chart's time
//                       zone. When you add the script you are asked to click
//                       the chart (bar precision); afterwards set it in
//                       Settings (minute precision). "+ seconds" adds seconds.
//                       To start right now: the status box shows the current
//                       time; type it in.
//    Countdown (min)    Minutes the window stays open from the start.
//                       0 = never expires.
//    Price              What is compared to the levels. Default: close.
//                       Can be any plotted series (e.g. an indicator line).
//    Buy only above     Buys pass only while price > this level.
//    Sell only below    Sells pass only while price < this level.
//    Allow buys/sells   Turn a side off completely inside the window.
//    Before start       What happens before the window opens:
//                       "Block" (no trades) or "Pass" (filter not active yet).
//    Shade window / Draw levels / Status box   Chart visuals.
//
//  OUTPUTS (Data Window / "Source" dropdown of another script)
//    DTF window open    1 while the window is open, 0 otherwise.
//    DTF buy allowed    1 when a buy may be taken on this bar, 0 otherwise.
//    DTF sell allowed   1 when a sell may be taken on this bar, 0 otherwise.
//    DTF expired        1 on the first bar after the window closes.
//    DTF price used     The series compared to the levels (echo of Price).
//
//  HOW TO USE IT
//  A) Paste into your own script (recommended)
//     Copy everything between the "BEGIN" and "END" markers below into your
//     script, below your own inputs. Then gate your entries:
//
//         if myBuySignal and dtfBuyOk
//             strategy.entry("L", strategy.long)
//         if mySellSignal and dtfSellOk
//             strategy.entry("S", strategy.short)
//
//     Exits are never gated. If your script runs in its own pane (a TDI,
//     an RSI...) set DTF_FORCE_OVERLAY = true so the visuals land on the
//     price chart. The block ships with the filter ON and a start in 2030,
//     i.e. WAITING and everything blocked: set a Start time, or switch
//     "Enable filter" off until you need it.
//     To compare the levels to one of your script's own series instead of
//     price, change  dtfValue = dtfRef  to  dtfValue = myLine  (myLine must
//     be computed above the block; move the block down if needed).
//     See xpw_orientation_tdi_v2.4_strategy.pine for a complete example
//     (two gates added to the entry conditions, nothing else changed).
//
//  B) Link without editing (indicator -> strategy)
//     Add this indicator to the chart. In your strategy add
//         dtfBuyExt  = input.source(close, "DTF buy allowed")
//         dtfSellExt = input.source(close, "DTF sell allowed")
//     and in the strategy's settings pick the "DTF buy allowed" / "DTF sell
//     allowed" plots (listed under this indicator's name). Gate with
//         myBuySignal and dtfBuyExt == 1
//     (== 1, not > 0: if the plot is not linked the source is still 'close'
//     and must not count as allowed; a symbol that closes at exactly 1.0
//     would still slip through, so check the link in the settings.)
//
//  TIMING
//  The committed value of every bar is judged at the bar's CLOSE time, on
//  history and live alike, so nothing changes when the chart reloads and a
//  strategy (which runs once per bar, at its close) backtests exactly as it
//  runs live. A bar is inside the window when its close is in [start, end):
//  the bar that closes exactly at the start is inside (its order fills at
//  the start), the bar that closes exactly at the end is outside. The order
//  of the last allowed bar fills at the open of the following bar; on a
//  thinly traded symbol that can be after the window has ended. While the
//  live bar is still forming, the real clock is used, so in an indicator the
//  shading, status box and alerts open/close on the exact second; those
//  intrabar states are not kept once the bar closes. A countdown shorter
//  than one chart bar opens for at most one bar, maybe none. On chart types
//  without a close time (Renko, Kagi, Line Break, Point & Figure) a bar is
//  judged at its open time. Bar Replay: committed bars are right; the
//  forming bar and the status box follow the real clock, not the replay.
//  Alerts and webhook/broker connections are snapshots of the inputs at
//  creation time: after changing Start time, re-create them.
// ============================================================================
indicator("Directional Time Filter", "DTF", overlay=true)

// ======================= BEGIN DIRECTIONAL TIME FILTER =======================
// Set true when this block lives in a script that runs in its own pane
// (overlay=false) so the visuals are drawn on the price chart.
DTF_FORCE_OVERLAY = false
GRP_DTF = "Directional time filter"
dtfOn        = input.bool(true, "Enable filter", group=GRP_DTF, tooltip="Off: every signal passes. On: buys are allowed only while price > buy level, sells only while price < sell level, and only inside the time window.")
dtfStart     = input.time(timestamp("2030-01-01T00:00:00+0000"), "Start time", confirm=true, group=GRP_DTF, tooltip="Date and minute the window opens, in the chart's time zone (the one on the time axis). Click the chart when adding the script, or set it here (minute resolution; add seconds below). To start right now, type the current time shown in the status box.")
dtfStartSec  = input.int(0, "+ seconds", minval=0, maxval=59, group=GRP_DTF, tooltip="Seconds added to the start (useful on second charts).")
dtfMinutes   = input.float(15, "Countdown (minutes)", minval=0, step=1, group=GRP_DTF, tooltip="Minutes the window stays open from the start. 0 = never expires. Bars are judged at their close, so a countdown shorter than one chart bar opens for at most one bar.")
dtfRef       = input.source(close, "Price", group=GRP_DTF, tooltip="What is compared to the levels. Default: close price. You can pick any plotted line from another indicator instead.")
dtfBuyLevel  = input.float(50, "Buy only above (price)", group=GRP_DTF, tooltip="A price level on this chart. Buys are allowed only while price is above it.")
dtfSellLevel = input.float(50, "Sell only below (price)", group=GRP_DTF, tooltip="A price level on this chart. Sells are allowed only while price is below it.")
dtfAllowBuy  = input.bool(true, "Allow buys", inline="side", group=GRP_DTF, tooltip="Turn one side off completely inside the window.")
dtfAllowSell = input.bool(true, "Allow sells", inline="side", group=GRP_DTF)
dtfBefore    = input.string("Block", "Before start", options=["Block", "Pass"], group=GRP_DTF, tooltip="Block: nothing is allowed before the window opens. Pass: everything is allowed until the window opens.")
dtfShowBg    = input.bool(true, "Shade window", inline="vis", group=GRP_DTF)
dtfShowLv    = input.bool(true, "Draw levels", inline="vis", group=GRP_DTF)
dtfShowTbl   = input.bool(true, "Status box", inline="vis", group=GRP_DTF, tooltip="Shown while the filter is enabled. Updates on each tick (once per bar inside a strategy) and freezes when the market is closed.")
dtfTblPos    = input.string("top_right", "Status box position", options=["top_right","middle_right","bottom_right","top_left","middle_left","bottom_left","top_center","bottom_center"], group=GRP_DTF)

dtfValue = dtfRef

// Clock. The committed value of a bar (history, and the closing update of the
// live bar) is judged at the bar's close time, so it never repaints. Intrabar
// ticks of the live bar use the real clock, so the window opens on the second.
dtfClock   = barstate.isconfirmed ? nz(time_close, time) : timenow
dtfStartAt = dtfStart + dtfStartSec * 1000
dtfEnd     = dtfMinutes > 0 ? dtfStartAt + math.round(dtfMinutes * 60000) : na

dtfBeforeStart = dtfClock < dtfStartAt
dtfOpen        = not dtfBeforeStart and (na(dtfEnd) or dtfClock < dtfEnd)
dtfAfterEnd    = not na(dtfEnd) and dtfClock >= dtfEnd

// Final gates: is a buy / a sell ALLOWED on this bar? (Permission only.)
dtfBuyOk  = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowBuy  and dtfValue > dtfBuyLevel)
dtfSellOk = not dtfOn or (dtfBeforeStart and dtfBefore == "Pass") or (dtfOpen and dtfAllowSell and dtfValue < dtfSellLevel)

// True on the first bar after the window has closed (chart marker / output).
dtfExpired = dtfOn and dtfAfterEnd and not dtfAfterEnd[1] and not barstate.isfirst

// A countdown shorter than one chart bar opens for at most one bar.
dtfTooShort = dtfOn and dtfMinutes > 0 and dtfMinutes * 60 < timeframe.in_seconds()

// ---- Visuals (optional: delete from here to END if you only want the gates)
dtfPosOf(string s) =>
    switch s
        "top_right"     => position.top_right
        "bottom_right"  => position.bottom_right
        "top_left"      => position.top_left
        "middle_left"   => position.middle_left
        "bottom_left"   => position.bottom_left
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        => position.middle_right

bgcolor(dtfShowBg and dtfOn and dtfOpen ? (dtfBuyOk and dtfSellOk ? color.new(color.yellow, 85) : dtfBuyOk ? color.new(color.green, 85) : dtfSellOk ? color.new(color.red, 85) : color.new(color.gray, 88)) : na, title="DTF window", force_overlay=DTF_FORCE_OVERLAY)
plotshape(dtfExpired, "DTF window ended", shape.xcross, location.top, color.orange, size=size.tiny, text="DTF end", textcolor=color.orange, force_overlay=DTF_FORCE_OVERLAY)

// Level lines as drawings (they do not stretch the price scale). While
// waiting they preview the last 50 bars; while open they span the window;
// after the end they stay as a record. Redrawn every bar so a host script's
// own drawings never garbage-collect them.
dtfActive = dtfOn and (dtfBeforeStart or dtfOpen)
var line dtfBuyLn    = na
var line dtfSellLn   = na
var int  dtfOpenFrom = na
if dtfOpen and na(dtfOpenFrom)
    dtfOpenFrom := bar_index
if dtfShowLv and dtfActive
    int dtfX1 = dtfOpen ? dtfOpenFrom : math.max(0, bar_index - 50)
    line.delete(dtfBuyLn)
    line.delete(dtfSellLn)
    dtfBuyLn  := line.new(dtfX1, dtfBuyLevel,  bar_index, dtfBuyLevel,  color=color.new(color.green, 0), width=2, force_overlay=DTF_FORCE_OVERLAY)
    dtfSellLn := line.new(dtfX1, dtfSellLevel, bar_index, dtfSellLevel, color=color.new(color.red, 0),   width=2, force_overlay=DTF_FORCE_OVERLAY)
else if not dtfActive
    dtfOpenFrom := na

// Status box, judged by the real clock (display only; the gates never use it).
var table dtfTable = table.new(dtfPosOf(dtfTblPos), 2, 6, bgcolor=color.new(color.black, 20), border_width=1, force_overlay=DTF_FORCE_OVERLAY)
if dtfShowTbl and dtfOn and barstate.islast
    bool   dBefore = timenow < dtfStartAt
    bool   dAfter  = not na(dtfEnd) and timenow >= dtfEnd
    bool   dOpen   = not dBefore and not dAfter
    bool   dBuy    = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowBuy  and dtfValue > dtfBuyLevel)
    bool   dSell   = (dBefore and dtfBefore == "Pass") or (dOpen and dtfAllowSell and dtfValue < dtfSellLevel)
    string dState  = dBefore ? (dtfTooShort ? "WAITING (< 1 bar)" : "WAITING") : dOpen ? "OPEN" : "ENDED"
    color  dCol    = dBefore ? color.yellow : dOpen ? color.lime : color.orange
    int    dSecs   = dOpen and not na(dtfEnd) ? math.max(0, math.floor((dtfEnd - timenow) / 1000.0)) : 0
    string dLeft   = dOpen and not na(dtfEnd) ? str.tostring(math.floor(dSecs / 60), "00") + ":" + str.tostring(dSecs % 60, "00") : dOpen ? "no limit" : "-"
    table.cell(dtfTable, 0, 0, "DTF", text_color=color.white)
    table.cell(dtfTable, 1, 0, dState, text_color=dCol)
    table.cell(dtfTable, 0, 1, "Now (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 1, str.format_time(timenow, "MMM dd HH:mm:ss", syminfo.timezone), text_color=color.white)
    table.cell(dtfTable, 0, 2, "Start (exch tz)", text_color=color.white)
    table.cell(dtfTable, 1, 2, str.format_time(dtfStartAt, "MMM dd HH:mm:ss", syminfo.timezone), text_color=color.white)
    table.cell(dtfTable, 0, 3, "Countdown", text_color=color.white)
    table.cell(dtfTable, 1, 3, dLeft, text_color=color.white)
    table.cell(dtfTable, 0, 4, "Buy  (> " + str.tostring(dtfBuyLevel) + ")", text_color=color.white)
    table.cell(dtfTable, 1, 4, dBuy ? "ALLOWED" : "BLOCKED", text_color=dBuy ? color.lime : color.red)
    table.cell(dtfTable, 0, 5, "Sell (< " + str.tostring(dtfSellLevel) + ")", text_color=color.white)
    table.cell(dtfTable, 1, 5, dSell ? "ALLOWED" : "BLOCKED", text_color=dSell ? color.lime : color.red)
// ======================== END DIRECTIONAL TIME FILTER ========================

// Exported values (Data Window + linkable as a source from other scripts).
plot(dtfOn and dtfOpen ? 1 : 0, "DTF window open", display=display.data_window)
plot(dtfBuyOk ? 1 : 0, "DTF buy allowed", display=display.data_window)
plot(dtfSellOk ? 1 : 0, "DTF sell allowed", display=display.data_window)
plot(dtfExpired ? 1 : 0, "DTF expired", display=display.data_window)
plot(dtfValue, "DTF price used", display=display.data_window)
