    "v1.20 BTC M3/D1 (low-cost)" => "or"
    "v1.10 Gold M3/H1" => "and"
    "v1.10 Gold M2/H1" => "and"
    "v1.10 Gold M3/H4" => "and"
    "v1.10 BTC M3/H1 (low-cost)" => "and"
    "v1.10 BTC M3/M30 (experimental)" => "and"
    => cStochR
bool tpZone = switch preset
    "v1.20 Gold M2/H4" => true
    "v1.20 Gold M3/H4" => false
    "v1.20 Gold M3/M15" => true
    "v1.20 Gold M3/H1" => false
    "v1.20 Gold M2/H1" => true
    "v1.20 BTC M1/M15 (low-cost)" => true
    "v1.20 BTC M5/H2 (low-cost)" => true
    "v1.20 BTC M3/D1 (low-cost)" => false
    "v1.10 Gold M3/H1" => false
    "v1.10 Gold M2/H1" => false
    "v1.10 Gold M3/H4" => false
    "v1.10 BTC M3/H1 (low-cost)" => false
    "v1.10 BTC M3/M30 (experimental)" => false
    => cZone
float zoneTol = switch preset
    "v1.20 Gold M2/H4" => 71
    "v1.20 Gold M3/H4" => 173
    "v1.20 Gold M3/M15" => 87
    "v1.20 Gold M3/H1" => 173
    "v1.20 Gold M2/H1" => 71
    "v1.20 BTC M1/M15 (low-cost)" => 3260
    "v1.20 BTC M5/H2 (low-cost)" => 7290
    "v1.20 BTC M3/D1 (low-cost)" => 5646
    "v1.10 Gold M3/H1" => 100
    "v1.10 Gold M2/H1" => 100
    "v1.10 Gold M3/H4" => 100
    "v1.10 BTC M3/H1 (low-cost)" => 100
    "v1.10 BTC M3/M30 (experimental)" => 100
    => cZoneTol
int zoneMin = switch preset
    "v1.20 Gold M2/H4" => 1
    "v1.20 Gold M3/H4" => 1
    "v1.20 Gold M3/M15" => 1
    "v1.20 Gold M3/H1" => 1
    "v1.20 Gold M2/H1" => 1
    "v1.20 BTC M1/M15 (low-cost)" => 1
    "v1.20 BTC M5/H2 (low-cost)" => 1
    "v1.20 BTC M3/D1 (low-cost)" => 1
    "v1.10 Gold M3/H1" => 1
    "v1.10 Gold M2/H1" => 1
    "v1.10 Gold M3/H4" => 1
    "v1.10 BTC M3/H1 (low-cost)" => 1
    "v1.10 BTC M3/M30 (experimental)" => 1
    => cZoneMin
float tpBuf = switch preset
    "v1.20 Gold M2/H4" => 0
    "v1.20 Gold M3/H4" => 35
    "v1.20 Gold M3/M15" => 0
    "v1.20 Gold M3/H1" => 0
    "v1.20 Gold M2/H1" => 28
    "v1.20 BTC M1/M15 (low-cost)" => 0
    "v1.20 BTC M5/H2 (low-cost)" => 1458
    "v1.20 BTC M3/D1 (low-cost)" => 1129
    "v1.10 Gold M3/H1" => 0
    "v1.10 Gold M2/H1" => 0
    "v1.10 Gold M3/H4" => 0
    "v1.10 BTC M3/H1 (low-cost)" => 0
    "v1.10 BTC M3/M30 (experimental)" => 0
    => cTpBuf
float spreadDef = switch preset
    "v1.20 Gold M2/H4" => 0.45
    "v1.20 Gold M3/H4" => 0.45
    "v1.20 Gold M3/M15" => 0.45
    "v1.20 Gold M3/H1" => 0.45
    "v1.20 Gold M2/H1" => 0.45
    "v1.20 BTC M1/M15 (low-cost)" => 5.0
    "v1.20 BTC M5/H2 (low-cost)" => 5.0
    "v1.20 BTC M3/D1 (low-cost)" => 5.0
    "v1.10 Gold M3/H1" => 0.45
    "v1.10 Gold M2/H1" => 0.45
    "v1.10 Gold M3/H4" => 0.45
    "v1.10 BTC M3/H1 (low-cost)" => 5.0
    "v1.10 BTC M3/M30 (experimental)" => 5.0
    => 0.0
// <</preset-values>>
useHtf   = preset == "Custom" ? cUseHtf : true
reqSweep = preset == "Custom" ? cSweep : false
sessOn   = preset == "Custom" ? cSessOn : true
spread   = spreadIn >= 0 ? spreadIn : spreadDef
ntBars   = ntIn > 0 ? ntIn : nBars
PT       = 0.01                                   // one "point" = 0.01 price, as in the EA presets
if useHtf and timeframe.in_seconds(htfTf) <= timeframe.in_seconds(timeframe.period)
    runtime.error("The trend filter timeframe (" + htfTf + ") must be higher than the chart timeframe (" + timeframe.period + ").")

// ===================================================================== R1 trend filter (no repaint)
// lookahead_on returns the HTF bar that CONTAINS this chart bar. Its values [0] are only final
// when this chart bar is the last one of that HTF bar (they close together); otherwise the last
// closed HTF bar is [1]. The EA decides at the next bar's open, so on the closing bar it already
// sees the HTF bar that just closed: this reproduces that without looking ahead.
htfData() =>
    m = ta.ema(close, 12) - ta.ema(close, 26)
    e = ta.ema(close, 50)
    [m, close, e, m[1], close[1], e[1], time_close]
[hM0, hC0, hE0, hM1, hC1, hE1, hTClose] = request.security(syminfo.tickerid, htfTf, htfData(), barmerge.gaps_off, barmerge.lookahead_on)
htfJustClosed = not na(hTClose) and not na(time_close) and time_close >= hTClose
hMacd  = htfJustClosed ? hM0 : hM1
hClose = htfJustClosed ? hC0 : hC1
hEma   = htfJustClosed ? hE0 : hE1
macdBear = hMacd < 0
emaBear  = hClose < hEma
htfBear  = condMode == "or" ? (macdBear or emaBear) : condMode == "macd" ? macdBear : condMode == "ema" ? emaBear : (macdBear and emaBear)
biasOK   = not useHtf or htfBear

// ===================================================================== R2 trigger, R3 stochastic
macd      = ta.ema(close, 12) - ta.ema(close, 26)
zeroCross = macd[1] >= 0 and macd < 0
stK = ta.stoch(close, high, low, 7)               // slowing 1 = raw %K
stD = ta.sma(stK, 7)
wasOB   = ta.highest(stK, 5) >= 80
turned  = stK < stD or stK < 80
stochOK = stochRule == "or" ? (wasOB or turned) : (wasOB and turned)

// ===================================================================== R6 session (next bar's open)
nextOpen = time_close
hhmm = hour(nextOpen, "America/New_York") * 100 + minute(nextOpen, "America/New_York")
inSession = not sessOn or (sessFrom <= sessTo ? (hhmm >= sessFrom and hhmm < sessTo) : (hhmm >= sessFrom or hhmm < sessTo))

// ===================================================================== R4 liquidity structure
// Offsets: the EA's shift k (k = 1 is the last closed bar) is offset k - 1 here, because the
// strategy decides on the close of that bar. The entry price is this bar's close, where the
// order fills (process_orders_on_close); the EA fills at the next bar's open bid.
isSwingHigh(int o, int s) =>
    bool ok = true
    for k = 1 to s
        if high[o - k] >= high[o] or high[o + k] > high[o]
            ok := false
            break
    ok
isSwingLow(int o, int s) =>
    bool ok = true
    for k = 1 to s
        if low[o - k] <= low[o] or low[o + k] < low[o]
            ok := false
            break
    ok

float planSL  = na
float planTP  = na
float planRef = na
string planWhy = ""
var string lastSkip = "-"
bool signal = false
bool readyBars = bar_index > math.max(nBars, ntBars) + sStr + 60

if barstate.isconfirmed and zeroCross and readyBars and strategy.position_size == 0 and biasOK and inSession and (not stochHard or stochOK)
    entryPx = close
    // (a) liquidity sweep candle: most recent bar that ran above an older swing high and closed below it
    int sweepO = -1
    for j = 1 to nBars
        int oj = j - 1
        // Pine counts DOWN when start > end, so guard the range explicitly
        if j + sStr + 1 <= nBars
            for i = j + sStr + 1 to nBars
                int oi = i - 1
                if isSwingHigh(oi, sStr) and high[oj] > high[oi] and close[oj] < high[oi]
                    sweepO := oj
                    break
        if sweepO >= 0
            break
    int structO = -1
    if sweepO >= 0 and high[sweepO] > entryPx
        structO := sweepO
    else if not reqSweep and 1 + sStr <= nBars
        // (b) most recent confirmed swing high above price
        for i = 1 + sStr to nBars
            if isSwingHigh(i - 1, sStr) and high[i - 1] > entryPx
                structO := i - 1
                break
    if structO < 0
        planWhy := "no liquidity high above price"
    else
        float ref = entryPx
        for o = 0 to structO
            ref := math.max(ref, high[o])
        float sl = ref + bufPts * PT + spread           // EA: buffer + spread above the high (ask side)
        float risk = sl - entryPx
        float riskPts = risk / PT
        // TP: nearest swing low below price (highest first) that pays >= min reward:risk
        // TP candidates: swing lows below price within the TP lookback, highest first.
        // Zone mode (EA TP_Mode = TP_ZONE): lows within the tolerance of a zone's TOP form one zone
        // and the zone top is the candidate. The TP is the candidate + TP buffer, and the first
        // (highest) candidate that pays >= min reward:risk is used.
        float tp = na
        lowsArr = array.new_float()
        if 1 + sStr <= ntBars
            for i = 1 + sStr to ntBars
                int o = i - 1
                if isSwingLow(o, sStr) and low[o] < entryPx
                    array.push(lowsArr, low[o])
        array.sort(lowsArr, order.descending)
        cands = array.new_float()
        if tpZone
            float zTop = na
            int zCount = 0
            for lv in lowsArr
                if not na(zTop) and zTop - lv <= zoneTol * PT
                    zCount += 1
                else
                    if not na(zTop) and zCount >= zoneMin
                        array.push(cands, zTop)
                    zTop := lv
                    zCount := 1
            if not na(zTop) and zCount >= zoneMin
                array.push(cands, zTop)
        else
            cands := lowsArr
        for c in cands
            float tpc = c + tpBuf * PT
            float reward = entryPx - tpc
            if reward > 0 and (minRR <= 0 or reward >= minRR * risk)
                tp := tpc
                break
        if na(tp) and fbRR > 0
            tp := entryPx - fbRR * risk
        if na(tp)
            planWhy := "no liquidity pool pays the min reward:risk"
        else if riskPts < minSLPts
            planWhy := "SL too tight"
        else if maxSLPts > 0 and riskPts > maxSLPts
            planWhy := "SL too wide"
        else
            planSL := sl
            planTP := tp
            planRef := ref
            signal := true
    lastSkip := signal ? "-" : planWhy

// ===================================================================== orders
// The EA's SL / TP / trailing trigger on the ASK. On a bid chart that is "spread" lower.
sh = spreadOn ? spread : 0.0
toTicks(float price) => math.max(1, math.round(price / syminfo.mintick))

var float openSL = na
var float openTP = na
if signal
    float riskMoney = strategy.equity * riskPct / 100.0
    float qty = riskMoney / ((planSL - close) * syminfo.pointvalue)
    qty := math.floor(qty / qtyStep) * qtyStep
    if qty > 0
        strategy.entry("XLZC short", strategy.short, qty = qty, comment = stochOK ? "STO+" : "STO-")
        stopPx  = planSL - sh
        limitPx = planTP - sh
        if trailOn
            strategy.exit("XLZC exit", "XLZC short", stop = stopPx, limit = limitPx,
                 trail_points = toTicks(tStart * PT + sh), trail_offset = toTicks(tDist * PT))
        else
            strategy.exit("XLZC exit", "XLZC short", stop = stopPx, limit = limitPx)
        openSL := stopPx
        openTP := limitPx

if strategy.position_size == 0 and not signal
    openSL := na
    openTP := na

// ===================================================================== display
plotshape(showSig and signal, "Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small, text = "XLZC")
plot(showLv and strategy.position_size < 0 ? openSL : na, "Stop (bid chart)", color.new(color.red, 0), 1, plot.style_linebr)
plot(showLv and strategy.position_size < 0 ? openTP : na, "Target (bid chart)", color.new(color.teal, 0), 1, plot.style_linebr)
bgcolor(showBias and useHtf and biasOK ? color.new(color.red, 93) : na, title = "Trend filter allows shorts")

chartOK = timeframe.period == trigTf
if showTbl and barstate.islast
    var table t = table.new(position.top_right, 2, 9, border_width = 1)
    table.cell(t, 0, 0, "XLZC Bear", text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(t, 1, 0, preset, text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(t, 0, 1, "Chart / needed")
    table.cell(t, 1, 1, timeframe.period + " / " + trigTf, text_color = color.white,
         bgcolor = chartOK ? color.new(color.green, 30) : color.new(color.red, 10))
    table.cell(t, 0, 2, "Trend filter")
    table.cell(t, 1, 2, useHtf ? htfTf + (biasOK ? ": shorts allowed" : ": no shorts") : "off")
    table.cell(t, 0, 3, "Session (NY)")
    table.cell(t, 1, 3, sessOn ? str.format("{0,number,0000}-{1,number,0000} {2}", sessFrom, sessTo, inSession ? "open" : "closed") : "off")
    table.cell(t, 0, 4, "Spread modelled")
    table.cell(t, 1, 4, str.tostring(spread) + (spreadOn ? "" : " (off)"))
    table.cell(t, 0, 5, "Trailing")
    table.cell(t, 1, 5, trailOn ? str.format("{0,number,#}/{1,number,#} pts", tStart, tDist) : "off")
    table.cell(t, 0, 6, "Commission to set")
    table.cell(t, 1, 6, str.tostring(spread * syminfo.pointvalue / 2.0) + " per contract per side + broker fee")
    table.cell(t, 0, 7, "Options")
    table.cell(t, 1, 7, "trend " + condMode + ", stoch " + (stochHard ? "hard/" + stochRule : "soft") + ", TP " + (tpZone ? "zones " + str.tostring(zoneTol) + " pts" : "swing") + (tpBuf > 0 ? " +" + str.tostring(tpBuf) : ""))
    table.cell(t, 0, 8, "Last skip")
    table.cell(t, 1, 8, lastSkip)
